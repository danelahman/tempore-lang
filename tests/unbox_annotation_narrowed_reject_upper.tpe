(* Run this test with the 'time-upper-bound' grading monoid, e.g.

     ./tempore --grades time-upper-bound \
       tests/unbox_annotation_narrowed_reject_upper.tpe *)

(* Correctly rejected by the typechecker, under 'time-upper-bound': a box of 3
   ticks annotated at 2 is unboxed at the annotated grade 2, not at 3, so not
   after 3 ticks. *)
run
  box 3 () as x in
  delay 3;
  unbox (x : [2]unit) as y in y

(* Correctly rejected by the typechecker: as above, the outermost of two
   annotations giving the grade. *)
run
  box 3 () as x in
  delay 3;
  unbox ((x : [3]unit) : [2]unit) as y in y

(* Correctly rejected by the typechecker: an annotation is a supertype of the
   type inside it, and a box of 3 ticks is not one of 4. *)
run
  box 3 () as x in
  delay 3;
  unbox (x : [4]unit) as y in y
