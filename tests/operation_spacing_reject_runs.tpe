(* Run this test with the 'operation-spacing' grading monoid, e.g.

     ./tempore --grades operation-spacing \
       tests/operation_spacing_reject_runs.tpe

   Operation spacing: grades that admit no run, each entry describing the same
   run and its total duration. *)

operation Beat : unit ~> unit ! {Beat} within [0.1, 0.5]
default Beat () = delay 0.2

operation Work : unit ~> unit ! {Work} within [1, 3]
default Work () = delay 2

operation Beep : unit ~> unit ! {Beep} within [0.1, 0.5]
default Beep () = delay 0.1

(* Rejected: the entry of `Beat` gives a total duration of 11, that of `Beep`
   one of 1. *)
let apart () :
    unit ! ((1, Beat, [10, 10], [1, 1]), (1, Beep, [0, 0], [1, 1])) =
  delay 10;
  perform Beat ();
  delay 1

(* Rejected: one or two beats last 1 or 11, neither within [4, 6]. *)
let counted () : unit ! (([1, 2], Beat, [0, 0], [10, 10], [1, 1]), [4, 6]) =
  perform Beat ();
  delay 4

(* Rejected: two calls of `Work` start at least 1 apart, its least running
   time. *)
let close () : unit ! (2, Work, [0, 0.01]) =
  perform Work ();
  perform Work ()
