(* Run this test with the 'traces-timed-upper-bound-rational' grading monoid, e.g.

     ./tempore --grades traces-timed-upper-bound-rational \
       tests/rational_traces_upper_reject.tpe

   Correctly rejected by the typechecker, under the
   'traces-timed-upper-bound-rational' grading monoid: an allowance of 7/4 time
   units does not pay for a sample, which may take up to 3/2, followed by a
   rest of 1/2. *)

operation Sample : unit ~> nat ! {Sample} within [1/2, 3/2]
default Sample () = delay 1/2; 3

let late () =
  box {7/4} () as due in
  let v = perform Sample () in
  delay 1/2;
  unbox due as u in
  v
