(* Intervals with fractional endpoints under time-interval-rational, among them
   '[1/3, ∞)' with no upper bound, and intervals open at an endpoint: the open
   interval '(0, 1)', written as a pair, and the half-open '(1/2, 3/2]',
   '[0, 1/2)' and '(1/3, ∞)'. *)

let open_ended () = box [1/3, ∞) "o" as r in delay 1/3; unbox r as y in y
let closed () = box [0.25, 2.0] "c" as r in delay 1.75; unbox r as y in y
let quotients () = box [1/2, 4/3] "q" as r in delay 2/3; unbox r as y in y
let open_pair () = box (0, 1) "p" as r in delay 0.999; unbox r as y in y
let open_below () = box (1/2, 3/2] "b" as r in delay 3/2; unbox r as y in y
let open_above () = box [0, 1/2) "a" as r in delay 1/4; unbox r as y in y
let open_late () =
  box (1/3, ∞) "l" as r in delay 1/3; delay 1/100; unbox r as y in y
let within_open () : unit # (1/4, 1) = delay 1/2

run open_ended ()
run closed ()
run quotients ()
run open_pair ()
run open_below ()
run open_above ()
run open_late ()
run within_open ()
