(* Run this test with the 'regular-trace-languages-symbolic' grade algebra, e.g.

     ./tempore --grades regular-trace-languages-symbolic \
       tests/regular_reject_protocol.tpe

   Rejected under the regular trace languages: a session that reads
   after closing, and one that is never closed. *)

operation Open : unit ~> unit ! {Open}
operation Read : unit ~> nat ! {Read}
operation Close : unit ~> unit ! {Close}
operation Session : unit ~> nat ! {Open; Read*; Close}

let late_read =
  handler
  | x -> x
  | Session () k ->
      perform Open ();
      perform Close ();
      let x = perform Read () in
      continue k with x

let unclosed () : nat ! {Open; Read*; Close} =
  perform Open (); perform Read ()
