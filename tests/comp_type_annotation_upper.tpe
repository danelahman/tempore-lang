(* Run this test with the 'time-upper-bound' grading monoid, e.g.

     ./tempore --grades time-upper-bound tests/comp_type_annotation_upper.tpe

   Correctly accepted by the typechecker, under 'time-upper-bound': the body
   takes 3 ticks, within the 5 the annotation allows. *)
let f () : nat # 5 = delay 3; 1

run f ()
