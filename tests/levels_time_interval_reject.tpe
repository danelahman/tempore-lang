(* Run this test with the 'time-interval-levels' grading monoid, e.g.

     ./tempore --grades time-interval-levels \
       tests/levels_time_interval_reject.tpe

   Rational time intervals with declared levels: rejected tilt readings. *)

levels Quiet < Noisy

operation StartTiltRead : unit ~> [([0.5,2.0],Quiet)]nat ! ((0.0,0.1],Quiet)
operation ReadSpeed : unit ~> nat ! ([0.5, 1.5], Quiet)
operation Transmit : nat ~> unit ! ((0.0, 1.0], Noisy)

(* Rejected: transmitting during the conversion touches Noisy. *)
let transmitting () =
  let s = perform StartTiltRead () in
  let v = perform ReadSpeed () in
  perform Transmit v;
  unbox s as x in
  x

(* Rejected: collecting immediately after starting accumulates [0, 0], not
   within [0.5, 2]. *)
let too_early () =
  let s = perform StartTiltRead () in
  unbox s as x in
  x

(* Rejected: reading the speed twice may take up to 3, beyond 2. *)
let too_late () =
  let s = perform StartTiltRead () in
  let _ = perform ReadSpeed () in
  let _ = perform ReadSpeed () in
  unbox s as x in
  x

(* Rejected: the annotated upper end 1.6 is open, the body may take 1.6. *)
let open_end () : nat ! ((0.5, 1.6), Quiet) =
  let _ = perform StartTiltRead () in
  perform ReadSpeed ()
