(* Run this test with the 'banked-traces-upper-bound' grade algebra, e.g.

     ./tempore --grades banked-traces-upper-bound \
       tests/banked_traces_reject_self_retry.tpe

   Correctly rejected by the typechecker, under the 'banked-traces-upper-bound'
   grade algebra: a compound operation may not name itself, since its
   running-time bounds are computed from those of the operations its grade
   names. A retry has to be expressed through a smaller operation instead. *)

operation Send : string ~> unit ! {Send | Send; Send}
