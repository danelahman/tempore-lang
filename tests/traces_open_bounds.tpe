(* Correctly accepted by the typechecker, under the 'traces-cost-upper-bound'
   grading monoid: over whole time steps an open end of runtime bounds
   abbreviates the closed one a time step inside it, so 'Tx' within (1, 4)
   takes two or three time steps, and a default of two time steps stays
   within [1, 3). *)

operation Tx : unit ~> unit # {Tx} within (1, 4)
operation Beep : unit ~> unit # {Beep} within [1, 3)

default Beep () = delay 2

let telemetry () =
  box {3} 1 as slot in
  perform Tx ();
  unbox slot as r in
  r

let beep () = perform Beep ()

run beep ()
