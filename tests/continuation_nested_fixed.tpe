(* Run this test with the 'time-upper-bound' grading monoid, e.g.

     ./tempore --grades time-upper-bound tests/continuation_nested_fixed.tpe *)

operation Op1 : unit ~> unit # 1
operation Op2 : unit ~> unit # 1

(* Correctly accepted by the typechecker: the inner case returns a function
   graded by the continuation k', whose grade may be any; the only solution
   grades the function the handler returns by the top grade ∞, that is,
   without a time bound. *)
let h =
  handler
  | x -> (fun () -> x)
  | Op1 p k ->
      handle
        perform Op2 ();
        continue k with ()
      with
        (handler
         | y -> y
         | Op2 q k' -> (fun () -> let f = continue k' with () in f ()))

run handle (perform Op1 (); 7) with h
