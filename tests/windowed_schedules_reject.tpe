(* Windowed schedules: rejected programs. *)

operation Send : unit ~> unit # (1, (Send, {0}))
operation Wait : unit ~> unit # [1, 3]

(* Rejected: the transmission happens at tick 3, not at the scheduled tick 2. *)
let late_send () : unit # (4, (Send, {2})) =
  delay 3;
  perform Send ()

(* Rejected: waiting may take three ticks, beyond the interval. *)
let slow () : unit # ([2, 3], (Send, {1 | 2})) =
  perform Wait ();
  perform Send ()

(* Rejected: the box allows no transmission since boxing. *)
let sent () =
  box [2, 4] 7 as x in
  perform Send ();
  delay 1;
  unbox x as n in
  n

(* Rejected: a handler may not transmit twice for one transmission. *)
let twice () =
  handle perform Send () with
  handler
  | x -> x
  | Send () k -> perform Send (); perform Send (); continue k with ()

(* Rejected: the annotation allows a transmission only under another name. *)
let renamed () : unit # (1, (Recv, {0})) = perform Send ()
