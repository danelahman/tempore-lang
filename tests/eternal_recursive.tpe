(* Run this test with the 'time-upper-bound' grading monoid, e.g.

     ./tempore --grades time-upper-bound tests/eternal_recursive.tpe *)

type 'a tree = Leaf of 'a | Node of 'a tree * 'a tree

(* Correctly accepted by the typechecker: a list of nats and a tree of nat
   lists are eternal, so they may be used after a delay and compared. *)
let later () =
  let l = [1; 2; 3] in
  let t = Node (Leaf l, Leaf [4]) in
  delay 5;
  match (l, t) with
  | (x :: _, Node (Leaf (y :: _), _)) -> x + y
  | _ -> 0

run later ()

run [1; 2] = [1; 2]
