(* Run this test with the 'regex-timed-rigid-interval-symbolic' grading monoid, e.g.

     ./tempore --grades regex-timed-rigid-interval-symbolic \
       tests/strict_delays_whole_reject.tpe

   Rejected under the 'regex-timed-rigid-interval-symbolic' grading monoid:
   over whole time steps, a strict delay `!d` admits waiting only; the budget
   form is accepted, the strict form rejected. *)

type token = Token of string

operation Read : unit ~> nat # {Read} within [1, 1]
operation Log : unit ~> unit # {Log} within [1, 1]

(* A log of one step fits a period of two to four steps beside a wait of
   two. *)
let logged_budget () =
  box {([2, 4]; Read)*} (Token "l") as l in
  delay 2;
  let a = perform Read () in
  perform Log ();
  delay 2;
  let b = perform Read () in
  unbox l as tok in
  tok

let logged_strict () =
  box {(![2, 4]; Read)*} (Token "l") as l in
  delay 2;
  let a = perform Read () in
  perform Log ();
  delay 2;
  let b = perform Read () in
  unbox l as tok in
  tok
