(* Run this test with the 'time-upper-bound-rational' grading monoid, e.g.

     ./tempore --grades time-upper-bound-rational tests/rational_time_upper_reject.tpe *)

(* Correctly rejected by the typechecker: four delays of 1/3 overrun the 1 the
   box allows. *)
let stale () =
  box 1 "fresh" as r in
  delay 1/3;
  delay 1/3;
  delay 1/3;
  delay 1/3;
  unbox r as y in
  y
