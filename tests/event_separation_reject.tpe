(* Run this test with the 'event-separation' grading monoid, e.g.

     ./tempore --grades event-separation tests/event_separation_reject.tpe

   Event separation: rejected programs. *)

operation Beat : unit ~> unit ! {Beat} within [0.1, 0.5]
default Beat () = delay 0.2

operation Work : unit ~> unit ! {Work} within [1, 3]
default Work () = delay 2

operation Beep : unit ~> unit ! {Beep} within [0.1, 0.5]
default Beep () = delay 0.1

(* Rejected: two rounds of work between beats may take 6.5, beyond the gap
   of 5 the invariant allows. *)
let rec slow n : unit ! (Beat, [0, 0], [0, 5], [0, 5]) =
  match n with
  | 0 -> ()
  | m + 1 ->
      perform Beat ();
      perform Work ();
      perform Work ();
      slow m

(* Rejected: a delay of 1 after a beep separates two beeps by at most 1.5,
   less than the 2 the rate limit requires. *)
let rec beeps n : unit ! (Beep, [2, ∞)) =
  match n with
  | 0 -> ()
  | m + 1 ->
      perform Beep ();
      delay 1;
      beeps m

(* Rejected: the short form is no loop invariant. It allows a stretch of 5
   without a beat at the end of the round and another at the start of the
   rest, so the gap between them may be longer than 5. *)
let rec short n : unit ! (Beat, [0, 5]) =
  match n with
  | 0 -> ()
  | m + 1 ->
      perform Beat ();
      perform Work ();
      short m

(* Rejected: a value boxed for exactly two beats is used after three. *)
let three_beats () =
  box (2, Beat, [0, 1]) 7 as x in
  perform Beat ();
  perform Beat ();
  perform Beat ();
  unbox x as n in
  n

(* Rejected: a value boxed for exactly two beats is used after one. *)
let one_beat () =
  box (2, Beat, [0, 1]) 7 as x in
  perform Beat ();
  unbox x as n in
  n
