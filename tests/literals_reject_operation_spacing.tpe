(* Run this test with the 'operation-spacing' grading monoid, e.g.

     ./tempore --grades operation-spacing \
       tests/literals_reject_operation_spacing.tpe

   Rejected: a specification of operation spacing lists one interval, the
   gaps, or three, the lead, the gaps and the tail. *)

operation Beat : unit ~> unit ! {Beat} within [0.1, 0.5]

let beat () : unit ! (Beat, [0, 1], [0, 5]) = perform Beat ()
