(* Intervals with no upper bound, '[n, ∞)' (ASCII '[n, inf)'), intervals open
   at an endpoint, which abbreviate closed ones in whole ticks, and the
   top '⊤' (ASCII 'top'), which is '[0, ∞)', under time-interval. *)

let claim_late () =
  box [3, ∞) "open-ended" as r in
  delay 100;
  unbox r as y in
  y

let claim_late_ascii () =
  box [3, inf) "open-ended" as r in
  delay 3;
  unbox r as y in
  y

let claim_top () =
  box ⊤ "any time" as r in
  delay 5;
  unbox r as y in
  y

let wait : unit -> unit # top = fun () -> delay 7

(* '(1, 5)' is '[2, 4]', '[2, 5)' is '[2, 4]', '(2, 5]' is '[3, 5]' and
   '(2, ∞)' is '[3, ∞)'. *)
let claim_open () =
  box (1, 5) "open" as r in
  delay 4;
  unbox r as y in
  y

let claim_half_open () = box [2, 5) "half" as r in delay 2; unbox r as y in y
let claim_open_below () = box (2, 5] "below" as r in delay 5; unbox r as y in y
let claim_open_late () = box (2, ∞) "late" as r in delay 3; unbox r as y in y
let open_type (x : [(0, 3)]nat) : nat # [1, 1] = delay 1; unbox x as y in y

(* Intervals in box types and effect annotations, beside list literals and
   list patterns. *)
let unbox_later (x : [[1, 2]]nat list) : nat list # [1, 1] =
  delay 1;
  unbox x as ys in
  match ys with [] -> [0] | [y] -> [y; y] | y :: _ -> [y]

let open_ended (x : [[1, ∞)]nat) : nat # [2, 2] =
  delay 2;
  unbox x as y in
  y

run claim_late ()
run claim_late_ascii ()
run claim_top ()
run wait ()
run unbox_later (box [1, 2] [3; 4])
run open_ended (box [1, ∞) 5)
run claim_open ()
run claim_half_open ()
run claim_open_below ()
run claim_open_late ()
run open_type (box [1, 2] 6)
