(* functions *)

let f (x: nat) = x

let f (x: nat) : nat = x

let f (x: bool) (y: nat) (z: nat -> bool -> nat) : nat = z y x
run f true

let f x : nat*nat = (x, x)

let g (x: 'a) = x
let g (x: 'a) : 'a = 12
let g (x: 'a) y : 'a = y

let g x : 'a*'b = (x, x)
let g (x: 'a) (y: 'b) : 'a*'b = (x, y)

let g x : 'a*'a = (x, x)

let f = function
  | (x: nat) -> x

(* variants *)
type ('a,'b) cow = Small of 'a | Large of 'b

let f (x : ('a, 'b) cow) : nat =
  match x with
  | Small x -> x
  | Large x -> 100

let f x : nat =
  match x with
  | Small s -> 100
  | Large (l :nat) -> 100

(* records *)
(* Records are not supported.
type ('a,'b) bull = {small : 'a; large : 'b}

let f {small= (x: nat); large= (y: nat)} = x
