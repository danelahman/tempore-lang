(* Rejected under the regular trace grading monoids: orderings refuted by
   words of the lesser grade that the greater grade does not contain, which a
   note names when the lesser grade has more than one word. *)

operation Open : unit ~> unit # {Open}
operation Read : unit ~> nat # {Read}
operation Write : nat ~> unit # {Write}
operation Close : unit ~> unit # {Close}
operation Auth : unit ~> unit # {Auth}
operation Fetch : unit ~> unit # {Fetch}

(* A session that may write, annotated as one that only reads. *)
let session (b : bool) : nat # {Open; Read*; Close} =
  perform Open ();
  let x = perform Read () in
  if b then perform Write x else ();
  perform Close ();
  x

(* A token used after a computation that may or may not authenticate. *)
let maybe_auth (b : bool) =
  box {Auth; _*} 42 as t in
  if b then perform Auth () else perform Fetch ();
  unbox t as tok in
  tok
