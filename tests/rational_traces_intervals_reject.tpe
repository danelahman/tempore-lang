(* Correctly rejected by the typechecker, under the
   'traces-cost-interval-rational' grading monoid: a reading is not ready after
   3/4 of a time unit, since a sample banks only its lower runtime bound of 1/2
   and the rest of 1/8 falls short of the remaining quarter. *)

operation Sample : unit ~> nat # ({Sample}, {Sample}) within (1/2, 3/2)
default Sample () = delay 3/4; 3

let early () =
  box (3/4, 2) () as due in
  let v = perform Sample () in
  delay 1/8;
  unbox due as u in
  v
