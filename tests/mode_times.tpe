(* Run this test with the 'mode-times' grading monoid, e.g.

     ./tempore --grades mode-times tests/mode_times.tpe

   Mode times: the time a computation spends in each mode between a start and
   an end mode, an operation running in the mode it starts from. *)

operation Take : unit ~> unit # ({Take}, Cold, Out) within [1, 2]
operation Return : unit ~> unit # ({Return}, Out, Cold) within [1, 1]
operation Pipette : unit ~> unit # ({Pipette}, Out, Out) within [3, 5]
operation Log : unit ~> unit # {Log} within [1/2, 1]

default Take () = delay 1
default Return () = delay 1
default Pipette () = delay 4
default Log () = delay 0.5

(* Accepted: a round out of the cold block, its taking counted in the cold
   block and its pipetting, waiting and return outside it. *)
let round () : unit # (Cold, Cold, (Cold, [1, 2]), (Out, [8, 10])) =
  perform Take ();
  perform Pipette ();
  delay 4;
  perform Return ()

(* Accepted: three rounds are out of the cold block at most 30 minutes in
   total. *)
let rounds () : unit # (Cold, Cold, (Out, [0, 30])) =
  round ();
  round ();
  round ()

(* Accepted: the change of mode takes effect at the end of the operation, so
   its running time is counted in the cold block. *)
let take () : unit # (Cold, Out, (Cold, [1, 2]), (Out, 0), [1, 2]) =
  perform Take ()

(* Accepted: an operation of every mode keeps the mode, its running time
   counted in it; a bound of '_' bounds the time in each mode not named. *)
let logged () :
    unit # ((Out, Out, (Out, [1/2, 1])), (_, _, (_, [0, 1]), [1/2, 1])) =
  perform Log ()

(* Accepted: a branch between a round and a delay, which keeps any mode; a
   round gets stuck outside the cold block. *)
let maybe b :
    unit
    # ( (Cold, Cold, (Cold, [1, 6]), (Out, [0, 10])),
        (Out, Out),
        (Out, Stuck),
        (_, _),
        (_, Stuck) ) =
  if b then round () else delay 6

(* Accepted: a handler may pipette in place of a pipetting. *)
let forwarding () =
  handle round () with
  handler
  | x -> x
  | Pipette () k -> perform Pipette (); continue k with ()

run rounds ()
