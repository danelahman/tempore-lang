(* Correctly rejected by the typechecker, under the 'traces-upper-bound'
   grading monoid, whose order is the inclusion of sets of runs: a delay pays
   for no operation, so a heating is not below the one time step a box allows,
   whereas under 'traces-cost-upper-bound', with 'Heat' declared
   'within (1, 1)', that time step pays for it. A run not listed by the greater
   grade is named as a counterexample. *)

operation Heat : unit ~> unit # {Heat}
operation Read : unit ~> nat # {Read}
operation Send : nat ~> unit # {Send}

let heated () =
  box 1 42 as r in
  perform Heat ();
  unbox r as x in
  x

let read_or_send (fresh : bool) : unit # {Read} =
  if fresh then (let x = perform Read () in ()) else perform Send 0
