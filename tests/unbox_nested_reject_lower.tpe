(* Run this test with the 'time-interval-rational' grading monoid, e.g.

     ./tempore --grades time-interval-rational \
       tests/unbox_nested_reject_lower.tpe *)

operation Fetch : unit ~> [[2, 5]][[1, 3]]nat ! [0, 1]

(* Correctly rejected by the typechecker: the inner box is unboxed 1/2 after
   the outer unboxing that binds it, before the lower bound of [1, 3]. *)
let early_parameter (x : [[2, 5]][[1, 3]]nat) =
  delay 2;
  unbox x as y in
  delay 1/2;
  unbox y as v in
  v

(* Correctly rejected by the typechecker: as above, for a doubly boxed result
   of an operation. *)
let early_operation () =
  let x = perform Fetch () in
  delay 2;
  unbox x as y in
  delay 1/2;
  unbox y as v in
  v
