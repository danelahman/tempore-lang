(* Run this test with the 'time-upper-bound' grading monoid, e.g.

     ./tempore --grades time-upper-bound tests/recursion_closure_reject_upper.tpe

   A recursive function whose recursive case takes a tick: its grade ε
   satisfies 1 · ε ≾ ε, whose least solution is ∞. *)

operation Read : unit ~> unit ! 1

let rec wait (n : nat) : unit ! 'e =
  match n with 0 -> () | m + 1 -> (delay 1; wait m)

(* Correctly rejected by the typechecker: the grade of wait is ∞, which the
   annotation bounds by 1; wait 2 takes 2 ticks. *)
let f () : unit ! 1 = wait 2

(* Correctly rejected by the typechecker: the grade of wait is ∞, which the
   clause for Read bounds by 1. *)
let h = handler
  | x -> x
  | Read p k -> wait 2
