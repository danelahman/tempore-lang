(* Run this test with the 'time-interval-levels' grading monoid, e.g.

     ./tempore --grades time-interval-levels tests/levels_time_interval.tpe

   Rational time intervals with declared levels: tilt readings collected within
   their windows while nothing noisy happens, open and closed ends, and
   literals with and without spaces. *)

levels Quiet < Noisy

operation StartTiltRead : unit ~> [([0.5,2.0],Quiet)]nat ! ((0.0,0.1],Quiet)
operation ReadSpeed : unit ~> nat ! ( [0.5 , 1.5] , Quiet )
operation Transmit : nat ~> unit ! ((0, 1], Noisy)

default StartTiltRead () = delay 1/20; box ([0.5, 2.0], Quiet) 544
default ReadSpeed () = delay 0.75; 12
default Transmit v = delay 0.5; ()

(* Accepted: the speed is read during the conversion, [0.5, 1.5] within
   [0.5, 2]; the step takes the Minkowski sum (0.5, 2.6] and touches Noisy. *)
let step () : nat ! ((0.5, 2.6], Noisy) =
  let s = perform StartTiltRead () in
  let v = perform ReadSpeed () in
  unbox s as x in
  perform Transmit (x + v);
  x

(* Accepted: a delay of 0.5 meets the closed lower end of the window, and the
   open annotated lower end is met by the open lower end of the body. *)
let wait () : nat ! ((0.5, 0.6], Quiet) =
  let s = perform StartTiltRead () in
  delay 1/2;
  unbox s as x in
  x

(* Accepted: an open window (0.25, 1) and a delay strictly inside it. *)
let window () : unit ! ([0.75, 0.75], Quiet) =
  box ((1/4, 1), Quiet) () as u in
  delay 0.75;
  unbox u as y in
  y

(* Accepted: the branches join to the hull of their intervals and levels. *)
let either (b : bool) : unit ! ((0, 1], Noisy) =
  if b then delay 0.25 else perform Transmit 0

run step ()
run wait ()
run window ()
run either false
