(* Run this test with the 'timed-regex-finite-upper-bound' grade algebra, e.g.

     ./tempore --grades timed-regex-finite-upper-bound \
       tests/idle_waits_finite_reject.tpe

   Rejected under the 'timed-regex-finite-upper-bound' grade algebra: an
   idle wait `idle d` admits waiting only; the span form is accepted,
   the idle form rejected. *)

type token = Token of string

operation Heat : unit ~> unit ! {Heat} within [2, 4]
operation Stir : unit ~> unit ! {Stir} within [1, 1]
operation Cool : unit ~> unit ! {Cool} within [1, 3]

(* A stir of one step fits a delay of three beside a wait of two. *)
let stirred_budget () =
  box {Heat; 3; Cool} (Token "h") as h in
  perform Heat ();
  delay 2;
  perform Stir ();
  perform Cool ();
  unbox h as tok in
  tok

let stirred_strict () =
  box {Heat; idle 3; Cool} (Token "h") as h in
  perform Heat ();
  delay 2;
  perform Stir ();
  perform Cool ();
  unbox h as tok in
  tok
