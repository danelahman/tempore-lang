(* Run this test with the default 'time-lower-bound' grading monoid, e.g.

     ./tempore tests/op_case_context_unbox.tpe *)

operation Op : unit ~> nat # 0

(* Correctly accepted by the typechecker: the case is typed under the lock of
   the top grade, which under 'time-lower-bound', whose top is the unit 0,
   restricts nothing; so the box 'b', bound outside the case, may be unboxed
   in it. *)
let h b =
  handler
  | x -> x
  | Op p k ->
      unbox b as v in
      continue k with v
