(* Correctly rejected by the typechecker: 'f' is local, hence monomorphic, and
   its type is 'int -> int', so the second application gives it a string where
   an int is expected. The error points at the argument, at the function whose
   type it disagrees with, and at the place that type was decided. *)

let id x = x

run
  let f = id (fun n -> n + 1) in
  let a = f 1 in
  f "one"
