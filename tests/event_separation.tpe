(* Run this test with the 'event-separation' grading monoid, e.g.

     ./tempore --grades event-separation tests/event_separation.tpe

   Event separation: the times between consecutive occurrences of an
   operation, at most and at least. *)

operation Beat : unit ~> unit # {Beat} within [0.1, 0.5]
default Beat () = delay 0.2

operation Work : unit ~> unit # {Work} within [1, 3]
default Work () = delay 2

operation Beep : unit ~> unit # {Beep} within [0.1, 0.5]
default Beep () = delay 0.1

(* Accepted: a heartbeat at least every 5 time units. The loop starts with a
   beat and each round takes at most 3.5, so the invariant
   '(Beat, [0, 0], [0, 5], [0, 5])', no time before the first beat and gaps
   and tail at most 5, holds of every number of rounds. *)
let rec heartbeat n : unit # (Beat, [0, 0], [0, 5], [0, 5]) =
  match n with
  | 0 -> ()
  | m + 1 ->
      perform Beat ();
      perform Work ();
      heartbeat m

(* Accepted: two beeps at least 2 apart, a rate limit; the delay of 2 after
   each beep separates it from the next. *)
let rec beeps n : unit # (Beep, [2, ∞)) =
  match n with
  | 0 -> ()
  | m + 1 ->
      perform Beep ();
      delay 2;
      beeps m

(* Accepted: a beat at the start and one after the work, at most 3.5 apart,
   in a computation of 1.2 to 4. *)
let pair () : unit # ((Beat, [1, 3.5]), [1.2, 4]) =
  perform Beat ();
  perform Work ();
  perform Beat ()

(* Accepted: a box is unboxed within its interval of durations, nothing
   performed since it was bound. *)
let boxed () =
  box [1, 3] 7 as x in
  delay 2;
  unbox x as n in
  n

run heartbeat 3
run beeps 2
run pair ()
run boxed ()
