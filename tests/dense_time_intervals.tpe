(* Run this test with the 'dense-time-interval' grading monoid, e.g.

     ./tempore --grades dense-time-interval tests/dense_time_intervals.tpe *)

operation Pour : unit ~> unit # (0.5, 3/4)

(* Correctly accepted by the typechecker: a delay of 1/4 and a pour accumulate
   (0.75, 1), which lies inside (0.5, 1.5). *)
let steep () =
  box (0.5, 1.5) "tea" as r in
  delay 1/4;
  perform Pour ();
  unbox r as y in
  y

(* Correctly accepted by the typechecker: the case waits 5/8 before resuming,
   inside the (0.5, 0.75) the operation promises. *)
let h = handler | x -> x | Pour () k -> delay 5/8; continue k with ()

run handle steep () with h
