(* Recursive functions accepted by the structural termination check: every
   recursive call is given a structural part of one fixed parameter. *)

(* On lists. *)
let rec sum xs =
  match xs with
  | [] -> 0
  | x :: xs' -> x + sum xs'

let rec len = function
  | [] -> 0
  | _ :: xs -> len xs + 1

(* On the second parameter. *)
let rec rev_onto acc = function
  | [] -> acc
  | x :: xs -> rev_onto (x :: acc) xs

(* On naturals, with successor patterns. *)
let rec double n =
  match n with
  | 0 -> 0
  | m + 1 -> double m + 2

(* On a user datatype. *)
type tree = Leaf | Node of tree * nat * tree

let rec total t =
  match t with
  | Leaf -> 0
  | Node (l, x, r) -> total l + x + total r

(* On a tuple of parameters, as in `zip`. *)
let rec pairs xs ys =
  match (xs, ys) with
  | (x :: xs', y :: ys') -> (x, y) :: pairs xs' ys'
  | _ -> []

(* On a parameter pattern of a type with a single constructor. *)
type chain = Link of chain option

let rec links (Link next) =
  match next with
  | None -> 1
  | Some c -> links c + 1

(* A partial application passed on with the decreasing argument supplied. *)
let rec interleave xs ys =
  match xs with
  | [] -> ys
  | x :: xs' -> x :: (ys |> interleave xs')

(* Calls inside a function and a handler. *)
let rec thunked xs =
  match xs with
  | [] -> 0
  | x :: xs' -> (fun () -> x + thunked xs') ()

let rec handled n =
  match n with
  | 0 -> 0
  | m + 1 -> handle 1 with (handler | r -> r + handled m)

(* A nested recursive function, itself calling the outer one. *)
let rec flatten xss =
  match xss with
  | [] -> []
  | xs :: xss' ->
    let rec prepend ys =
      match ys with
      | [] -> flatten xss'
      | y :: ys' -> y :: prepend ys'
    in
    prepend xs

(* A variable bound by `as` under a successor pattern. *)
let rec fib n =
  match n with
  | 0 -> 1
  | 1 -> 1
  | ((m + 1) as k) + 1 -> fib k + fib m

run (sum [1; 2; 3], len [1; 2; 3], rev_onto [] [1; 2; 3])

run (double 4, total (Node (Node (Leaf, 1, Leaf), 2, Leaf)))

run (pairs [1; 2; 3] ["a"; "b"], links (Link (Some (Link (Some (Link None))))))

run interleave [1; 3] [2; 4]

run (thunked [1; 2; 3], handled 3)

run (flatten [[1; 2]; []; [3]], fib 10)
