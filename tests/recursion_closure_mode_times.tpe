(* Run this test with the 'mode-times' grade algebra, e.g.

     ./tempore --grades mode-times tests/recursion_closure_mode_times.tpe

   A recursive function each of whose rounds takes an enzyme out of the cold
   block, pipettes it and returns it: the grade accumulated by a call of it is
   the unit joined with the closure of the round, in which the times in the
   cold block, out of it and in total have no upper bound. *)

operation Take : unit ~> unit ! ({Take}, Cold, Out) within [1, 2]
operation Pipette : unit ~> unit ! ({Pipette}, Out, Out) within [3, 5]
operation Return : unit ~> unit ! ({Return}, Out, Cold) within [1, 1]

let rec pipette (n : nat) : unit ! 'e =
  match n with
  | 0 -> ()
  | m + 1 ->
      (perform Take (); perform Pipette (); perform Return (); pipette m)

(* Correctly accepted by the typechecker. From the cold block, the rounds
   return the enzyme to it, spending no time in a third mode; from any other
   mode, the call keeps the mode at no time if it performs no round, and
   otherwise gets stuck at taking the enzyme, at no time. *)
let pipetting () =
  box
    ( (Cold, Cold, (_, 0)),
      (Out, Out, 0),
      (Out, Stuck, 0),
      (_, _, 0),
      (_, Stuck, 0) )
    7
  as x in
  pipette 3;
  unbox x as n in
  n
