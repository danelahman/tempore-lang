(* Run this test with the 'time-upper-bound' grading monoid, e.g.

     ./tempore --grades time-upper-bound tests/continuation_twice_reject_upper.tpe *)

operation Op : unit ~> unit # 1

(* Correctly rejected by the typechecker: the second resumption unboxes k, a
   box of grade 1, after the first has run for the effect ε of k, and ∣ε∣ <= 1
   does not hold for every ε: it fails for ε = ∞. *)
let h = handler | x -> x | Op p k -> let a = continue k with () in continue k with ()

run handle (perform Op (); 3) with h
