(* Run this test with the 'banked-traces-upper-bound' grade algebra, e.g.

     ./tempore --grades banked-traces-upper-bound \
       tests/banked_traces_reject_bounds_declared.tpe

   Correctly rejected by the typechecker, under the 'banked-traces-upper-bound'
   grade algebra: a compound operation's running-time bounds follow from its
   grade and those of the operations it names, so they must not be declared. *)

operation Tx : string ~> unit ! {Tx} within [2, 3]
operation Send : string ~> unit ! {Tx | Tx; Tx} within [2, 6]
