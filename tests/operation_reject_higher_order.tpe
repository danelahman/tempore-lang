(* Correctly rejected by the typechecker: an operation whose result is a
   function lets a handler build a non-terminating program:

     let h = handler
       | x -> x
       | Op u k -> continue k with (fun () -> let g = perform Op () in g ())
     run handle (let g = perform Op () in g ()) with h *)
operation Op : unit ~> (unit -> unit # 0) # 0
