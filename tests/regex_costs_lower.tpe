(* Accepted under the 'regex-cost-lower-bound' grading monoid: regular lower bounds
   covered by runs whose operations bank their lower runtime bounds. *)

type token = Token of string

operation Ping : unit ~> unit # {Ping} within [1, 2]
default Ping () = delay 1
operation Log : unit ~> unit # {Log} within [1, 1]
default Log () = delay 1
operation Fetch : unit ~> unit # {Fetch} within [2, 4]
default Fetch () = delay 3

(* A ping, then three ticks' worth of delays and operations. *)
let ping_then_wait () =
  box {Ping; 3} (Token "t") as t in
  perform Ping ();
  perform Fetch ();
  delay 1;
  unbox t as tok in
  tok

(* A ping after any delay. *)
let eventually_ping () =
  box {1*; Ping} (Token "p") as p in
  delay 2;
  perform Log ();
  perform Ping ();
  unbox p as tok in
  tok

(* Either demand may be met. *)
let either () =
  box {Ping | Log} (Token "e") as e in
  perform Log ();
  unbox e as tok in
  tok

(* A function that takes at least two ticks, by a fetch. *)
let slow () : unit # {2} = perform Fetch ()

run ping_then_wait ()
