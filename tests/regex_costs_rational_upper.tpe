(* Accepted under the 'regex-cost-upper-bound-rational' grading monoid: regular
   upper bounds over rational delays whose delays pay for operations at their
   fractional upper runtime bounds, with intervals of delays and
   complements. *)

type token = Token of string

(* A sample takes between half a time unit and one and a half. *)
operation Sample : unit ~> nat # {Sample} within [1/2, 3/2]
default Sample () = delay 1/2; 3

(* A transmission takes between a quarter of a time unit and one. *)
operation Send : nat ~> unit # {Send} within [1/4, 1]
default Send n = delay 0.25

(* A sample, at its upper bound of 3/2, and a pause of 1/2 fill an allowance
   of two time units exactly. *)
let sample_then_rest () =
  box {2} (Token "t") as t in
  let v = perform Sample () in
  delay 1/2;
  unbox t as tok in
  tok

(* A pause under a time unit before a matched transmission, and one of at most
   a quarter after it. *)
let paced (n : nat) =
  box {[0, 1); Send; [0, 1/4]} (Token "p") as p in
  delay 1/2;
  perform Send n;
  delay 1/4;
  unbox p as tok in
  tok

(* A pause of one time unit, which the complement excludes, is permitted by
   the longer pauses it keeps. *)
let offbeat () =
  box {~1} (Token "o") as o in
  delay 1/2;
  delay 0.5;
  unbox o as tok in
  tok

(* Pauses under a half on either side of a transmission take less than
   1/2 + 1 + 1/2 = 2 time units, however close to a half they come. *)
let short_pause () : unit # {[0, 1/2)} = delay 0.49

let bursts (n : nat) =
  box {2} (Token "b") as b in
  short_pause ();
  perform Send n;
  short_pause ();
  unbox b as tok in
  tok

(* Samples, each followed by a pause of a third. *)
let polling () =
  box {(Sample; 1/3)*} (Token "t") as t in
  let v = perform Sample () in
  delay 1/3;
  let w = perform Sample () in
  delay 1/3;
  unbox t as tok in
  tok

(* The annotated grade pays for a sample, a pause of a quarter and a
   transmission: 3/2 + 1/4 + 1 = 11/4. *)
let report () : unit # {11/4} =
  let v = perform Sample () in
  delay 1/4;
  perform Send v

(* An operation cannot be excluded while unbounded time is allowed: the delays
   of the bound buy the sample. *)
let unexcluded () =
  box {(_ & ~Sample)*} (Token "u") as u in
  let v = perform Sample () in
  unbox u as tok in
  tok

run report ()
