(* Run this test with the 'regex-timed-upper-bound-rational-symbolic' grading monoid, e.g.

     ./tempore --grades regex-timed-upper-bound-rational-symbolic \
       tests/literals_reject_strict_grade.tpe

   Rejected under the 'regex-timed-upper-bound-rational-symbolic' grading
   monoid: strict delays are read by the rigid grades only. *)

operation Read : unit ~> nat # {Read} within [1, 1]

let read () : nat # {Read; !3} =
  let a = perform Read () in
  delay 3;
  a
