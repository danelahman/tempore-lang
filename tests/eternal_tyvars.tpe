(* Run this test with the 'time-upper-bound' grading monoid, e.g.

     ./tempore --grades time-upper-bound tests/eternal_tyvars.tpe

   Zero is the minimal element of that sub-grade order, so using a local
   variable after some grade has accumulated requires its type to be eternal.
   When that type is a type variable, the requirement is not decided at the
   definition but carried into its generalised type as a constraint, to be
   checked at each use. *)

noneternal type token = Token

(* A phantom parameter: a tag holds nothing, whatever it is tagged with. *)
type 'a tag = Tag

(* Correctly accepted by the typechecker: x is used after a tick of waiting,
   so keep gets the qualified scheme ∀ α. Et(α) ⇒ α → α # 1. *)
let keep x = delay 1; x

(* Correctly accepted by the typechecker: x is used after g has run, whose
   effect ε₀ is unknown here, so after gets the scheme ∀ α β ε₀. Et(β) ∨
   ∣ε₀∣ ≾ 0 ⇒ (unit → α # ε₀) → β → β # ε₀ # 0, and either side of the
   disjunction may discharge the constraint at a use. *)
let after g x = g (); x

(* Correctly accepted by the typechecker: two constraints, one per variable. *)
let keep_pair x y = delay 1; (x, y)

(* Correctly accepted by the typechecker: the constraint of keep is owed by
   twice_keep in turn, which passes it on in its own type. *)
let twice_keep x = keep (keep x)

(* Correctly accepted by the typechecker: a local variable of eternal type
   may be captured by an operation case. *)
operation Op : unit ~> unit # 1
let h x = handler | y -> y | Op p k -> let r = continue k with () in x

(* Correctly accepted by the typechecker: nat is eternal. *)
run keep 5

(* Correctly accepted by the typechecker: a tag imposes nothing on its
   parameter, so even a function-tagged one is eternal. *)
run keep (Tag : (unit -> unit) tag)

(* Correctly accepted by the typechecker: the argument 5 is eternal, so the
   grade of g may be anything. *)
run after (fun () -> delay 2) 5

(* Correctly accepted by the typechecker: the argument is not eternal, but g
   accumulates no grade. *)
run after (fun () -> ()) (fun () -> ())

run keep_pair 1 "two"
run twice_keep true
run handle (perform Op (); 5) with h 6

(* Correctly rejected by the typechecker: a function is never eternal,
     Typing error: `unit → unit` is not eternal, but `keep` needs the type of
       `x` to be eternal
       Note: the resource inequality `1 <= 0` does not hold
*)
(*
run keep (fun () -> ())
*)

(* Correctly rejected by the typechecker: neither is a noneternal type,
     Typing error: `token` is not eternal, but `keep` needs the type of `x`
       to be eternal
       Note: the resource inequality `1 <= 0` does not hold
*)
(*
run keep Token
*)

(* Correctly rejected by the typechecker: neither side of the disjunction
   holds,

     Typing error: `unit → unit` is not eternal, but `after` needs the type
       of `x` to be eternal
       Note: the resource inequality `2 <= 0` does not hold
*)
(*
run after (fun () -> delay 2) (fun () -> ())
*)
