(* Run this test with the 'time-upper-bound' grading monoid, e.g.

     ./tempore --grades time-upper-bound tests/recursion_effect_reject_unannotated.tpe *)

(* Correctly rejected by the typechecker: without an annotation, the body of
   a recursive function has the unit effect, but a round takes a step. *)
let rec wait n =
  match n with
  | 0 -> ()
  | m + 1 ->
      delay 1;
      wait m

run wait 2
