(* Run this test with the 'timed-regex-interval-rational' grade algebra, e.g.

     ./tempore --grades timed-regex-interval-rational \
       tests/idle_waits_rational_reject.tpe

   Rejected under the 'timed-regex-interval-rational' grade
   algebra: an idle wait `idle d` admits waiting only. Each span form is
   accepted and the idle form after it rejected; the span restricted to
   the operations other than `Reset` admits readings and waits, and no
   reset. *)

type token = Token of string

operation AddBeads : unit ~> unit ! {AddBeads} within [1, 1]
operation ChangeTip : unit ~> unit ! {ChangeTip} within [1, 1]
operation MagnetOn : unit ~> unit ! {MagnetOn} within [1, 1]
operation Read : unit ~> nat ! {Read} within [0.1, 0.1]
operation Log : unit ~> unit ! {Log} within [0.1, 0.4]
operation Reset : unit ~> unit ! {Reset} within [0.1, 0.1]

(* A tip changed during the binding fits a span of up to ten minutes. *)
let binding_budget () =
  box {AddBeads; [5, 10]; MagnetOn} (Token "b") as b in
  perform AddBeads ();
  delay 7;
  perform ChangeTip ();
  perform MagnetOn ();
  unbox b as tok in
  tok

let binding_strict () =
  box {AddBeads; idle [5, 10]; MagnetOn} (Token "b") as b in
  perform AddBeads ();
  delay 7;
  perform ChangeTip ();
  perform MagnetOn ();
  unbox b as tok in
  tok

(* A log between two readings fits a sampling period with jitter. *)
let sampling_budget () =
  box {([9.5, 10.5]; Read)*} (Token "s") as s in
  delay 10;
  let a = perform Read () in
  perform Log ();
  delay 10;
  let b = perform Read () in
  unbox s as tok in
  tok

let sampling_strict () =
  box {(idle [9.5, 10.5]; Read)*} (Token "s") as s in
  delay 10;
  let a = perform Read () in
  perform Log ();
  delay 10;
  let b = perform Read () in
  unbox s as tok in
  tok

(* Readings and waits only: no reset. *)
let without_reset () =
  box {≥0 & ~Reset} (Token "r") as r in
  let a = perform Read () in
  delay 2;
  let b = perform Read () in
  unbox r as tok in
  tok

let with_reset () =
  box {≥0 & ~Reset} (Token "r") as r in
  let a = perform Read () in
  delay 2;
  perform Reset ();
  unbox r as tok in
  tok
