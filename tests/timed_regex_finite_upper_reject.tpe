(* Run this test with the 'timed-regex-finite-upper-bound' grade algebra, e.g.

     ./tempore --grades timed-regex-finite-upper-bound \
       tests/timed_regex_finite_upper_reject.tpe

   Rejected under the 'timed-regex-finite-upper-bound' grade algebra: every
   operation of a bound is matched, in order; the first definition is
   accepted, the second rejected. *)

type token = Token of string

operation Heat : unit ~> unit ! {Heat} within [2, 4]
operation Cool : unit ~> unit ! {Cool} within [1, 2]
operation Log : unit ~> unit ! {Log} within [1, 1]

(* A log bought within the delay between heating and cooling. *)
let logged () =
  box {Heat; 3; Cool} (Token "l") as l in
  perform Heat ();
  perform Log ();
  delay 2;
  perform Cool ();
  unbox l as tok in
  tok

(* The cooling of the bound is not left out. *)
let uncooled () =
  box {Heat; 3; Cool} (Token "u") as u in
  perform Heat ();
  delay 3;
  unbox u as tok in
  tok
