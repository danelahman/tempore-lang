(* Run this test with the 'banked-traces-upper-bound' grade algebra, e.g.

     ./tempore --grades banked-traces-upper-bound \
       tests/banked_traces_reject_fractional_bound.tpe

   Rejected: running-time bounds are delays, and those of
   banked-traces-upper-bound are whole numbers of ticks; the error names the
   trace grades with banked delays whose delays are rationals. *)

operation Heat : unit ~> unit ! {Heat} within [1/2, 1]
