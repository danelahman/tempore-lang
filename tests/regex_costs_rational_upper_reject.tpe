(* Rejected under the 'regex-cost-upper-bound-rational-symbolic' grading monoid:
   traces that the regular upper bounds over rational delays do not permit at
   the fractional upper running-time bounds. *)

type token = Token of string

operation Sample : unit ~> nat # {Sample} within [1/2, 3/2]
operation Send : nat ~> unit # {Send} within [1/4, 1]

(* A sample and a delay of a third may take 3/2 + 1/3 = 11/6, more than the
   7/4 the bound allows. *)
let too_slow () =
  box {7/4} (Token "t") as t in
  let v = perform Sample () in
  delay 1/3;
  unbox t as tok in
  tok

(* The two time units follow the transmission, and a match resets the budget:
   they cannot pay for a sample before it. *)
let budget_reset () =
  box {Send; 2} (Token "t") as t in
  let v = perform Sample () in
  perform Send v;
  unbox t as tok in
  tok

(* Delays under a half on either side of a transmission come arbitrarily close
   to 1/2 + 1 + 1/2 = 2 time units, more than 1.99. *)
let short_pause () : unit # {[0, 1/2)} = delay 0.49

let bursts (n : nat) =
  box {1.99} (Token "b") as b in
  short_pause ();
  perform Send n;
  short_pause ();
  unbox b as tok in
  tok

(* The complement removes the end of the interval: a delay after the
   transmission stays under one time unit. *)
let late (n : nat) =
  box {Send; ([0, 1] & ~1)} (Token "l") as l in
  perform Send n;
  delay 1;
  unbox l as tok in
  tok

(* The annotated grade does not pay for a second sample: 3/2 + 3/2 = 3 is
   more than 5/2. *)
let two_samples () : nat # {5/2} =
  let v = perform Sample () in
  perform Sample ()
