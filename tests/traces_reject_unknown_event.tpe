(* Run this test with the 'traces-timed-upper-bound' grading monoid, e.g.

     ./tempore --grades traces-timed-upper-bound \
       tests/traces_reject_unknown_event.tpe

   Correctly rejected by the typechecker, under the 'traces-timed-upper-bound'
   grading monoid: the events of a grade must be operations that have already
   been declared. *)

operation Heat : unit ~> unit # {Heat} within [1, 2]
operation PrintModel : unit ~> unit # {Heat; Extrude}
