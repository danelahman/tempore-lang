(* Run this test with the 'time-upper-bound' grade algebra, e.g.

     ./tempore --grades time-upper-bound \
       tests/noneternal_reject_after_delay.tpe *)

noneternal type token = Token

(* Correctly rejected by the typechecker: the token is bound, a tick of waiting
   passes, and only then is it used, but a non-eternal token survives only an
   accumulated grade below the unit, 0. *)
let use_late () =
  let t = Token in
  delay 1;
  t

run use_late ()
