(* A step of a PID controller that reads a sensor, waits and drives an
   actuator, with its gains a top-level constant. *)

operation ReadAngle : unit ~> float ! 1
operation Drive : string * float ~> unit ! 1

type gains = Gains of float * float * float

let gains = Gains (20.0, 0.5, 0.8)

let pid (Gains (kp, ki, kd)) (integral, previous) error =
  let integral = integral +. error in
  (kp *. error +. ki *. integral +. kd *. (error -. previous), (integral, error))

let step state =
  let angle = perform ReadAngle () in
  let (u, state) = pid gains state (0.0 -. angle) in
  delay 2;
  perform Drive ("motor", u);
  state

run pid gains (0.0, 0.0) 0.5
run step (0.0, 0.0)
