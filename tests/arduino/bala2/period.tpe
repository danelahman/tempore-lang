(* A control step that shows the tilt on the display, longer than the period,
   after balance.tpe. *)

let step_shown ((tilt, speed, integral, position, heading) : state) : state
    # [0, 5) =
  let reading = perform ReadImu () in
  box [0, 2] reading as fresh in
  unbox fresh as imu in
  let accel, gyro = imu in
  let raw, _, _ = gyro in
  let tilt =
    complementary gyro_weight period tilt (tilt_x_of_accel accel) raw
  in
  perform ShowNumber tilt;
  perform SetMotors (0i, 0i);
  (tilt, speed, integral, position, heading)
