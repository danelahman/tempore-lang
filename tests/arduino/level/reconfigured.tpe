(* A rejected variant of examples/arduino/level/level.tpe. *)

let step_reconfigured ((reference, age, rate, touching) : state) : state =
  box {Touched; ReadImu} reference as kept in
  let touched, x, y = perform Touched () in
  (if touched && on_sensor x y then (
     perform ConfigureImu 400;
     perform Beep (600, 50))
   else ());
  let accel, _ = perform ReadImu () in
  unbox kept as reference in
  display reference (angles accel reference) (age + 1);
  (reference, age + 1, rate, touched)
