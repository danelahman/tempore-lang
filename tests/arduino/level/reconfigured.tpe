(* A rejected variant of examples/arduino/level/level.tpe. *)

let step_reconfigured ((reference, age, rate, touching) : state) : state =
  box {(ReadImu | ReadTouch)*; (ConfigureImu; CheckAtRest | 0)} reference
    as kept in
  let accel, _ = perform ReadImu () in
  let touched, x, y = perform ReadTouch () in
  let rate =
    if touched && not touching && on_sensor x y then (
      let rate = if rate = 100 then 400 else 100 in
      perform ConfigureImu rate;
      rate)
    else rate
  in
  unbox kept as kept_reference in
  display kept_reference (angles accel kept_reference) age 0;
  (kept_reference, age, rate, touched)
