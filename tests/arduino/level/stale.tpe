(* A rejected variant of examples/arduino/level/level.tpe. *)

let step_stale ((reference, age, rate, touching) : state) : state =
  let touched, _, _ = perform Touched () in
  let accel, _ = perform ReadImu () in
  box 0 accel as reading in
  let reference = if touched then take () else reference in
  unbox reading as accel in
  display reference (angles accel reference) 0;
  (reference, 0, rate, touched)
