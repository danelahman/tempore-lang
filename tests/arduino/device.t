  $ cd _arduino/projects/toy
  $ cat platformio.ini
  ; The PlatformIO project of a device programmed in Tempore, for the board esp32-devkit.
  
  [env:esp32-devkit]
  platform = espressif32@7.1.3
  board = esp32dev
  framework = arduino
  monitor_speed = 115200
  build_flags =
      -std=gnu++17
  build_unflags = -std=gnu++11
  $ cat src/main.cpp
  // The device of the program toy.tpe on the board esp32-devkit, generated by Tempore.
  
  #include <Arduino.h>
  #include <freertos/FreeRTOS.h>
  #include <freertos/task.h>
  #include <Wire.h>
  
  #include "tempore_bindings.h"
  #include "tempore_scaffold.h"
  
  // The configuration.
  const tempore_monitor_policy tempore_monitor = tempore_monitor_policy::abort;
  const uint64_t tempore_unit_numerator_us = 1000ULL;
  const uint64_t tempore_unit_denominator_us = 1ULL;
  
  void tempore_safe_state() { lights_off(); }
  
  // The periodic task step, of period 10000 us.
  static tempore_task_monitor tempore_task0_monitor("step", 10000);
  
  static void tempore_task0(void *) {
    tempore_check_halt();
    auto state = start_0(tempore_unit{});
    TickType_t release = xTaskGetTickCount();
    for (;;) {
      tempore_check_halt();
      tempore_trace("Release %s", "step");
      const int64_t start = tempore_clock_us();
      state = step_2(state);
      tempore_monitor_period(&tempore_task0_monitor, start, tempore_clock_us());
      vTaskDelayUntil(&release, pdMS_TO_TICKS(10));
    }
  }
  
  // The free task blinker.
  static void tempore_task1(void *) {
    tempore_check_halt();
    tempore_trace("Start %s", "blinker");
    blinker_4(tempore_unit{});
    tempore_trace("End %s", "blinker");
    vTaskDelete(nullptr);
  }
  
  tempore_task_monitor *const tempore_task_monitors[] = {
      &tempore_task0_monitor,
      nullptr};
  
  void setup() {
    Serial.begin(115200);
    Wire.begin(21, 22, 400000);
    Wire.setClock(400000);
    xTaskCreatePinnedToCore(tempore_task0, "step", 4096, nullptr, 2, nullptr, 1);
    xTaskCreatePinnedToCore(tempore_task1, "blinker", 4096, nullptr, 1, nullptr, 0);
    tempore_profile_begin();
  }
  
  void loop() { vTaskDelete(nullptr); }
