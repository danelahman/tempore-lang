(* A rejected variant of examples/arduino/starter/starter.tpe. *)

let fire_cleared (gun : at_gun) (m : float) (w : float) : outcome =
  box {Beep; ReadClock} (m, w) as armed in
  perform Beep (2500, 300);
  perform ClearDisplay ();
  let fired = perform ReadClock () in
  unbox armed as (m, w) in
  let found, at = react m w in
  unbox gun as (lane, warnings) in
  if found then Reaction (lane, warnings, elapsed fired at) else NoStart
