(* A rejected variant of examples/arduino/starter/starter.tpe. *)

let set_at_once (a : athlete) : at_set =
  let mark = marks a in
  perform ShowColourTextAt (0, 40, 3, black, white, "ON YOUR MARKS");
  perform ShowColourTextAt (0, 70, 2, black, white, "Settle for 1 s");
  perform DrawButton (0, 188, 156, 40, "Stand up");
  perform DrawButton (164, 188, 156, 40, "");
  unbox mark as set_thunk in
  set_thunk ()
