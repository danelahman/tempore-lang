(* Two sessions that keep the neutral tilt recorded before the first, after
   controller.tpe. *)

let sessions_kept (v : view) =
  let zero = record_neutral () in
  starting ();
  let latest = confirm 40 in
  unbox zero as neutral in
  let v =
    balancing 4000000000 v (box {≥0 & ~SendStop} neutral) latest
  in
  stopping ();
  starting ();
  let latest = confirm 40 in
  unbox zero as kept in
  balancing 4000000000 v (box {≥0 & ~SendStop} kept) latest
