(* A session that keeps the neutral tilt of the last, unboxing its box after
   a Stop, after controller.tpe. *)

let sessions_kept (zero : neutral) (v : view) =
  stopping ();
  starting ();
  let latest = confirm 40 in
  unbox zero as kept in
  balancing 4000000000 v (box {≥0 & ~SendStop} kept) latest
