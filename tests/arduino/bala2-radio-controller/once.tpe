(* A session that sends Start once, after controller.tpe. *)

let rec session_once (n : nat)
    ((link_shown, shown_tilt, bubble_next, guide_shown) : view) : unit
    ! {((ReadTouch; SendBeat; ReceiveMessage;
         (DrawLevel | ShowColourTextAt | 0); idle 21/2)*;
        (ReadTouch | 0);
        Beep; ReadImu; (SendStart; idle 25/2)^80; SendStart; idle 25/2;
        ReceiveMessage;
        (SendStart; idle 25/2; ReceiveMessage)*;
        (ReadImu; ReadTouch; (SendDrive | SendBeat);
         (ShowTextAt | ShowNumberAt | DrawLevel | ShowColourTextAt | 0);
         idle 21/2; ReceiveMessage)*;
        (ReadImu; ReadTouch | 0); Beep; (SendStop; idle 25/2)^20; ShowTextAt)*;
       ((ReadTouch; SendBeat; ReceiveMessage;
         (DrawLevel | ShowColourTextAt | 0); idle 21/2)*;
        (ReadTouch | 0)
       | 0)} =
  match n with
  | 0 -> ()
  | m + 1 ->
      let tapped, shown = idle 4000000000 true guide_shown Blank 0 in
      if tapped then (
        perform Beep (1760, 60);
        let zero = record_neutral () in
        perform SendStart ();
        delay 25/2;
        let latest = confirm 40 in
        unbox zero as neutral in
        let v =
          balancing 4000000000
            (link_shown, shown_tilt, bubble_next, shown)
            (box {≥0 & ~SendStop} neutral)
            latest
        in
        perform Beep (880, 60);
        stopping ();
        perform ShowTextAt (0, 30, 2, "Stopped");
        session_once m v)
      else ()
