(* A balancing iteration that redraws the bubble of the last iteration after
   the readings, and then drives on the reading of the unit, after
   controller.tpe. *)

let balancing_redrawn (zero : neutral) (latest : latest_status)
    (shown : float * float) =
  let latest_reading = read_imu_boxed () in
  let _ = perform ReadTouch () in
  let shown_pitch, shown_roll = shown in
  draw_bubble shown_pitch shown_roll green;
  unbox latest_reading as reading in
  unbox zero as at_rest in
  unbox latest as status in
  let accel, _ = reading in
  let rest_pitch, rest_roll = at_rest in
  let pitch = tilt_x_of_accel accel -. rest_pitch in
  let roll = tilt_y_of_accel accel -. rest_roll in
  let speed = command speed_gain speed_limit pitch in
  let turn = command turn_gain turn_limit roll in
  if remote_balancing status then perform SendDrive (speed, turn)
  else perform SendBeat ()
