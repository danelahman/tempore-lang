(* A rejected variant of examples/arduino/steps/steps.tpe. *)

let step_eager c =
  let c, added = advance c in
  if added = 0 then poll (pause c) else poll (count c added)

let rec listen_eager (n : nat) (c : counter) : counter
    # ((ReadImu, [0, 0], [0, 50], [0, 50]), (CountStep, [250, ∞))) =
  match n with
  | 0 -> c
  | m + 1 ->
      let c = step_eager c in
      let k = tapped c in
      if k = Calibration then c
      else if k = Reset then
        let c = respond c k in
        listen_eager m c
      else listen_eager m c
