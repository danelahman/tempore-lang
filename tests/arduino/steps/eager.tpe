(* A rejected variant of examples/arduino/steps/steps.tpe. *)

let step_eager c =
  let c, added = advance c in
  if added = 0 then poll (pause c) else poll (count c added)

let rec listen_eager (n : nat) (c : counter)
    : unit # ((ReadImu, [0, 0], [0, 50], [0, 50]), (CountStep, [250, ∞))) =
  match n with
  | 0 -> ()
  | m + 1 ->
      let c = step_eager c in
      let _, _, _, _, _, (_, began, x, y), _, _ = c in
      if began then
        let c = respond c x y in
        listen_eager m c
      else listen_eager m c
