(* A measurement that checks the robot at rest before it disarms it, and
   samples the readings after the Disarm, after robot.tpe. *)

let measure_unsettled () =
  let rest = perform CheckAtRest () in
  box {(Reading; !10)*} rest as checked in
  perform Disarm ();
  let samples = sample () in
  unbox checked as at_rest in
  if at_rest && still samples then bias_of samples else 0.0
