(* A session that reads the tilt once, after the hold, and starts the
   balancing on it after the wait for Start, after robot.tpe. *)

let session_stale_tilt () =
  let calibrated = calibrate () in
  hold ();
  let tilt, _ = perform LatestTilt () in
  if wait_start () then (
    unbox calibrated as open_starting in
    let starting = open_starting () in
    unbox starting as calibration in
    if magnitude (tilt -. balance_point) <= upright_limit then (
      perform StartBalancing calibration;
      drive 4000000000 0)
    else ())
  else ()
