(* An iteration of the drive that polls again for a Disarm before it applies
   the message received first, after robot.tpe. *)

let drive_polled () =
  let latest = remote_receive () in
  let newer = remote_receive () in
  unbox newer as polled in
  let n, _ = polled in
  (match n with Got Disarm -> perform Disarm () | _ -> ());
  unbox latest as received in
  let r, setpoints = received in
  match r with
  | Got (Drive _) ->
      (match setpoints with Setpoints (speed, turn) -> perform Command (speed, turn))
  | _ -> perform Command (0.0, 0.0)
