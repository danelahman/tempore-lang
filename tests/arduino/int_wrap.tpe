(* Arithmetic on integers of 32 bits modulo 2^32, the quotient of -2^31 by -1
   included, and the conversions of large natural numbers and floats. *)

let wrap x y = (x +! y, x -! (~-!y), x *! y, ~-!x, x /! -1i, x mod! -1i)

let convert x = int_of_float x

run wrap 2147483647i 1i
run wrap (-2147483648i) 2i
run (int_of_nat 4294967295, int_of_nat 2147483648)
run (convert 2147483648.0, convert (~-. 2147483904.0), convert 1e10)
