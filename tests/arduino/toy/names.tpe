(* Operations whose names are spelt alike in C++: a prime and the letter p
   after an underscore, two underscores and one, and a name ending in
   _monitor. Time is in milliseconds, under the grades time-interval-rational. *)

operation Show' : nat ~> unit ! [0, 1]
operation Show_p : nat ~> unit ! [0, 1]
operation A__b : nat ~> unit ! [0, 1]
operation A_b : nat ~> unit ! [0, 1]
operation Count : nat ~> unit ! [0, 1]
operation Count_monitor : nat ~> unit ! [0, 1]

let start () = 0

let step (n : nat) : nat ! [0, 10) =
  perform Show' n;
  perform Show_p n;
  perform A__b n;
  perform A_b n;
  perform Count n;
  perform Count_monitor n;
  n + 1
