(* Functions that cannot be the functions of the tasks of toy.device.json: a
   step whose effect is not below the period of 10 ms, a curried function and
   a function of a pair. *)

operation Show : nat ~> unit # [0.1, 0.2]

let slow n =
  delay 12;
  n + 1

let add m n = m + n

let swap (m, n) = (n, m)

let zero () = 0
