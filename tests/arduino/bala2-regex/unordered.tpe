(* A control step that reads the encoders before the unit, after
   balance_regex.tpe. *)

let step_unordered ((tilt, speed, integral, position) : state) : state
    # {ReadImu; ReadEncoders; Setpoints; Publish; SetMotors} =
  let left, right = perform ReadEncoders () in
  let accel, gyro = perform ReadImu () in
  let armed, bias, target, turn = perform Setpoints () in
  let raw, _, _ = gyro in
  let tilt =
    complementary gyro_weight period tilt (tilt_x_of_accel accel) (raw -. bias)
  in
  perform Publish (tilt, raw);
  perform SetMotors (0.0, 0.0);
  (tilt, speed, integral, (left +. right) /. 2.0)
