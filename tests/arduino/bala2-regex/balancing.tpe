(* A measurement of the bias of the gyroscope that does not stop the
   balancing first, after balance_regex.tpe. *)

let measure_bias_balancing () : float
    # {StopBalancing; ClearDisplay; ShowTextAt; ShowTextAt; ShowText;
       (LatestTilt; 10)*} =
  perform ClearDisplay ();
  perform ShowTextAt (0, 0, 2, "Balancing robot with regexes");
  perform ShowTextAt (188, 230, 1, "Typechecked by Tempore");
  perform ShowText "Calibrating";
  let sum = rate_sum 50 0.0 in
  sum /. 50.0
