(* A control step that uses the reading of the unit after two reads of the
   encoders 1.5 ms apart, after balance_regex.tpe. *)

let step_stale ((tilt, speed, integral, position) : state) : state =
  let reading = perform ReadImu () in
  box {ReadEncoders; Setpoints} reading as fresh in
  let left1, right1 = perform ReadEncoders () in
  delay 1.5;
  let left2, right2 = perform ReadEncoders () in
  let left = (left1 +. left2) /. 2.0 in
  let right = (right1 +. right2) /. 2.0 in
  let armed, bias, target, turn = perform Setpoints () in
  unbox fresh as imu in
  let accel, gyro = imu in
  let raw, _, _ = gyro in
  let tilt =
    complementary gyro_weight period tilt (tilt_x_of_accel accel) (raw -. bias)
  in
  perform Publish (tilt, raw);
  perform SetMotors (0.0, 0.0);
  (tilt, speed, integral, (left +. right) /. 2.0)
