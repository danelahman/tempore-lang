(* A sum of the rates that shows the readings left on the display, after
   balance_regex.tpe. *)

let rec rate_sum_shown (n : nat) (sum : float) : float # {(LatestTilt; 10)*} =
  match n with
  | 0 -> sum
  | m + 1 ->
      let _, rate = perform LatestTilt () in
      perform ShowNumber (float_of_nat m);
      delay 10;
      rate_sum_shown m (sum +. rate)
