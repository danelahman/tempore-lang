(* Two sessions that keep the neutral tilt recorded before the first, after
   controller.tpe. *)

let sessions_kept (v : view) =
  let zero = record_neutral () in
  arming ();
  let latest, fresh = confirm 40 in
  unbox zero as neutral in
  let v =
    armed 4000000000 v (box {(!_ & ~SendDisarm)*} neutral) latest fresh
  in
  disarming ();
  arming ();
  let latest, fresh = confirm 40 in
  unbox zero as kept in
  armed 4000000000 v (box {(!_ & ~SendDisarm)*} kept) latest fresh
