(* Two sessions that keep the neutral tilt recorded before the first, after
   controller.tpe. *)

let sessions_kept (v : view) =
  let zero = record_neutral () in
  arming ();
  unbox zero as neutral in
  let v = armed 4000000000 v (box {(!_ & ~SendDisarm)*} neutral) in
  disarming ();
  arming ();
  unbox zero as kept in
  armed 4000000000 v (box {(!_ & ~SendDisarm)*} kept)
