(* A drive that reads the unit twice and averages the pitch of the two
   readings, after controller.tpe. *)

let drive_averaged () =
  let accel, _ = perform ReadImu () in
  box {(!_ & ~ReadImu)*} accel as latest in
  box [0, 2] accel as recent in
  let again, _ = perform ReadImu () in
  unbox latest as pitched in
  unbox recent as rolled in
  let pitch = (tilt_x_of_accel pitched +. tilt_x_of_accel again) /. 2.0 in
  let speed = command speed_gain speed_limit pitch in
  let turn = command turn_gain turn_limit (tilt_y_of_accel rolled) in
  perform SendDrive (speed, turn)
