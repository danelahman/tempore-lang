(* A session that waits for Arm without a bound and then arms the robot with
   its calibration, after balance_remote.tpe. *)

let rec wait_arm_unbounded (n : nat) : bool
    # {(Receive; Report; !400)*; (Receive | 0)} =
  match n with
  | 0 -> false
  | m + 1 -> (
      let latest, _ = remote_receive () in
      unbox latest as r in
      match r with
      | Got Arm -> true
      | _ ->
          perform Report false;
          delay 400;
          wait_arm_unbounded m)

let session_waited () =
  let aged, still = calibrate () in
  perform ShowTextAt (0, 100, 2, "Hold upright");
  delay 1000;
  if wait_arm_unbounded 4000000000 then (
    unbox aged as calibration in
    unbox still as _ in
    perform Arm calibration;
    drive 4000000000 0)
  else ()
