(* A session that unboxes the calibration right after the hold, when its age
   is checked, and arms the robot with it after the wait for Arm, after
   balance_remote.tpe. *)

let session_early () =
  let calibrated = calibrate () in
  perform ShowTextAt (0, 100, 2, "Hold upright");
  delay 1000;
  unbox calibrated as calibration in
  if wait_arm () then (
    perform Arm calibration;
    drive 4000000000 0)
  else ()
