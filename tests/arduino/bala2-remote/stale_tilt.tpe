(* A session that reads the tilt once, after the hold, and arms the robot on
   it after the wait for Arm, after balance_remote.tpe. *)

let session_stale_tilt () =
  let calibrated = calibrate () in
  perform ShowTextAt (0, 100, 2, "Hold upright");
  delay 1000;
  let tilt, _ = perform Attitude () in
  perform ShowTextAt (0, 100, 2, "Waiting for Arm");
  if wait_arm () then (
    unbox calibrated as open_arming in
    let arming = open_arming () in
    unbox arming as calibration in
    if magnitude (tilt -. balance_point) <= upright_limit then (
      perform Arm calibration;
      drive 4000000000 0)
    else ())
  else ()
