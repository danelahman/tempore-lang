(* An iteration of the drive that redraws the whole screen between receiving
   a message and applying it, after balance_remote.tpe. *)

let drive_step_redrawn (silent : nat) : bool * nat =
  let fresh = remote_receive () in
  perform ClearDisplay ();
  perform ShowTextAt (0, 0, 2, "Remote robot");
  perform ShowTextAt (80, 230, 1, "Typechecked by Tempore (tempore-lang.ee)");
  perform ShowTextAt (0, 100, 2, "Armed");
  perform ShowText "Link up";
  unbox fresh as r in
  match r with
  | Got (Drive (speed, turn)) ->
      perform Command (speed, turn);
      (false, 0)
  | Got Disarm ->
      perform Disarm ();
      (true, 0)
  | _ ->
      perform Command (0.0, 0.0);
      (false, silent)
