(* Run this test with the 'inter-arrival' grade algebra, e.g.

     ./tempore --grades inter-arrival \
       tests/literals_reject_inter_arrival.tpe

   Rejected: a specification of inter-arrival bounds lists one interval, the
   gaps, or three, the lead time, the gaps and the tail. *)

operation Beat : unit ~> unit ! {Beat} within [0.1, 0.5]

let beat () : unit ! (Beat, [0, 1], [0, 5]) = perform Beat ()
