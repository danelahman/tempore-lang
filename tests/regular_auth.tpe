(* Accepted under the regular trace grading monoids: resources guarded by the
   traces that may occur before they are used. *)

type token = Token of string

operation Auth : unit ~> unit # {Auth}
operation Fetch : unit ~> unit # {Fetch}
operation Revoke : unit ~> unit # {Revoke}

(* A token usable only once the session has authenticated. *)
let after_auth () =
  box {_*; Auth; _*} (Token "t") as t in
  perform Fetch ();
  perform Auth ();
  delay 1;
  unbox t as tok in
  tok

(* A capability usable only as long as it has not been revoked. *)
let before_revoke () =
  box {~(_*; Revoke; _*)} (Token "c") as c in
  perform Auth ();
  perform Fetch ();
  unbox c as cap in
  perform Revoke ();
  cap

(* The top grade permits every trace. *)
let anytime () =
  box ⊤ (Token "a") as a in
  perform Revoke ();
  delay 5;
  unbox a as tok in
  tok

(* A grade that permits only the traces beginning with three ticks. *)
let embargo () =
  box {3; _*} 42 as x in
  delay 3;
  perform Fetch ();
  unbox x as n in
  n

run box {3; _*} 42 as x in delay 4; unbox x as n in n
