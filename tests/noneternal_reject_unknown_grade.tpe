(* Run this test with the 'time-upper-bound' grading monoid, e.g.

     ./tempore --grades time-upper-bound tests/noneternal_reject_unknown_grade.tpe

   Both rejections below are the same disjunction 'Et(τ) ∨ ρ ≾ 0' with the
   type known not to be eternal: the grade accumulated is the unknown
   effect of a function argument followed by a delay, which is below 0 for no
   effect of the argument. The diagnostic shows the least instance, where the
   argument takes no time and 1 <= 0 does not hold; without the delay the
   disjunction would become the qualifier ∣ε₀∣ ≾ 0 of the definition. *)

noneternal type token = Token

(* Correctly rejected by the typechecker: the token is used after g has run and
   a tick has passed, which amounts to at least one tick whatever the effect of
   g. The constraint is reported where it arises. *)
let keep g =
  let t = Token in
  let r = g () in
  delay 1;
  t

(* Correctly accepted by the typechecker: the same body, but the value kept is
   the polymorphic argument x, so the disjunction reduces to Et(β) for its type
   β and is carried in the scheme of 'hold' instead, owed again at each use. *)
let hold g x =
  let y = x in
  let r = g () in
  delay 1;
  y

(* Correctly rejected by the typechecker: the use owes that constraint with x
   taken to be a token, and now the eternality side is settled --- against it. *)
let hold_token g = hold g Token
