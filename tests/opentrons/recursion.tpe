(* Top-level and local recursion, curried and higher-order functions. *)

let rec factorial n =
  match n with
  | 0 -> 1
  | m + 1 -> n * factorial m

let fib n =
  let rec pair n =
    match n with
    | 0 -> (0, 1)
    | m + 1 -> let (a, b) = pair m in (b, a + b)
  in
  fst (pair n)

let power b =
  let rec go e =
    match e with
    | 0 -> 1
    | k + 1 -> b * go k
  in
  go

let add3 x y z = x + y + z

let apply_twice f x = f (f x)

run factorial 20
run fib 15
run power 2 64
run (let partial = add3 1 2 in partial 10)
run apply_twice (add3 1 1) 0
run (let rec evens n = match n with 0 -> [] | k + 1 -> if even n then n :: evens k else evens k in evens 10)
run map (fun f -> f 3) [factorial; fib; power 3]
