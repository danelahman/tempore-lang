(* An else-if chain of 120 tests of a boolean variable: 120 matches, each
   nested in the last case of the one before it, deeper than the levels of
   indentation CPython accepts. *)

let choose b =
  if b then 0
  else if b then 1
  else if b then 2
  else if b then 3
  else if b then 4
  else if b then 5
  else if b then 6
  else if b then 7
  else if b then 8
  else if b then 9
  else if b then 10
  else if b then 11
  else if b then 12
  else if b then 13
  else if b then 14
  else if b then 15
  else if b then 16
  else if b then 17
  else if b then 18
  else if b then 19
  else if b then 20
  else if b then 21
  else if b then 22
  else if b then 23
  else if b then 24
  else if b then 25
  else if b then 26
  else if b then 27
  else if b then 28
  else if b then 29
  else if b then 30
  else if b then 31
  else if b then 32
  else if b then 33
  else if b then 34
  else if b then 35
  else if b then 36
  else if b then 37
  else if b then 38
  else if b then 39
  else if b then 40
  else if b then 41
  else if b then 42
  else if b then 43
  else if b then 44
  else if b then 45
  else if b then 46
  else if b then 47
  else if b then 48
  else if b then 49
  else if b then 50
  else if b then 51
  else if b then 52
  else if b then 53
  else if b then 54
  else if b then 55
  else if b then 56
  else if b then 57
  else if b then 58
  else if b then 59
  else if b then 60
  else if b then 61
  else if b then 62
  else if b then 63
  else if b then 64
  else if b then 65
  else if b then 66
  else if b then 67
  else if b then 68
  else if b then 69
  else if b then 70
  else if b then 71
  else if b then 72
  else if b then 73
  else if b then 74
  else if b then 75
  else if b then 76
  else if b then 77
  else if b then 78
  else if b then 79
  else if b then 80
  else if b then 81
  else if b then 82
  else if b then 83
  else if b then 84
  else if b then 85
  else if b then 86
  else if b then 87
  else if b then 88
  else if b then 89
  else if b then 90
  else if b then 91
  else if b then 92
  else if b then 93
  else if b then 94
  else if b then 95
  else if b then 96
  else if b then 97
  else if b then 98
  else if b then 99
  else if b then 100
  else if b then 101
  else if b then 102
  else if b then 103
  else if b then 104
  else if b then 105
  else if b then 106
  else if b then 107
  else if b then 108
  else if b then 109
  else if b then 110
  else if b then 111
  else if b then 112
  else if b then 113
  else if b then 114
  else if b then 115
  else if b then 116
  else if b then 117
  else if b then 118
  else if b then 119
  else 120

run choose false

run choose true
