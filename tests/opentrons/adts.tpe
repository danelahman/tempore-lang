(* Algebraic data types, nested patterns, as-patterns and n+k patterns. *)

type shape =
  | Circle of float
  | Rectangle of float * float
  | Group of shape list

type 'a tree = Leaf | Node of 'a tree * 'a * 'a tree

let rec insert x t =
  match t with
  | Leaf -> Node (Leaf, x, Leaf)
  | Node (l, y, r) ->
      if x < y then Node (insert x l, y, r)
      else if x > y then Node (l, y, insert x r)
      else t

let rec elements t =
  match t with
  | Leaf -> []
  | Node (l, x, r) -> elements l @ (x :: elements r)

let rec depth t =
  match t with
  | Leaf -> 0
  | Node (l, _, r) -> 1 + max (depth l) (depth r)

let area s =
  match s with
  | Circle r -> 3.0 *. r *. r
  | Rectangle (w, h) -> w *. h
  | Group _ -> 0.0

let describe n =
  match n with
  | 0 -> ("zero", 0)
  | 1 -> ("one", 0)
  | k + 2 -> ("two more than", k)

let classify p =
  match p with
  | (0, _) -> ("first zero", [])
  | (_, Some (x :: (y :: _ as rest))) -> ("two or more", x :: y :: rest)
  | (_, Some [x]) -> ("one", [x])
  | (_, Some []) -> ("empty", [])
  | (n + 1, None) -> ("none after", [n])

run elements (fold_left (fun t x -> insert x t) Leaf [5; 3; 8; 1; 4; 7; 9; 3])
run depth (fold_left (fun t x -> insert x t) Leaf [5; 3; 8; 1; 4; 7; 9; 3])
run map area [Circle 1.0; Rectangle (2.0, 3.5); Group []]
run Group [Circle 1.0; Rectangle (2.0, 3.0)]
run map describe [0; 1; 2; 10]
run map classify [(0, None); (1, Some [1; 2; 3]); (2, Some [4]); (3, Some []); (4, None)]
run (match insert 2 Leaf with Node (_, x, _) as t -> (x, t) | Leaf -> (0, Leaf))
run Circle 1.0 < Rectangle (0.0, 0.0)
run (Group [] = Group [], Some 1 < Some 2, None < Some 0)
