(* Run this test with the 'traces-timed-upper-bound' grading monoid, e.g.

     ./tempore --grades traces-timed-upper-bound \
       tests/traces_reject_bounds_declared.tpe

   Correctly rejected by the typechecker, under the 'traces-timed-upper-bound'
   grading monoid: a compound operation's running-time bounds follow from its
   grade and those of the operations it names, so they must not be declared. *)

operation Tx : string ~> unit ! {Tx} within [2, 3]
operation Send : string ~> unit ! {Tx | Tx; Tx} within [2, 6]
