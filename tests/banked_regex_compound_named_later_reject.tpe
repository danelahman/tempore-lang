(* Run this test with the 'banked-regex-interval-symbolic' grade algebra, e.g.

     ./tempore --grades banked-regex-interval-symbolic \
       tests/banked_regex_compound_named_later_reject.tpe

   Rejected: the grade of the compound operation Two names Later, which is
   declared after it. *)

operation Fetch : unit ~> unit ! {Fetch} within [2, 4]
operation Two : unit ~> unit ! {Fetch; Later}
operation Later : unit ~> unit ! {Later} within [1, 2]
