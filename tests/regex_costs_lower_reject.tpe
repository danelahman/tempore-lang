(* Rejected under the 'traces-regex-lower' grading monoid: runs that do not
   cover the regular lower bounds at the lower runtime bounds. *)

type token = Token of string

operation Ping : unit ~> unit # {Ping} within (1, 2)
operation Log : unit ~> unit # {Log} within (1, 1)
operation Fetch : unit ~> unit # {Fetch} within (2, 4)

(* Two ticks after the ping are short of the three demanded. *)
let too_early () =
  box {Ping; 3} (Token "t") as t in
  perform Ping ();
  delay 2;
  unbox t as tok in
  tok

(* Waiting never performs a demanded operation. *)
let waiting () =
  box {Fetch} (Token "f") as f in
  delay 10;
  unbox f as tok in
  tok

(* A ping may take a single tick, short of the three demanded. *)
let too_quick (b : bool) =
  box {3} (Token "q") as q in
  if b then perform Fetch (); delay 1 else perform Ping ();
  unbox q as tok in
  tok
