(* The conversions between natural numbers and floats, the square root and
   the arctangents. *)

let rec power (n : nat) = match n with 0 -> 1 | m + 1 -> 10 * power m

run (float_of_nat 0, float_of_nat 3, float_of_nat (power 20))
run nat_of_float (float_of_nat 9007199254740993)
run (float_of_nat (power 308), float_of_nat (power 309))
run (nat_of_float 2.75, nat_of_float 3.0, nat_of_float 0.5, nat_of_float 1e20)
run (nat_of_float (~-. 2.75), nat_of_float (~-. 0.0), nat_of_float (0.0 /. 0.0))
run nat_of_float (~-. 1.0 /. 0.0)
run nat_of_float (float_of_nat 4294967295)
run (sqrt 4.0, sqrt 2.0, sqrt 0.0, sqrt (~-. 0.0), sqrt (~-. 1.0))
run (sqrt (1.0 /. 0.0), sqrt (0.0 /. 0.0))
run (atan 1.0, atan (~-. 1.0), atan (1.0 /. 0.0), atan (0.0 /. 0.0))
run (atan2 (1.0, 1.0), atan2 (1.0, ~-. 1.0), atan2 (~-. 1.0, ~-. 1.0))
run (atan2 (0.0, 0.0), atan2 (0.0, ~-. 0.0), atan2 (~-. 0.0, ~-. 1.0))
run (atan2 (1.0, 0.0), atan2 (1.0 /. 0.0, 1.0 /. 0.0), atan2 (0.0 /. 0.0, 1.0))
