(* Run this test with the 'banked-regex-upper-bound-symbolic' grade algebra, e.g.

     ./tempore --grades banked-regex-upper-bound-symbolic \
       tests/banked_regex_upper_open_reject.tpe

   Correctly rejected by the typechecker, under the
   'banked-regex-upper-bound-symbolic' grade algebra: 'Tx' within (1, 4) takes
   up to three ticks, more than the two the box allows, and a default of three
   ticks exceeds [1, 3). *)

operation Tx : unit ~> unit ! {Tx} within (1, 4)
operation Beep : unit ~> unit ! {Beep} within [1, 3)

let telemetry () =
  box {2} 1 as slot in
  perform Tx ();
  unbox slot as r in
  r

default Beep () = delay 3
