(* Accepted under the 'regex-cost-lower-bound-rational-symbolic' grading monoid:
   regular lower bounds over rational delays, covered by traces whose operations
   bank their fractional lower running-time bounds. *)

type token = Token of string

operation Sample : unit ~> nat # {Sample} within [1/2, 3/2]
default Sample () = delay 1/2; 3
operation Send : nat ~> unit # {Send} within [1/4, 1]
default Send n = delay 0.25

(* A sample, then at least half a time unit of delays and operations: a
   transmission banks a quarter and a delay adds another. *)
let sample_then_wait () =
  box {Sample; [1/2, ∞)} (Token "t") as t in
  let v = perform Sample () in
  perform Send v;
  delay 1/4;
  unbox t as tok in
  tok

(* A transmission after any delay. *)
let eventually_send (n : nat) =
  box {[0, ∞); Send} (Token "s") as s in
  delay 1/3;
  perform Send n;
  unbox s as tok in
  tok

(* Delays of more than a quarter cover a guarantee of a quarter. *)
let long_pause () : unit # {(1/4, ∞)} = delay 1/3

let paused () =
  box {1/4} (Token "p") as p in
  long_pause ();
  unbox p as tok in
  tok

(* The delays from a half to one time unit, written with a complement, are
   covered by a delay of a quarter and a transmission. *)
let covered (n : nat) =
  box {~[0, 1/2) & [0, 1]} (Token "c") as c in
  delay 1/4;
  perform Send n;
  unbox c as tok in
  tok

(* A function that takes at least 3/4: a sample and a transmission at their
   lower bounds. *)
let slow () : unit # {3/4} =
  let v = perform Sample () in
  perform Send v

run slow ()
