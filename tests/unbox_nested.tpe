(* Run this test with the 'time-interval-rational' grading monoid, e.g.

     ./tempore --grades time-interval-rational tests/unbox_nested.tpe *)

operation Fetch : unit ~> [[2, 5]][[1, 3]]nat ! [0, 1]

(* Correctly accepted by the typechecker: the outer box is unboxed 2 after its
   binding, inside [2, 5], and the inner one 3/2 after the outer unboxing,
   inside [1, 3]. *)
let timely_parameter (x : [[2, 5]][[1, 3]]nat) =
  delay 2;
  unbox x as y in
  delay 3/2;
  unbox y as v in
  v

(* Correctly accepted by the typechecker: as above, for a doubly boxed result
   of an operation. *)
let timely_operation () =
  let x = perform Fetch () in
  delay 2;
  unbox x as y in
  delay 3/2;
  unbox y as v in
  v
