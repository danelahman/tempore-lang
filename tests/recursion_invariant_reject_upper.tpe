(* Run this test with the 'time-upper-bound' grading monoid, e.g.

     ./tempore --grades time-upper-bound \
       tests/recursion_invariant_reject_upper.tpe

   A recursive function whose recursive case calls it twice: its annotated
   grade ε satisfies ε · ε ≾ ε, and its base case takes a tick, so ε is the
   closure of a tick, ∞. *)

let rec w (n : nat) : unit # 'e =
  match n with 0 -> delay 1 | m + 1 -> (w m; w m)

(* Correctly rejected by the typechecker: the grade ∞ of w exceeds 1; w 2
   takes 4 ticks. *)
let g () : unit # 1 = w 2
