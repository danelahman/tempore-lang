(* Rejected under the 'regex-cost-interval-rational-symbolic' grading monoid: each
   component is checked at its own end of the fractional running-time bounds. *)

type token = Token of string

operation Sample : unit ~> nat # {Sample} within [1/2, 3/2]
operation Send : nat ~> unit # {Send} within [1/4, 1]

(* A sample may take only a half, short of the lower bound of 3/4. *)
let too_quick () =
  box [3/4, 2] (Token "t") as t in
  let v = perform Sample () in
  unbox t as tok in
  tok

(* A delay of a half and a sample may take two time units, past an upper bound
   of delays under one. *)
let too_slow () =
  box [{1/2}, {[0, 1)}] (Token "t") as t in
  delay 1/2;
  let v = perform Sample () in
  unbox t as tok in
  tok
