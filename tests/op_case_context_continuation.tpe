(* Run this test with the default 'time-lower-bound' grading monoid, e.g.

     ./tempore tests/op_case_context_continuation.tpe *)

operation Op1 : unit ~> unit # 0
operation Op2 : unit ~> unit # 0

(* Correctly accepted by the typechecker: the inner case is typed under the
   lock of the top grade, which under 'time-lower-bound', whose top is the
   unit 0, restricts nothing; so the outer continuation 'k', bound outside the
   inner case, may be resumed in it. *)
let h =
  handler
  | x -> x
  | Op1 p k ->
      handle
        perform Op2 ();
        continue k with ()
      with
        (handler
         | y -> y
         | Op2 q k' ->
             let a = continue k' with () in
             continue k with ())

run handle (perform Op1 (); 7) with h
