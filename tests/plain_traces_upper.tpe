(* Correctly accepted by the typechecker, under the 'traces-upper-bound'
   grading monoid, whose order is the inclusion of sets of traces: the
   operations declare no running-time bounds, the traces of the branches of a
   conditional are joined, and adjacent delays are merged. *)

operation Read : unit ~> nat # {Read}
operation Send : nat ~> unit # {Send}

(* A reading sent at once or after two delays of one tick, which make the
   trace listed with a delay of two. *)
let relay (urgent : bool) : unit # {Read; Send | Read; 2; Send} =
  let x = perform Read () in
  if urgent then perform Send x else (delay 1; delay 1; perform Send x)

(* A box whose grade lists more traces than are exhibited before it is
   unboxed. *)
let report () =
  box {Read; Send | Read; 2; Send | Send} () as due in
  relay false;
  unbox due as u in
  u

(* The greatest grade permits any trace. *)
let anything () =
  box top () as due in
  relay true;
  delay 3;
  unbox due as u in
  u
