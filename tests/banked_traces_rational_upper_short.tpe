(* Run this test with the 'banked-traces-upper-bound-rational' grade algebra, e.g.

     ./tempore --grades banked-traces-upper-bound-rational \
       tests/banked_traces_rational_upper_short.tpe

   Correctly accepted by the typechecker, under the
   'banked-traces-upper-bound-rational' grade algebra: an operation may take less
   than one time unit, its upper running-time bound being positive. *)

(* A tap takes between a quarter and a half of a time unit. *)
operation Tap : unit ~> unit ! {Tap} within [1/4, 1/2]
default Tap () = delay 1/4

(* Two taps fit in one time unit, each at its upper bound of 1/2. *)
let two_taps () : unit ! {1} =
  perform Tap ();
  perform Tap ()

run two_taps ()
