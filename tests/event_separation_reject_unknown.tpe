(* Run this test with the 'event-separation' grading monoid, e.g.

     ./tempore --grades event-separation \
       tests/event_separation_reject_unknown.tpe

   Rejected: a specification names an operation that is not declared. *)

operation Beat : unit ~> unit ! {Beat} within [0.1, 0.5]
default Beat () = delay 0.2

let beat () : unit ! (Bleat, [0, 5]) = perform Beat ()
