(* Run this test with the 'time-interval-rational' grading monoid, e.g.

     ./tempore --grades time-interval-rational \
       tests/unbox_nested_reject_upper.tpe *)

operation Fetch : unit ~> [[2, 5]][[1, 3]]nat ! [0, 1]

(* Correctly rejected by the typechecker: the inner box is unboxed 4 after the
   outer unboxing that binds it, beyond the upper bound of [1, 3]. *)
let late_parameter (x : [[2, 5]][[1, 3]]nat) =
  delay 2;
  unbox x as y in
  delay 4;
  unbox y as v in
  v

(* Correctly rejected by the typechecker: as above, for a doubly boxed result
   of an operation. *)
let late_operation () =
  let x = perform Fetch () in
  delay 2;
  unbox x as y in
  delay 4;
  unbox y as v in
  v
