{
  "name": "vscode-tempore",
  "displayName": "Tempore Language",
  "description": "Syntax highlighting for Tempore (.tpe) source files.",
  "version": "0.1.0",
  "publisher": "tempore",
  "engines": {
    "vscode": "^1.60.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/danelahman/tempore-lang"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tempore",
        "aliases": [
          "Tempore",
          "tempore"
        ],
        "extensions": [
          ".tpe"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tempore",
        "scopeName": "source.tempore",
        "path": "./syntaxes/tempore.tmLanguage.json"
      }
    ]
  }
}
