(executable
 (name web)
 (libraries
  utils
  language
  grades
  cmarkit
  vdom
  vdom.base
  ojs
  backend
  backendRegistry
  webDeclarations
  webChoices
  webCheckCache
  webLink
  webDocPages
  webBackend
  webInterpreter
  syntaxHighlight
  desugarer
  inference
  loader
  typechecker
  zarith_stubs_js)
 (modes js)
 ;; zarith_stubs_js provides the JavaScript primitives of zarith, which the
 ;; grades link. -no-check-prims hides a missing primitive: without the stubs
 ;; the link succeeds and the bundle fails at load, on ml_z_init.
 (link_flags -no-check-prims)
 (promote
  (until-clean)
  (into ../../../web)
  (only web.bc.js)))

;; The modules Readme_md, Arduino_readme_md and Opentrons_readme_md, generated
;; as Stdlib_tpe is in src/06-user-interface/core/dune, with the sources of the
;; READMEs the documentation view renders. The {md| |md} delimiter is used rather than
;; {| |}, so that a "|}" written in a README does not terminate the literal.

(rule
 (with-stdout-to
  readme_md.ml
  (progn
   (echo "let contents = {md|")
   (cat ../../../README.md)
   (echo "|md}"))))

(rule
 (with-stdout-to
  arduino_readme_md.ml
  (progn
   (echo "let contents = {md|")
   (cat ../../05-backends/arduino/README.md)
   (echo "|md}"))))

(rule
 (with-stdout-to
  opentrons_readme_md.ml
  (progn
   (echo "let contents = {md|")
   (cat ../../05-backends/opentrons/README.md)
   (echo "|md}"))))

;; The module Examples_tpe, generated from the example index
;; examples/index and the source of the examples it names by gen_examples
;; (see gen_examples/gen_examples.ml); the rule depends on the whole examples
;; tree, so that editing the index or any example rebuilds it.

(rule
 (target examples_tpe.ml)
 (deps
  (glob_files_rec %{project_root}/examples/*)
  gen_examples/gen_examples.exe)
 (action
  (with-stdout-to
   examples_tpe.ml
   (run
    gen_examples/gen_examples.exe
    %{project_root}/examples/index
    %{project_root}))))
