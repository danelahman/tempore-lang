(executable
 (name web)
 (libraries
  utils
  language
  grades
  cmarkit
  vdom
  vdom.base
  ojs
  webBackend
  webInterpreter
  loader
  zarith_stubs_js)
 (modes js)
 ;; zarith_stubs_js provides the JavaScript primitives of zarith, which the
 ;; grades link. -no-check-prims hides a missing primitive: without the stubs
 ;; the link succeeds and the bundle fails at load, on ml_z_init.
 (link_flags -no-check-prims)
 (promote
  (until-clean)
  (into ../../../web)
  (only web.bc.js)))

;; The same trick as in src/core/dune, generating the module Readme_md with the
;; README's source, which the documentation view renders. The {md| |md} delimiter
;; is used rather than {| |}, so that a "|}" written in the README some day does
;; not silently terminate the literal.

(rule
 (with-stdout-to
  readme_md.ml
  (progn
   (echo "let contents = {md|")
   (cat ../../../README.md)
   (echo "|md}"))))

;; The module Examples_tpe, generated from the example manifest
;; examples/index and the source of the examples it names by gen_examples
;; (see gen_examples/gen_examples.ml); the rule depends on the whole examples
;; tree, so that editing the manifest or any example rebuilds it.

(rule
 (target examples_tpe.ml)
 (deps
  (glob_files_rec %{project_root}/examples/*)
  gen_examples/gen_examples.exe)
 (action
  (with-stdout-to
   examples_tpe.ml
   (run
    gen_examples/gen_examples.exe
    %{project_root}/examples/index
    %{project_root}))))
