(library
 (name loader)
 (libraries
  utils
  language
  grades
  inference
  sugaredAst
  parser
  desugarer
  typechecker
  backend))

;; The module Stdlib_tpe, generated with the source of the standard library
;; stdlib.tpe as the string contents, after the rule of the dune file of
;; Menhir. The {tpe| |tpe} delimiter is used rather than {| |}, so that a "|}"
;; written in the library does not terminate the literal.

(rule
 (with-stdout-to
  stdlib_tpe.ml
  (progn
   (echo "let contents = {tpe|")
   (cat stdlib.tpe)
   (echo "|tpe}"))))
