; A native, host-run generator, kept in its own directory so that its modules
; do not collide with those of the (js-only) web executable it feeds. The
; reading of the example index is a library of its own, which the tests link.

(library
 (name exampleIndex)
 (modules exampleIndex)
 (libraries grades backendRegistry))

(executable
 (name gen_examples)
 (modules gen_examples)
 (libraries exampleIndex backendRegistry))
