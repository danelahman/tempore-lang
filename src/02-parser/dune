;; The sugared syntax is a library of its own: menhir infers the types of the
;; grammar's symbols with -short-paths, which prints the two-parameter
;; abbreviations of the sugared syntax as [Parser.SugaredAst.term] and so on
;; from within the parser library, a dependency of the parser on itself.

(library
 (name sugaredAst)
 (modules sugaredAst)
 (libraries utils language grades zarith))

(library
 (name parser)
 (modules :standard \ sugaredAst)
 (libraries utils language grades sugaredAst zarith))

(ocamllex lexer)

;; The tokens are declared in token.mly, of which menhir generates the module
;; Token, independent of the grade system the grammar is parameterised by.

(menhir
 (modules token)
 (flags --only-tokens))

(menhir
 (modules token grammar)
 (merge_into grammar)
 (flags --external-tokens Token))
