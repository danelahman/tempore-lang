{
  "title": "M5Stack Core2",
  "description": "M5Stack Core2: ESP32 with PSRAM and an MPU6886 IMU; external I2C on port A",
  "platform": "espressif32@7.1.3",
  "board": "m5stack-core2",
  "framework": "arduino",
  "lib_deps": ["m5stack/M5Unified@0.2.25", "m5stack/M5GFX@0.2.32"],
  "build_flags": ["-DBOARD_HAS_PSRAM"],
  "cores": 2,
  "m5unified": true,
  "capabilities": ["imu", "display", "touch", "speaker", "battery"],
  "serial_baud": 115200,
  "usb": ["10c4:ea60", "1a86:55d4"],
  "i2c": [{ "port": "Wire", "sda": 32, "scl": 33, "frequency": 400000 }],
  "includes": [],
  "init": []
}
