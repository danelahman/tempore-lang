(* The package bala2-radio under the upper-bound grades of the regular
   expressions of timed operations over rational delays, in milliseconds:
   sending and receiving the messages of bala2_radio_protocol.tpe through the
   operations Send and ReceiveMessage of the package esp-now, which a program
   using this package also names, before it.

   A message received is boxed with {[0, 150)}: it is used within 150 ms of
   its reception. *)

(* One operation per message: SendStart, SendDrive (speed, turn), SendStop
   and SendBeat queue the packet of their message to the peer, as Send does
   with its tag, so that grades tell the messages apart. Their bounds are
   those of Send, provisional. *)

operation SendStart : unit ~> unit # {SendStart} within (0, 1]
default SendStart _ = delay 1/10

operation SendDrive : float * float ~> unit # {SendDrive} within (0, 1]
default SendDrive _ = delay 1/10

operation SendStop : unit ~> unit # {SendStop} within (0, 1]
default SendStop _ = delay 1/10

(* SendStatus (code, tilt) queues the status of the robot to the peer: the
   code of its phase, by remote_phase_code, and its tilt; with the
   provisional bounds of Send. *)

operation SendStatus : nat * float ~> unit # {SendStatus} within (0, 1]
default SendStatus _ = delay 1/10

operation SendBeat : unit ~> unit # {SendBeat} within (0, 1]
default SendBeat _ = delay 1/10

(* A message received, to be used within 150 ms. *)
type fresh = [{[0, 150)}]received

(* Sends a message to the peer. *)
let remote_send (m : message) = perform Send (remote_encode m)

(* The latest message from the peer, received at most remote_age_limit ms
   ago, or Nothing, boxed for its use. *)
let remote_receive () : fresh =
  let r = remote_decode (perform ReceiveMessage remote_age_limit) in
  box {[0, 150)} r

(* A status received, to be used within 200 ms of its reception. *)
type fresh_status = [{[0, 200)}]status

(* The latest status of the peer, received at most remote_age_limit ms ago,
   or NoStatus, boxed for its use. *)
let remote_status () : fresh_status =
  let s = remote_status_decode (perform ReceiveMessage remote_age_limit) in
  box {[0, 200)} s

