(* The package bala2-remote under the rigid upper-bound grades of the regular
   expressions of timed operations over rational delays, in milliseconds:
   sending and receiving the messages of bala2_remote_protocol.tpe through
   the operations Send and Receive of the package esp-now, which a program
   using this package also names, before it.

   A message received is returned in two boxes: the message, with the
   setpoints of Drive set to zero, boxed with {(!_ & ~Receive)*}, usable only
   while no further Receive has come, so that it is the latest; and its
   setpoints, of the non-eternal type setpoints, boxed with {[0, 150)}, usable within 150 ms of the reception. A
   grade has a single upper bound, and a box of a box is refused, so the two
   conditions are two boxes; the setpoints of the first are zero, so that a
   program that takes them from it alone commands no motion. *)

(* One operation per message: SendArm, SendDrive (speed, turn), SendDisarm
   and SendBeat queue the packet of their message to the peer, as Send does
   with its tag, so that grades tell the messages apart. Their bounds are
   those of Send, provisional. *)

operation SendArm : unit ~> unit # {SendArm} within [0, 1]
default SendArm _ = delay 1/10

operation SendDrive : float * float ~> unit # {SendDrive} within [0, 1]
default SendDrive _ = delay 1/10

operation SendDisarm : unit ~> unit # {SendDisarm} within [0, 1]
default SendDisarm _ = delay 1/10

(* SendStatus (armed, tilt) queues the status of the robot to the peer,
   with the provisional bounds of Send. *)

operation SendStatus : bool * float ~> unit # {SendStatus} within [0, 1]
default SendStatus _ = delay 1/10

operation SendBeat : unit ~> unit # {SendBeat} within [0, 1]
default SendBeat _ = delay 1/10

(* A message received, to be used before the next Receive. *)
type latest = [{(!_ & ~Receive)*}]received

(* The setpoints of a message received, to be used within 150 ms. *)
type fresh = [{[0, 150)}]setpoints

(* Sends a message to the peer. *)
let remote_send (m : message) = perform Send (remote_encode m)

(* The latest message from the peer, received at most remote_age_limit ms
   ago, or Nothing, and its setpoints, boxed for their use. *)
let remote_receive () : latest * fresh =
  let r = remote_decode (perform Receive remote_age_limit) in
  box {(!_ & ~Receive)*} (remote_without_setpoints r) as latest in
  box {[0, 150)} (Setpoints (remote_setpoints r)) as fresh in
  (latest, fresh)

(* A status received, to be used before the next Receive, and within 200 ms
   of its reception. *)
type latest_status = [{(!_ & ~Receive)*}]status
type fresh_status = [{[0, 200)}]status

(* The latest status of the peer, received at most remote_age_limit ms ago,
   or NoStatus, boxed as the latest and as fresh. *)
let remote_status () : latest_status * fresh_status =
  let s = remote_status_decode (perform Receive remote_age_limit) in
  box {(!_ & ~Receive)*} s as latest in
  box {[0, 200)} s as fresh in
  (latest, fresh)

