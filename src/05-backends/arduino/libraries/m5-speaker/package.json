    "banked-regex-lower-bound-rational-symbolic": "m5_speaker_timed_ops.tpe",
    "banked-regex-upper-bound-rational-symbolic": "m5_speaker_timed_ops.tpe",
    "banked-regex-interval-rational-symbolic": "m5_speaker_timed_ops.tpe",
    "timed-regex-lower-bound-rational": "m5_speaker_timed_ops.tpe",
    "timed-regex-upper-bound-rational": "m5_speaker_timed_ops.tpe",
    "timed-regex-interval-rational": "m5_speaker_timed_ops.tpe",
