(* The package m5-speaker under the at-most counts: tones on the speaker of an
   M5Stack core, through M5Unified. Grades: at-most-counts; a tone counts once,
   and its running time is not bounded. Beep is that of m5_speaker.tpe, its
   default implementation without a delay. *)

operation Beep : nat * nat ~> unit ! (Beep, 1)
default Beep _ = ()
