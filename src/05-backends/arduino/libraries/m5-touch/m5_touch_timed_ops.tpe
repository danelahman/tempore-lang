(* The package m5-touch under the regular expressions of timed operations:
   the touch screen of an M5Stack core, read through M5Unified. Grades: the
   regular expressions of timed operations over rational delays, in
   milliseconds; the operation is its own trace, within the bounds of its
   running time. ReadTouch, its bounds and its default implementation are those
   of m5_touch.tpe. *)

operation ReadTouch : unit ~> bool * nat * nat # {ReadTouch} within (0, 1.45]
default ReadTouch () = delay 3/10; (false, 0, 0)
