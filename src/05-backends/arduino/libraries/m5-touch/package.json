{
  "description": "The touch screen of an M5Stack core through M5Unified",
  "declarations": {
    "time-interval-rational": "m5_touch.tpe",
    "banked-regex-lower-bound-rational-symbolic": "m5_touch_timed_ops.tpe",
    "banked-regex-upper-bound-rational-symbolic": "m5_touch_timed_ops.tpe",
    "banked-regex-interval-rational-symbolic": "m5_touch_timed_ops.tpe",
    "timed-regex-lower-bound-rational-symbolic": "m5_touch_timed_ops.tpe",
    "timed-regex-upper-bound-rational-symbolic": "m5_touch_timed_ops.tpe",
    "timed-regex-interval-rational-symbolic": "m5_touch_timed_ops.tpe",
    "inter-arrival": "m5_touch_timed_ops.tpe",
    "at-most-counts": "m5_touch_counts.tpe"
  },
  "requires": ["m5unified", "touch"],
  "sources": ["m5_touch.cpp"],
  "host_models": ["m5_touch_model.cpp"],
  "bindings": ["ReadTouch"],
  "bounds": {
    "m5stack-cores3-radio": { "ReadTouch": [0, 1.5] }
  }
}
