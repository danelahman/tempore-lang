(* The package m5-touch under the operation counts: the touch screen of an
   M5Stack core, read through M5Unified. Grades: counts-upper-bound; a
   reading counts once, and its running time is not bounded. Touched and its
   default implementation are those of m5_touch.tpe. *)

operation Touched : unit ~> bool * nat * nat # (Touched, 1)
default Touched () = (false, 0, 0)
