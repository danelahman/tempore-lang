(* The package m5-touch under the at-most counts: the touch screen of an M5Stack
   core, read through M5Unified. Grades: at-most-counts; a reading counts once,
   and its running time is not bounded. ReadTouch and its default implementation
   are those of m5_touch.tpe. *)

operation ReadTouch : unit ~> bool * nat * nat ! (ReadTouch, 1)
default ReadTouch () = (false, 0, 0)
