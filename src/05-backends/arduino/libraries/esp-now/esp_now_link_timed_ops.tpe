(* The package esp-now under the regular expressions of timed operations:
   packets between two ESP32 boards over ESP-NOW. Grades: the regular
   expressions of timed operations over rational delays, in milliseconds;
   each operation is its own trace, within the bounds of its running time.
   The operations, their provisional bounds and their default implementations
   are those of esp_now_link.tpe. *)

operation LinkStart : nat ~> bool # {LinkStart} within (0, 1500]
default LinkStart _ = delay 88; true

operation Send : nat * float * float ~> unit # {Send} within (0, 1]
default Send _ = delay 1/10

operation Receive : nat ~> bool * nat * float * float # {Receive} within (0, 1/10]
default Receive _ = delay 1/100; (false, 0, 0.0, 0.0)
