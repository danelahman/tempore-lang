{
  "description": "The accelerometer and gyroscope of an M5Stack core through M5Unified, with an attitude filter",
  "definitions": "m5_imu_filter.tpe",
  "declarations": {
    "time-interval-rational": "m5_imu.tpe",
    "regex-timed-lower-bound-rational-symbolic": "m5_imu_timed_ops.tpe",
    "regex-timed-upper-bound-rational-symbolic": "m5_imu_timed_ops.tpe",
    "regex-timed-interval-rational-symbolic": "m5_imu_timed_ops.tpe",
    "regex-timed-rigid-lower-bound-rational-symbolic": "m5_imu_timed_ops.tpe",
    "regex-timed-rigid-upper-bound-rational-symbolic": "m5_imu_rigid_upper.tpe",
    "regex-timed-rigid-interval-rational-symbolic": "m5_imu_rigid.tpe",
    "operation-spacing": "m5_imu_timed_ops.tpe",
    "counts-upper-bound": "m5_imu_counts.tpe"
  },
  "requires": ["m5unified", "imu"],
  "sources": ["m5_imu.cpp"],
  "host_models": ["m5_imu_model.cpp"],
  "bindings": ["ReadImu", "ConfigureImu", "CheckAtRest"],
  "init": "m5_imu_init",
  "bounds": {
    "m5stack-gray": { "ReadImu": [0.55, 1.25] },
    "m5stack-gray-radio": { "ReadImu": [0.55, 2.2], "CheckAtRest": [17.95, 33] },
    "m5stack-cores3": { "ReadImu": [0.2, 1.5] },
    "m5stack-cores3-radio": { "ReadImu": [0.2, 1.95] }
  }
}
