(* The package m5-display under the regular expressions of timed operations:
   lines of text and numbers on the display of an M5Stack core, through
   M5Unified. Grades: the regular expressions of timed operations over
   rational delays, in milliseconds; each operation is its own trace, within
   the bounds of its running time. The operations, their bounds and their
   default implementations are those of m5_display.tpe. *)

operation ShowText : string ~> unit # {ShowText} within [0.2, 20]
default ShowText _ = delay 1

operation ShowNumber : float ~> unit # {ShowNumber} within [0.2, 20]
default ShowNumber _ = delay 1

operation ClearDisplay : unit ~> unit # {ClearDisplay} within [10, 60]
default ClearDisplay () = delay 31
