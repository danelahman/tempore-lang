{
  "description": "Text, numbers, buttons, bars and a bubble level on the display of an M5Stack core through M5Unified",
  "declarations": {
    "time-interval-rational": "m5_display.tpe",
    "banked-regex-lower-bound-rational-symbolic": "m5_display_timed_ops.tpe",
    "banked-regex-upper-bound-rational-symbolic": "m5_display_timed_ops.tpe",
    "banked-regex-interval-rational-symbolic": "m5_display_timed_ops.tpe",
    "timed-regex-lower-bound-rational": "m5_display_timed_ops.tpe",
    "timed-regex-upper-bound-rational": "m5_display_timed_ops.tpe",
    "timed-regex-interval-rational": "m5_display_timed_ops.tpe",
    "inter-arrival": "m5_display_timed_ops.tpe",
    "at-most-counts": "m5_display_counts.tpe"
  },
  "requires": ["m5unified", "display"],
  "sources": ["m5_display.cpp"],
  "bindings": [
    "ShowText", "ShowNumber", "ClearDisplay", "ShowTextAt", "ShowNumberAt",
    "ShowTimeAt", "ShowColourTextAt", "ShowColourNumberAt", "DrawButton", "DrawBar", "DrawLevel"
  ],
  "init": "m5_display_init",
  "bounds": {
    "m5stack-gray-radio": { "ClearDisplay": [31, 53.5] }
  }
}
