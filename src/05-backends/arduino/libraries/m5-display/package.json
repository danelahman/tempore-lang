{
  "description": "Text, numbers, buttons, bars and a bubble level on the display of an M5Stack core through M5Unified",
  "declarations": {
    "time-interval-rational": "m5_display.tpe",
    "regex-timed-lower-bound-rational-symbolic": "m5_display_timed_ops.tpe",
    "regex-timed-upper-bound-rational-symbolic": "m5_display_timed_ops.tpe",
    "regex-timed-interval-rational-symbolic": "m5_display_timed_ops.tpe",
    "counts-upper-bound": "m5_display_counts.tpe"
  },
  "requires": ["m5unified", "display"],
  "sources": ["m5_display.cpp"],
  "host_models": ["m5_display_model.cpp"],
  "bindings": [
    "ShowText", "ShowNumber", "ClearDisplay", "ShowTextAt", "ShowNumberAt",
    "ShowTimeAt", "ShowColourTextAt", "DrawButton", "DrawBar", "DrawLevel"
  ],
  "init": "m5_display_init",
  "bounds": {
    "m5stack-cores3": { "ShowTextAt": [2.55, 33], "ShowNumberAt": [1.8, 33] }
  }
}
