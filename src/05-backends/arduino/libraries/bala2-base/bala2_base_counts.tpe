(* The package bala2-base under the operation counts: the two motors and
   wheel encoders of the base of the M5Stack BALA2. Grades:
   counts-upper-bound; each call counts once, and running times are not
   bounded. The operations and the watchdog of the motor setpoints are those
   of bala2_base.tpe; the default implementations read zeros. *)

operation SetMotors : float * float ~> unit # (SetMotors, 1)
default SetMotors _ = ()

operation ReadEncoders : unit ~> float * float # (ReadEncoders, 1)
default ReadEncoders () = (0.0, 0.0)

operation ResetEncoders : unit ~> unit # (ResetEncoders, 1)
default ResetEncoders () = ()
