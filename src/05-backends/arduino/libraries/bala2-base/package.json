    "banked-regex-interval-rational-symbolic": "bala2_base_timed_ops.tpe",
    "timed-regex-lower-bound-rational": "bala2_base_timed_ops.tpe",
    "timed-regex-upper-bound-rational": "bala2_base_timed_ops.tpe",
    "timed-regex-interval-rational": "bala2_base_timed_ops.tpe",
