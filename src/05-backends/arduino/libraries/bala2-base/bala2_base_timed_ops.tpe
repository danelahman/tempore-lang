(* The package bala2-base under the regular expressions of timed operations:
   the two motors and wheel encoders of the base of the M5Stack BALA2.
   Grades: the regular expressions of timed operations over rational delays,
   in milliseconds; each operation is its own trace, within the bounds of its
   running time. The operations, their bounds, their default implementations
   and the watchdog of the motor setpoints are those of bala2_base.tpe. *)

operation SetMotors : int * int ~> unit ! {SetMotors} within [0.2, 0.45]
default SetMotors _ = delay 1/5

operation ReadEncoders : unit ~> int * int ! {ReadEncoders} within [0.45, 1]
default ReadEncoders () = delay 1/2; (0i, 0i)

operation ResetEncoders : unit ~> unit ! {ResetEncoders} within [0.3, 0.6]
default ResetEncoders () = delay 7/20
