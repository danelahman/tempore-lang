(library
 (name arduinoBackend)
 (libraries utils language grades zarith))

; The files of C++, JSON and Tempore that the backend writes or reads are
; embedded as string literals by the generator embed/embed.exe:
;
; - Arduino_runtime.header, the runtime header tempore_arduino.h, and
;   Arduino_runtime.host_prelude, the beginning of the main program of the runs
;   on the host after the include of the program header,
;   tempore_host_prelude.cpp;
; - Arduino_boards.files, the board profiles boards/NAME.json, each with its
;   name NAME.json;
; - Arduino_scaffold.files, the files of the scaffold under scaffold/, each
;   with its path below scaffold/; those under m5/ are those of the boards
;   with a screen driven through M5Unified, and those under battery/ those of
;   the manifests with the battery indicator;
; - Arduino_libraries.files, the files of the peripheral packages under
;   libraries/NAME/, each with its path below libraries/.

(rule
 (target arduino_runtime.ml)
 (deps tempore_arduino.h tempore_host_prelude.cpp)
 (action
  (with-stdout-to
   %{target}
   (progn
    (run %{exe:embed/embed.exe} value header tempore_arduino.h)
    (run %{exe:embed/embed.exe} value host_prelude tempore_host_prelude.cpp)))))

(rule
 (target arduino_boards.ml)
 (deps
  (glob_files boards/*.json))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:embed/embed.exe} files files boards/ %{deps}))))

(rule
 (target arduino_scaffold.ml)
 (deps
  (glob_files_rec scaffold/*.{h,cpp}))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:embed/embed.exe} files files scaffold/ %{deps}))))

(rule
 (target arduino_libraries.ml)
 (deps
  (glob_files_rec libraries/*.{json,tpe,h,cpp}))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:embed/embed.exe} files files libraries/ %{deps}))))
