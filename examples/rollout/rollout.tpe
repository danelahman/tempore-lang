  handle
    let a = perform Build (src, v) in
    let go = perform Approve a in
    let patched = perform FetchPatch src in
    roll (plan 2 hosts) [] go
  with deployer_with (box ⊤ probe_retrying)
*)

(* Correctly rejected by the typechecker: a deployer that patches each host
   touches untrusted input before it resumes 'k'. Under 'time-lower-bound'
   the same handler is accepted:

     Typing error: Variable `k` is unboxed with grade `(6,High)` accumulated
       since it was bound, which is not below its box grade `(4,Low)`
       ...
       Note: the resource inequality `(6,High) ≾ (4,Low)` does not hold
*)
(*
let patching_deployer =
  handler
  | x -> x
  | Deploy (h, r) k ->
      let p = perform FetchPatch "api" in
      perform Install (h, r);
      continue k with (perform Probe (h, 0))
*)

let hosts =
  [Host "web-1"; Host "web-2"; Host "web-3"; Host "db-1"; Host "db-2"]

(* The hosts, as a first wave of one host, then two waves of two hosts. *)
run plan 2 hosts

(* 'plan' and 'size' at a list of strings: seven items. *)
run size (plan 3 ["a"; "b"; "c"; "d"; "e"; "f"; "g"])

(* The rollout completes on all five hosts, 'db-2' after one retry, with its
   audit trail. *)
run handle release (box ⊤ probe_retrying) "api" 7 hosts with audit

(* Under the strict policy 'db-2' fails, and the five hosts deployed are
   reverted. *)
run handle release (box ⊤ probe_once) "api" 7 hosts with audit

(* The host of the first wave, 'cache-1', reports errors while it is
   watched, and is reverted. *)
run
  handle release (box ⊤ probe_retrying) "api" 7 [Host "cache-1"; Host "web-1"]
  with audit

(* The patched release completes on all five hosts. *)
run patched_release "api" 8 hosts
