(* Values boxed for a time interval, unboxed once the interval has elapsed.

   Run this example with the 'time-interval' grading monoid, e.g.

     ./tempore --grades time-interval examples/time/time_intervals.tpe

   Grades [n, m]: between n and m time steps, (n, m) being [n + 1, m - 1]
     - Unit [0, 0]: no time spent
     - Top [0, ∞): no bound, the widest interval
     - Product: componentwise addition *)

(* Correctly accepted by the typechecker: the two delays accumulate [3, 3],
   which lies inside the [1, 4] the box demands. *)
let foo1 () = 
  box [1, 4] 1 as r in
  let _ = delay 1 in
  let _ = delay 2 in
  unbox r as y in
  1

(* Correctly accepted by the typechecker: as 'foo1', and the unboxed value may
   be returned since the box has been opened. *)
let foo2 () = 
  box [1, 4] 1 as r in
  let _ = delay 1 in
  let _ = delay 2 in
  unbox r as y in
  y

(* Correctly accepted by the typechecker: 'z' is bound after the delays, so no
   grade has accumulated since it was bound. *)
let foo3 () = 
  let x = 7 in
  box [1, 4] 1 as r in
  let _ = delay 1 in
  let _ = delay 2 in
  let z = 3 in
  unbox r as y in
  y + z

(* Correctly accepted by the typechecker: 'x' is used three ticks after it was
   bound, which is fine because 'nat' is an eternal type. *)
let foo4 () = 
  let x = 7 in
  box [1, 4] 1 as r in
  let _ = delay 1 in
  let _ = delay 2 in
  let z = 3 in
  unbox r as y in
  y + x

(* Correctly accepted by the typechecker: boxing 'x' at [2, 5] requires it to be
   usable in that future, which 'nat' being eternal allows, and the delays'
   [3, 3] lies inside both [1, 4] and [2, 5]. *)
let foo5 () = 
  let x = 7 in
  box [2, 5] x as x' in
  box [1, 4] 1 as r in
  let _ = delay 1 in
  let _ = delay 2 in
  let z = 3 in
  unbox r as y in
  unbox x' as x'' in
  y + x + x''

(* Correctly accepted by the typechecker: the open interval (0, 5) excludes its
   ends, and over whole time steps is the interval [1, 4]; the delays
   accumulate [4, 4]. *)
let foo_open () =
  box (0, 5) 1 as r in
  delay 4;
  unbox r as y in
  y

(* Correctly rejected by the typechecker: five ticks overshoot the upper end of
   the [1, 4] interval the box demands:

     Typing error: Variable `r` is unboxed with grade `[5, 5]` accumulated since
       it was bound, which is not below its box grade `[1, 4]`
       Note: the resource inequality `[5, 5] <= [1, 4]` does not hold
*)
(*
let foo6 () = 
  let r = box [1, 4] 1 in
  delay 5;
  unbox r as y in
  y + 1
*)

(* Correctly rejected by the typechecker: 'r'' is a boxed value, whose type is
   not eternal, so it cannot be used after the three ticks that follow its
   binding:

     Typing error: Variable `r` is used with grade `[3, 3]` accumulated since it
       was bound, but its type `[[3, 3]]nat` is not eternal
       Note: the resource inequality `[3, 3] <= [0, 0]` does not hold
*)
(*
let foo7 () =
  let r = box [1, 4] 1 in
  delay 3;
  let r' = r in
  delay 3;
  unbox r' as y in
  y + 1
*)

run foo1 ()
run foo2 ()
run foo3 ()
run foo4 ()
run foo5 ()
run foo_open ()