(* A medication schedule in hours, with doses due within fractional windows.

   Run this example with the 'time-interval-rational' grading monoid, e.g.

     ./tempore --grades time-interval-rational examples/time/rational_time_intervals.tpe

   Grades [q, r] or (q, r): between q and r hours, a parenthesised end excluded
     - Unit [0, 0]: no time spent
     - Top [0, ∞): no bound, the widest interval
     - Product: componentwise addition, an end open if either end added is *)

(* A nurse's check-in with the patient takes between a quarter and half an
   hour; unhandled, it takes a quarter of an hour. *)
operation CheckIn : unit ~> unit # [0.25, 0.5]

default CheckIn () = delay 0.25

(* Correctly accepted by the typechecker: the next dose is released between
   four and six hours after the last, and waiting 3.75 hours and checking in
   accumulates [4, 4.25], which lies inside [4, 6]. *)
let next_dose dose =
  box [4, 6] dose as d in
  delay 3.75;
  perform CheckIn ();
  unbox d as x in
  x

(* Correctly accepted by the typechecker: a sedative is given strictly more
   than four hours after the last dose, and at most six; waiting four hours
   and checking in accumulates [4.25, 4.5], which lies inside (4, 6]. *)
let next_sedative dose =
  box (4, 6] dose as d in
  delay 4;
  perform CheckIn ();
  unbox d as x in
  x

(* Correctly accepted by the typechecker: a report is filed hourly, and three
   readings twenty minutes apart accumulate exactly [1, 1], with no rounding. *)
let hourly_report reading =
  box [1, 1] reading as r in
  delay 1/3;
  delay 1/3;
  delay 1/3;
  unbox r as x in
  x

(* Correctly rejected by the typechecker: waiting three hours and checking in
   twice may take as little as 3.5 hours, before the dose is due:

     Typing error: Variable `d` is unboxed with grade `[3.5, 4]` accumulated
       since it was bound, which is not below its box grade `[4, 6]`
       Note: the resource inequality `[3.5, 4] <= [4, 6]` does not hold
*)
(*
let early_dose dose =
  box [4, 6] dose as d in
  delay 3;
  perform CheckIn ();
  perform CheckIn ();
  unbox d as x in
  x
*)

(* Correctly rejected by the typechecker: waiting 3.75 hours and checking in
   may take exactly four hours, which (4, 6] excludes:

     Typing error: Variable `d` is unboxed with grade `[4, 4.25]` accumulated
       since it was bound, which is not below its box grade `(4, 6]`
       Note: the resource inequality `[4, 4.25] <= (4, 6]` does not hold
*)
(*
let early_sedative dose =
  box (4, 6] dose as d in
  delay 3.75;
  perform CheckIn ();
  unbox d as x in
  x
*)

(* Correctly rejected by the typechecker: two readings twenty minutes apart
   accumulate only 2/3 of the hour the report is due after:

     Typing error: Variable `r` is unboxed with grade `[2/3, 2/3]` accumulated
       since it was bound, which is not below its box grade `[1, 1]`
       Note: the resource inequality `[2/3, 2/3] <= [1, 1]` does not hold
*)
(*
let early_report reading =
  box [1, 1] reading as r in
  delay 1/3;
  delay 1/3;
  unbox r as x in
  x
*)

run next_dose 500
run next_sedative 25
run hourly_report 72
