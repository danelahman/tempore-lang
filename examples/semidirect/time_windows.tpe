(* Sensor frames that transmit in a fixed slot of a repeating time window.

   Run this example with the 'time-windows' grading monoid, e.g.

     ./tempore --grades time-windows examples/semidirect/time_windows.tpe

   Grades (T, E): possible durations T and times E of windowed operations;
   (T, E) · (T', E') = (T + T', E ∪ (T + E')). *)

(* Sensing takes a tick, and is performed at any time. *)
operation Sense : unit ~> int # 1
default Sense () = delay 1; 21

(* A transmission takes a tick, and happens at its start. *)
operation Send : int ~> unit # (1, {0})
default Send x = delay 1

(* Correctly accepted by the typechecker: a frame of ten ticks that transmits
   in the node's slot, ticks 4 and 5 of the frame. *)
let frame () : unit # (10, {4 | 5}) =
  let x = perform Sense () in
  delay 3;
  perform Send (2 * x);
  delay 5

(* Correctly accepted by the typechecker: three frames, each transmitting in
   its own slot, and thus within the slots of every frame. *)
let frames () : unit # (30, {(4 | 5); 10*}) =
  frame ();
  frame ();
  frame ()

(* Correctly accepted by the typechecker: an optional frame takes 0 or 10
   ticks, so the slot of the frame after it is at ticks 4 and 5 or at ticks 14
   and 15. *)
let maybe_twice b : unit # ({10 | 20}, {4 | 5 | 14 | 15}) =
  if b then frame () else ();
  frame ()

(* Correctly accepted by the typechecker: a reading stays fresh for three to
   five ticks, provided nothing is transmitted meanwhile. *)
let fresh () =
  let x = perform Sense () in
  box (3, 5) x as r in
  delay 3;
  unbox r as y in
  perform Send y

(* Correctly rejected by the typechecker: sensing twice and waiting four ticks
   transmits at tick 6, after the slot:

     Typing error: This function's body has grade `(10,{6})`, which does not
       match its annotated grade `(10,{4 | 5})`
       Note: the effect inequality `(10,{6}) <= (10,{4 | 5})` does not hold
*)
(*
let late_frame () : unit # (10, {4 | 5}) =
  let x = perform Sense () in
  let y = perform Sense () in
  delay 4;
  perform Send (x + y);
  delay 3
*)

(* Correctly rejected by the typechecker: a transmission between boxing and
   unboxing spoils the reading:

     Typing error: Variable `r` is unboxed with grade `(3,{1})` accumulated
       since it was bound, which is not below its box grade `(3,5)`
       ...
       Note: the resource inequality `(3,{1}) <= (3,5)` does not hold
*)
(*
let stale () =
  let x = perform Sense () in
  box (3, 5) x as r in
  delay 1;
  perform Send 0;
  delay 1;
  unbox r as y in
  perform Send y
*)

run frames ()
run fresh ()
