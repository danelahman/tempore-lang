(* File copies and uploads, checked against the levels of each resource held.

   Run this example with the 'resource-levels' grading monoid, e.g.

     ./tempore --grades resource-levels examples/semidirect/resource_levels.tpe

   Grades ((R, t, d, h), ...): trough t, net change d, peak h of resource R
     - Unit (0, 0): no resource changed or held
     - Top (∞, ∞): unbounded trough, net change and peak of every resource
     - Product: net changes added, later levels shifted by earlier changes *)

(* The levels are relative to the level at the start. An entry (R, d, h) has
   the trough min(0, d), and a net change [d1, d2] ranges from d1 to d2:
   (t, [d1, d2], h) · (t', [d1', d2'], h')
     = (min(t, d1 + t'), [d1 + d1', d2 + d2'], max(h, d2 + h')). *)

type file = File of string
type socket = Socket of string

(* Opening a file holds exactly one more file, and closing one releases it.
   No code acquires or releases a file, so neither has a default
   implementation, and a run stops at its first 'Open'. *)
operation Open : string ~> file # (Files, 1, 1)

operation Close : file ~> unit # (Files, -1, 0)

(* Connecting holds exactly one more socket, and disconnecting releases it;
   neither has a default implementation either. *)
operation Connect : string ~> socket # (Sockets, 1, 1)

operation Disconnect : socket ~> unit # (Sockets, -1, 0)

(* Reading, writing and sending hold nothing more, of any resource. *)
operation Read : file ~> string # (0, 0)
default Read f = "contents"

operation Write : file * string ~> unit # (0, 0)
default Write (f, s) = ()

operation Send : socket * string ~> unit # (0, 0)
default Send (c, s) = ()

(* Correctly accepted by the typechecker: a copy holds two files at its peak
   and releases both. *)
let copy (src, dst) : unit # (Files, 0, 2) =
  let i = perform Open src in
  let o = perform Open dst in
  let s = perform Read i in
  perform Write (o, s);
  perform Close o;
  perform Close i

(* Correctly accepted by the typechecker: two copies in sequence still hold at
   most two files at a time, although they open four. *)
let backup () : unit # (Files, 0, 2) =
  copy ("a", "a.bak");
  copy ("b", "b.bak")

(* Correctly accepted by the typechecker: an upload holds one file and one
   socket at a time, each bounded on its own. *)
let upload name : unit # ((Files, 0, 1), (Sockets, 0, 1)) =
  let c = perform Connect "backup.example" in
  let f = perform Open name in
  let s = perform Read f in
  perform Close f;
  perform Send (c, s);
  perform Disconnect c

(* Correctly accepted by the typechecker: a backup followed by an upload holds
   at most two files and one socket at a time, each peak reached at a
   different time. *)
let backup_and_upload () : unit # ((Files, 0, 2), (Sockets, 0, 1)) =
  backup ();
  upload "a.bak"

(* Correctly accepted by the typechecker: a branch holds the join of the peaks
   of its arms, resource by resource. *)
let maybe_upload b : unit # ((Files, 0, 2), (Sockets, 0, 1)) =
  if b then upload "a" else backup ()

(* Correctly accepted by the typechecker: rotating a log closes the file it is
   given before opening the next one, falling one file below the level at the
   start and never rising above it. *)
let rotate log : file # (Files, -1, 0, 0) =
  perform Close log;
  perform Open "log.1"

(* Correctly rejected by the typechecker: the source is never closed, so one
   file is still held at the end:

     Typing error: This function's body has grade `(Files, 1, 2)`, which does
       not match its annotated grade `(Files, 0, 2)`
       Note: the effect inequality `(Files, 1, 2) <= (Files, 0, 2)` does not
       hold
*)
(*
let leaky_copy (src, dst) : unit # (Files, 0, 2) =
  let i = perform Open src in
  let o = perform Open dst in
  let s = perform Read i in
  perform Write (o, s);
  perform Close o
*)

(* Correctly rejected by the typechecker: mirroring a copy to two hosts holds
   two sockets at once, one more than the annotation allows, however few files
   it holds:

     Typing error: This function's body has grade
       `((Files, 0, 2), (Sockets, 0, 2))`, which does not match its annotated
       grade `((Files, 0, 2), (Sockets, 0, 1))`
       Note: the effect inequality
         `((Files, 0, 2), (Sockets, 0, 2)) <=
         ((Files, 0, 2), (Sockets, 0, 1))` does not hold
*)
(*
let mirror (src, dst) : unit # ((Files, 0, 2), (Sockets, 0, 1)) =
  let c = perform Connect "primary.example" in
  let d = perform Connect "mirror.example" in
  copy (src, dst);
  perform Disconnect d;
  perform Disconnect c
*)

(* Correctly rejected by the typechecker: opening the next log before closing
   the one given holds one more file than the annotation allows:

     Typing error: This function's body has grade `(Files, 0, 1)`, which does
       not match its annotated grade `(Files, -1, 0, 0)`
       Note: the effect inequality `(Files, 0, 1) <= (Files, -1, 0, 0)` does
         not hold
*)
(*
let rotate_early log : file # (Files, -1, 0, 0) =
  let next = perform Open "log.1" in
  perform Close log;
  next
*)

run backup ()
