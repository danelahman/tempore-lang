(* A file-session protocol, an authentication token and a revocable capability.

   Run this example with the 'traces-regex-symbolic' grading monoid, e.g.

     ./tempore --grades traces-regex-symbolic examples/regular/regular_traces.tpe

   Grades {...}: regular languages of runs over ticks and operations
     - Unit {0}: the empty run
     - Top ⊤: every run
     - Product: concatenation of runs *)

type token = Token of string

(* The operations of a file protocol. *)
operation Open : unit ~> unit # {Open}
operation Read : unit ~> nat # {Read}
operation Write : nat ~> unit # {Write}
operation Close : unit ~> unit # {Close}

(* A session: open, any number of reads and writes, close. *)
operation Session : unit ~> nat # {Open; (Read | Write)*; Close}

(* The operations of an authenticated service. *)
operation Auth : unit ~> unit # {Auth}
operation Fetch : unit ~> unit # {Fetch}
operation Revoke : unit ~> unit # {Revoke}

(* Correctly accepted by the typechecker: two copies within one session
   follow the protocol. *)
let copy_twice () : nat # {Open; (Read | Write)*; Close} =
  perform Open ();
  let x = perform Read () in
  perform Write x;
  let y = perform Read () in
  perform Write y;
  perform Close ();
  x + y

(* Correctly accepted by the typechecker: the clause realises a session by a
   single read, one of the runs 'Session' permits. *)
let one_read =
  handler
  | x -> x
  | Session () k ->
      perform Open ();
      let x = perform Read () in
      perform Close ();
      continue k with x

(* Correctly accepted by the typechecker: sessions separated by ticks, any
   number of times. *)
let two_sessions () : nat # {(Open; (Read | Write)*; Close | 1)*} =
  let x = perform Session () in
  delay 2;
  let y = perform Session () in
  x + y

(* Correctly accepted by the typechecker: the token may be used once the
   session has authenticated, whatever happened before and since. Its grade is
   printed as '{~(_ & ~Auth)*}', all runs but those avoiding 'Auth'. *)
let after_auth () =
  box {_*; Auth; _*} (Token "t") as t in
  perform Fetch ();
  perform Auth ();
  delay 1;
  unbox t as tok in
  tok

(* Correctly accepted by the typechecker: the capability may be used as long
   as it has not been revoked. *)
let before_revoke () =
  box {~{_*; Revoke; _*}} (Token "c") as c in
  perform Auth ();
  perform Fetch ();
  unbox c as cap in
  perform Revoke ();
  cap

(* Correctly accepted by the typechecker: the grade permits the runs that
   begin with three ticks, whatever follows. This is '{3}' followed by '⊤',
   which is not '⊤': the top grade is not absorbing. *)
let settle () =
  box {3; _*} "settled" as s in
  delay 3;
  perform Fetch ();
  unbox s as msg in
  msg

(* Correctly rejected by the typechecker: the clause reads after closing,
   which no session permits:

     Typing error: Variable `k` is unboxed with grade `{Open; Close; Read}`
       accumulated since it was bound, which is not below its box grade
       `{Open; (Read | Write)*; Close}`
       ...
       Note: the resource inequality
         `{Open; Close; Read} <= {Open; (Read | Write)*; Close}` does not hold
*)
(*
let late_read =
  handler
  | x -> x
  | Session () k ->
      perform Open ();
      perform Close ();
      let x = perform Read () in
      continue k with x
*)

(* Correctly rejected by the typechecker: the session is never closed:

     Typing error: This function's body has grade `{Open; Read}`, which does
       not match its annotated grade `{Open; (Read | Write)*; Close}`
       Note: the effect inequality
         `{Open; Read} <= {Open; (Read | Write)*; Close}` does not hold
*)
(*
let unclosed () : nat # {Open; (Read | Write)*; Close} =
  perform Open ();
  perform Read ()
*)

(* Correctly rejected by the typechecker: the token is used before
   authenticating:

     Typing error: Variable `t` is unboxed with grade `{Fetch}` accumulated since
       it was bound, which is not below its box grade `{~(_ & ~Auth)*}`
       ...
       Note: the resource inequality `{Fetch} <= {~(_ & ~Auth)*}` does not
         hold
*)
(*
let before_auth () =
  box {_*; Auth; _*} (Token "t") as t in
  perform Fetch ();
  unbox t as tok in
  perform Auth ();
  tok
*)

(* Correctly rejected by the typechecker: the capability is used after its
   revocation:

     Typing error: Variable `c` is unboxed with grade `{Revoke}` accumulated
       since it was bound, which is not below its box grade `{(_ & ~Revoke)*}`
       ...
       Note: the resource inequality `{Revoke} <= {(_ & ~Revoke)*}` does not
         hold
*)
(*
let after_revoke () =
  box {~{_*; Revoke; _*}} (Token "c") as c in
  perform Revoke ();
  unbox c as cap in
  cap
*)

(* Correctly rejected by the typechecker: the three ticks come after the
   'Fetch', and the order is part of the grade:

     Typing error: Variable `s` is unboxed with grade `{Fetch; 3}` accumulated
       since it was bound, which is not below its box grade `{3; _*}`
       ...
       Note: the resource inequality `{Fetch; 3} <= {3; _*}` does not hold
*)
(*
let settle_early () =
  box {3; _*} "settled" as s in
  perform Fetch ();
  delay 3;
  unbox s as msg in
  msg
*)

(* The operations have no default implementations, since only performing an
   operation realises its grade; the run uses delays alone. *)
run box {3; _*} "settled" as s in delay 4; unbox s as msg in msg

(* Correctly rejected by the typechecker: a session that may write, annotated
   as one that only reads; the second note names a run the body may exhibit
   that the annotated grade does not contain:

     Typing error: This function's body has grade
       `{Open; Read; (0 | Write); Close}`, which does not match its annotated
       grade `{Open; Read*; Close}`
       Note: the effect inequality
         `{Open; Read; (0 | Write); Close} <= {Open; Read*; Close}` does not
         hold
       Note: the grade `{Open; Read; Write; Close}` is below
         `{Open; Read; (0 | Write); Close}` but not below `{Open; Read*; Close}`
*)
(*
let maybe_write (b : bool) : nat # {Open; Read*; Close} =
  perform Open ();
  let x = perform Read () in
  if b then perform Write x else ();
  perform Close ();
  x
*)

(* A grade whose automaton is large: the box grade permits the runs whose
   13th-last step, if any, is neither an 'A' nor a 'B'. Under 'traces-regex',
   reading the literal builds the minimal automata of the two complements, of
   2^13 states each by the subset construction, and of their intersection,
   which dominates: the program takes about 10 s. Under
   'traces-regex-symbolic', the literal is kept as a normalised expression, and
   the inclusions the typechecker decides explore only the derivatives along
   one run: the program takes about 0.04 s. *)
(*
operation A : unit ~> unit # {A}
operation B : unit ~> unit # {B}
operation C : unit ~> unit # {C}
run
  box {~(_*; A; _; _; _; _; _; _; _; _; _; _; _; _)
       & ~(_*; B; _; _; _; _; _; _; _; _; _; _; _; _)} 42 as x in
  perform C ();
  unbox x as v in
  v
*)
