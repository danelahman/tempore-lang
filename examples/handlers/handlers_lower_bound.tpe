(* Handler clauses for reading and writing state, delaying or forwarding grades.

   Run this example with the 'time-lower-bound' grading monoid, e.g.

     ./tempore --grades time-lower-bound examples/handlers/handlers_lower_bound.tpe

   Grades n: at least n time steps
     - Unit 0: no time needed
     - Top 0: no time needed; the unit is the top
     - Product: addition *)

(* Reading the state takes 71 ticks. *)
operation Get : unit ~> int # 71
(* Writing it takes 2. *)
operation Set : int ~> unit # 2

(* Correctly accepted by the typechecker: the 'Get' clause delays exactly the
   71 ticks of the operation and the 'Set' clause forwards it at its own cost
   of 2; the return case performs both itself, so the handler has grade 73. *)
let h =
  handler
  | x ->
      perform Set 42;
      let y = perform Get () in
      x + y
  | Get () k ->
      delay 71;
      continue k with 42
  | Set x k ->
      perform Set x;
      continue k with ()

(* Correctly accepted by the typechecker: a handler whose return case takes no
   time, so its grade is 0; the 'Get' clause again delays the 71 ticks of the
   operation. *)
let h' =
  handler
  | x -> x * x
  | Get x k ->
      delay 71;
      continue k with 42

(* Correctly accepted by the typechecker: the 'Get' clause performs 'Get'
   itself instead of delaying, which costs exactly the grade of the operation
   it handles. *)
let h'' =
  handler
  | x -> x * x
  | Get x k ->
      perform Get ();
      continue k with 42

(* Correctly accepted by the typechecker: resuming twice unboxes 'k' a
   second time only after the first resumption has run for the
   continuation's own rigid effect eps, growing the accumulated grade to
   71 · eps, which still meets its box grade 71, since more grade only helps. *)
let h_twice =
  handler
  | x -> x
  | Get () k ->
      delay 71;
      let y = continue k with 42 in
      continue k with y

(* Correctly accepted by the typechecker: 'n' is bound outside the handler,
   but an int is eternal, so the case may use it however late it runs. *)
let h_offset n =
  handler
  | x -> x + n
  | Get () k ->
      delay 71;
      continue k with n

(* Correctly rejected by the typechecker: the continuation may be resumed
   only once 71 ticks have passed since the call, but this clause delays
   only 70:

     Typing error: Variable `k` is unboxed with grade `70` accumulated since it
       was bound, which is not below its box grade `71`
       Note: the resource inequality `70 >= 71` does not hold
*)
(*
let h_short =
  handler
  | x -> x
  | Get () k ->
      delay 70;
      continue k with 42
*)

(* Correctly rejected by the typechecker: performing 'Set' costs only 2
   ticks, short of the 71 the continuation demands:

     Typing error: Variable `k` is unboxed with grade `2` accumulated since it
       was bound, which is not below its box grade `71`
       Note: the resource inequality `2 >= 71` does not hold
*)
(*
let h_swap =
  handler
  | x -> x
  | Get () k ->
      perform Set 0;
      continue k with 42
*)

(* Correctly rejected by the typechecker: the case must be a sub-grade of
   71 · eps for every eps, but never resuming gives it grade 0, which
   already fails for eps = 0:

     Typing error: For every grade `ε₀` the continuation `k` may have, the
       case for `Get` must have a grade matching `71 · ε₀`, but its grade
       `0` does not
       Note: the effect inequality `∀ε₀. 0 >= 71 · ε₀` does not hold: for
         `ε₀ = 0` it becomes `0 >= 71`
*)
(*
let h_abandon =
  handler
  | x -> x
  | Get () k -> 0
*)

(* Correctly rejected by the typechecker: the return case makes the
   handler's result type 'unit -> α # 0', so the continuation must be
   resumed as soon as the case runs, with only the unit grade accumulated:

     Typing error: Variable `k` is unboxed with the unit grade `0` accumulated
       since it was bound, which is not below its box grade `71`
       Note: the resource inequality `0 >= 71` does not hold
*)
(*
let h_fixed =
  handler
  | x -> (fun () -> x)
  | Get () k -> (fun () -> let f = continue k with 42 in f ())
*)

(* Accepted by the typechecker: 'f' is bound outside the handler like 'n'
   above, but under time-lower-bound the case's lock at the top grade
   restricts nothing, since zero is the top of the order, so a
   non-eternal function may still be used in it. Under time-upper-bound
   the same case is rejected, since the top grade there is not the unit
   (see 'handlers_upper_bound.tpe'). *)
let h_helper f =
  handler
  | x -> x
  | Get () k ->
      delay 71;
      continue k with (f ())

(* A single-use token, declared non-eternal whatever its structure. *)
noneternal type token = Token

(* Accepted by the typechecker: 't' is bound outside the handler and a
   token is declared noneternal, but under time-lower-bound the case's
   lock at the top grade restricts nothing, so it may still be used,
   zero being the top grade there. Under time-upper-bound the same case
   is rejected (see 'handlers_upper_bound.tpe'). *)
let h_token t =
  handler
  | x -> x
  | Get () k ->
      delay 71;
      let (Token) = t in
      continue k with 42

(* Accepted by the typechecker: a case may keep a non-eternal function
   like 'g' from outside it under time-lower-bound, since the lock at
   the top grade restricts nothing there; 'g''s inferred type
   `[71](int → α # 0) → β # ε₀` still pins down the continuation's grade,
   so no soundness is lost by letting the case call 'g' on 'k'. Under
   time-upper-bound the same case is rejected, since the top grade
   there is not the unit (see 'handlers_upper_bound.tpe'). *)
let h_leak g =
  handler
  | x -> x
  | Get () k ->
      g k;
      delay 71;
      continue k with 42

(* The run handles a 'Get' with 'h_twice': the first resumption returns 45,
   which the second resumption then continues with, so the run returns 48. *)
run
  handle
    let x = perform Get () in
    return x + 3
  with h_twice

(* The run handles a 'Get' with 'h_offset 10': the case resumes with the
   captured 10 and the return case adds it again, so the run returns 23. *)
run
  handle
    let x = perform Get () in
    return x + 3
  with h_offset 10

(* The run handles a 'Get' with 'h', whose return case then performs a 'Set';
   the 'Set' clause forwards it and nothing outside catches it, so the run
   stops at that unhandled operation. *)
run
  handle
    let x = perform Get () in
    return x + 3
  with h
