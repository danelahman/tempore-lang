(* Handler clauses for reading state, bounded above by the operation's grade.

   Run this example with the 'time-upper-bound' grading monoid, e.g.

     ./tempore --grades time-upper-bound examples/handlers/handlers_upper_bound.tpe

   Grades n: at most n time steps
     - Unit 0: no time spent, the least grade
     - Top ∞: unbounded time
     - Product: addition *)

(* Reading the state takes at most 71 ticks. *)
operation Get : unit ~> int # 71
(* Writing it takes at most 2. *)
operation Set : int ~> unit # 2

(* Correctly accepted by the typechecker: the 'Get' clause delays exactly the
   71 ticks the operation allows and then resumes. *)
let h =
  handler
  | x -> x
  | Get () k ->
      delay 71;
      continue k with 42

(* Correctly accepted by the typechecker: an upper bound only forbids taking
   more than the operation allows, so a case may take less; delaying only 10
   before resuming is fine, since 10 · eps <= 71 · eps. *)
let h_fast =
  handler
  | x -> x
  | Get () k ->
      delay 10;
      continue k with 42

(* Correctly accepted by the typechecker: 'n' is bound outside the handler,
   but an int is eternal, so the case may use it however late it runs. *)
let h_offset n =
  handler
  | x -> x
  | Get () k ->
      delay 10;
      continue k with n

(* Correctly rejected by the typechecker: 72 ticks overrun the 71 the
   continuation must be resumed within:

     Typing error: Variable `k` is unboxed with grade `72` accumulated since it
       was bound, which is not below its box grade `71`
       Note: the resource inequality `72 <= 71` does not hold
*)
(*
let h_slow =
  handler
  | x -> x
  | Get () k ->
      delay 72;
      continue k with 42
*)

(* Correctly accepted by the typechecker: never resuming gives the case
   grade 0, a sub-grade of 71 · eps for every eps, since zero is the minimum
   grade. Under a lower bound the same handler is rejected. *)
let h_abandon =
  handler
  | x -> x
  | Get () k -> 0

(* Correctly rejected by the typechecker: resuming twice unboxes 'k' a
   second time only after the first resumption has run for the
   continuation's own rigid effect eps, and |eps| <= 71 already fails
   once eps is unbounded:

     Typing error: Variable `k` is unboxed with grade `∣ε₀∣` accumulated since
       it was bound, which is not below its box grade `71`
       Note: the resource inequality `∀ε₀. ∣ε₀∣ <= 71` does not hold:
         for `ε₀ = ∞` it becomes `∞ <= 71`
   (Contrast: accepted under a lower bound.)
*)
(*
let h_twice =
  handler
  | x -> x
  | Get () k ->
      let y = continue k with 42 in
      continue k with y
*)

(* Correctly accepted by the typechecker: the local function 'f' is used
   before resuming, so only its eternal result 'z' is kept across the
   resumption. *)
let h_before =
  handler
  | x -> x
  | Get () k ->
      let f = (fun () -> 1) in
      let z = f () in
      let y = continue k with 42 in
      z + y

(* Correctly rejected by the typechecker: 'f' is not eternal, so it may not
   be used after a resumption that may take any number of ticks:

     Typing error: Variable `f` is used with grade `∣ε₀∣` accumulated since it
       was bound, but its type `unit → int` is not eternal
       Note: the resource inequality
         `∀ε₀. ∣ε₀∣ <= 0` does not hold: for `ε₀ = ∞` it becomes
         `∞ <= 0`
*)
(*
let h_after =
  handler
  | x -> x
  | Get () k ->
      let f = (fun () -> 1) in
      let y = continue k with 42 in
      f () + y
*)

(* Correctly rejected by the typechecker: a case keeps nothing but eternal
   types from outside it; letting 'g', a function, in would leak the
   continuation's arbitrary grade through it into the type of 'h_leak':

     Typing error: Variable `g` has type `[71](int → α # ε₀) → β`, which is not
       eternal, so it cannot be used in the case for `Get`: the case runs with a
       grade the handler does not fix
       Note: the resource inequality `∞ <= 0` does not hold
*)
(*
let h_leak g =
  handler
  | x -> x
  | Get () k ->
      g k;
      continue k with 42
*)

(* The run handles a 'Get' with 'h_fast', which delays only 10 of the 71
   allotted ticks before resuming with 42, so the run returns 45. *)
run
  handle
    let x = perform Get () in
    return x + 3
  with h_fast

(* The run handles a 'Get' with 'h_abandon', which never resumes, so the run
   returns 0 without ever reaching the '+ 3'. *)
run
  handle
    let x = perform Get () in
    return x + 3
  with h_abandon

(* The run handles a 'Get' with 'h_before', whose case computes 'z' before
   resuming with 42 and adds it to the result afterwards, so the run returns
   46. *)
run
  handle
    let x = perform Get () in
    return x + 3
  with h_before

(* The run handles a 'Get' with 'h_offset 39', whose case resumes with the
   captured 39, so the run returns 42. *)
run
  handle
    let x = perform Get () in
    return x + 3
  with h_offset 39
