(* Nested handlers, the outer case resuming once the inner handle completes.

   Run this example with the 'time-lower-bound' grading monoid, e.g.

     ./tempore --grades time-lower-bound examples/handlers/handlers_nested.tpe

   Grades n: at least n ticks (time steps)
     - Unit 0: no time needed
     - Top 0: no time needed; the unit is the top
     - Product: addition *)

operation Op1 : unit ~> unit # 2
operation Op2 : unit ~> unit # 3

(* Correctly accepted by the typechecker: with ε₀ the grade the outer
   continuation 'k' may have and ε₁ that of the inner 'k'', the inner case
   delays the 3 ticks of 'Op2' and resumes 'k'', so its grade 3 · ε₁ is a
   sub-grade of 3 · ε₁; the outer case resumes 'k' once the inner handle is
   done. *)
let h =
  handler
  | x -> x
  | Op1 p k ->
      let a =
        handle
          perform Op2 ();
          return ()
        with
          (handler
           | y -> y
           | Op2 q k' ->
               delay 3;
               continue k' with ())
      in
      continue k with ()

(* The run performs 'Op1', whose case performs 'Op2'; the outer case's grade
   3 · ε₀ covers the 2 ticks of 'Op1', and the run returns 7. *)
run
  handle
    perform Op1 ();
    return 7
  with h
