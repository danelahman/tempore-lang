(* A tagmentation on the Opentrons Flex: thawed reagents used within 30 minutes.

   Run this example with the 'time-interval' grading monoid, e.g.

     ./tempore --grades time-interval examples/opentrons/reagents.tpe

   Grades [n, m]: between n and m minutes, (n, m) being [n + 1, m - 1]
     - Unit [0, 0]: no time spent
     - Top [0, ∞): no bound, the widest interval
     - Product: componentwise addition *)

(* Modelled on the Opentrons Protocol Library protocols
   illumina-nextera-XT-library-prep-part1 (a tagmentation after which the
   neutralization buffer is added immediately) and 6a93a2-part2 (a mastermix
   kept at 4 °C on a temperature module).

   The protocols are in
     https://github.com/Opentrons/Protocols/tree/2f447c936b49/protocols/
       - illumina-nextera-XT-library-prep-part1
       - 6a93a2-part2

   A unit of duration is a minute. The protocol for the Flex, with the
   operations performed by the functions of 'reagents_bindings.py', is
   written by

     ./tempore --grades time-interval \
       --emit-opentrons reagents.py \
       --bind examples/opentrons/reagents_bindings.py \
       --time-unit minutes \
       --simulate \
       examples/opentrons/reagents.tpe

   and run by the Opentrons simulator, installed by 'make opentrons-deps'.
   The target opentrons-reagents-simulate of 'make' runs this command.

   A thawed reagent is a box: it may be dispensed only within 30 minutes of
   thawing. The thawing and its 30-minute window are the example's own.
   Reagents are named by strings, wrapped in the type reagent, and columns by
   numbers, of the type column. The type reagent is not eternal: a reagent
   unboxed from its window is dispensed before any further step. *)

noneternal type reagent = Reagent of string
type column = nat

(* Thawing a reagent takes five to ten minutes. *)
operation Thaw : reagent ~> [[0, 30]]reagent # [5, 10]
default Thaw (Reagent name) = delay 6; box [0, 30] (Reagent name)

(* Dispensing a reagent or the DNA into a column takes one to two minutes. *)
operation Dispense : reagent * column ~> unit # [1, 2]
default Dispense (r, column) = delay 2

operation AddDNA : column ~> unit # [1, 2]
default AddDNA column = delay 1

(* The tagmentation holds a column at 55 °C for five minutes and cools it,
   in five to seven minutes. The protocol runs its tagmentation program off
   the deck and does not state it; the program is the example's own. *)
operation Tagment : column ~> unit # [5, 7]
default Tagment column = delay 6

(* Dispenses a thawed reagent into a column after the step on the column.
   The scheme of 'after' is polymorphic in the window of the reagent, which
   must contain the running time of the step:

     ∀ α ε₀. (column → α # ε₀) → [∣ε₀∣]reagent → (column → unit # [1, 2] · ε₀) *)
let after step thawed (column : column) =
  step column;
  unbox thawed as r in
  perform Dispense (r, column)

let load (column : column) =
  perform Dispense (Reagent "tagment DNA buffer", column);
  perform AddDNA column

(* Correctly accepted by the typechecker: the tagment mix is dispensed two to
   four minutes after thawing, once the column is loaded, and the
   neutralization buffer five to seven minutes after thawing, once the
   column is tagmented. *)
let tagmentation (column : column) =
  let mix = perform Thaw (Reagent "amplicon tagment mix") in
  after load mix column;
  let neutralization = perform Thaw (Reagent "neutralize tagment buffer") in
  after (fun c -> perform Tagment c) neutralization column

(* Correctly rejected by the typechecker: the neutralization buffer is thawed
   before a tagmentation followed by a 30-minute incubation, so it would be
   dispensed 35 to 37 minutes after thawing:

     Typing error: The resource inequality `[35, 37] <= [0, 30]` does not
       hold
       Note: while matching `[[0, 30]]reagent` against `[[35, 37]]reagent`
*)
(*
let incubate (column : column) =
  perform Tagment column;
  delay 30

let tagmentation_late (column : column) =
  let neutralization = perform Thaw (Reagent "neutralize tagment buffer") in
  after incubate neutralization column
*)

(* Correctly rejected by the typechecker: the neutralization buffer is
   unboxed right after thawing and dispensed after a tagmentation followed by
   a 30-minute incubation:

     Typing error: Variable `r` is used with grade `[35, 37]` accumulated
       since it was bound, but its type `reagent` is not eternal
       Note: the resource inequality `[35, 37] <= [0, 0]` does not hold
*)
(*
let tagmentation_unboxed (column : column) =
  let neutralization = perform Thaw (Reagent "neutralize tagment buffer") in
  unbox neutralization as r in
  perform Tagment column;
  delay 30;
  perform Dispense (r, column)
*)

run tagmentation 1
