(* As the example of an enzyme-linked immunosorbent assay (ELISA), with the
   plate washed after too short an incubation with the detection antibody,
   once from its box and once by its name from before the incubation.

   Run this example with the 'time-interval' grade algebra, e.g.

     ./tempore --grades time-interval examples/opentrons/elisa_reject.tpe

   Grades [n, m]: between n and m minutes, (n, m) being [n + 1, m - 1]
     - Unit [0, 0]: no time spent
     - Top [0, ∞): no bound, the widest interval
     - Product: componentwise addition *)

noneternal type plate = Plate of string
noneternal type reagent = Reagent of string

operation Detect : plate * reagent ~> [[60, ∞)]plate ! [1, 3]
default Detect (Plate name, antibody) = delay 2; box [60, ∞) (Plate name)

operation Wash : plate ~> plate ! [2, 4]
default Wash (Plate name) = delay 3; Plate name

(* Correctly rejected by the typechecker: the plate incubates with the
   detection antibody for 30 minutes only, short of the 60 it demands:

     Typing error: Variable `incubating` is unboxed with grade `[30, 30]`
       accumulated since it was bound, which is not below its box grade
       `[60, ∞)`
       ...
       Note: the resource inequality `[30, 30] <= [60, ∞)` does not hold
*)
let early_wash (plate : plate) (antibody : reagent) =
  let incubating = perform Detect (plate, antibody) in
  delay 30;
  unbox incubating as incubated in
  perform Wash incubated

(* Correctly rejected by the typechecker: the plate is washed 30 minutes
   into the incubation by the name it had before it, and the type plate is
   not eternal:

     Typing error: Variable `plate` is used with grade `[31, 33]` accumulated
       since it was bound, but its type `plate` is not eternal
       ...
       Note: the resource inequality `[31, 33] <= [0, 0]` does not hold
*)
let early_wash_unboxed (plate : plate) (antibody : reagent) =
  let incubating = perform Detect (plate, antibody) in
  delay 30;
  perform Wash plate

run early_wash (Plate "plate") (Reagent "detection antibody")
