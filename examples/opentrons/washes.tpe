(* A bead clean-up on the Opentrons Flex: two or more ethanol washes, each with a fresh tip.

   Run this example with the 'regex-timed-rigid-interval-symbolic' grading monoid, e.g.

     ./tempore --grades regex-timed-rigid-interval-symbolic \
       examples/opentrons/washes.tpe

   Grades [L, U]: a lower bound in the coverage order and an upper bound in
   the rigid allowance order on the traces
     - Unit [{0}, {0}]: nothing demanded, only the empty trace allowed
     - Top [{0}, ∞): nothing demanded, every trace allowed
     - Product: concatenation of traces, componentwise *)

(* Modelled on the Opentrons Protocol Library protocols kapa-amp-cleanup (a
   bead clean-up with a five-minute binding, two ethanol washes and a dry time
   of two to three minutes) and nextera-flex-library-prep-post-tag-cleanup
   (magnetic washes, beads kept wet to prevent overdrying).

   The protocols are in
     https://github.com/Opentrons/Protocols/tree/2f447c936b49/protocols/
       - kapa-amp-cleanup
       - nextera-flex-library-prep-post-tag-cleanup

   A tick is a minute. The protocol for the Flex, with the operations
   performed by the functions of 'washes_bindings.py', is written by

     ./tempore --grades regex-timed-rigid-interval-symbolic \
       --emit-opentrons washes.py \
       --bind examples/opentrons/washes_bindings.py \
       --time-unit minutes \
       --simulate \
       examples/opentrons/washes.tpe

   and run by the Opentrons simulator, installed by 'make opentrons-deps'.
   The target opentrons-washes-simulate of 'make' runs this command.

   Each operation declares its running time, which the monitors of the
   protocol check against the durations of its binding function. The beads
   and the eluates are named by strings, of the types beads and eluates. *)

type beads = string
type eluates = string

(* Mixing the beads into the samples takes one to two minutes. The plate is
   moved onto and off the magnetic block in at most a minute. *)
operation AddBeads : unit ~> unit # {AddBeads} within [1, 2]
default AddBeads () = delay 2

operation MagnetOn : unit ~> unit # {MagnetOn} within [0, 1]
default MagnetOn () = delay 1

operation MagnetOff : unit ~> unit # {MagnetOff} within [0, 1]
default MagnetOff () = delay 1

(* Removing the supernatant from the beads, an ethanol wash of the beads,
   which adds and removes the ethanol, the elution of the DNA from the beads,
   which returns the eluates, and the transfer of the eluates each take one
   to two minutes; changing the tip at most one. *)
operation RemoveLiquid : beads ~> unit # {RemoveLiquid} within [1, 2]
default RemoveLiquid beads = delay 2

operation Wash : beads ~> unit # {Wash} within [1, 2]
default Wash beads = delay 1

operation ChangeTip : unit ~> unit # {ChangeTip} within [0, 1]
default ChangeTip () = delay 1

operation EluteDNA : beads ~> eluates # {EluteDNA} within [1, 2]
default EluteDNA beads = delay 1; "eluates"

operation Transfer : eluates ~> unit # {Transfer} within [1, 2]
default Transfer eluates = delay 2

(* Each of n ethanol washes is followed by a fresh tip and nothing else. *)
let rec washes (beads : beads) (n : nat) : unit # {(Wash; ChangeTip)*} =
  match n with
  | 0 -> ()
  | m + 1 ->
      perform Wash beads;
      perform ChangeTip ();
      washes beads m

(* The grade of the clean-up demands nothing and allows no removal of the
   supernatant, wash or transfer after a move off the magnet without a move
   onto it in between, every delay being a wait. The beads are boxed twice.
   The first box releases them to the removal of the supernatant after five
   to ten minutes of binding, waiting only, before the plate goes on the
   magnet; the upper bound of ten minutes is the example's own. The second
   box releases them to the elution after n + 2 washes: its lower bound
   demands at least two, a fresh tip after the first, an undisturbed air-dry
   of at least two minutes after the last and a fresh tip for the elution
   buffer; its upper bound allows every wash but the last followed by a
   fresh tip and nothing else, and the last by an air-dry of two to three
   minutes, waiting only, and the fresh tip. The eluates are boxed on the
   magnet, and released to the transfer after two to five minutes of
   settling, waiting only. *)
let cleanup (beads : beads) (n : nat)
    : unit # [{0}, {!_* & ~(_*; MagnetOff; (_ & ~MagnetOn)*;
                            (RemoveLiquid | Wash | Transfer); _*)}] =
  box {AddBeads; ![5, 10]; MagnetOn} beads as binding in
  perform AddBeads ();
  delay 7;
  perform MagnetOn ();
  unbox binding as beads in
  delay 3;
  perform RemoveLiquid beads;
  box [{Wash; ChangeTip; Wash; !2; ChangeTip},
       {(Wash; ChangeTip)*; Wash; ![2, 3]; ChangeTip}] beads as washed in
  perform Wash beads;
  perform ChangeTip ();
  washes beads n;
  perform Wash beads;
  delay 3;
  perform ChangeTip ();
  unbox washed as beads in
  perform MagnetOff ();
  let eluates = perform EluteDNA beads in
  delay 2;
  perform MagnetOn ();
  box {![2, 5]} eluates as settling in
  delay 3;
  unbox settling as eluates in
  perform Transfer eluates

(* Correctly rejected by the typechecker: the further washes share a tip.
   Under 'regex-timed-interval-symbolic' it is accepted, the tip changes of
   the upper bound being left out:

     Typing error: This function's body has grade `[{0 | Wash;
       (Wash; ChangeTip)*}, {0 | Wash; (Wash; ChangeTip)*}]`, which does not
       match its annotated grade `[{(Wash; ChangeTip)*},
       {(Wash; ChangeTip)*}]`
       Note: the effect inequality `[{0 | Wash; (Wash; ChangeTip)*},
       {0 | Wash; (Wash; ChangeTip)*}] <= [{(Wash; ChangeTip)*},
       {(Wash; ChangeTip)*}]` does not hold
       Note: the grade `[{0 | Wash; (Wash; ChangeTip)*}, {Wash}]` is below
       `[{0 | Wash; (Wash; ChangeTip)*}, {0 | Wash; (Wash; ChangeTip)*}]` but
       not below `[{(Wash; ChangeTip)*}, {(Wash; ChangeTip)*}]`
*)
(*
let rec washes_shared_tip (beads : beads) (n : nat)
    : unit # {(Wash; ChangeTip)*} =
  match n with
  | 0 -> ()
  | m + 1 ->
      perform Wash beads;
      washes_shared_tip beads m
*)

(* Correctly rejected by the typechecker: the plate is not moved back onto
   the magnet after the elution, and the eluates are taken off the magnet,
   which aspirates the beads. The box of the eluates holds; the grade of the
   function does not. Under 'regex-timed-interval-symbolic', and with `_*`
   and `[2, 5]` in place of `!_*` and `![2, 5]`, it is accepted, the
   transfer fitting in a budget delay:

     Typing error: This function's body has grade `[{MagnetOff; EluteDNA;
       !2; !3; Transfer}, {MagnetOff; EluteDNA; !2; !3; Transfer}]`, which
       does not match its annotated grade ...
*)
(*
let elute_off_magnet (beads : beads)
    : unit # [{0}, {!_* & ~(_*; MagnetOff; (_ & ~MagnetOn)*;
                            (RemoveLiquid | Wash | Transfer); _* )}] =
  perform MagnetOff ();
  let eluates = perform EluteDNA beads in
  delay 2;
  box {![2, 5]} eluates as settling in
  delay 3;
  unbox settling as eluates in
  perform Transfer eluates
*)

(* Correctly rejected by the typechecker: the residual ethanol is removed
   within the air-dry, which leaves a minute of drying. Under
   'regex-timed-interval-symbolic', and with the budgets `2` and `[2, 3]` in
   place of `!2` and `![2, 3]`, it is accepted, the removal counting towards
   the air-dry:

     Typing error: Variable `washed` is unboxed with grade `[{Wash; ChangeTip;
       (Wash; ChangeTip)*; Wash; RemoveLiquid; !1; ChangeTip}, {Wash;
       ChangeTip; (Wash; ChangeTip)*; Wash; RemoveLiquid; !1; ChangeTip}]`
       accumulated since it was bound, which is not below its box grade
       `[{Wash; ChangeTip; Wash; !2; ChangeTip}, {(Wash; ChangeTip)*; Wash;
       ![2, 3]; ChangeTip}]`
       ...
*)
(*
let cleanup_short_dry (beads : beads) (n : nat) =
  box [{Wash; ChangeTip; Wash; !2; ChangeTip},
       {(Wash; ChangeTip)*; Wash; ![2, 3]; ChangeTip}] beads as washed in
  perform Wash beads;
  perform ChangeTip ();
  washes beads n;
  perform Wash beads;
  perform RemoveLiquid beads;
  delay 1;
  perform ChangeTip ();
  unbox washed as beads in
  perform EluteDNA beads
*)

run cleanup "beads" 0
