(* Correctly rejected by the typechecker: the eluates are taken with the
   plate off the magnet, which aspirates the beads. Under
   'regex-timed-interval-symbolic', and with `_*` in place of `!_*`, it is
   accepted, the transfer fitting in a budget delay:

     Typing error: Variable `handled` is unboxed with grade `[{MagnetOff;
       EluteDNA; !5; Transfer}, {MagnetOff; EluteDNA; !5; Transfer}]`
       accumulated since it was bound, which is not below its box grade ...
*)
(*
let elute_off_magnet (beads : beads) =
