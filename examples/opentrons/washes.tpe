(* A bead clean-up on the Opentrons Flex: two or more ethanol washes, each with a fresh tip.

   Run this example with the 'regex-timed-rigid-interval-symbolic' grading monoid, e.g.

     ./tempore --grades regex-timed-rigid-interval-symbolic \
       examples/opentrons/washes.tpe

   Grades [L, U]: a lower bound in the coverage order and an upper bound in
   the rigid allowance order on the traces
     - Unit [{0}, {0}]: nothing demanded, only the empty trace allowed
     - Top [{0}, ∞): nothing demanded, every trace allowed
     - Product: concatenation of traces, componentwise *)

(* Modelled on the Opentrons Protocol Library protocols kapa-amp-cleanup (a
   bead clean-up with a five-minute binding, two ethanol washes and a dry time
   of two to three minutes) and nextera-flex-library-prep-post-tag-cleanup
   (magnetic washes, beads kept wet to prevent overdrying).

   The protocols are in
     https://github.com/Opentrons/Protocols/tree/2f447c936b49/protocols/
       - kapa-amp-cleanup
       - nextera-flex-library-prep-post-tag-cleanup

   A tick is a minute. The protocol for the Flex, with the operations
   performed by the functions of 'washes_bindings.py', is written by

     ./tempore --grades regex-timed-rigid-interval-symbolic \
       --emit-opentrons washes.py \
       --bind examples/opentrons/washes_bindings.py \
       --time-unit minutes \
       --simulate \
       examples/opentrons/washes.tpe

   and run by the Opentrons simulator, installed by 'make opentrons-deps'.
   The target opentrons-washes-simulate of 'make' runs this command.

   Each operation declares its running time, which the monitors of the
   protocol check against the durations of its binding function. The beads
   are named by a string, of the type beads. *)

type beads = string

(* Mixing the beads into the samples takes one to two minutes. The plate is
   moved onto and off the magnetic block in at most a minute. *)
operation AddBeads : unit ~> unit # {AddBeads} within [1, 2]
default AddBeads () = delay 2

operation MagnetOn : unit ~> unit # {MagnetOn} within [0, 1]
default MagnetOn () = delay 1

operation MagnetOff : unit ~> unit # {MagnetOff} within [0, 1]
default MagnetOff () = delay 1

(* Removing the supernatant, an ethanol wash, which adds and removes the
   ethanol, and the elution each take one to two minutes; changing the tip
   at most one. *)
operation RemoveLiquid : unit ~> unit # {RemoveLiquid} within [1, 2]
default RemoveLiquid () = delay 2

operation Wash : unit ~> unit # {Wash} within [1, 2]
default Wash () = delay 1

operation ChangeTip : unit ~> unit # {ChangeTip} within [0, 1]
default ChangeTip () = delay 1

operation EluteDNA : unit ~> unit # {EluteDNA} within [1, 2]
default EluteDNA () = delay 1

operation Transfer : unit ~> unit # {Transfer} within [1, 2]
default Transfer () = delay 2

(* Each of n ethanol washes is followed by a fresh tip and nothing else. *)
let rec washes (n : nat) : unit # {(Wash; ChangeTip)*} =
  match n with
  | 0 -> ()
  | m + 1 ->
      perform Wash ();
      perform ChangeTip ();
      washes m

(* Throughout the protocol, no liquid is removed with the plate off the
   magnet: no removal of the supernatant, wash or transfer follows a move
   off the magnet without a move onto it in between, and every delay is a
   wait. The beads bind the sample for five to ten minutes of waiting only
   before the plate goes on the magnet; the upper bound of ten minutes is
   the example's own. The protocol washes the beads n + 2 times. The washed
   beads may take the elution buffer after at least two ethanol washes, a
   fresh tip after the first, an undisturbed air-dry of at least two minutes
   after the last and a fresh tip for the buffer, as the lower bound demands;
   every wash but the last is followed by a fresh tip and nothing else, and
   the last by an air-dry of two to three minutes, waiting only, and the
   fresh tip, as the upper bound demands. *)
let cleanup (beads : beads) (n : nat) =
  box {!_* & ~(_*; MagnetOff; (_ & ~MagnetOn)*;
               (RemoveLiquid | Wash | Transfer); _*)} beads as handled in
  box {AddBeads; ![5, 10]; MagnetOn} beads as binding in
  perform AddBeads ();
  delay 7;
  perform MagnetOn ();
  unbox binding as beads in
  delay 3;
  perform RemoveLiquid ();
  box [{Wash; ChangeTip; Wash; !2; ChangeTip},
       {(Wash; ChangeTip)*; Wash; ![2, 3]; ChangeTip}] beads as washed in
  perform Wash ();
  perform ChangeTip ();
  washes n;
  perform Wash ();
  delay 3;
  perform ChangeTip ();
  unbox washed as beads in
  perform MagnetOff ();
  perform EluteDNA ();
  delay 2;
  perform MagnetOn ();
  delay 3;
  perform Transfer ();
  unbox handled as beads in
  ()

(* Correctly rejected by the typechecker: the beads are washed once only,
   short of the two washes the lower bound demands:

     Typing error: Variable `washed` is unboxed with grade `[{Wash; !3;
       ChangeTip}, {Wash; !3; ChangeTip}]` accumulated since it was bound,
       which is not below its box grade `[{Wash; ChangeTip; Wash; !2;
       ChangeTip}, {(Wash; ChangeTip)*; Wash; ![2, 3]; ChangeTip}]`
       Note: the resource inequality `[{Wash; !3; ChangeTip}, {Wash; !3;
       ChangeTip}] <= [{Wash; ChangeTip; Wash; !2; ChangeTip},
       {(Wash; ChangeTip)*; Wash; ![2, 3]; ChangeTip}]` does not hold
*)
