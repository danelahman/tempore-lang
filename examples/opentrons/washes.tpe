    : unit ! [{≥0},
              {((≥0 & ~MagnetOff)
                | MagnetOff;
                  (≥0 & ~(MagnetOn | RemoveLiquid | Wash | FinalWash
                          | Transfer));
                  MagnetOn)*;
               (MagnetOff;
                (≥0 & ~(MagnetOn | RemoveLiquid | Wash | FinalWash
                        | Transfer)))?}] =
