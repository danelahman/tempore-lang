(* A bead clean-up on the Opentrons Flex: two or more ethanol washes, each with a fresh tip.

   Run this example with the 'timed-regex-interval-rational' grade algebra, e.g.

     ./tempore --grades timed-regex-interval-rational \
       examples/opentrons/washes.tpe

   Grades [L, U]: a lower and an upper bound on the traces with rational
   durations, in the timed regex order: operations are matched in order, time
   spans admit the operations that fit in them, idle waits admit none, a
   literal is read by its hull on each side, and operations take positive
   time
     - Unit {skip}: the empty trace
     - Top {≥0}: every trace
     - Product: concatenation of traces, componentwise *)

(* Modelled on the Opentrons Protocol Library protocols kapa-amp-cleanup (a
   bead clean-up with a five-minute binding, two ethanol washes and a dry time
   of two to three minutes) and nextera-flex-library-prep-post-tag-cleanup
   (magnetic washes, beads kept wet to prevent overdrying).

   The protocols are in
     https://github.com/Opentrons/Protocols/tree/2f447c936b49/protocols/
       - kapa-amp-cleanup
       - nextera-flex-library-prep-post-tag-cleanup

   A tick is a minute. The protocol for the Flex, with the operations
   performed by the functions of 'washes_bindings.py', is written by

     ./tempore --grades timed-regex-interval-rational \
       --emit-opentrons washes.py \
       --bind examples/opentrons/washes_bindings.py \
       --time-unit minutes \
       --simulate \
       examples/opentrons/washes.tpe

   and run by the Opentrons simulator, installed by 'make opentrons-deps'.
   The target opentrons-washes-simulate of 'make' runs this command.

   Each operation declares its running time, which the monitors of the
   protocol check against the durations of its binding function. The beads
   are a value of the type beads, which is not eternal: each step takes the
   beads and returns them, boxed by the step where a wait or a tip change
   follows it, and the beads cross time only in such a box. *)

noneternal type beads = Beads of string

(* Mixing the beads into the samples takes one to two minutes; the beads then
   bind the samples for five to ten minutes, waiting only, before the plate
   goes on the magnet; the upper bound of ten minutes is the example's own.
   The plate is moved onto and off the magnetic block in at most a minute;
   on the magnet the beads settle for two to five minutes, waiting only,
   before a liquid is taken from them. *)
operation AddBeads : beads ~> [{idle [5, 10]}]beads ! {AddBeads} within [1, 2]
default AddBeads (Beads name) = delay 2; box {idle [5, 10]} (Beads name)

operation MagnetOn : beads ~> [{idle [2, 5]}]beads ! {MagnetOn} within (0, 1]
default MagnetOn (Beads name) = delay 1; box {idle [2, 5]} (Beads name)

operation MagnetOff : beads ~> beads ! {MagnetOff} within (0, 1]
default MagnetOff (Beads name) = delay 1; Beads name

(* Removing the supernatant from the beads, an ethanol wash of the beads,
   which adds and removes the ethanol, the elution of the DNA from the beads
   and the transfer of the eluates each take one to two minutes; changing the
   tip at most one. A wash is followed by a fresh tip and nothing else
   before the beads are taken again. The last wash leaves the beads to
   air-dry for two to three minutes, waiting only, followed by the fresh tip
   for the elution buffer. The beads release the DNA into the buffer off the
   magnet for two to five minutes, waiting only. *)
operation RemoveLiquid : beads ~> beads ! {RemoveLiquid} within [1, 2]
default RemoveLiquid (Beads name) = delay 2; Beads name

operation Wash : beads ~> [{ChangeTip}]beads ! {Wash} within [1, 2]
default Wash (Beads name) = delay 1; box {ChangeTip} (Beads name)

operation FinalWash : beads ~> [{idle [2, 3]; ChangeTip}]beads ! {FinalWash}
  within [1, 2]
default FinalWash (Beads name) =
  delay 1;
  box {idle [2, 3]; ChangeTip} (Beads name)

operation ChangeTip : unit ~> unit ! {ChangeTip} within (0, 1]
default ChangeTip () = delay 1

operation EluteDNA : beads ~> [{idle [2, 5]}]beads ! {EluteDNA} within [1, 2]
default EluteDNA (Beads name) = delay 1; box {idle [2, 5]} (Beads name)

operation Transfer : beads ~> unit ! {Transfer} within [1, 2]
default Transfer beads = delay 2

(* The washes before the last: n + 1 ethanol washes, each followed by a fresh
   tip. The grade demands at least one. *)
let rec washes (beads : beads) (n : nat)
    : beads ! {(Wash; ChangeTip)^[1, ∞)} =
  let rinsing = perform Wash beads in
  perform ChangeTip ();
  unbox rinsing as rinsed in
  match n with
  | 0 -> rinsed
  | m + 1 -> washes rinsed m

(* The grade of the clean-up demands nothing and allows no removal of the
   supernatant, wash or transfer after a move off the magnet without a move
   onto it in between. The beads are washed n + 2 times, at least twice: by
   the washes, whose grade demands at least one, and by the last wash. The
   boxes returned by the steps release the beads to the move onto the magnet
   after the binding, to the removal of the supernatant and to the transfer
   of the eluates after the settling, to the next wash after a fresh tip, to
   the elution after the air-dry and the fresh tip, and to the move onto the
   magnet after the release of the DNA. *)
let cleanup (beads : beads) (n : nat)
    : unit ! [{≥0},
              {((≥0 & ~MagnetOff)
                | MagnetOff;
                  (≥0 & ~(MagnetOn | RemoveLiquid | Wash | FinalWash
                          | Transfer));
                  MagnetOn)*;
               (MagnetOff;
                (≥0 & ~(MagnetOn | RemoveLiquid | Wash | FinalWash
                        | Transfer)))?}] =
  let binding = perform AddBeads beads in
  delay 7;
  unbox binding as bound in
  let settling = perform MagnetOn bound in
  delay 3;
  unbox settling as settled in
  let cleared = perform RemoveLiquid settled in
  let washed = washes cleared n in
  let drying = perform FinalWash washed in
  delay 3;
  perform ChangeTip ();
  unbox drying as dried in
  let released = perform MagnetOff dried in
  let eluting = perform EluteDNA released in
  delay 2;
  unbox eluting as eluted in
  let resettling = perform MagnetOn eluted in
  delay 3;
  unbox resettling as resettled in
  perform Transfer resettled

(* Correctly rejected by the typechecker: the further washes share a tip,
   where the box of each wash demands a fresh tip:

     Typing error: Variable `rinsing` is unboxed with the unit grade `{skip}`
       accumulated since it was bound, which is not below its box grade
       `{ChangeTip}`
       Note: the resource inequality `{skip} <= {ChangeTip}` does not hold
*)
(*
let rec washes_shared_tip (beads : beads) (n : nat)
    : beads ! {(Wash; ChangeTip)^[1, ∞)} =
  let rinsing = perform Wash beads in
  unbox rinsing as rinsed in
  match n with
  | 0 -> rinsed
  | m + 1 -> washes_shared_tip rinsed m
*)

(* Correctly rejected by the typechecker: the washes perform no wash for
