*)

(* Correctly rejected by the typechecker: the beads are taken out of the
   air-dry after a minute, for the removal of the residual ethanol:

     Typing error: Variable `drying` is unboxed with grade `{idle 1}`
       accumulated since it was bound, which is not below its box grade
       `{idle [2, 3]; ChangeTip}`
       ...
       Note: the resource inequality `{idle 1} <= {idle [2, 3]; ChangeTip}`
       does not hold
*)
(*
let cleanup_short_dry (washed : beads) =
  let drying = perform FinalWash washed in
  delay 1;
  unbox drying as wet in
  let cleared = perform RemoveLiquid wet in
  delay 1;
  perform ChangeTip ();
  let released = perform MagnetOff cleared in
  perform EluteDNA released
*)

run cleanup (Beads "beads") 0
