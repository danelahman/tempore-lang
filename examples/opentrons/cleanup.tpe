(* A bead clean-up on the Opentrons Flex whose steps are compound operations,
   implemented by a handler in terms of the atomic operations of the robot.

   Run this example with the 'timed-regex-interval-rational' grade algebra, e.g.

     ./tempore --grades timed-regex-interval-rational \
       examples/opentrons/cleanup.tpe

   Grades [L, U]: a lower and an upper bound on the traces with rational
   durations, in the timed regex order: operations are matched in order, time
   spans admit the operations that fit in them, idle waits admit none, a
   literal is read by its hull on each side, and operations take positive
   time
     - Unit {skip}: the empty trace
     - Top {≥0}: every trace
     - Product: concatenation of traces, componentwise *)

(* Modelled on the Opentrons Protocol Library protocols kapa-amp-cleanup (a
   bead clean-up with a five-minute binding, three minutes on the magnet, two
   ethanol washes of half a minute each, a dry time and an elution followed by
   three minutes on the magnet) and nextera-flex-library-prep-post-tag-cleanup
   (magnetic washes, beads kept wet to prevent overdrying).

   The protocols are in
     https://github.com/Opentrons/Protocols/tree/2f447c936b49/protocols/
       - kapa-amp-cleanup
       - nextera-flex-library-prep-post-tag-cleanup

   A tick is a minute. The protocol for the Flex, with the atomic operations
   performed by the functions of 'cleanup_bindings.py', is written by

     ./tempore --grades timed-regex-interval-rational \
       --emit-opentrons cleanup.py \
       --bind examples/opentrons/cleanup_bindings.py \
       --time-unit minutes \
       --simulate \
       examples/opentrons/cleanup.tpe

   and run by the Opentrons simulator, installed by 'make opentrons-deps'.
   The target opentrons-cleanup-simulate of 'make' runs this command.

   The atomic operations declare their running times and have binding
   functions; the compound operations have neither, and are performed by the
   handler 'cleanup_steps'. The beads are a value of the type beads, which is
   not eternal: the compound operations take the beads and return them,
   boxed for the wait that follows, and the beads cross time only in such a
   box. The atomic operations act on the plate. *)

noneternal type beads = Beads of string

(* The atomic operations. Mixing the beads into the samples, removing the
   supernatant or the ethanol, adding the elution buffer and transferring the
   eluates each take one to two minutes. The plate is moved onto and off the
   magnetic block, and the ethanol is added from above, in at most a
   minute. *)
operation AddBeads : unit ~> unit ! {AddBeads} within [1, 2]
default AddBeads () = delay 2

operation MagnetOn : unit ~> unit ! {MagnetOn} within (0, 1]
default MagnetOn () = delay 1

operation MagnetOff : unit ~> unit ! {MagnetOff} within (0, 1]
default MagnetOff () = delay 1

operation RemoveLiquid : unit ~> unit ! {RemoveLiquid} within [1, 2]
default RemoveLiquid () = delay 1

operation AddEthanol : unit ~> unit ! {AddEthanol} within (0, 1]
default AddEthanol () = delay 1

operation RemoveEthanol : unit ~> unit ! {RemoveEthanol} within [1, 2]
default RemoveEthanol () = delay 2

operation AddBuffer : unit ~> unit ! {AddBuffer} within [1, 2]
default AddBuffer () = delay 1

operation Transfer : unit ~> unit ! {Transfer} within [1, 2]
default Transfer () = delay 2

(* The compound operations, their running-time bounds derived from their
   grades. Binding adds the beads, lets them bind the sample for five to ten
   minutes and engages the magnet; the beads it returns settle on the magnet
   for three to five minutes. The wash removes the supernatant and washes the
   beads in exactly two ethanol washes, each of which adds the ethanol and
   removes it after a minute; the beads it returns air-dry for two to three
   minutes. The elution resuspends the beads off the magnet in the buffer for
   two to five minutes, engages the magnet and, after three to five minutes,
   transfers the eluates. The upper bounds are the example's own. *)
operation Bind : beads ~> [[3, 5]] beads ! {AddBeads; [5, 10]; MagnetOn}

operation Wash : beads ~> [[2, 3]] beads
  ! {RemoveLiquid; (AddEthanol; 1; RemoveEthanol)^2}

operation EluteDNA : beads ~> beads
  ! {MagnetOff; AddBuffer; [2, 5]; MagnetOn; [3, 5]; Transfer}

(* Correctly accepted by the typechecker: each case performs the atomic
   operations its compound operation names, in order, with waits within the
   delays of its grade, before it resumes the continuation. *)
let cleanup_steps =
  handler
  | x -> x
  | Bind (Beads name) k ->
      perform AddBeads ();
      delay 7;
      perform MagnetOn ();
      continue k with (box [3, 5] (Beads name))
  | Wash (Beads name) k ->
      perform RemoveLiquid ();
      perform AddEthanol ();
      delay 1;
      perform RemoveEthanol ();
      perform AddEthanol ();
      delay 1;
      perform RemoveEthanol ();
      continue k with (box [2, 3] (Beads name))
  | EluteDNA (Beads name) k ->
      perform MagnetOff ();
      perform AddBuffer ();
      delay 3;
      perform MagnetOn ();
      delay 4;
      perform Transfer ();
      continue k with (Beads name)

(* The protocol. The beads are washed once they have settled, and take the
   elution buffer after an air-dry of two to three minutes. *)
let cleanup (beads : beads) =
  let settling = perform Bind beads in
  delay 4;
  unbox settling as settled in
  let drying = perform Wash settled in
  delay 3;
  unbox drying as dried in
  perform EluteDNA dried

(* Correctly rejected by the typechecker: the first ethanol wash removes the
   ethanol without the minute of washing:

     Typing error: Variable `k` is unboxed with grade `{RemoveLiquid;
       AddEthanol; RemoveEthanol; AddEthanol; idle 1; RemoveEthanol}`
       accumulated since it was bound, which is not below its box grade
       `{RemoveLiquid; (AddEthanol; 1; RemoveEthanol)^2}`
       Note: the resource inequality `{RemoveLiquid; AddEthanol;
       RemoveEthanol; AddEthanol; idle 1; RemoveEthanol} <= {RemoveLiquid;
       (AddEthanol; 1; RemoveEthanol)^2}` does not hold
*)
(*
let no_wait =
  handler
  | x -> x
  | Wash (Beads name) k ->
      perform RemoveLiquid ();
      perform AddEthanol ();
      perform RemoveEthanol ();
      perform AddEthanol ();
      delay 1;
      perform RemoveEthanol ();
      continue k with (box [2, 3] (Beads name))
*)

(* Correctly rejected by the typechecker: the wash performs one ethanol wash
   in place of two:

     Typing error: Variable `k` is unboxed with grade `{RemoveLiquid;
       AddEthanol; idle 1; RemoveEthanol}` accumulated since it was bound,
       which is not below its box grade `{RemoveLiquid; (AddEthanol; 1;
       RemoveEthanol)^2}`
       Note: the resource inequality `{RemoveLiquid; AddEthanol; idle 1;
       RemoveEthanol} <= {RemoveLiquid; (AddEthanol; 1; RemoveEthanol)^2}`
       does not hold
*)
(*
let one_wash =
  handler
  | x -> x
  | Wash (Beads name) k ->
      perform RemoveLiquid ();
      perform AddEthanol ();
      delay 1;
      perform RemoveEthanol ();
      continue k with (box [2, 3] (Beads name))
*)

run handle cleanup (Beads "beads") with cleanup_steps
