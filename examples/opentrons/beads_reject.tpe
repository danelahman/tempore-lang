(* As the bead clean-up example, with the beads air-dried for too long.

   Run this example with the 'time-interval' grading monoid, e.g.

     ./tempore --grades time-interval examples/opentrons/beads_reject.tpe

   Grades [n, m]: between n and m minutes, (n, m) being [n + 1, m - 1]
     - Unit [0, 0]: no time spent
     - Top [0, ∞): no bound, the widest interval
     - Product: componentwise addition *)

operation Disengage : string ~> unit # [0, 1]
default Disengage beads = ()

operation LastEthanol : string ~> [[2, 5]]string # [1, 2]
default LastEthanol beads = delay 1; box [2, 5] beads

operation Elute : string ~> unit # [1, 2]
default Elute beads = delay 1

(* Correctly rejected by the typechecker: the elution buffer is added six to
   seven minutes after the last ethanol wash, when the beads are overdried:

     Typing error: Variable `drying` is unboxed with grade `[6, 7]`
       accumulated since it was bound, which is not below its box grade
       `[2, 5]`
       ...
       Note: the resource inequality `[6, 7] <= [2, 5]` does not hold
*)
let overdried () =
  let drying = perform LastEthanol "beads" in
  delay 6;
  perform Disengage "beads";
  unbox drying as beads in
  perform Elute beads

run overdried ()
