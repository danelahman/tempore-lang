(* A stop and read on the Opentrons Flex: a stopped plate read within 30 minutes.

   Run this example with the 'time-interval' grading monoid, e.g.

     ./tempore --grades time-interval examples/opentrons/stopread.tpe

   Grades [n, m]: between n and m minutes, (n, m) being [n + 1, m - 1]
     - Unit [0, 0]: no time spent
     - Top [0, ∞): no bound, the widest interval
     - Product: componentwise addition *)

(* Modelled on the Opentrons Protocol Library protocols 1464-3 (an ELISA
   whose substrate is stopped after 30 minutes) and
   sci-tecan-cortisol-saliva-elisa (plates read off the deck).

   The protocols are in
     https://github.com/Opentrons/Protocols/tree/2f447c936b49/protocols/
       - 1464-3
       - sci-tecan-cortisol-saliva-elisa

   A unit of duration is a minute. The protocol for the Flex, with the
   operations performed by the functions of 'stopread_bindings.py', is
   written by

     ./tempore --grades time-interval \
       --emit-opentrons stopread.py \
       --bind examples/opentrons/stopread_bindings.py \
       --time-unit minutes \
       --simulate \
       examples/opentrons/stopread.tpe

   and run by the Opentrons simulator, installed by 'make opentrons-deps'.
   The target opentrons-stopread-simulate of 'make' runs this command.

   A plate is named by a string, wrapped in the type plate. A stopped plate
   is a box, read within 30 minutes of the stop; the 30-minute window of the
   reading is the example's own. The type plate is not eternal: a plate
   unboxed from its window is read before any further step. *)

noneternal type plate = Plate of string

(* Dispensing the stop solution takes one to two minutes. *)
operation AddStop : plate ~> [[0, 30]]plate ! [1, 2]
default AddStop (Plate name) = delay 2; box [0, 30] (Plate name)

(* The operations of a plate reader with an injector for the stop solution:
   stopping a plate takes one to two minutes, and reading it one to two. *)
operation Stop : plate ~> [[0, 30]]plate ! [1, 2]
default Stop (Plate name) = delay 1; box [0, 30] (Plate name)

operation Read : plate ~> nat ! [1, 2]
default Read plate = delay 1; 0

(* Noting a simulated reading in the run log takes at most a minute. *)
operation Note : plate ~> unit ! [0, 1]
default Note plate = ()

(* Simulates the reader: the stop solution is dispensed by the pipette, whose
   boxed plate the case of Stop passes to the continuation, and a reading is
   noted, takes a minute and gives 0. *)
let simulated_reader =
  handler
  | x -> x
  | Stop plate k ->
      let stopped = perform AddStop plate in
      continue k with stopped
  | Read plate k ->
      perform Note plate;
      delay 1;
      continue k with 0

(* Correctly accepted by the typechecker: each plate is read one to two
   minutes after its stop. *)
let assay () =
  let first = perform Stop (Plate "plate 1") in
  let second = perform Stop (Plate "plate 2") in
  unbox first as first_plate in
  let a = perform Read first_plate in
  unbox second as second_plate in
  let b = perform Read second_plate in
  (a, b)

(* Correctly rejected by the typechecker: the second plate is stopped 30
   minutes after the first, so the first is read 31 to 32 minutes after its
   stop:

     Typing error: Variable `first` is unboxed with grade `[31, 32]`
       accumulated since it was bound, which is not below its box grade
       `[0, 30]`
       Note: the resource inequality `[31, 32] <= [0, 30]` does not hold
*)
(*
let assay_late () =
  let first = perform Stop (Plate "plate 1") in
  delay 30;
  let second = perform Stop (Plate "plate 2") in
  unbox first as first_plate in
  let a = perform Read first_plate in
  unbox second as second_plate in
  let b = perform Read second_plate in
  (a, b)
*)

(* Correctly rejected by the typechecker: both plates are unboxed at once,
   and the second is read after the reading of the first:

     Typing error: Variable `second_plate` is used with grade `[1, 2]`
       accumulated since it was bound, but its type `plate` is not eternal
       Note: the resource inequality `[1, 2] <= [0, 0]` does not hold
*)
(*
let assay_unboxed () =
  let first = perform Stop (Plate "plate 1") in
  let second = perform Stop (Plate "plate 2") in
  unbox first as first_plate in
  unbox second as second_plate in
  let a = perform Read first_plate in
  let b = perform Read second_plate in
  (a, b)
*)

run handle assay () with simulated_reader
