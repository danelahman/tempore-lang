(* As the bead clean-up by compound operations, with an ethanol wash that
   removes the ethanol before adding it.

   Run this example with the 'timed-regex-interval-rational-symbolic' grade algebra, e.g.

     ./tempore --grades timed-regex-interval-rational-symbolic \
       examples/opentrons/cleanup_reject.tpe

   Grades [L, U]: a lower and an upper bound on the traces with rational
   durations, in the timed regex order: operations are matched in order, time
   spans admit the operations that fit in them, idle waits admit none, a
   literal is read by its hull on each side, and operations take positive
   time
     - Unit {skip}: the empty trace
     - Top {≥0}: every trace
     - Product: concatenation of traces, componentwise *)

operation AddEthanol : unit ~> unit ! {AddEthanol} within (0, 1]
default AddEthanol () = delay 1

operation RemoveEthanol : unit ~> unit ! {RemoveEthanol} within [1, 2]
default RemoveEthanol () = delay 2

operation EthanolWash : unit ~> unit ! {AddEthanol; 1; RemoveEthanol}

(* Correctly rejected by the typechecker: the case performs the steps of the
   wash in the reverse order:

     Typing error: Variable `k` is unboxed with grade
       `{RemoveEthanol; idle 1; AddEthanol}` accumulated since it was bound,
       which is not below its box grade ...
*)
let reversed_wash =
  handler
  | x -> x
  | EthanolWash () k ->
      perform RemoveEthanol ();
      delay 1;
      perform AddEthanol ();
      continue k with ()

let two_washes () =
  perform EthanolWash ();
  perform EthanolWash ()

run handle two_washes () with reversed_wash
