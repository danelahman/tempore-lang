(* A ddPCR plate set-up on the Opentrons Flex, keeping clean tips from the test article.

   Run this example with the 'time-upper-bound-levels' grading monoid, e.g.

     ./tempore --grades time-upper-bound-levels examples/opentrons/contamination.tpe

   Grades (n, l): at most n minutes, touching nothing above level l,
   Low being clean and High contaminated
     - Unit (0, Low): no time spent, nothing contaminated touched
     - Top (∞, High): unbounded time, whatever is touched
     - Product: addition and join, componentwise *)

(* Modelled on the Opentrons Protocol Library protocol 0e525c (a ddPCR plate
   set-up with a serial dilution of a test article on a preparation plate,
   and a master mix, the dilutions and no-template water controls dispensed
   into a final plate, with filter tips).

   The protocol is in
     https://github.com/Opentrons/Protocols/tree/2f447c936b49/protocols/
       - 0e525c

   A unit of duration is a minute. The protocol for the Flex, with the
   operations performed by the functions of 'contamination_bindings.py', is
   written by

     ./tempore --grades time-upper-bound-levels --emit-opentrons contamination.py --bind examples/opentrons/contamination_bindings.py --time-unit minutes examples/opentrons/contamination.tpe

   The level of an operation is High if its tip touches the test article,
   and Low otherwise. A tip is boxed at level Low: it may enter a clean
   reagent only while nothing contaminated has been touched since it was
   picked up. Its type is not eternal, so it cannot be kept unboxed past an
   operation. The monitors of the protocol check each binding function
   against the time bound of its operation's grade. A reagent is named by a
   string, of the type reagent, and a column by its number, of the type
   column.

   The protocol is given its master mix ready; its preparation, and the
   30-minute window within which it is dispensed, are the example's own. So
   is the use of one clean tip for the buffer of every column, where the
   protocol takes a new tip for each. *)

noneternal type tip = Tip
type reagent = string
type column = nat

(* Changing the tip takes at most a minute. *)
operation ChangeTip : unit ~> unit # (1, Low)
default ChangeTip () = delay 1

(* Buffer, master mix and water are clean reagents, and dispensing one into a
   column takes at most a minute. The buffer goes to the preparation plate,
   the master mix and the water to the final plate. *)
operation AddBuffer : tip * column ~> unit # (1, Low)
default AddBuffer (t, column) = delay 1

operation AddMix : tip * column ~> unit # (1, Low)
default AddMix (t, column) = delay 1

operation AddWater : tip * column ~> unit # (1, Low)
default AddWater (t, column) = delay 1

(* The master mix takes at most five minutes to prepare, and must be
   dispensed within 30 minutes. *)
operation PrepareMix : unit ~> [(30, High)]reagent # (5, Low)
default PrepareMix () = delay 4; box (30, High) "master mix"

(* Adding the test article, diluting it from one column of the preparation
   plate into the next, and transferring a dilution from a column of the
   preparation plate into a column of the final plate touch the test
   article. *)
operation AddArticle : tip * column ~> unit # (1, High)
default AddArticle (t, column) = delay 1

operation Dilute : tip * (column * column) ~> unit # (2, High)
default Dilute (t, columns) = delay 2

operation AddDilution : tip * (column * column) ~> unit # (1, High)
default AddDilution (t, columns) = delay 1

let new_tip () =
  perform ChangeTip ();
  box (∞, Low) Tip

(* Correctly accepted by the typechecker: one clean tip dispenses the buffer,
   each step of the dilution series has a new tip, a new clean tip dispenses
   the master mix into the final plate, each dilution is transferred into it
   with a new tip, and the water control, added last, has a new clean one. *)
let ddpcr () =
  let mix = perform PrepareMix () in
  let clean = new_tip () in
  unbox clean as t in
  perform AddBuffer (t, 2);
  unbox clean as t in
  perform AddBuffer (t, 3);
  let article = new_tip () in
  unbox article as t in
  perform AddArticle (t, 1);
  let step = new_tip () in
  unbox step as t in
  perform Dilute (t, (1, 2));
  let step = new_tip () in
  unbox step as t in
  perform Dilute (t, (2, 3));
  unbox mix as m in
  let clean = new_tip () in
  unbox clean as t in
  perform AddMix (t, 1);
  unbox clean as t in
  perform AddMix (t, 2);
  unbox clean as t in
  perform AddMix (t, 3);
  unbox clean as t in
  perform AddMix (t, 4);
  let sample = new_tip () in
  unbox sample as t in
  perform AddDilution (t, (1, 1));
  let sample = new_tip () in
  unbox sample as t in
  perform AddDilution (t, (2, 2));
  let sample = new_tip () in
  unbox sample as t in
  perform AddDilution (t, (3, 3));
  let water = new_tip () in
  unbox water as t in
  perform AddWater (t, 4)

(* Correctly rejected by the typechecker: the tip that added the test article
   is used again for the water control:

     Typing error: Variable `tip` is unboxed with grade `(1, High)` accumulated
       since it was bound, which is not below its box grade `(∞, Low)`
       Note: the resource inequality `(1, High) <= (∞, Low)` does not hold
*)
(*
let ddpcr_shared_tip () =
  let tip = new_tip () in
  unbox tip as t in
  perform AddArticle (t, 1);
  unbox tip as t in
  perform AddWater (t, 4)
*)

run ddpcr ()
