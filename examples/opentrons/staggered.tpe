(* A staggered fixation on the Opentrons Flex: each column fixed for 12 to 20 minutes.

   Run this example with the 'time-interval' grade algebra, e.g.

     ./tempore --grades time-interval examples/opentrons/staggered.tpe

   Grades [n, m]: between n and m minutes, (n, m) being [n + 1, m - 1]
     - Unit [0, 0]: no time spent
     - Top [0, ∞): no bound, the widest interval
     - Product: componentwise addition *)

(* Modelled on the Opentrons Protocol Library protocol 00a214-protocol-5 (PFA
   fixation of at least 12 minutes, the plates fixed one after another).

   The protocol is in
     https://github.com/Opentrons/Protocols/tree/2f447c936b49/protocols/
       - 00a214-protocol-5

   A unit of duration is a minute. The protocol for the Flex, with the
   operations performed by the functions of 'staggered_bindings.py', is
   written by

     ./tempore --grades time-interval \
       --emit-opentrons staggered.py \
       --bind examples/opentrons/staggered_bindings.py \
       --time-unit minutes \
       --simulate \
       examples/opentrons/staggered.tpe

   and run by the Opentrons simulator, installed by 'make opentrons-deps'.
   The target opentrons-staggered-simulate of 'make' runs this command.

   The columns of a plate of cells are fixed in turn, at staggered times:
   while one column fixes, the column before it is rinsed and the column
   after it starts fixing. The staggering of the columns and the upper bound
   of 20 minutes are the example's own. A column of the plate is named by
   its number. A column with fixative is a value of the type column, which
   is not eternal: it is returned only by the addition of the fixative, in a
   box, and crosses time only in that box. *)

noneternal type column = Column of nat

(* Adding the fixative to the column of a number takes one to two minutes;
   the column is rinsed 12 to 20 minutes later. *)
operation Fix : nat ~> [[12, 20]]column ! [1, 2]
default Fix number = delay 1; box [12, 20] (Column number)

(* Rinsing a column takes one to two minutes. *)
operation Rinse : column ~> unit ! [1, 2]
default Rinse column = delay 2

(* Rinses the column [fixed] and starts the next column while the column in
   [fixing] fixes. The pair of the boxed column and the column to rinse is
   passed to the recursive call at the moment the box is created, and the
   box is opened when its column is rinsed. *)
let rec stagger (numbers : nat list) ((fixing : [[12, 20]]column), (fixed : column)) : unit ! [0, ∞) =
  perform Rinse fixed;
  match numbers with
  | [] -> delay 14; unbox fixing as last in perform Rinse last
  | number :: rest ->
      delay 13;
      let started = perform Fix number in
      unbox fixing as previous in
      stagger rest (started, previous)

(* Correctly accepted by the typechecker: each column is rinsed 15 to 17
   minutes after its fixative was added. *)
let fixation (numbers : nat list) =
  match numbers with
  | [] -> ()
  | first :: rest -> (
      let fixing = perform Fix first in
      match rest with
      | [] -> delay 15; unbox fixing as fixed in perform Rinse fixed
      | second :: remaining ->
          delay 14;
          let started = perform Fix second in
          unbox fixing as fixed in
          stagger remaining (started, fixed))

(* Correctly rejected by the typechecker: the next column is started five
   minutes after the rinse instead of 13, so a column is rinsed seven to
   nine minutes after its fixative was added:

     Typing error: Variable `fixing` is unboxed with grade `[7, 9]`
       accumulated since it was bound, which is not below its box grade
       `[12, 20]`
       Note: the resource inequality `[7, 9] <= [12, 20]` does not hold
*)
(*
let rec stagger_early (numbers : nat list) ((fixing : [[12, 20]]column), (fixed : column)) : unit ! [0, ∞) =
  perform Rinse fixed;
  match numbers with
  | [] -> delay 14; unbox fixing as last in perform Rinse last
  | number :: rest ->
      delay 5;
      let started = perform Fix number in
      unbox fixing as previous in
      stagger_early rest (started, previous)
*)

run fixation [1; 2; 3; 4]
