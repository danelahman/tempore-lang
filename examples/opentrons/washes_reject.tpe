(* As the bead clean-up example, with the further ethanol washes sharing a tip.

   Run this example with the 'regex-timed-rigid-interval-rational-symbolic' grading monoid, e.g.

     ./tempore --grades regex-timed-rigid-interval-rational-symbolic \
       examples/opentrons/washes_reject.tpe

   Grades [L, U]: a lower and an upper bound on the traces with rational
   durations, in the rigid order: operations are matched in order, budgets
   admit operations within their time, strict waits `!` admit none, a
   literal is read by its hull on each side, and operations take positive
   time
     - Unit {0}: the empty trace
     - Top {≥0}: every trace
     - Product: concatenation of traces, componentwise *)

type beads = string

operation Wash : beads ~> unit # {Wash} within [1, 2]
default Wash beads = delay 1

operation ChangeTip : unit ~> unit # {ChangeTip} within (0, 1]
default ChangeTip () = delay 1

(* Correctly rejected by the typechecker: the further washes share a tip,
   where the grade of the recursion demands a fresh tip after each:

     Typing error: This function's body has grade `{(Wash; …)?}`, which
       does not match its annotated grade `{(Wash; ChangeTip)*}`
       ...
*)
let rec washes_shared_tip (beads : beads) (n : nat)
    : unit # {(Wash; ChangeTip)*} =
  match n with
  | 0 -> ()
  | m + 1 ->
      perform Wash beads;
      washes_shared_tip beads m

run washes_shared_tip "beads" 2
