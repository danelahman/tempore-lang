(* As the bead clean-up example, with the further ethanol washes sharing a
   tip, and the residual ethanol removed from the beads by their name from
   before the last wash.

   Run this example with the 'timed-regex-interval-rational' grade algebra, e.g.

     ./tempore --grades timed-regex-interval-rational \
       examples/opentrons/washes_reject.tpe

   Grades [L, U]: a lower and an upper bound on the traces with rational
   durations, in the timed regex order: operations are matched in order, time
   spans admit the operations that fit in them, idle waits admit none, a
   literal is read by its hull on each side, and operations take positive
   time
     - Unit {skip}: the empty trace
     - Top {≥0}: every trace
     - Product: concatenation of traces, componentwise *)

noneternal type beads = Beads of string

operation MagnetOff : beads ~> beads ! {MagnetOff} within (0, 1]
default MagnetOff (Beads name) = delay 1; Beads name

operation RemoveLiquid : beads ~> beads ! {RemoveLiquid} within [1, 2]
default RemoveLiquid (Beads name) = delay 2; Beads name

operation Wash : beads ~> [{ChangeTip}]beads ! {Wash} within [1, 2]
default Wash (Beads name) = delay 1; box {ChangeTip} (Beads name)

operation FinalWash : beads ~> [{idle [2, 3]; ChangeTip}]beads ! {FinalWash}
  within [1, 2]
default FinalWash (Beads name) =
  delay 1;
  box {idle [2, 3]; ChangeTip} (Beads name)

operation ChangeTip : unit ~> unit ! {ChangeTip} within (0, 1]
default ChangeTip () = delay 1

operation EluteDNA : beads ~> [{idle [2, 5]}]beads ! {EluteDNA} within [1, 2]
default EluteDNA (Beads name) = delay 1; box {idle [2, 5]} (Beads name)

(* Correctly rejected by the typechecker: the further washes share a tip,
   where the box of each wash demands a fresh tip:

     Typing error: Variable `rinsing` is unboxed with the unit grade `{skip}`
       accumulated since it was bound, which is not below its box grade
       `{ChangeTip}`
       ...
*)
let rec washes_shared_tip (beads : beads) (n : nat)
    : beads ! {(Wash; ChangeTip)^[1, ∞)} =
  let rinsing = perform Wash beads in
  unbox rinsing as rinsed in
  match n with
  | 0 -> rinsed
  | m + 1 -> washes_shared_tip rinsed m

(* Correctly rejected by the typechecker: the residual ethanol is removed
   within the air-dry from the beads by the name they had before the last
   wash, and the type beads is not eternal:

     Typing error: Variable `washed` is used with grade `{FinalWash}`
       accumulated since it was bound, but its type `beads` is not eternal
       ...
       Note: the resource inequality `{FinalWash} <= {skip}` does not hold
*)
let cleanup_stale_beads (washed : beads) =
  let drying = perform FinalWash washed in
  let cleared = perform RemoveLiquid washed in
  delay 1;
  perform ChangeTip ();
  let released = perform MagnetOff cleared in
  perform EluteDNA released

run washes_shared_tip (Beads "beads") 2
