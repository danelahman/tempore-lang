(* As the bead purification example, with overdried beads, the generous end
   of several windows, and one ethanol wash in place of two.

   Run this example with the 'regex-timed-interval-symbolic' grading monoid, e.g.

     ./tempore --grades regex-timed-interval-symbolic \
       examples/opentrons/purification_reject.tpe

   Grades [L, U]: a lower and upper regular-language bound on the traces
     - Unit [{0}, {0}]: nothing demanded, only the empty trace allowed
     - Top [{0}, ∞): nothing demanded, every trace allowed
     - Product: concatenation of traces, componentwise *)

type sample = string
type beads = string

operation AddBeads : sample ~> beads # {AddBeads} within [1, 2]
default AddBeads samples = delay 1; "beads"

operation MagnetOn : unit ~> unit # {MagnetOn} within [0, 1]
default MagnetOn () = delay 1

operation MagnetOff : unit ~> unit # {MagnetOff} within [0, 1]
default MagnetOff () = delay 1

operation RemoveSupernatant : beads ~> unit # {RemoveSupernatant}
  within [1, 2]
default RemoveSupernatant beads = delay 1

operation AddEthanol : unit ~> unit # {AddEthanol} within [0, 1]
default AddEthanol () = delay 1

operation RemoveEthanol : unit ~> unit # {RemoveEthanol} within [1, 2]
default RemoveEthanol () = delay 1

operation RemoveResidualEthanol : beads ~> unit # {RemoveResidualEthanol}
  within [0, 1]
default RemoveResidualEthanol beads = delay 1

operation EluteDNA : beads ~> unit # {EluteDNA} within [1, 2]
default EluteDNA beads = delay 1

operation Transfer : beads * sample ~> unit # {Transfer} within [1, 2]
default Transfer (beads, samples) = delay 1

let bind (samples : sample) =
  let beads = perform AddBeads samples in
  box [5, 10] beads

let separate (binding : [[5, 10]]beads) =
  delay 5;
  unbox binding as beads in
  perform MagnetOn ();
  box [3, 5] beads

let clear (settling : [[3, 5]]beads) =
  delay 3;
  unbox settling as beads in
  perform RemoveSupernatant beads;
  box {AddEthanol; [1, 2]} beads

let wash (soaking : [{AddEthanol; [1, 2]}]beads) =
  perform AddEthanol ();
  delay 1;
  unbox soaking as beads in
  perform RemoveEthanol ();
  box {AddEthanol; [1, 2]; RemoveEthanol} beads

let final_wash (rinsing : [{AddEthanol; [1, 2]; RemoveEthanol}]beads) =
  perform AddEthanol ();
  delay 1;
  perform RemoveEthanol ();
  unbox rinsing as beads in
  perform RemoveResidualEthanol beads;
  box {[3, 5]; MagnetOff} beads

let elute (drying : [{[3, 5]; MagnetOff}]beads) =
  delay 3;
  perform MagnetOff ();
  unbox drying as beads in
  perform EluteDNA beads;
  box {[2, 5]; MagnetOn; [2, 5]} beads

let collect (eluting : [{[2, 5]; MagnetOn; [2, 5]}]beads) =
  delay 2;
  perform MagnetOn ();
  delay 2;
  unbox eluting as beads in
  beads

(* Correctly rejected by the typechecker: the beads air-dry for eight
   minutes, and are overdried:

     Typing error: Variable `drying` is unboxed with grade
       `[{8; MagnetOff}, {8; MagnetOff}]` accumulated since it was bound,
       which is not below its box grade ...
*)
let elute_overdried (drying : [{[3, 5]; MagnetOff}]beads) =
  delay 8;
  perform MagnetOff ();
  unbox drying as beads in
  perform EluteDNA beads

(* Correctly rejected by the typechecker: the binding, the settling on the
   magnet and the air-dry each take the upper end of their windows, which
   their boxes accept, but the eluates reach the cold block up to 40 minutes
   after the beads were added:

     Typing error: Variable `warm` is unboxed with grade ... accumulated
       since it was bound, which is not below its box grade `[{0}, {35}]`
*)
let separate_long (binding : [[5, 10]]beads) =
  delay 10;
  unbox binding as beads in
  perform MagnetOn ();
  box [3, 5] beads

let clear_long (settling : [[3, 5]]beads) =
  delay 5;
  unbox settling as beads in
  perform RemoveSupernatant beads;
  box {AddEthanol; [1, 2]} beads

let elute_long (drying : [{[3, 5]; MagnetOff}]beads) =
  delay 5;
  perform MagnetOff ();
  unbox drying as beads in
  perform EluteDNA beads;
  box {[2, 5]; MagnetOn; [2, 5]} beads

let purification_generous (samples : sample) =
  let binding = bind samples in
  box [0, 35] samples as warm in
  let beads =
    collect
      (elute_long (final_wash (wash (clear_long (separate_long binding)))))
  in
  unbox warm as samples in
  perform Transfer (beads, samples)

(* Correctly rejected by the typechecker: the beads are washed once, and the
   final wash finds them in the box of the first wash, which does not allow
   for the removal of its ethanol before the box is opened:

     Typing error: The resource inequality
       `[{AddEthanol; 1; (0 | 1); RemoveEthanol}, ...] <=
       [{AddEthanol; 1; (0 | 1)}, {AddEthanol; 1; (0 | 1)}]` does not hold
*)
let purification_one_wash (samples : sample) =
  let binding = bind samples in
  box [0, 35] samples as warm in
  let beads = collect (elute (final_wash (clear (separate binding)))) in
  unbox warm as samples in
  perform Transfer (beads, samples)

run purification_generous "samples"
