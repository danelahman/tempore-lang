(* As the bead purification example, with the generous end of several
   windows, one ethanol wash in place of two, a soak off the magnet, and a
   token kept unboxed across the steps.

   Run this example with the 'timed-regex-interval-rational' grade algebra, e.g.

     ./tempore --grades timed-regex-interval-rational \
       examples/opentrons/purification_reject.tpe

   Grades [L, U]: a lower and an upper bound on the traces with rational
   durations, in the timed regex order: operations are matched in order, time
   spans admit the operations that fit in them, idle waits admit none, a
   literal is read by its hull on each side, and operations take positive
   time
     - Unit {skip}: the empty trace
     - Top {≥0}: every trace
     - Product: concatenation of traces, componentwise *)

type sample = string
type beads = string

noneternal type token = Token

operation TakeSamples : unit ~> sample * [[0, 40]]token ! {TakeSamples}
  within (0, 1]
default TakeSamples () =
  delay 1/2;
  box [0, 40] Token as tok in
  ("samples", tok)

operation AddBeads : sample ~> beads ! {AddBeads} within [1, 2]
default AddBeads samples = delay 3/2; "beads"

operation MagnetOn : unit ~> unit ! {MagnetOn} within (0, 1]
default MagnetOn () = delay 1/2

operation MagnetOff : unit ~> unit ! {MagnetOff} within (0, 1]
default MagnetOff () = delay 1/2

operation RemoveSupernatant : unit ~> unit ! {RemoveSupernatant}
  within [1, 2]
default RemoveSupernatant () = delay 3/2

operation AddEthanol : unit ~> unit ! {AddEthanol} within (0, 1]
default AddEthanol () = delay 3/4

operation RemoveEthanol : unit ~> unit ! {RemoveEthanol} within [1, 2]
default RemoveEthanol () = delay 3/2

operation RemoveResidualEthanol : unit ~> unit ! {RemoveResidualEthanol}
  within (0, 1]
default RemoveResidualEthanol () = delay 3/4

operation EluteDNA : unit ~> unit ! {EluteDNA} within [1, 2]
default EluteDNA () = delay 3/2

operation Transfer : token ~> unit ! {Transfer} within [1, 2]
default Transfer valid = delay 3/2

operation AddMasterMix : beads ~> unit ! {AddMasterMix} within [1, 2]
default AddMasterMix eluates = delay 3/2

let bind (samples : sample) =
  let beads = perform AddBeads samples in
  box [5, 10] beads

let separate (binding : [[5, 10]]beads) =
  delay 15/2;
  unbox binding as beads in
  perform MagnetOn ();
  box [3, 5] beads

let clear (settling : [[3, 5]]beads) =
  delay 4;
  unbox settling as beads in
  perform RemoveSupernatant ();
  box {AddEthanol; idle [1/2, 3/2]} beads

let wash (soaking : [{AddEthanol; idle [1/2, 3/2]}]beads) =
  perform AddEthanol ();
  delay 1;
  unbox soaking as beads in
  perform RemoveEthanol ();
  box {AddEthanol; idle [1/2, 3/2]; RemoveEthanol} beads

let final_wash (rinsing : [{AddEthanol; idle [1/2, 3/2]; RemoveEthanol}]beads) =
  perform AddEthanol ();
  delay 3/4;
  perform RemoveEthanol ();
  unbox rinsing as beads in
  perform RemoveResidualEthanol ();
  box {[3, 5]; MagnetOff} beads

let elute (drying : [{[3, 5]; MagnetOff}]beads) =
  delay 7/2;
  perform MagnetOff ();
  unbox drying as beads in
  perform EluteDNA ();
  box {[2, 5]; MagnetOn; [2, 5]} beads

let collect (eluting : [{[2, 5]; MagnetOn; [2, 5]}]beads) =
  delay 3;
  perform MagnetOn ();
  delay 5/2;
  unbox eluting as eluates in
  box {Transfer} (fun () -> box [2, 5] eluates)

(* Correctly rejected by the typechecker: the binding, the settling on the
   magnet and the air-dry each take the upper end of their windows, which
   their boxes accept, but the eluates reach the cold block up to 43.25
   minutes after the samples are taken out of the cold:

     Typing error: Variable `tok` is unboxed with grade ... accumulated
       since it was bound, which is not below its box grade `{[0, 40]}`
*)
let separate_long (binding : [[5, 10]]beads) =
  delay 10;
  unbox binding as beads in
  perform MagnetOn ();
  box [3, 5] beads

let clear_long (settling : [[3, 5]]beads) =
  delay 5;
  unbox settling as beads in
  perform RemoveSupernatant ();
  box {AddEthanol; idle [1/2, 3/2]} beads

let elute_long (drying : [{[3, 5]; MagnetOff}]beads) =
  delay 5;
  perform MagnetOff ();
  unbox drying as beads in
  perform EluteDNA ();
  box {[2, 5]; MagnetOn; [2, 5]} beads

let purification_generous () =
  let (samples, tok) = perform TakeSamples () in
  let binding = bind samples in
  let collected =
    collect
      (elute_long (final_wash (wash (clear_long (separate_long binding)))))
  in
  unbox tok as valid in
  perform Transfer valid;
  unbox collected as cool in
  let cooling = cool () in
  delay 7/2;
  unbox cooling as eluates in
  perform AddMasterMix eluates

(* Correctly rejected by the typechecker: the beads are washed once, and the
   final wash finds them in the box of the first wash, which does not allow
   for the removal of its ethanol before the box is opened:

     Typing error: The resource inequality
       `{AddEthanol; idle [0.5, 1.5]; RemoveEthanol} <=
       {AddEthanol; idle [0.5, 1.5]}` does not hold
*)
let purification_one_wash () =
  let (samples, tok) = perform TakeSamples () in
  let binding = bind samples in
  let collected = collect (elute (final_wash (clear (separate binding)))) in
  unbox tok as valid in
  perform Transfer valid;
  unbox collected as cool in
  let cooling = cool () in
  delay 7/2;
  unbox cooling as eluates in
  perform AddMasterMix eluates

(* Correctly rejected by the typechecker: the plate is moved off the magnet
   during the first soak, and the ethanol is removed off the magnet:

     Typing error: Variable `soaking` is unboxed with grade `{AddEthanol;
       MagnetOff; idle 0.5}` accumulated since it was bound, which is not below
       its box grade ...
*)
let wash_off_magnet (soaking : [{AddEthanol; idle [1/2, 3/2]}]beads) =
  perform AddEthanol ();
  perform MagnetOff ();
  delay 1/2;
  unbox soaking as beads in
  perform RemoveEthanol ();
  box {AddEthanol; idle [1/2, 3/2]; RemoveEthanol} beads

(* Correctly rejected by the typechecker: the token is unboxed when the
   samples are taken out of the cold and kept unboxed across the steps:

     Typing error: Variable `valid` is used with grade `{AddBeads; idle 7.5;
       MagnetOn; ...; MagnetOn; idle 2.5}` accumulated since it was bound,
       but its type `token` is not eternal
*)
let purification_stale_token () =
  let (samples, tok) = perform TakeSamples () in
  unbox tok as valid in
  let binding = bind samples in
  let collected =
    collect (elute (final_wash (wash (clear (separate binding)))))
  in
  perform Transfer valid;
  unbox collected as cool in
  let cooling = cool () in
  delay 7/2;
  unbox cooling as eluates in
  perform AddMasterMix eluates

run purification_generous ()
