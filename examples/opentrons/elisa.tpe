(* An enzyme-linked immunosorbent assay (ELISA) on the Opentrons Flex:
   incubation, dilution and timed development.

   Run this example with the 'time-interval' grading monoid, e.g.

     ./tempore --grades time-interval examples/opentrons/elisa.tpe

   Grades [n, m]: between n and m minutes, (n, m) being [n + 1, m - 1]
     - Unit [0, 0]: no time spent
     - Top [0, ∞): no bound, the widest interval
     - Product: componentwise addition *)

(* Modelled on the Opentrons Protocol Library protocols 0fd3dd (an ELISA on a
   pre-coated plate, with three washes after the samples, a 60-minute
   incubation of the detection antibody, one wash after it and a 15-minute
   development) and 00a214-protocol-5 (a stated minimum incubation).

   The protocols are in
     https://github.com/Opentrons/Protocols/tree/2f447c936b49/protocols/
       - 0fd3dd
       - 00a214-protocol-5

   A unit of duration is a minute. The protocol for the Flex, with the
   operations performed by the functions of 'elisa_bindings.py', is written by

     ./tempore --grades time-interval \
       --emit-opentrons elisa.py \
       --bind examples/opentrons/elisa_bindings.py \
       --time-unit minutes \
       --simulate \
       examples/opentrons/elisa.tpe

   and run by the Opentrons simulator, installed by 'make opentrons-deps'.
   The target opentrons-elisa-simulate of 'make' runs this command.

   The grade of an operation is the interval of its running times, which the
   monitors of the protocol check against the durations of its binding
   function. A plate is named by a string, of the type plate, and the
   antibody by a string wrapped in the type reagent. A developing plate is
   of the type developed_plate. The types reagent and developed_plate are
   not eternal: a value unboxed from its window is used before any further
   step. The plate is pre-coated. The dilution of the detection antibody
   and its 20-minute window, the 20-minute upper bound of the development and
   the reading of the plate are the example's own. *)

type plate = string
noneternal type reagent = Reagent of string
noneternal type developed_plate = Developed of plate

(* Adding the samples to the plate takes one to three minutes. *)
operation AddSample : plate ~> plate ! [1, 3]
default AddSample plate = delay 2; plate

(* A wash of the plate takes two to four minutes. *)
operation Wash : plate ~> plate ! [2, 4]
default Wash plate = delay 3; plate

(* Diluting the detection antibody takes one to two minutes; the dilution must
   be used within 20 minutes. *)
operation Dilute : unit ~> [[0, 20]]reagent ! [1, 2]
default Dilute () = delay 1; box [0, 20] (Reagent "detection antibody")

(* Adding the detection antibody to the plate takes one to three minutes. The
   plate may be washed once it has incubated for at least 60 minutes. *)
operation Detect : plate * reagent ~> [[60, ∞)]plate ! [1, 3]
default Detect (plate, antibody) = delay 2; box [60, ∞) plate

(* The substrate develops the plate, which must be stopped between 15 and 20
   minutes later. *)
operation Develop : plate ~> [[15, 20]]developed_plate ! [1, 2]
default Develop plate = delay 1; box [15, 20] (Developed plate)

(* Stopping takes at most a minute, and reading the absorbances one to two. *)
operation Stop : developed_plate ~> plate ! [0, 1]
default Stop (Developed plate) = plate

operation Read : plate ~> nat ! [1, 2]
default Read plate = delay 2; 0

let wash3 (plate : plate) : plate ! [6, 12] =
  let plate = perform Wash plate in
  let plate = perform Wash plate in
  perform Wash plate

(* Correctly accepted by the typechecker: the antibody is used three washes,
   six to 12 minutes, after its dilution; the plate incubates with it for 65
   minutes, beyond the 60 it demands, before it is washed; and the development
   is stopped after the 17 minutes of the delay. *)
let elisa (plate : plate) =
  let plate = perform AddSample plate in
  let antibody = perform Dilute () in
  let plate = wash3 plate in
  unbox antibody as detection in
  let incubating = perform Detect (plate, detection) in
  delay 65;
  unbox incubating as incubated in
  let washed = perform Wash incubated in
  let developing = perform Develop washed in
  delay 17;
  unbox developing as developed in
  let stopped = perform Stop developed in
  perform Read stopped

(* Correctly rejected by the typechecker: the plate is washed after an
   incubation of 30 minutes with the detection antibody, short of the 60 it
   demands:

     Typing error: Variable `incubating` is unboxed with grade `[30, 30]`
       accumulated since it was bound, which is not below its box grade
       `[60, ∞)`
       Note: the resource inequality `[30, 30] <= [60, ∞)` does not hold
*)
(*
let elisa_early (plate : plate) (antibody : reagent) =
  let incubating = perform Detect (plate, antibody) in
  delay 30;
  unbox incubating as incubated in
  perform Wash incubated
*)

(* Correctly rejected by the typechecker: the developing plate is unboxed
   after 17 minutes and stopped five minutes later, 22 minutes after the
   development:

     Typing error: Variable `developed` is used with grade `[5, 5]`
       accumulated since it was bound, but its type `developed_plate` is not
       eternal
       Note: the resource inequality `[5, 5] <= [0, 0]` does not hold
*)
(*
let elisa_overdeveloped (washed : plate) =
  let developing = perform Develop washed in
  delay 17;
  unbox developing as developed in
  delay 5;
  perform Stop developed
*)

run elisa "plate"
