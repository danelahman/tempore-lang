(* An ELISA on the Opentrons Flex: incubation, dilution and timed development.

   Run this example with the 'time-interval' grading monoid, e.g.

     ./tempore --grades time-interval examples/opentrons/elisa.tpe

   Grades [n, m]: between n and m minutes, (n, m) being [n + 1, m - 1]
     - Unit [0, 0]: no time spent
     - Top [0, ∞): no bound, the widest interval
     - Product: componentwise addition *)

(* Modelled on the Opentrons Protocol Library protocols 0fd3dd (an ELISA with
   timed incubations and three washes), 00a214-protocol-5 (a stated minimum
   incubation) and illumina-nextera-XT-library-prep-part1 (a reagent to be
   used promptly once prepared).

   A unit of duration is a minute. The protocol for the Flex, with the
   operations performed by the functions of 'elisa_bindings.py', is written by

     ./tempore --grades time-interval --emit-opentrons elisa.py
       --bind examples/opentrons/elisa_bindings.py --time-unit minutes
       examples/opentrons/elisa.tpe

   The grade of an operation is the interval of its running times, which the
   monitors of the protocol check against the durations of its binding
   function. A plate is named by a string. *)

(* Coating dispenses the capture antibody into the plate in one to three
   minutes. The coated plate may be washed once it has incubated for at least
   60 minutes. *)
operation Coat : string ~> [[60, ∞)]string # [1, 3]
default Coat plate = delay 2; box [60, ∞) plate

(* A wash of the plate takes two to four minutes. *)
operation Wash : string ~> string # [2, 4]
default Wash plate = delay 3; plate

(* Diluting the detection antibody takes one to two minutes; the dilution must
   be used within 20 minutes. *)
operation Dilute : unit ~> [[0, 20]]string # [1, 2]
default Dilute () = delay 1; box [0, 20] "detection antibody"

(* Adding the detection antibody to the plate takes one to three minutes. *)
operation Detect : string * string ~> string # [1, 3]
default Detect (plate, antibody) = delay 2; plate

(* The substrate develops the plate, which must be stopped between 15 and 20
   minutes later. *)
operation Develop : string ~> [[15, 20]]string # [1, 2]
default Develop plate = delay 1; box [15, 20] plate

(* Stopping takes at most a minute, and reading the absorbances one to two. *)
operation Stop : string ~> string # [0, 1]
default Stop plate = plate

operation Read : string ~> nat # [1, 2]
default Read plate = delay 1; 0

let wash3 plate =
  let plate = perform Wash plate in
  let plate = perform Wash plate in
  perform Wash plate

(* Correctly accepted by the typechecker: the coated plate incubates for 60
   minutes before it is washed; the antibody is used three washes, six to 12
   minutes, after its dilution; and the development is stopped after the 15
   minutes of the delay. *)
let elisa () =
  let coated = perform Coat "plate" in
  delay 60;
  unbox coated as plate in
  let antibody = perform Dilute () in
  let plate = wash3 plate in
  unbox antibody as detection in
  let plate = perform Detect (plate, detection) in
  delay 60;
  let plate = wash3 plate in
  let developing = perform Develop plate in
  delay 15;
  unbox developing as plate in
  let plate = perform Stop plate in
  perform Read plate

run elisa ()
