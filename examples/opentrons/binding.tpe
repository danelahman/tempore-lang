(* A bead binding on the Opentrons Flex: the beads resuspended every 2 to 5 minutes.

   Run this example with the 'event-separation' grading monoid, e.g.

     ./tempore --grades event-separation examples/opentrons/binding.tpe

   Grades (X, lead, gaps, tail): the times before the first X, between the
   starts of consecutive Xs and from the start of the last X to the end
     - Unit 0: no operation, no time spent
     - Top ⊤: any times before, between and after the operations
     - Product: (a, G, b) · (a', G', b') = (a, G ∪ G' ∪ {b + a'}, b') *)

(* A unit of duration is a minute. The protocol for the Flex, with the
   operations performed by the functions of 'binding_bindings.py', is written
   by

     ./tempore --grades event-separation \
       --emit-opentrons binding.py \
       --bind examples/opentrons/binding_bindings.py \
       --time-unit minutes \
       --simulate \
       examples/opentrons/binding.tpe

   and run by the Opentrons simulator, installed by 'make opentrons-deps'.
   The target opentrons-binding-simulate of 'make' runs this command.

   The magnetic beads of a nucleic-acid extraction bind the DNA of the
   lysates while they are suspended, and settle within a few minutes; the
   incubation therefore resuspends them by mixing at least every 5 minutes.
   Each mix pipettes the lysates up and down, which shears long DNA, and the
   mixes are at least 2 minutes apart. The bounds of 2 and 5 minutes are the
   example's own. *)

(* Adding the beads in their binding buffer and mixing them into the lysates,
   and a mix of every lysate, take one to two minutes each. Filling the wash
   plate with ethanol takes two to three minutes. *)
operation AddBeads : unit ~> unit # {AddBeads} within [1, 2]
default AddBeads () = delay 1

operation Mix : unit ~> unit # {Mix} within [1, 2]
default Mix () = delay 1

operation FillWashPlate : unit ~> unit # {FillWashPlate} within [2, 3]
default FillWashPlate () = delay 2

(* Moving the plate onto and off the magnetic block takes at most a minute,
   and removing the liquid one to two minutes. *)
operation MagnetOn : unit ~> unit # {MagnetOn} within [0, 1]
default MagnetOn () = delay 1

operation MagnetOff : unit ~> unit # {MagnetOff} within [0, 1]
default MagnetOff () = delay 1

operation RemoveLiquid : unit ~> unit # {RemoveLiquid} within [1, 2]
default RemoveLiquid () = delay 1

(* Correctly accepted by the typechecker: n mixes, each followed by two
   minutes of incubation. The grade is the invariant of the loop: it starts
   with a mix, the starts of consecutive mixes are 2 to 5 minutes apart, 3
   to 4 here, and the end is at most 5 minutes after the start of the last.
   The invariant is closed under sequencing, so that it holds of any number
   of mixes. *)
let rec incubate (n : nat) : unit # (Mix, [0, 0], [2, 5], [0, 5]) =
  match n with
  | 0 -> ()
  | m + 1 ->
      perform Mix ();
      delay 2;
      incubate m

(* Correctly accepted by the typechecker: the beads are added and mixed into
   the lysates, and first mixed again one to two minutes later. The wash
   plate is filled in the first incubation, 3 to 5 minutes between two
   mixes, followed by three more mixes. *)
let binding () : unit # (Mix, [1, 2], [2, 5], [0, 5]) =
  perform AddBeads ();
  perform Mix ();
  perform FillWashPlate ();
  incubate 3

(* Correctly rejected by the typechecker: the wash plate is filled after the
   two minutes of incubation that follow the first mix, which leaves the
   beads unmixed for 5 to 7 minutes:

     Typing error: This function's body has grade
       `{AddBeads; Mix; 2; FillWashPlate} · (Mix, [0, 0], [2, 5], [0, 5])`,
       which does not match its annotated grade
       `(Mix, [1, 2], [2, 5], [0, 5])`
       Note: the effect inequality
         `{AddBeads; Mix; 2; FillWashPlate} · (Mix, [0, 0], [2, 5], [0, 5])
         <= (Mix, [1, 2], [2, 5], [0, 5])` does not hold
*)
(*
let binding_late_wash () : unit # (Mix, [1, 2], [2, 5], [0, 5]) =
  perform AddBeads ();
  perform Mix ();
  delay 2;
  perform FillWashPlate ();
  incubate 3
*)

(* The binding, then the beads captured on the magnet in three minutes and
   the lysates removed. *)
let extraction () =
  binding ();
  perform MagnetOn ();
  delay 3;
  perform RemoveLiquid ();
  perform MagnetOff ()

run extraction ()
