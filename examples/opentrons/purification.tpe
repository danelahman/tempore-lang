(* Correctly rejected by the typechecker: the plate is moved off the magnet
   during the first soak, and the ethanol is removed off the magnet, which
   aspirates the beads. Under 'regex-timed-interval-rational-symbolic', and
   with the budget `[1/2, 3/2]` in place of `![1/2, 3/2]`, it is accepted,
   the move fitting beside the wait of half a minute:

     Typing error: Variable `soaking` is unboxed with grade `[{AddEthanol;
       MagnetOff; !0.5}, {AddEthanol; MagnetOff; !0.5}]` accumulated since it
       was bound, which is not below its box grade `[{AddEthanol;
       ![0.5, 1.5]}, {AddEthanol; ![0.5, 1.5]}]`
       Note: the resource inequality `[{AddEthanol; MagnetOff; !0.5},
       {AddEthanol; MagnetOff; !0.5}] <= [{AddEthanol; ![0.5, 1.5]},
       {AddEthanol; ![0.5, 1.5]}]` does not hold
*)
(*
let wash_off_magnet (soaking : [{AddEthanol; ![1/2, 3/2]}]beads) =
  perform AddEthanol ();
  perform MagnetOff ();
  delay 1/2;
  unbox soaking as beads in
  perform RemoveEthanol ();
  box {AddEthanol; ![1/2, 3/2]; RemoveEthanol} beads
*)

run purification "samples"
