(* A bead purification on the Opentrons Flex: the phases of the beads as boxes.

   Run this example with the 'timed-regex-interval-rational' grade algebra, e.g.

     ./tempore --grades timed-regex-interval-rational \
       examples/opentrons/purification.tpe

   Grades [L, U]: a lower and an upper bound on the traces with rational
   durations, in the timed regex order: operations are matched in order, time
   spans admit the operations that fit in them, idle waits admit none, a
   literal is read by its hull on each side, and operations take positive
   time
     - Unit {skip}: the empty trace
     - Top {≥0}: every trace
     - Product: concatenation of traces, componentwise *)

(* A tick is a minute. The protocol for the Flex is written and simulated by

     ./tempore --grades timed-regex-interval-rational \
       --emit-opentrons purification.py \
       --bind examples/opentrons/purification_bindings.py \
       --time-unit minutes \
       --simulate \
       examples/opentrons/purification.tpe

   The protocol is a sequence of phases: binding and settling, two ethanol
   washes, air-drying, and elution up to the addition of the PCR master mix.
   The operation that ends a phase takes the beads and returns them boxed
   with the whole of the next phase, and the operations inside a phase take
   unit and occur only in the grade of that box. The samples are taken out
   of the cold together with a token boxed for the time they may spend at
   room temperature, which the transfer to the cold block takes. Modelled on
   the Opentrons Protocol Library protocol kapa-amp-cleanup. The windows are
   the example's own. *)

type sample = string

(* The beads and the token are not eternal: each crosses time only in a box,
   and is used at once when unboxed. *)
noneternal type beads = Beads
noneternal type token = Token

(* The samples are taken out of the cold block in at most a minute, and
   returned with a token for at most 40 minutes at room temperature. *)
operation TakeSamples : unit ~> sample * [{[0, 40]}]token ! {TakeSamples}
  within (0, 1]
default TakeSamples () =
  delay 1/2;
  box {[0, 40]} Token as tok in
  ("samples", tok)

(* The operations inside a phase. The plate is moved onto and off the
   magnetic block and the ethanol added from above in at most a minute, and
   the ethanol is removed in one to two minutes. *)
operation MagnetOn : unit ~> unit ! {MagnetOn} within (0, 1]
default MagnetOn () = delay 1/2

operation MagnetOff : unit ~> unit ! {MagnetOff} within (0, 1]
default MagnetOff () = delay 1/2

operation AddEthanol : unit ~> unit ! {AddEthanol} within (0, 1]
default AddEthanol () = delay 3/4

operation RemoveEthanol : unit ~> unit ! {RemoveEthanol} within [1, 2]
default RemoveEthanol () = delay 3/2

(* The operations that end a phase. The beads are mixed into the samples,
   the supernatant removed, and the elution buffer mixed in, in one to two
   minutes each, and the residual ethanol is removed in at most a minute.
   Each returns the beads boxed with the next phase. The beads bind the
   samples for five to ten minutes, waiting only, before the plate goes onto
   the magnet, where they settle for three to five minutes. *)
operation AddBeads : sample ~>
  [{idle [5, 10]; MagnetOn; idle [3, 5]}]beads ! {AddBeads}
  within [1, 2]
default AddBeads samples =
  delay 3/2;
  box {idle [5, 10]; MagnetOn; idle [3, 5]} Beads

(* Once the supernatant is removed, the beads take exactly two washes, the
   ethanol of each added at once after the removal before it, and standing
   for half a minute to a minute and a half, waiting only, before its
   removal. *)
operation RemoveSupernatant : beads ~>
  [{AddEthanol; idle [1/2, 3/2]; RemoveEthanol;
    AddEthanol; idle [1/2, 3/2]; RemoveEthanol}]beads ! {RemoveSupernatant}
  within [1, 2]
default RemoveSupernatant Beads =
  delay 3/2;
  box {AddEthanol; idle [1/2, 3/2]; RemoveEthanol;
       AddEthanol; idle [1/2, 3/2]; RemoveEthanol} Beads

(* Once the residual ethanol is removed, the beads air-dry on the magnet for
   three to five minutes, so that they are neither wet nor overdried when
   the plate is moved off the magnet for the elution buffer. *)
operation RemoveResidualEthanol : beads ~>
  [{idle [3, 5]; MagnetOff}]beads ! {RemoveResidualEthanol}
  within (0, 1]
default RemoveResidualEthanol Beads =
  delay 3/4;
  box {idle [3, 5]; MagnetOff} Beads

(* The beads release the DNA into the buffer off the magnet for two to five
   minutes, and settle on the magnet for two to five minutes. The eluates
   are then transferred to the cold block, with no other step before, and
   cool to 4 °C there for two to five minutes before they take the master
   mix. *)
operation EluteDNA : beads ~>
  [{idle [2, 5]; MagnetOn; idle [2, 5]; Transfer; idle [2, 5]}]beads
  ! {EluteDNA} within [1, 2]
default EluteDNA Beads =
  delay 3/2;
  box {idle [2, 5]; MagnetOn; idle [2, 5]; Transfer; idle [2, 5]} Beads

(* The eluates are transferred to a plate on the cold block and the master
   mix mixed into them in one to two minutes each. The transfer takes the
   token of the samples, and ends their time at room temperature. *)
operation Transfer : token ~> unit ! {Transfer} within [1, 2]
default Transfer valid = delay 3/2

operation AddMasterMix : beads ~> unit ! {AddMasterMix} within [1, 2]
default AddMasterMix eluates = delay 3/2

(* The stages. Each carries out the phase stated by the grade of the box it
   takes, unboxes the beads, and passes them at once to the operation that
   ends the phase, which returns the box of the next phase:

     clear  : [{idle [5, 10]; MagnetOn; idle [3, 5]}]beads
                → [{AddEthanol; idle [1/2, 3/2]; RemoveEthanol;
                    AddEthanol; idle [1/2, 3/2]; RemoveEthanol}]beads
     washes : [{AddEthanol; idle [1/2, 3/2]; RemoveEthanol;
                AddEthanol; idle [1/2, 3/2]; RemoveEthanol}]beads
                → [{idle [3, 5]; MagnetOff}]beads
     elute  : [{idle [3, 5]; MagnetOff}]beads
                → [{idle [2, 5]; MagnetOn; idle [2, 5]; Transfer;
                    idle [2, 5]}]beads *)
let clear (binding : [{idle [5, 10]; MagnetOn; idle [3, 5]}]beads) =
  delay 15/2;
  perform MagnetOn ();
  delay 4;
  unbox binding as beads in
  perform RemoveSupernatant beads

let washes (cleared : [{AddEthanol; idle [1/2, 3/2]; RemoveEthanol;
                        AddEthanol; idle [1/2, 3/2]; RemoveEthanol}]beads) =
  perform AddEthanol ();
  delay 1;
  perform RemoveEthanol ();
  perform AddEthanol ();
  delay 3/4;
  perform RemoveEthanol ();
  unbox cleared as beads in
  perform RemoveResidualEthanol beads

let elute (drying : [{idle [3, 5]; MagnetOff}]beads) =
  delay 7/2;
  perform MagnetOff ();
  unbox drying as beads in
  perform EluteDNA beads

(* Correctly accepted by the typechecker: every phase is carried out within
   the grade of its box, the eluates reach the cold block 27.25 to 38.25
   minutes after the samples are taken out of the cold, and take the master
   mix two to five minutes later. The last phase includes the transfer,
   which takes the token, and is carried out here, where the token is. The
   token is boxed for at most 40 minutes at room temperature, a box whose
   scope encloses the boxes of the phases: the windows of the phases allow
   up to 49 minutes in all, so the box of the token bounds their
   combination. A third wash is rejected as the one wash below is, the box
   of the washes admitting exactly two. Each value is used once: the samples
   by AddBeads, the beads by the operations that end the phases, and the
   token by the transfer. *)
let purification () =
  let (samples, tok) = perform TakeSamples () in
  let eluting = elute (washes (clear (perform AddBeads samples))) in
  delay 3;
  perform MagnetOn ();
  delay 5/2;
  unbox tok as valid in
  perform Transfer valid;
  delay 7/2;
  unbox eluting as eluates in
  perform AddMasterMix eluates

(* Correctly rejected by the typechecker: the binding, the settling on the
   magnet, and the air-dry each take the upper end of their windows, which
   their boxes accept, but the eluates reach the cold block up to 43.25
   minutes after the samples are taken out of the cold:

     Typing error: Variable `tok` is unboxed with grade `{AddBeads; idle 10;
       MagnetOn; idle 5; RemoveSupernatant; AddEthanol; idle 1; RemoveEthanol;
       AddEthanol; idle 0.75; RemoveEthanol; RemoveResidualEthanol; idle 5;
       MagnetOff; EluteDNA; idle 3; MagnetOn; idle 2.5}` accumulated since it
       was bound, which is not below its box grade `{[0, 40]}`
       Note: the resource inequality `{AddBeads; idle 10; MagnetOn; idle 5;
       RemoveSupernatant; AddEthanol; idle 1; RemoveEthanol; AddEthanol;
       idle 0.75; RemoveEthanol; RemoveResidualEthanol; idle 5; MagnetOff;
       EluteDNA; idle 3; MagnetOn; idle 2.5} <= {[0, 40]}` does not hold
*)
