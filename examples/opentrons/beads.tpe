(* A bead clean-up on the Opentrons Flex: settled beads and an air-dry window.

   Run this example with the 'time-interval' grade algebra, e.g.

     ./tempore --grades time-interval examples/opentrons/beads.tpe

   Grades [n, m]: between n and m minutes, (n, m) being [n + 1, m - 1]
     - Unit [0, 0]: no time spent
     - Top [0, ∞): no bound, the widest interval
     - Product: componentwise addition *)

(* Modelled on the Opentrons Protocol Library protocols kapa-amp-cleanup (a
   bead clean-up with three minutes on the magnet and a dry time of two to
   three minutes), nextera-flex-library-prep-post-tag-cleanup (beads kept wet
   to prevent overdrying) and macherey-nagel-nucleomag-rna (an air-dry before
   the next reagent, there of 30 minutes).

   The protocols are in
     https://github.com/Opentrons/Protocols/tree/2f447c936b49/protocols/
       - kapa-amp-cleanup
       - nextera-flex-library-prep-post-tag-cleanup
       - macherey-nagel-nucleomag-rna

   A unit of duration is a minute. The protocol for the Flex, with the
   operations performed by the functions of 'beads_bindings.py', is written by

     ./tempore --grades time-interval \
       --emit-opentrons beads.py \
       --bind examples/opentrons/beads_bindings.py \
       --time-unit minutes \
       --simulate \
       examples/opentrons/beads.tpe

   and run by the Opentrons simulator, installed by 'make opentrons-deps'.
   The target opentrons-beads-simulate of 'make' runs this command.

   The beads of the samples are a value of the type beads, which is not
   eternal: each step takes the beads and returns them, and the beads cross
   time only in a box returned by a step. Beads binding the samples are a
   box that opens once they have bound, beads on the magnet a box that opens
   once they have settled, and air-drying beads a box that opens only within
   the drying window. *)

noneternal type beads = Beads of string

(* Mixing the beads into the samples and removing a liquid take one to two
   minutes each. The beads then bind the samples in at least five minutes. *)
operation AddBeads : beads ~> [[5, ∞)]beads ! [1, 2]
default AddBeads (Beads name) = delay 2; box [5, ∞) (Beads name)

operation RemoveLiquid : beads ~> beads ! [1, 2]
default RemoveLiquid (Beads name) = delay 1; Beads name

(* Moving the plate onto the magnetic block takes at most a minute; the beads
   then settle in at least three minutes. Moving it off takes at most a
   minute. *)
operation MagnetOn : beads ~> [[3, ∞)]beads ! [0, 1]
default MagnetOn (Beads name) = box [3, ∞) (Beads name)

operation MagnetOff : beads ~> beads ! [0, 1]
default MagnetOff (Beads name) = Beads name

(* An ethanol wash adds and removes the ethanol in one to two minutes. The
   last wash leaves the beads to air-dry on the magnet: the plate is moved
   off the magnet two to three minutes after it, once the ethanol has
   evaporated and before the beads overdry. *)
operation Wash : beads ~> beads ! [1, 2]
default Wash (Beads name) = delay 2; Beads name

operation FinalWash : beads ~> [[2, 3]]beads ! [1, 2]
default FinalWash (Beads name) = delay 1; box [2, 3] (Beads name)

(* Adding the elution buffer and transferring the eluate take one to two
   minutes each. The beads release the DNA into the buffer in at least two
   minutes. *)
operation EluteDNA : beads ~> [[2, ∞)]beads ! [1, 2]
default EluteDNA (Beads name) = delay 1; box [2, ∞) (Beads name)

operation Transfer : beads ~> unit ! [1, 2]
default Transfer beads = delay 2

(* Correctly accepted by the typechecker: the beads bind the samples for
   five minutes, and the supernatant is removed after they have settled for
   four minutes, at least the three they demand. The plate is moved off the
   magnet two minutes into the air-dry, and the elution buffer is added two
   to three minutes into it. The beads release the DNA for two minutes, and
   the eluate is transferred after they have settled again for three. *)
let cleanup (beads : beads) =
  let binding = perform AddBeads beads in
  delay 5;
  unbox binding as bound in
  let settling = perform MagnetOn bound in
  delay 4;
  unbox settling as settled in
  let cleared = perform RemoveLiquid settled in
  let washed = perform Wash cleared in
  let drying = perform FinalWash washed in
  delay 2;
  unbox drying as dried in
  let released = perform MagnetOff dried in
  let eluting = perform EluteDNA released in
  delay 2;
  unbox eluting as eluted in
  let resettling = perform MagnetOn eluted in
  delay 3;
  unbox resettling as resettled in
  perform Transfer resettled

(* Correctly rejected by the typechecker: the plate is moved off the magnet
   four minutes after the last ethanol wash, when the beads are overdried:

     Typing error: Variable `drying` is unboxed with grade `[4, 4]`
       accumulated since it was bound, which is not below its box grade
       `[2, 3]`
       Note: the resource inequality `[4, 4] <= [2, 3]` does not hold
*)
(*
let cleanup_overdried (washed : beads) =
  let drying = perform FinalWash washed in
  delay 4;
  unbox drying as dried in
  let released = perform MagnetOff dried in
  perform EluteDNA released
*)

run cleanup (Beads "beads")
