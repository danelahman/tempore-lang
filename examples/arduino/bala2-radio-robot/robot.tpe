      perform StartBalancing calibration;
      drive 4000000000 0)
    else ())
  else ()
*)

(* Correctly rejected by the typechecker: an iteration of the drive that
   polls again for a Stop before it applies the message received first,
   which is then no longer the latest:

     Typing error: Variable `latest` is unboxed with grade
       `{ReceiveMessage; StopBalancing?}` accumulated since it was bound,
       which is not below its box grade `{[0, 150) & ~ReceiveMessage}`
       ...
*)
(*
let drive_polled () =
  let latest = remote_receive () in
  let newer = remote_receive () in
  unbox newer as polled in
  let n, _ = polled in
  (match n with Got Stop -> perform StopBalancing () | _ -> ());
  unbox latest as received in
  let r, setpoints = received in
  match r with
  | Got (Drive _) ->
      (match setpoints with
       | Setpoints (speed, turn) -> perform Move (speed, turn))
  | _ -> perform Move (0.0, 0.0)
*)

(* Two control steps from the reading of the default implementation of the
   unit, a robot at rest, and a tilt of 3 degrees. *)
run step (step (3.0, 0.0, 0.0, 0.0, 0.0))
