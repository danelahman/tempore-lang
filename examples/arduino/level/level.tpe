(* A spirit level on the M5Stack CoreS3 Lite: a calibration applied only to
   readings that no reconfiguration of the unit precedes

   Run this example with the 'regex-timed-interval-rational-symbolic' grading monoid, e.g.

     ./tempore --grades regex-timed-interval-rational-symbolic \
       --package m5-imu \
       --package m5-display \
       --package m5-touch \
       --package m5-speaker \
       --board m5stack-cores3 \
       examples/arduino/level/level.tpe

   Grades [L, U]: a lower and upper regular-language bound on the traces with
   rational durations
     - Unit [{0}, {0}]: nothing demanded, only the empty trace allowed
     - Top [{0}, ∞): nothing demanded, every trace allowed
     - Product: concatenation of traces, componentwise *)

(* An application of the Arduino backend under the regular expressions of
   timed operations, in milliseconds, to the M5Stack CoreS3 Lite lying on a
   surface: the device manifest level.device.json runs the step 'step' every
   250 ms, from the state of 'start'. The step shows the pitch and the roll
   of the unit, in degrees, less the offsets of a calibration, "LEVEL" when
   both are within half a degree, and the age of the calibration. A tap on
   the screen calibrates: the offsets are the mean tilts of four readings,
   the unit is self-tested and a tone sounds. A tap on the top right corner
   reconfigures the unit, setting the output data rate of its accelerometer
   to 400 or 100 Hz, which invalidates the calibration until the next.

   The operations ReadImu, ConfigureImu, SelfTestImu, ShowTextAt,
   ShowNumberAt, ClearDisplay, Touched and Beep, and the functions
   tilt_x_of_accel and tilt_y_of_accel, come from the packages m5-imu,
   m5-display, m5-touch and m5-speaker, whose declarations under these
   grades precede this file. bindings.cpp defines the safe state; world.cpp
   is the host model of the surface and of the taps on the screen.

   The PlatformIO project is written, and simulated on the host for 9
   seconds, by

     ./tempore --grades regex-timed-interval-rational-symbolic \
       --emit-arduino level \
       --device examples/arduino/level/level.device.json \
       --host-simulate 9 \
       examples/arduino/level/level.tpe

   and built for the board, with PlatformIO, by --build in place of
   --host-simulate. The make targets arduino-level-simulate, -build, -upload
   and -profile run these commands and their variants for the board;
   'make examples-help' lists them with their variables.

   A grade written as one expression is both bounds: the operations it names
   are demanded, in its order, and the delays between them are bounded below
   and above; another operation may come between them only within a delay,
   at the upper bound of its running time. The box grades below therefore
   name operations without delays: such a grade excludes every operation it
   does not name. A box grade such as '{~(_*; ConfigureImu; ...)}', the
   traces in which every reconfiguration is followed by a self-test, does
   not exclude a reconfiguration here, since it contains the delays, within
   which any operation may come; nor does '{(ConfigureImu; SelfTestImu |
   0); ReadImu}', whose upper bound permits the self-test to be left out and
   whose lower bound demands only one of its traces.

   A box is checked from its binding to its unboxing, within one function
   body. The calibration persists from step to step in the state, as data:
   each step boxes it anew, and its age is counted in steps, so that it
   expires after 2400 steps, 10 minutes at the period, which the monitor of
   the device enforces; the typing bounds each step below its period. The
   step carries the calibration into the next state only as unboxed from
   its box; the typing does not exclude returning the calibration of the
   state unchecked, which is plain data.

   The bounds of the running times of the operations of the packages are
   those on the M5Stack CoreS3, the board of the manifest, which the option
   --board m5stack-cores3 of the interpreter run selects and to which the
   figures below refer. Those of ConfigureImu, SelfTestImu, ShowTextAt,
   ShowNumberAt, Touched and Beep are provisional, not yet measured. *)

(* A calibration: none yet, invalidated by a reconfiguration or by its age,
   failed by its self-test, or the offsets of the pitch and the roll, in
   degrees. *)
type calibration =
  | Uncalibrated
  | Invalidated
  | Failed
  | Offsets of float * float

(* The state of the step: the calibration, its age in steps, the output data
   rate of the accelerometer, in hertz, and whether the screen was touched
   at the last step. *)
type state = calibration * nat * nat * bool

(* The period, in seconds, the age at which a calibration expires, in steps,
   and the tolerance of the level, in degrees. *)
let period = 0.25
let expiry = 2400
let tolerance = 0.5

let magnitude (x : float) = if x < 0.0 then ~-.x else x

(* Whether a point of the screen, in pixels, lies in its top right corner. *)
let corner (x : nat) (y : nat) = x >= 240 && y < 80

(* The pitch and the roll of an acceleration, in degrees, less the offsets of
   a calibration, if any. *)
let angles (accel : vector) (calibration : calibration) =
  let pitch = tilt_x_of_accel accel in
  let roll = tilt_y_of_accel accel in
  match calibration with
  | Offsets (dx, dy) -> (pitch -. dx, roll -. dy)
  | _ -> (pitch, roll)

let level ((pitch, roll) : float * float) =
  magnitude pitch <= tolerance && magnitude roll <= tolerance

(* The screen: a title at the top, the labels, and a footer at the bottom,
   drawn once by 'start'; the angles, the verdict, the state of the
   calibration and its age, in seconds, redrawn by each step over the bands
   of the previous. *)
let display (calibration : calibration) (shown : float * float) (age : nat) :
    unit # {ShowNumberAt; ShowNumberAt; ShowTextAt; ShowTextAt; ShowNumberAt}
    =
  let pitch, roll = shown in
  perform ShowNumberAt (130, 30, 3, 1, pitch);
  perform ShowNumberAt (130, 70, 3, 1, roll);
  (match calibration with
  | Offsets _ ->
      if level shown then perform ShowTextAt (0, 110, 4, "LEVEL")
      else perform ShowTextAt (0, 110, 4, "")
  | _ -> perform ShowTextAt (0, 110, 4, ""));
  (match calibration with
  | Uncalibrated -> perform ShowTextAt (0, 160, 2, "Tap to calibrate")
  | Invalidated -> perform ShowTextAt (0, 160, 2, "Recalibrate (tap)")
  | Failed -> perform ShowTextAt (0, 160, 2, "Self-test failed")
  | Offsets _ -> perform ShowTextAt (0, 160, 2, "Calibrated"));
  perform ShowNumberAt (130, 190, 2, 0, float_of_nat age *. period)

(* The tilts of a reading, in degrees. *)
let tilts () : float * float # {ReadImu} =
  let accel, _ = perform ReadImu () in
  (tilt_x_of_accel accel, tilt_y_of_accel accel)

(* Correctly accepted by the typechecker: the calibration reads the unit four
   times, 10 ms apart, self-tests it and sounds a tone, high if the unit is
   at rest and low otherwise. The offsets are boxed with the self-test and
   the tone, without delays: they are installed only after a self-test, with
   no other operation, in particular no reconfiguration, between. *)
let calibrate () : calibration
    # {ReadImu; 10; ReadImu; 10; ReadImu; 10; ReadImu; SelfTestImu; Beep} =
  let x1, y1 = tilts () in
  delay 10;
  let x2, y2 = tilts () in
  delay 10;
  let x3, y3 = tilts () in
  delay 10;
  let x4, y4 = tilts () in
  let offsets = Offsets ((x1 +. x2 +. x3 +. x4) /. 4.0, (y1 +. y2 +. y3 +. y4) /. 4.0) in
  box {SelfTestImu; Beep} offsets as untested in
  let rest = perform SelfTestImu () in
  (if rest then perform Beep (2000, 100) else perform Beep (400, 400));
  unbox untested as tested in
  if rest then tested else Failed

(* Correctly rejected by the typechecker: the offsets are installed without a
   self-test, which the lower bound of their box demands:

     Typing error: Variable `untested` is unboxed with grade
       `[{Beep}, {Beep}]` accumulated since it was bound, which is not below
       its box grade `[{SelfTestImu; Beep}, {SelfTestImu; Beep}]`
       ...
       Note: the resource inequality
         `[{Beep}, {Beep}] <= [{SelfTestImu; Beep}, {SelfTestImu; Beep}]`
         does not hold
*)
(*
let calibrate_untested () : calibration =
  let x, y = tilts () in
  box {SelfTestImu; Beep} (Offsets (x, y)) as untested in
  perform Beep (2000, 100);
  unbox untested as tested in
  tested
*)

(* Correctly accepted by the typechecker: the step reads the touch screen,
   then calibrates on a tap, reconfigures the unit on a tap on the corner,
   or neither, then reads the unit and draws, in this order; its durations,
   0.7 to 234.5 ms, lie below its period of 250 ms. The calibration of the
   state is boxed with the reading of the touch screen and of the unit,
   without delays: it is applied, and kept, only if nothing else came
   between the start of the step and the reading, in particular no
   reconfiguration and no calibration. The reading is boxed for 5 ms. *)
let step ((calibration, age, rate, touching) : state) : state
    # {Touched;
       (ReadImu; 10; ReadImu; 10; ReadImu; 10; ReadImu; SelfTestImu; Beep
       | ConfigureImu; Beep | 0);
       ReadImu; ShowNumberAt; ShowNumberAt; ShowTextAt; ShowTextAt;
       ShowNumberAt} =
  box {Touched; ReadImu} calibration as kept in
  let touched, x, y = perform Touched () in
  let tapped = touched && not touching in
  if tapped && corner x y then (
    let rate = if rate = 100 then 400 else 100 in
    perform ConfigureImu rate;
    perform Beep (600, 50);
    let accel, _ = perform ReadImu () in
    display Invalidated (angles accel Invalidated) 0;
    (Invalidated, 0, rate, touched))
  else if tapped then (
    let calibration = calibrate () in
    let accel, _ = perform ReadImu () in
    box [0, 5] accel as reading in
    unbox reading as accel in
    display calibration (angles accel calibration) 0;
    (calibration, 0, rate, touched))
  else
    let accel, _ = perform ReadImu () in
    box [0, 5] accel as reading in
    unbox kept as calibration in
    unbox reading as accel in
    match calibration with
    | Offsets _ ->
        if age + 1 >= expiry then (
          display Invalidated (angles accel Invalidated) 0;
          (Invalidated, 0, rate, touched))
        else (
          display calibration (angles accel calibration) (age + 1);
          (calibration, age + 1, rate, touched))
    | _ ->
        display calibration (angles accel calibration) 0;
        (calibration, 0, rate, touched)

(* The initial state: the screen cleared, with its title, labels and footer,
   and the unit at its default rate, uncalibrated. *)
let start () : state =
  perform ClearDisplay ();
  perform ShowTextAt (0, 0, 1, "Spirit level");
  perform ShowTextAt (0, 30, 3, "Pitch");
  perform ShowTextAt (0, 70, 3, "Roll");
  perform ShowTextAt (0, 190, 2, "Age (s)");
  perform ShowTextAt (0, 230, 1, "Powered by Tempore (tempore-lang.ee)");
  perform ConfigureImu 100;
  (Uncalibrated, 0, 100, false)

(* Correctly rejected by the typechecker: a tap on the corner reconfigures
   the unit, and the step still applies the calibration to the reading:

     Typing error: Variable `kept` is unboxed with grade
       `[{Touched; (0 | ConfigureImu; Beep); ReadImu},
       {Touched; (0 | ConfigureImu; Beep); ReadImu}]` accumulated since it
       was bound, which is not below its box grade
       `[{Touched; ReadImu}, {Touched; ReadImu}]`
       ...
       Note: the resource inequality
         `[{Touched; (0 | ConfigureImu; Beep); ReadImu},
         {Touched; (0 | ConfigureImu; Beep); ReadImu}] <=
         [{Touched; ReadImu}, {Touched; ReadImu}]` does not hold
*)
(*
let step_reconfigured ((calibration, age, rate, touching) : state) : state =
  box {Touched; ReadImu} calibration as kept in
  let touched, x, y = perform Touched () in
  (if touched && corner x y then (
     perform ConfigureImu 400;
     perform Beep (600, 50))
   else ());
  let accel, _ = perform ReadImu () in
  unbox kept as calibration in
  display calibration (angles accel calibration) (age + 1);
  (calibration, age + 1, rate, touched)
*)

(* Correctly rejected by the typechecker: the step reads the unit before it
   calibrates, and applies the new calibration to a reading more than 5 ms
   old:

     Typing error: Variable `reading` is unboxed with grade
       `[{0 | ReadImu; 10; ReadImu; 10; ReadImu; 10; ReadImu; SelfTestImu;
       Beep}, {0 | ReadImu; 10; ReadImu; 10; ReadImu; 10; ReadImu;
       SelfTestImu; Beep}]` accumulated since it was bound, which is not
       below its box grade `[{0}, {5}]`
       ...
       Note: the resource inequality
         `[{0 | ReadImu; 10; ReadImu; 10; ReadImu; 10; ReadImu; SelfTestImu;
         Beep}, {0 | ReadImu; 10; ReadImu; 10; ReadImu; 10; ReadImu;
         SelfTestImu; Beep}] <= [{0}, {5}]` does not hold
*)
(*
let step_stale ((calibration, age, rate, touching) : state) : state =
  let touched, _, _ = perform Touched () in
  let accel, _ = perform ReadImu () in
  box [0, 5] accel as reading in
  let calibration = if touched then calibrate () else calibration in
  unbox reading as accel in
  display calibration (angles accel calibration) 0;
  (calibration, 0, rate, touched)
*)

(* Correctly rejected by the typechecker: the step draws before it reads the
   unit, against the order of its grade:

     Typing error: This function's body has grade
       `[{Touched; ShowNumberAt; ShowNumberAt; ShowTextAt; ShowTextAt;
       ShowNumberAt; ReadImu}, {Touched; ShowNumberAt; ShowNumberAt;
       ShowTextAt; ShowTextAt; ShowNumberAt; ReadImu}]`, which does not
       match its annotated grade `[{Touched; ReadImu; ShowNumberAt;
       ShowNumberAt; ShowTextAt; ShowTextAt; ShowNumberAt}, {Touched;
       ReadImu; ShowNumberAt; ShowNumberAt; ShowTextAt; ShowTextAt;
       ShowNumberAt}]`
       ...
*)
(*
let step_drawn_first ((calibration, age, rate, touching) : state) : state
    # {Touched; ReadImu; ShowNumberAt; ShowNumberAt; ShowTextAt; ShowTextAt;
       ShowNumberAt} =
  let touched, _, _ = perform Touched () in
  display calibration (0.0, 0.0) age;
  let _ = perform ReadImu () in
  (calibration, age + 1, rate, touched)
*)

(* A step without a tap from the initial state, and a calibration with the
   default implementations, which read a unit at rest with its z axis up. *)
run step (start ())

run calibrate ()
