(* A digital level on the M5Stack CoreS3 Lite: a reference applied only to
   readings that no reconfiguration of the unit precedes

   Run this example with the 'regex-timed-interval-rational-symbolic' grading monoid, e.g.

     ./tempore --grades regex-timed-interval-rational-symbolic \
       --package m5-imu \
       --package m5-display \
       --package m5-touch \
       --package m5-speaker \
       --board m5stack-cores3 \
       examples/arduino/level/level.tpe

   Grades [L, U]: a lower and upper regular-language bound on the traces with
   rational durations
     - Unit [{0}, {0}]: nothing demanded, only the empty trace allowed
     - Top [{0}, ∞): nothing demanded, every trace allowed
     - Product: concatenation of traces, componentwise *)

(* Runs on the M5Stack CoreS3 Lite lying on a surface (level.device.json):
   'step' every 250 ms from the state of 'start'. The screen shows a bubble
   vial, the pitch and the roll, in degrees, less the offsets of a
   reference, "LEVEL" when both are within half a degree, the state of the
   reference, and two buttons: "Set reference" takes a reference, checked
   at rest, and "Reconfigure sensor" switches the output data rate of the
   accelerometer between 100 and 400 Hz, which invalidates it; a
   reference expires after 30 seconds. bindings.cpp defines the safe state
   and world.cpp models the surface and the taps. The figures below are
   those under the bounds of the CoreS3, some of them provisional.

   On the board: make arduino-level-upload; simulated on the host: make
   arduino-level-simulate ('make examples-help', README: Arduino). *)

(* A reference: none yet, held still before it is taken for the given
   number of steps, rejected by its check at rest, invalidated by a
   reconfiguration, to the given rate, or by its age, or the offsets of the pitch and the roll,
   in degrees. *)
type reference =
  | NoReference
  | Holding of nat
  | Rejected
  | Reconfigured of nat
  | Expired
  | Offsets of float * float

(* The state of the step: the reference, its age in steps, the output data
   rate of the accelerometer, in hertz, and whether the screen was touched
   at the last step. *)
type state = reference * nat * nat * bool

(* The period, in seconds; the age at which a reference expires, in steps,
   and the steps held still before a reference is taken; the tolerance of the level, in degrees, and the
   displacement of the bubble, in pixels per degree. *)
let period = 0.25
let expiry = 120
let hold = 4
let tolerance = 0.5
let scale = 8.0

(* The colours of the bubble: without a valid reference, off level and
   level. *)
let grey = 0x808080
let white = 0xffffff
let green = 0x00e000

let magnitude (x : float) = if x < 0.0 then ~-.x else x

(* Whether a point of the screen, in pixels, lies on the button "Set
   reference" at the bottom left or on the button "Reconfigure sensor" at
   the bottom right. *)
let on_set (x : nat) (y : nat) = x < 146 && y >= 190
let on_sensor (x : nat) (y : nat) = x >= 146 && y >= 190

(* The pitch and the roll of an acceleration, in degrees, less the offsets of
   a reference, if any. *)
let angles (accel : vector) (reference : reference) =
  let pitch = tilt_x_of_accel accel in
  let roll = tilt_y_of_accel accel in
  match reference with
  | Offsets (dx, dy) -> (pitch -. dx, roll -. dy)
  | _ -> (pitch, roll)

let level ((pitch, roll) : float * float) =
  magnitude pitch <= tolerance && magnitude roll <= tolerance

(* The two lines of the state of the reference, of age 'age' in steps. *)
let status (reference : reference) (age : nat) :
    unit # {(ShowTextAt | ShowTimeAt); ShowTextAt} =
  match reference with
  | NoReference ->
      perform ShowTextAt (0, 150, 2, "No reference: place on the");
      perform ShowTextAt (0, 172, 2, "surface, tap Set reference")
  | Holding _ ->
      perform ShowTextAt (0, 150, 2, "Hold still...");
      perform ShowTextAt (0, 172, 2, "")
  | Rejected ->
      perform ShowTextAt (0, 150, 2, "Moved during check:");
      perform ShowTextAt (0, 172, 2, "reference rejected")
  | Reconfigured 400 ->
      perform ShowTextAt (0, 150, 2, "Reconfigured, now 400 Hz:");
      perform ShowTextAt (0, 172, 2, "old reference not trusted")
  | Reconfigured _ ->
      perform ShowTextAt (0, 150, 2, "Reconfigured, now 100 Hz:");
      perform ShowTextAt (0, 172, 2, "old reference not trusted")
  | Expired ->
      perform ShowTextAt (0, 150, 2, "Reference expired:");
      perform ShowTextAt (0, 172, 2, "tap Set reference")
  | Offsets _ ->
      perform ShowTimeAt (0, 150, 2, "Reference valid for ", (expiry - age) / 4);
      perform ShowTextAt (0, 172, 2, "(checked at rest)")

(* The screen: the title, the rate of the accelerometer, the guarantee, the
   labels, the buttons and the footer, drawn once by 'start', the rate
   redrawn by a reconfiguration; the vial, whose bubble moves to the higher
   side, grey without a valid reference and green when level, the angles,
   the verdict and the state of the reference, redrawn by each step over
   the bands of the previous. *)
let display (reference : reference) (shown : float * float) (age : nat) :
    unit
    # {DrawLevel; ShowNumberAt; ShowNumberAt; ShowTextAt;
       (ShowTextAt | ShowTimeAt); ShowTextAt} =
  let pitch, roll = shown in
  let valid = match reference with Offsets _ -> true | _ -> false in
  let colour = if not valid then grey else if level shown then green else white in
  perform DrawLevel
    (60, 90, 50, int_of_float (~-.roll *. scale), int_of_float (~-.pitch *. scale), colour);
  perform ShowNumberAt (200, 40, 3, 1, pitch);
  perform ShowNumberAt (200, 80, 3, 1, roll);
  (if valid && level shown then perform ShowTextAt (130, 120, 3, "LEVEL")
   else perform ShowTextAt (130, 120, 3, ""));
  status reference age

(* The tilts of a reading, in degrees. *)
let tilts () : float * float # {ReadImu} =
  let accel, _ = perform ReadImu () in
  (tilt_x_of_accel accel, tilt_y_of_accel accel)

(* The box grades below name operations without delays: such a grade
   excludes every operation it does not name. A box grade such as
   '{~(_*; ConfigureImu; ...)}', the traces in which every reconfiguration
   is followed by a check, does not exclude a reconfiguration here, since it
   contains the delays, within which any operation may come; nor does
   '{(ConfigureImu; CheckAtRest | 0); ReadImu}', whose upper bound permits
   the check to be left out and whose lower bound demands only one of its
   traces. *)

(* Correctly accepted by the typechecker: a reference reads the unit four
   times, 10 ms apart, checks that it is at rest and sounds a tone, high if
   it is and low otherwise. The offsets are boxed with the check and the
   tone, without delays: they are installed only after a check at rest,
   with no other operation, in particular no reconfiguration, between. *)
let take () : reference
    # {ReadImu; 10; ReadImu; 10; ReadImu; 10; ReadImu; CheckAtRest; Beep} =
  let x1, y1 = tilts () in
  delay 10;
  let x2, y2 = tilts () in
  delay 10;
  let x3, y3 = tilts () in
  delay 10;
  let x4, y4 = tilts () in
  let offsets = Offsets ((x1 +. x2 +. x3 +. x4) /. 4.0, (y1 +. y2 +. y3 +. y4) /. 4.0) in
  box {CheckAtRest; Beep} offsets as unchecked in
  let rest = perform CheckAtRest () in
  (if rest then perform Beep (2000, 100) else perform Beep (400, 400));
  unbox unchecked as checked in
  if rest then checked else Rejected

(* Correctly rejected by the typechecker: the offsets are installed without a
   check at rest, which the lower bound of their box demands:

     Typing error: Variable `unchecked` is unboxed with grade
       `[{Beep}, {Beep}]` accumulated since it was bound, which is not below
       its box grade `[{CheckAtRest; Beep}, {CheckAtRest; Beep}]`
       ...
       Note: the resource inequality
         `[{Beep}, {Beep}] <= [{CheckAtRest; Beep}, {CheckAtRest; Beep}]`
         does not hold
*)
(*
let take_unchecked () : reference =
  let x, y = tilts () in
  box {CheckAtRest; Beep} (Offsets (x, y)) as unchecked in
  perform Beep (2000, 100);
  unbox unchecked as checked in
  checked
*)

(* Correctly accepted by the typechecker: the step reads the unit and then
   the touch screen; on a tap on "Reconfigure sensor", it reconfigures the
   unit, setting the output data rate of its accelerometer to 400 or 100 Hz,
   shows the rate, in grey, reads the unit anew and draws; at the end of the
   hold after a tap on "Set reference", it takes the reference and shows its
   state; and otherwise it draws the first reading. Its durations, 0.45 to
   213 ms, lie below its period of 250 ms. The first reading is boxed with
   the reading of the touch screen, and the reference of the state with any
   number of readings of the unit and of the touch screen, without delays:
   each is used only if no other operation came between, in particular no
   reconfiguration and no new reference.

   A box is checked from its binding to its unboxing, within one function
   body. The reference persists from step to step in the state, as data:
   each step boxes it anew, and its age is counted in steps, so that it
   expires after 120 steps, 30 seconds at the period, which the monitor of
   the device enforces; the typing bounds each step below its period. The
   step carries the offsets into the next state only as unboxed from their
   box; the typing does not exclude returning the reference of the state
   unchecked, which is plain data. *)
let step ((reference, age, rate, touching) : state) : state
    # {ReadImu; Touched;
       ((ConfigureImu; Beep; ShowColourTextAt; ReadImu | 0); DrawLevel;
        ShowNumberAt; ShowNumberAt; ShowTextAt; (ShowTextAt | ShowTimeAt);
        ShowTextAt
       | ReadImu; 10; ReadImu; 10; ReadImu; 10; ReadImu; CheckAtRest; Beep;
         (ShowTextAt | ShowTimeAt); ShowTextAt)} =
  box {(ReadImu | Touched)*} reference as kept in
  let accel, _ = perform ReadImu () in
  box {Touched} accel as reading in
  let touched, x, y = perform Touched () in
  let tapped = touched && not touching in
  if tapped && on_sensor x y then (
    let rate = if rate = 100 then 400 else 100 in
    perform ConfigureImu rate;
    perform Beep (600, 50);
    (if rate = 100 then perform ShowColourTextAt (206, 6, 1, grey, 0, "Sensor rate: 100 Hz")
     else perform ShowColourTextAt (206, 6, 1, grey, 0, "Sensor rate: 400 Hz"));
    let accel, _ = perform ReadImu () in
    display (Reconfigured rate) (angles accel (Reconfigured rate)) 0;
    (Reconfigured rate, 0, rate, touched))
  else
    match reference with
    | Holding 0 ->
        let reference = take () in
        status reference 0;
        (reference, 0, rate, touched)
    | _ ->
        unbox kept as reference in
        unbox reading as accel in
        let next, age =
          if tapped && on_set x y then (Holding hold, 0)
          else
            match reference with
            | Holding (n + 1) -> (Holding n, 0)
            | Offsets _ ->
                if age + 1 >= expiry then (Expired, 0) else (reference, age + 1)
            | _ -> (reference, 0)
        in
        display next (angles accel next) age;
        (next, age, rate, touched)

(* The initial state: the screen cleared, with its title, guarantee, labels,
   buttons and footer, and the unit at its default rate, without a
   reference. *)
let start () : state =
  perform ClearDisplay ();
  perform ShowTextAt (0, 0, 2, "Digital level");
  perform ShowTextAt (0, 24, 1, "Reference used only if at rest and not reconfigured");
  perform ShowTextAt (130, 45, 2, "Pitch");
  perform ShowTextAt (130, 85, 2, "Roll");
  perform ShowColourTextAt (206, 6, 1, grey, 0, "Sensor rate: 100 Hz");
  perform DrawButton (0, 194, 144, 24, "Set reference");
  perform DrawButton (148, 194, 172, 24, "Reconfigure sensor");
  perform ShowTextAt (80, 230, 1, "Typechecked by Tempore (tempore-lang.ee)");
  perform ConfigureImu 100;
  (NoReference, 0, 100, false)

(* Correctly rejected by the typechecker: a tap on "Reconfigure sensor"
   reconfigures the unit, and the step keeps the reference and applies it
   to the reading, although it was taken at the former rate:

     Typing error: Variable `kept` is unboxed with grade
       `[{ReadImu; Touched; (0 | ConfigureImu)},
       {ReadImu; Touched; (0 | ConfigureImu)}]` accumulated since it was
       bound, which is not below its box grade
       `[{(ReadImu | Touched)*}, {(ReadImu | Touched)*}]`
       ...
       Note: the resource inequality
         `[{ReadImu; Touched; (0 | ConfigureImu)},
         {ReadImu; Touched; (0 | ConfigureImu)}] <=
         [{(ReadImu | Touched)*}, {(ReadImu | Touched)*}]` does not hold
*)
(*
let step_reconfigured ((reference, age, rate, touching) : state) : state =
  box {(ReadImu | Touched)*} reference as kept in
  let accel, _ = perform ReadImu () in
  let touched, x, y = perform Touched () in
  let rate =
    if touched && not touching && on_sensor x y then (
      let rate = if rate = 100 then 400 else 100 in
      perform ConfigureImu rate;
      rate)
    else rate
  in
  unbox kept as reference in
  display reference (angles accel reference) age;
  (reference, age, rate, touched)
*)

(* Correctly rejected by the typechecker: after a reconfiguration the step
   draws the reading taken before it, in place of a new one:

     Typing error: Variable `reading` is unboxed with grade
       `[{Touched; ConfigureImu; Beep}, {Touched; ConfigureImu; Beep}]`
       accumulated since it was bound, which is not below its box grade
       `[{Touched}, {Touched}]`
       ...
       Note: the resource inequality
         `[{Touched; ConfigureImu; Beep}, {Touched; ConfigureImu; Beep}] <=
         [{Touched}, {Touched}]` does not hold
*)
(*
let step_stale ((reference, age, rate, touching) : state) : state =
  let accel, _ = perform ReadImu () in
  box {Touched} accel as reading in
  let touched, x, y = perform Touched () in
  if touched && not touching && on_sensor x y then (
    let rate = if rate = 100 then 400 else 100 in
    perform ConfigureImu rate;
    perform Beep (600, 50);
    unbox reading as accel in
    display (Reconfigured rate) (angles accel (Reconfigured rate)) 0;
    (Reconfigured rate, 0, rate, touched))
  else (reference, age, rate, touched)
*)

(* A step without a tap from the initial state, and a reference with the
   default implementations, which read a unit at rest with its z axis up. *)
run step (start ())

run take ()
