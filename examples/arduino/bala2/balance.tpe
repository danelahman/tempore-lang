  perform ShowText "Hold upright";
  delay 600000;
  unbox token as calibration in
  perform Arm calibration;
  drive 4000000000
*)

(* Correctly rejected by the typechecker: an iteration of the drive that
   waits 150 ms clears and redraws the display, and may take 223.1 ms, so
   that a command may expire before the next:

     Typing error: This function's body has grade `[181.2, 223.1]`, which
       does not match its annotated grade `[0, 200)`
       Note: the effect inequality `[181.2, 223.1] <= [0, 200)` does not
