(* Correctly rejected by the typechecker: the step shows the tilt on the
   display, which takes up to 12.5 ms, longer than the period:

     Typing error: This function's body has grade `[0.85, 14.2]`, which
       does not match its annotated grade `[0, 5)`
       Note: the effect inequality `[0.85, 14.2] <= [0, 5)` does not hold
*)
(*
let step_shown ((tilt, speed, integral, position) : state) : state # [0, 5) =
  let reading = perform ReadImu () in
  box [0, 2] reading as fresh in
  unbox fresh as imu in
  let accel, gyro = imu in
