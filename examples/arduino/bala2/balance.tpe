    complementary gyro_weight period tilt (tilt_x_of_accel accel) raw
  in
  perform ShowNumber tilt;
  perform SetMotors (0i, 0i);
  (tilt, speed, integral, position)
*)

(* The supervision. The bias of the gyroscope is the mean of 50 rates
   published by the step 10 ms apart, with the robot held still; the
   calibration is boxed for ten minutes, and arming the robot needs it
   unboxed, that is, at most ten minutes old. *)

let rec rate_sum (n : nat) (sum : float) : float # [0, ∞) =
  match n with
  | 0 -> sum
  | m + 1 ->
      let _, rate = perform Attitude () in
      delay 10;
      rate_sum m (sum +. rate)

let calibrate () =
  perform Disarm ();
  perform ClearDisplay ();
  perform ShowText "Calibrating";
  let sum = rate_sum 50 0.0 in
  box [0, 600000) (Calibration (sum /. 50.0))

(* Correctly accepted by the typechecker: an iteration of the drive commands
   zero setpoints, shows the tilt every tenth iteration and waits 100 ms; it
   takes 100 to 112.6 ms, within the 200 ms after which a command expires. *)
let drive_step (n : nat) : unit # [0, 200) =
  let tilt, _ = perform Attitude () in
  perform Command (0.0, 0.0);
  (if n mod 10 = 0 then perform ShowNumber tilt else ());
  delay 100

let rec drive (n : nat) : unit # [0, ∞) =
  match n with
  | 0 -> ()
  | m + 1 ->
      drive_step m;
      drive m

(* Correctly accepted by the typechecker: the robot is calibrated, held
   upright for a second, armed with a calibration 1000.1 to 1012.5 ms old,
   and driven for about 13 years, after which it is disarmed and the
   supervision repeats. *)
let supervise () =
  let token = calibrate () in
  perform ShowText "Hold upright";
  delay 1000;
  unbox token as calibration in
  perform Arm calibration;
  perform ShowText "Armed";
  drive 4000000000;
  perform Disarm ()

(* Correctly rejected by the typechecker: the robot is armed with the boxed
   calibration, not with an unboxed one:

     Typing error: Operation `Arm` takes an argument of type `calibration` but
       is given `[_]calibration`
       ...
*)
(*
let supervise_unchecked () =
  let token = calibrate () in
  perform Arm token;
  drive 4000000000
*)

(* Correctly rejected by the typechecker: the robot is armed with a
   calibration more than ten minutes old:

     Typing error: Variable `token` is unboxed with grade
       `[600000.1, 600012.5]`
       accumulated since it was bound, which is not below its box grade
       `[0, 600000)`
       ...
       Note: the resource inequality `[600000.1, 600012.5] <= [0, 600000)`
       does not hold
*)
(*
let supervise_late () =
