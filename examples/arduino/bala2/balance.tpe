(* The supervision. The bias of the gyroscope is the mean of 50 rates
   published by the step 10 ms apart, with the robot held still; the
   calibration is boxed with a delay of at least a second, and starting the
   balancing needs it unboxed, that is, at least a second after the
   calibration, in which the robot is to be held upright. *)

let rec rate_sum (n : nat) (sum : float) : float # [0, ∞) =
  match n with
  | 0 -> sum
  | m + 1 ->
      let _, rate = perform LatestTilt () in
      delay 10;
      rate_sum m (sum +. rate)

let calibrate () =
  perform StopBalancing ();
  perform ClearDisplay ();
  perform ShowTextAt (0, 0, 2, "Balancing robot");
  perform ShowTextAt (188, 230, 1, "Typechecked by Tempore");
  perform ShowText "Calibrating";
  let sum = rate_sum 50 0.0 in
  box [1000, ∞) (Calibration (sum /. 50.0))

(* Correctly accepted by the typechecker: an iteration of the drive moves with
   zero setpoints, shows the tilt every tenth iteration and waits 100 ms; it
   takes 100 to 112.6 ms, within the 200 ms after which a move expires. *)
let drive_step (n : nat) : unit # [0, 200) =
  let tilt, _ = perform LatestTilt () in
  perform Move (0.0, 0.0);
  (if n mod 10 = 0 then perform ShowNumber tilt else ());
  delay 100

let rec drive (n : nat) : unit # [0, ∞) =
  match n with
  | 0 -> ()
  | m + 1 ->
      drive_step m;
      drive m

(* Correctly accepted by the typechecker: the robot is calibrated, held
   upright for a second, started with a calibration 1000.05 to 1012.5 ms
   old, and driven for about 13 years, after which it is stopped and the
   supervision repeats. *)
let supervise () =
  let token = calibrate () in
  perform ShowText "Hold upright";
  delay 1000;
  unbox token as calibration in
  perform StartBalancing calibration;
  perform ShowText "Balancing";
  drive 4000000000;
  perform StopBalancing ()

(* Correctly rejected by the typechecker: the robot is started 100 ms after
   the message, before it can be held upright:

     Typing error: Variable `token` is unboxed with grade `[100.05, 112.5]`
       accumulated since it was bound, which is not below its box grade
       `[1000, ∞)`
       ...
       Note: the resource inequality `[100.05, 112.5] <= [1000, ∞)` does not
       hold
*)
(*
let supervise_hasty () =
  let token = calibrate () in
  perform ShowText "Hold upright";
  delay 100;
