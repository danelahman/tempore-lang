  else perform SendBeat ()
*)

(* An iteration of the armed phase from the default implementations of the
   operations: no touch, the unit flat, no status, and Beat sent. *)
run (
  let latest, fresh = remote_status () in
  armed 1 (false, 0.0, true) (box {(!_ & ~SendDisarm)*} (0.0, 0.0))
    latest fresh)
