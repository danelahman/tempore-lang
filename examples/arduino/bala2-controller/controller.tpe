(* Correctly rejected by the typechecker: an iteration that waits 40 ms, to
   send at about 20 Hz, may take 76.95 ms with a redraw:

     Typing error: This function's body has grade `[40.2, 76.95]`, which
       does not match its annotated grade `[0, 50)`
       Note: the effect inequality `[40.2, 76.95] <= [0, 50)` does not hold
*)
(*
let iteration_slow
    ((m, (shown, shown_speed, shown_turn, speed_next)) : mode * view) :
    mode * view # [0, 50) =
  let touched, x, y = perform ReadTouch () in
  let m = next m (if touched then press x y else NoPress) in
  let accel, _ = perform ReadImu () in
