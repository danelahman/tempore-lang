(* The controller of the BALA2 on the M5Stack CoreS3: drive by tilt over
   ESP-NOW, arm and disarm by touch, under rigid timed regular expressions

   Run this example with the 'regex-timed-rigid-interval-rational-symbolic' grading monoid, e.g.

     ./tempore --grades regex-timed-rigid-interval-rational-symbolic \
       --package m5-imu \
       --package m5-display \
       --package m5-touch \
       --package esp-now \
       --package bala2-remote \
       --board m5stack-cores3 \
       examples/arduino/bala2-controller/controller.tpe

   Grades [L, U]: a lower bound in the coverage order and an upper bound in
   the rigid allowance order on the traces with rational durations
     - Unit [{0}, {0}]: nothing demanded, only the empty trace allowed
     - Top [{0}, ∞): nothing demanded, every trace allowed
     - Product: concatenation of traces, componentwise *)

(* Runs on the M5Stack CoreS3 (controller.device.json): 'remote' as a free
   task, sending the messages of the package bala2-remote, one operation per
   message, to the robot of examples/arduino/bala2-remote, under 50 ms
   apart, and receiving its status, on which it drives; a bubble level
   shows the tilt that steers it. On the board: make
   arduino-bala2-controller-upload REMOTE_PEER=XX:XX:XX:XX:XX:XX, the
   address of the robot (by default broadcast); simulated on the host, with
   world.cpp tilting and touching the device: make
   arduino-bala2-controller-simulate. *)

(* The command of a tilt: the dead zone, in degrees, and the gain and the
   bound of the speed of the wheels, in encoder counts per second, per
   degree of pitch, and of the turn, a difference of the drives of the
   motors in units of 1023, per degree of roll. A pitch of 30 degrees gives
   the greatest speed, 400 counts per second, about 0.2 m/s. *)
let dead_zone = 5.0
let speed_gain = 16.0
let speed_limit = 400.0
let turn_gain = 4.0
let turn_limit = 100.0

let clamp (limit : float) (x : float) =
  if x < ~-.limit then ~-.limit else if x > limit then limit else x

(* x rounded to the nearest whole number, a half away from zero. *)
let whole (x : float) =
  if x < 0.0 then float_of_int (int_of_float (x -. 0.5))
  else float_of_int (int_of_float (x +. 0.5))

(* The command of an angle: zero within the dead zone, and beyond it the
   gain times the excess, bounded and rounded. *)
let command (gain : float) (limit : float) (angle : float) =
  if angle > dead_zone then whole (clamp limit (gain *. (angle -. dead_zone)))
  else if angle < ~-.dead_zone then
    whole (clamp limit (gain *. (angle +. dead_zone)))
  else 0.0

(* The buttons Arm and Disarm, 156 by 40 pixels, side by side at the bottom
   of the screen. *)
type press = ArmPress | DisarmPress | NoPress

let press (x : nat) (y : nat) =
  if y < 188 then NoPress
  else if x < 156 then ArmPress
  else if x >= 164 then DisarmPress
  else NoPress

(* Arm, sent 80 times 12.5 ms apart, for 1 s, within which the robot, which
   reads only the latest packet, polls at least twice; and Disarm, sent 20
   times, for 250 ms, within which the armed robot reads at least five
   messages. *)
let arm_five () : unit # {(SendArm; !25/2)^5} =
  perform SendArm ();
  delay 25/2;
  perform SendArm ();
  delay 25/2;
  perform SendArm ();
  delay 25/2;
  perform SendArm ();
  delay 25/2;
  perform SendArm ();
  delay 25/2

let arm_twenty () : unit # {(SendArm; !25/2)^20} =
  arm_five ();
  arm_five ();
  arm_five ();
  arm_five ()

let arming () : unit # {(SendArm; !25/2)^80} =
  arm_twenty ();
  arm_twenty ();
  arm_twenty ();
  arm_twenty ()

let disarm_five () : unit # {(SendDisarm; !25/2)^5} =
  perform SendDisarm ();
  delay 25/2;
  perform SendDisarm ();
  delay 25/2;
  perform SendDisarm ();
  delay 25/2;
  perform SendDisarm ();
  delay 25/2;
  perform SendDisarm ();
  delay 25/2

let disarming () : unit # {(SendDisarm; !25/2)^20} =
  disarm_five ();
  disarm_five ();
  disarm_five ();
  disarm_five ()

(* The neutral tilt of a session: the pitch and the roll, in degrees, at
   which the CoreS3 is held when Arm is tapped, from which the speed and the
   turn are measured. It is boxed with {(!_ & ~SendDisarm)*}, so that it is
   used only before the next Disarm, within its session. *)
type neutral = [{(!_ & ~SendDisarm)*}](float * float)

(* Reads the neutral tilt. *)
let record_neutral () : neutral # {ReadImu} =
  let accel, _ = perform ReadImu () in
  box {(!_ & ~SendDisarm)*} (tilt_x_of_accel accel, tilt_y_of_accel accel)

(* The handshake: after the arming, Arm again every 12.5 ms until the status
   of the robot says it is armed, at most 40 more times; it returns the last
   status received, in its two boxes, for the first iteration of the armed
   phase. *)
let rec confirm (n : nat) : latest_status * fresh_status
    # {SendArm; !25/2; Receive; (SendArm; !25/2; Receive)*} =
  perform SendArm ();
  delay 25/2;
  let latest, fresh = remote_status () in
  unbox latest as s in
  match n with
  | 0 -> (latest, fresh)
  | m + 1 -> if remote_armed s then (latest, fresh) else confirm m

(* The bubble level: a vial of radius 56 pixels centred at (62, 122), its
   inner circle of radius 14 marking the dead zone, and the greatest offset
   of the bubble, 46 pixels. The colours: green while the robot confirms it
   is armed, grey without a link, and dark grey while disarmed. *)
let vial_x = 62
let vial_y = 122
let vial_r = 56
let inner = 14.0
let outer = 46.0
let green = 0x00c000
let grey = 0x808080
let dark_grey = 0x404040

(* The tilt at which the speed and the turn reach their bounds, 30 degrees
   for both: the dead zone and the bound divided by the gain, 5 + 400 / 16
   and 5 + 100 / 4. *)
let full_tilt = 30.0

let magnitude (x : float) = if x < 0.0 then ~-.x else x

(* The offset of the bubble, in pixels, for an angle beyond the neutral
   tilt, in degrees: the dead zone fills the inner circle, and the rest of
   the range, up to full_tilt, the vial out to the greatest offset, so that
   the bubble leaves the inner circle as the command leaves zero and reaches
   the edge as the command reaches its bound. Each axis is scaled alone. *)
let bubble (angle : float) =
  let a = magnitude angle in
  let d =
    if a <= dead_zone then a *. inner /. dead_zone
    else
      inner
      +. ((if a > full_tilt then full_tilt else a) -. dead_zone)
         *. (outer -. inner) /. (full_tilt -. dead_zone)
  in
  int_of_float (whole (if angle < 0.0 then ~-.d else d))

(* The vial with its bubble at an offset, pitch forwards drawing the bubble
   up and roll to the right drawing it right, as a stick pushed that way. *)
let draw_bubble (pitch : float) (roll : float) (colour : nat) =
  perform DrawLevel
    (vial_x, vial_y, vial_r, bubble roll, ~-!(bubble pitch), colour)

(* Disarmed: Beat every 10.5 ms after a reading of the touch screen, until a
   tap on Arm; false if none comes in n readings. With dim, the first
   iteration draws the bubble centred and dark grey after its Beat. *)
let rec idle (n : nat) (dim : bool) : bool
    # {(ReadTouch; SendBeat; (DrawLevel | 0); !21/2)*; (ReadTouch | 0)} =
  match n with
  | 0 -> false
  | m + 1 ->
      let touched, x, y = perform ReadTouch () in
      if touched && press x y = ArmPress then true
      else (
        perform SendBeat ();
        (if dim then draw_bubble 0.0 0.0 dark_grey else ());
        delay 21/2;
        idle m false)

(* What the screen shows: whether the link is shown, the tilt of the robot
   shown, and whether the bubble is redrawn next, else the tilt. *)
type view = bool * float * bool

(* Correctly accepted by the typechecker: armed, an iteration reads the
   unit by read_imu_boxed of the package m5-imu, reads the touch screen, and
   ends the phase at a tap on Disarm; otherwise it unboxes the status of the
   robot received at the end of the last iteration, or by the handshake.
   If that status is of an armed robot, the link holds, and the iteration
   sends Drive with the speed from the pitch and the turn from the roll of
   the reading, each less that of the neutral tilt of the session; else it
   sends Beat. It redraws at most one item: the state, "Armed" or "No link",
   when it changes, and else, in turn, the bubble of the tilt beyond the
   neutral tilt, green with the link and grey without, or the tilt of the
   robot, if it changed and the link holds. It waits 10.5 ms and receives
   the status for the next iteration.

   The boxes span the readings of the unit and the touch screen: those of
   the reading, {(!_ & ~ReadImu)*} and [0, 2], as before; those of the
   status, {(!_ & ~Receive)*} and [0, 200), so that the command is decided
   on the latest status, received at most 200 ms earlier; the tilt shown
   comes from the second. The neutral tilt is unboxed after the readings
   and boxed again for the next iteration. An iteration takes 10.7 to 47.55
   ms, a redraw of the state or the tilt taking up to 33 ms and one of the
   bubble up to 10 ms. *)
let rec armed (n : nat) ((link_shown, shown_tilt, bubble_next) : view)
    (zero : neutral) (latest : latest_status) (fresh : fresh_status) : view
    # {(ReadImu; ReadTouch; (SendDrive | SendBeat);
        (ShowTextAt | ShowNumberAt | DrawLevel | 0); !21/2; Receive)*;
       (ReadImu; ReadTouch | 0)} =
  match n with
  | 0 -> (link_shown, shown_tilt, bubble_next)
  | m + 1 ->
      let reading_latest, reading_recent = read_imu_boxed () in
      let touched, x, y = perform ReadTouch () in
      if touched && press x y = DisarmPress then
        (link_shown, shown_tilt, bubble_next)
      else
        unbox reading_latest as latest_reading in
        unbox reading_recent as recent_reading in
        unbox zero as neutral in
        unbox latest as status in
        unbox fresh as recent_status in
        let pitched, _ = latest_reading in
        let rolled, _ = recent_reading in
        let neutral_pitch, neutral_roll = neutral in
        let pitch = tilt_x_of_accel pitched -. neutral_pitch in
        let roll = tilt_y_of_accel rolled -. neutral_roll in
        let speed = command speed_gain speed_limit pitch in
        let turn = command turn_gain turn_limit roll in
        let link = remote_armed status in
        let tilt =
          match recent_status with Status (_, t) -> t | NoStatus -> shown_tilt
        in
        (if link then perform SendDrive (speed, turn) else perform SendBeat ());
        let view =
          if link = link_shown then
            if bubble_next then (
              draw_bubble pitch roll (if link then green else grey);
              (link, shown_tilt, false))
            else if (not link) || tilt = shown_tilt then
              (link, shown_tilt, true)
            else (
              perform ShowNumberAt (130, 110, 3, 1, tilt);
              (link, tilt, true))
          else (
            (if link then perform ShowTextAt (0, 30, 2, "Armed")
             else perform ShowTextAt (0, 30, 2, "No link"));
            (link, shown_tilt, bubble_next))
        in
        delay 21/2;
        let latest, fresh = remote_status () in
        armed m view (box {(!_ & ~SendDisarm)*} neutral) latest fresh

(* Correctly accepted by the typechecker: a session sends Beat until a tap
   on Arm, records the neutral tilt, sends Arm 80 times and then until the
   robot confirms, Drive or Beat until a tap on Disarm, and Disarm 20
   times, in this order; its grade is the protocol of the controller, and
   its strict delays and operations bound the time from the end of one
   message to the start of the next by 46.95 ms, below the 50 ms within
   which the robot expects one: after the last Disarm, the wait of 12.5 ms,
   the redraw of the state, up to 33 ms, and the reading of the touch
   screen, before the first Beat; the bubble, dimmed, is redrawn after that
   Beat. *)
let rec session (n : nat) (v : view) : unit
    # {((ReadTouch; SendBeat; (DrawLevel | 0); !21/2)*; (ReadTouch | 0);
        ReadImu; (SendArm; !25/2)^80; SendArm; !25/2; Receive;
        (SendArm; !25/2; Receive)*;
        (ReadImu; ReadTouch; (SendDrive | SendBeat);
         (ShowTextAt | ShowNumberAt | DrawLevel | 0); !21/2; Receive)*;
        (ReadImu; ReadTouch | 0); (SendDisarm; !25/2)^20; ShowTextAt)*;
       ((ReadTouch; SendBeat; (DrawLevel | 0); !21/2)*; (ReadTouch | 0) | 0)}
    =
  match n with
  | 0 -> ()
  | m + 1 ->
      if idle 4000000000 true then (
        let zero = record_neutral () in
        arming ();
        let latest, fresh = confirm 40 in
        unbox zero as neutral in
        let v =
          armed 4000000000 v (box {(!_ & ~SendDisarm)*} neutral) latest fresh
        in
        disarming ();
        perform ShowTextAt (0, 30, 2, "Disarmed");
        session m v)
      else ()

let remote () =
  perform LinkStart remote_channel;
  perform ClearDisplay ();
  perform ShowTextAt (0, 0, 2, "Robot remote");
  perform ShowTextAt (80, 230, 1, "Typechecked by Tempore (tempore-lang.ee)");
  perform ShowTextAt (0, 30, 2, "Disarmed");
  perform ShowTextAt (130, 80, 2, "Robot tilt");
  perform ShowNumberAt (130, 110, 3, 1, 0.0);
  perform DrawButton (0, 188, 156, 40, "Arm");
  perform DrawButton (164, 188, 156, 40, "Disarm");
  session 4000000000 (false, 0.0, true)

(* Correctly rejected by the typechecker: a session that sends Arm once,
   which the robot, polling every 400 ms, may miss:

     Typing error: This function's body has grade `[{(ReadTouch; SendBeat;
       !10.5)*; (ReadTouch | 0); (0 | ReadImu; SendArm; !12.5; SendArm;
       !12.5; Receive; ...`, which does not match its annotated grade
       `[{((ReadTouch; SendBeat; !10.5)*; (ReadTouch | 0); ReadImu; (SendArm;
       !12.5)^80; ...`
       ...
*)
