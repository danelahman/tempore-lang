(* The controller of the BALA2 on the M5Stack CoreS3: drive by tilt over
   ESP-NOW, arm and disarm by touch, under rigid timed regular expressions

   Run this example with the 'regex-timed-rigid-interval-rational-symbolic' grading monoid, e.g.

     ./tempore --grades regex-timed-rigid-interval-rational-symbolic \
       --package m5-imu \
       --package m5-display \
       --package m5-touch \
       --package esp-now \
       --package bala2-remote \
       --board m5stack-cores3 \
       examples/arduino/bala2-controller/controller.tpe

   Grades [L, U]: a lower bound in the coverage order and an upper bound in
   the rigid allowance order on the traces with rational durations
     - Unit [{0}, {0}]: nothing demanded, only the empty trace allowed
     - Top [{0}, ∞): nothing demanded, every trace allowed
     - Product: concatenation of traces, componentwise *)

(* Runs on the M5Stack CoreS3 (controller.device.json): 'remote' as a free
   task, sending the messages of the package bala2-remote, one operation per
   message, to the robot of examples/arduino/bala2-remote, under 50 ms
   apart. On the board: make arduino-bala2-controller-upload
   REMOTE_PEER=XX:XX:XX:XX:XX:XX, the address of the robot (by default
   broadcast); simulated on the host, with world.cpp tilting and touching
   the device: make arduino-bala2-controller-simulate. *)

(* The command of a tilt: the dead zone, in degrees, and the gain and the
   bound of the speed of the wheels, in encoder counts per second, per
   degree of pitch, and of the turn, a difference of the drives of the
   motors in units of 1023, per degree of roll. A pitch of 30 degrees gives
   the greatest speed, 400 counts per second, about 0.2 m/s. *)
let dead_zone = 5.0
let speed_gain = 16.0
let speed_limit = 400.0
let turn_gain = 4.0
let turn_limit = 100.0

let clamp (limit : float) (x : float) =
  if x < ~-.limit then ~-.limit else if x > limit then limit else x

(* x rounded to the nearest whole number, a half away from zero. *)
let whole (x : float) =
  if x < 0.0 then float_of_int (int_of_float (x -. 0.5))
  else float_of_int (int_of_float (x +. 0.5))

(* The command of an angle: zero within the dead zone, and beyond it the
   gain times the excess, bounded and rounded. *)
let command (gain : float) (limit : float) (angle : float) =
  if angle > dead_zone then whole (clamp limit (gain *. (angle -. dead_zone)))
  else if angle < ~-.dead_zone then
    whole (clamp limit (gain *. (angle +. dead_zone)))
  else 0.0

(* The buttons Arm and Disarm, 156 by 40 pixels, side by side at the bottom
   of the screen. *)
type press = ArmPress | DisarmPress | NoPress

let press (x : nat) (y : nat) =
  if y < 188 then NoPress
  else if x < 156 then ArmPress
  else if x >= 164 then DisarmPress
  else NoPress

(* Disarmed: Beat every 10.5 ms after a reading of the touch screen, until a
   tap on Arm; false if none comes in n readings. *)
let rec idle (n : nat) : bool
    # {(ReadTouch; SendBeat; !21/2)*; (ReadTouch | 0)} =
  match n with
  | 0 -> false
  | m + 1 ->
      let touched, x, y = perform ReadTouch () in
      if touched && press x y = ArmPress then true
      else (
        perform SendBeat ();
        delay 21/2;
        idle m)

(* Arm and Disarm, each sent 20 times 12.5 ms apart, about 250 ms, since the
   robot reads only the latest packet. *)
let arm_five () : unit # {(SendArm; !25/2)^5} =
  perform SendArm ();
  delay 25/2;
  perform SendArm ();
  delay 25/2;
  perform SendArm ();
  delay 25/2;
  perform SendArm ();
  delay 25/2;
  perform SendArm ();
  delay 25/2

let arming () : unit # {(SendArm; !25/2)^20} =
  arm_five ();
  arm_five ();
  arm_five ();
  arm_five ()

let disarm_five () : unit # {(SendDisarm; !25/2)^5} =
  perform SendDisarm ();
  delay 25/2;
  perform SendDisarm ();
  delay 25/2;
  perform SendDisarm ();
  delay 25/2;
  perform SendDisarm ();
  delay 25/2;
  perform SendDisarm ();
  delay 25/2

let disarming () : unit # {(SendDisarm; !25/2)^20} =
  disarm_five ();
  disarm_five ();
  disarm_five ();
  disarm_five ()

(* What the screen shows: the speed and the turn shown, and whether the
   speed is redrawn next. *)
type view = float * float * bool

(* Correctly accepted by the typechecker: armed, an iteration reads the
   unit by read_imu_boxed of the package m5-imu, which returns the reading
   in two boxes, reads the touch screen, and ends the phase at a tap on
   Disarm, dropping the reading; otherwise it sends Drive with the speed
   from the pitch and the turn from the roll of the reading, redraws at
   most the speed or the turn, in turn, if it changed, and waits 10.5 ms.
   The boxes span the reading of the touch screen: {(!_ & ~ReadImu)*}
   admits it but no second reading of the unit, so that the command is that
   of the latest reading; [0, 2] admits it by its bound of [0, 1.45] ms on
   the CoreS3, so that the command is sent within 2 ms of the reading of
   the unit, and no slower operation fits between. The speed comes from the
   first box and the turn from the second. An iteration takes 10.7 to
   47.45 ms. *)
let rec armed (n : nat) ((shown_speed, shown_turn, speed_next) : view) : view
    # {(ReadImu; ReadTouch; SendDrive; (ShowNumberAt | 0); !21/2)*;
       (ReadImu; ReadTouch | 0)} =
  match n with
  | 0 -> (shown_speed, shown_turn, speed_next)
  | m + 1 ->
      let latest, recent = read_imu_boxed () in
      let touched, x, y = perform ReadTouch () in
      if touched && press x y = DisarmPress then
        (shown_speed, shown_turn, speed_next)
      else
        unbox latest as latest_reading in
        unbox recent as recent_reading in
        let pitched, _ = latest_reading in
        let rolled, _ = recent_reading in
        let speed =
          command speed_gain speed_limit (tilt_x_of_accel pitched)
        in
        let turn = command turn_gain turn_limit (tilt_y_of_accel rolled) in
        perform SendDrive (speed, turn);
        let view =
          if speed_next then
            if speed = shown_speed then (shown_speed, shown_turn, false)
            else (
              perform ShowNumberAt (120, 100, 2, 0, speed);
              (speed, shown_turn, false))
          else if turn = shown_turn then (shown_speed, shown_turn, true)
          else (
            perform ShowNumberAt (120, 140, 2, 0, turn);
            (shown_speed, turn, true))
        in
        delay 21/2;
        armed m view

(* Correctly accepted by the typechecker: a session sends Beat until a tap
   on Arm, Arm 20 times, Drive until a tap on Disarm, and Disarm 20 times,
   in this order; its grade is the protocol of the controller, and its
   strict delays and operations bound the time from the end of one message
   to the start of the next by 48.45 ms, below the 50 ms within which the
   robot expects one: after the last Arm, 12.5 ms, the redraw of the state,
   up to 33 ms, and the readings of the unit and the touch screen, up to
   1.5 and 1.45 ms, before the first Drive. *)
let rec session (n : nat) (v : view) : unit
    # {((ReadTouch; SendBeat; !21/2)*; (ReadTouch | 0);
        (SendArm; !25/2)^20; ShowTextAt;
        (ReadImu; ReadTouch; SendDrive; (ShowNumberAt | 0); !21/2)*;
        (ReadImu; ReadTouch | 0); (SendDisarm; !25/2)^20; ShowTextAt)*;
       ((ReadTouch; SendBeat; !21/2)*; (ReadTouch | 0) | 0)} =
  match n with
  | 0 -> ()
  | m + 1 ->
      if idle 4000000000 then (
        arming ();
        perform ShowTextAt (0, 60, 2, "Armed");
        let v = armed 4000000000 v in
        disarming ();
        perform ShowTextAt (0, 60, 2, "Disarmed");
        session m v)
      else ()

let remote () =
  perform LinkStart remote_channel;
  perform ClearDisplay ();
  perform ShowTextAt (0, 0, 2, "Robot remote");
  perform ShowTextAt (80, 230, 1, "Typechecked by Tempore (tempore-lang.ee)");
  perform ShowTextAt (0, 60, 2, "Disarmed");
  perform ShowTextAt (0, 100, 2, "Speed");
  perform ShowNumberAt (120, 100, 2, 0, 0.0);
  perform ShowTextAt (0, 140, 2, "Turn");
  perform ShowNumberAt (120, 140, 2, 0, 0.0);
  perform DrawButton (0, 188, 156, 40, "Arm");
  perform DrawButton (164, 188, 156, 40, "Disarm");
  session 4000000000 (0.0, 0.0, true)

