(* A peak tilt recorder on the M5Stack CoreS3 Lite: its flash writes counted

   Run this example with the 'counts-upper-bound' grading monoid, e.g.

     ./tempore --grades counts-upper-bound \
       --package m5-imu \
       --package m5-display \
       --board m5stack-cores3 \
       examples/arduino/peak/peak.tpe

   Grades ((A, n), ...): at most n calls of each operation A
     - Unit 0: no calls, the least grade
     - Top ∞: unlimited calls of every operation
     - Product: addition, name by name *)

(* An application of the Arduino backend under the operation counts, on the
   M5Stack CoreS3 Lite: the device manifest peak.device.json runs the step
   'step' every 20 ms, from the state of 'start', and repeats the recorder
   'record' as a free task. The recorder keeps the largest magnitude of the
   tilt in the flash memory of the board, so that it survives a reset. The
   operations ReadImu, ShowText, ShowNumber, ShowTextAt and ClearDisplay,
   and the functions tilt_x and tilt_x_of_accel, come from the packages
   m5-imu and m5-display, whose declarations under these grades precede
   this file. The operations declared below are bound by bindings.cpp. The
   host simulation tilts the unit by the default world of the backend, a
   harmonic oscillation.

   The PlatformIO project is written, and simulated on the host for 3
   seconds, by

     ./tempore --grades counts-upper-bound \
       --emit-arduino peak \
       --device examples/arduino/peak/peak.device.json \
       --host-simulate 3 \
       examples/arduino/peak/peak.tpe

   and built for the board, with PlatformIO, by --build in place of
   --host-simulate. The make targets arduino-peak-simulate, -build, -upload
   and -profile run these commands and their variants for the board;
   'make examples-help' lists them with their variables.

   The grades count the calls of the operations and bound no durations, so
   the step is not checked against its period by the typechecker, only by
   the monitor of the device; the operations have no running-time bounds,
   and their calls are not monitored. The option --board m5stack-cores3 of
   the interpreter run names the board of the manifest, whose running-time
   bounds do not apply under these grades. *)

(* The exchange between the tasks, through bindings.cpp: the step publishes
   the tilt, in degrees, and the recorder reads the tilt last published. *)

operation Publish : float ~> unit # (Publish, 1)
default Publish _ = ()

operation Latest : unit ~> float # (Latest, 1)
default Latest () = 0.0

(* The record in the flash memory, through bindings.cpp: LoadPeak reads it,
   and StorePeak writes it, which erases a sector of the flash from time to
   time; a sector endures a limited number of erasures. *)

operation LoadPeak : unit ~> float # (LoadPeak, 1)
default LoadPeak () = 0.0

operation StorePeak : float ~> unit # (StorePeak, 1)
default StorePeak _ = ()

(* The period, in seconds, and the weight of the gyroscope in the
   complementary filter of the tilt. *)
let period = 0.02
let gyro_weight = 0.9

(* Correctly accepted by the typechecker: the step reads the unit once,
   filters the tilt and publishes it once; it performs no other operation,
   and in particular does not write the flash. *)
let step (tilt : float) : float # ((ReadImu, 1), (Publish, 1)) =
  let imu = perform ReadImu () in
  let tilt = tilt_x gyro_weight period tilt imu in
  perform Publish tilt;
  tilt

(* The initial state: the tilt from the accelerometer alone. *)
let start () : float =
  let accel, _ = perform ReadImu () in
  tilt_x_of_accel accel

(* Correctly rejected by the typechecker: the step writes the flash itself:

     Typing error: This function's body has grade
       `((Publish, 1), (ReadImu, 1), (StorePeak, 1))`, which does not match
       its annotated grade `((Publish, 1), (ReadImu, 1))`
       Note: the effect inequality
         `((Publish, 1), (ReadImu, 1), (StorePeak, 1)) <=
         ((Publish, 1), (ReadImu, 1))` does not hold
*)
(*
let step_stored (tilt : float) : float # ((ReadImu, 1), (Publish, 1)) =
  let imu = perform ReadImu () in
  let tilt = tilt_x gyro_weight period tilt imu in
  perform Publish tilt;
  perform StorePeak tilt;
  tilt
*)

let magnitude (x : float) = if x < 0.0 then ~-.x else x

(* Correctly accepted by the typechecker: an iteration of the recorder writes
   the flash at most once. It reads the record, which is boxed with no write
   of the flash allowed, so that the copy is unboxed only while it equals the
   record. It writes the magnitude of the tilt last published if it exceeds
   the record by more than half a degree, shows the record, between the name
   of the example and the footer in small text, and waits one second. *)
let record () : unit # ((StorePeak, 1), (_, ∞)) =
  let stored = perform LoadPeak () in
  box ((StorePeak, 0), (_, ∞)) stored as copy in
  let tilt = magnitude (perform Latest ()) in
  unbox copy as peak in
  let peak =
    if tilt > peak +. 0.5 then (
      perform StorePeak tilt;
      tilt)
    else peak
  in
  perform ClearDisplay ();
  perform ShowTextAt (0, 0, 1, "Peak tilt recorder");
  perform ShowText "Peak tilt";
  perform ShowNumber peak;
  perform ShowTextAt (0, 230, 1, "Powered by Tempore (tempore-lang.ee)");
  delay 1000

(* Correctly rejected by the typechecker: the recorder compares a second tilt
   with the copy of the record read before the first write, which may then
   overwrite a greater record with a smaller one:

     Typing error: Variable `copy` is unboxed with grade
       `((Latest, 2), (StorePeak, 1))` accumulated since it was bound, which
       is not below its box grade `((StorePeak, 0), (_, ∞))`
       ...
       Note: the resource inequality
         `((Latest, 2), (StorePeak, 1)) <= ((StorePeak, 0), (_, ∞))` does not
         hold
*)
(*
let record_twice () =
  let stored = perform LoadPeak () in
  box ((StorePeak, 0), (_, ∞)) stored as copy in
  let first = magnitude (perform Latest ()) in
  unbox copy as peak in
  (if first > peak +. 0.5 then perform StorePeak first else ());
  delay 500;
  let second = magnitude (perform Latest ()) in
  unbox copy as peak in
  if second > peak +. 0.5 then perform StorePeak second else ()
*)

(* A step from the reading of the default implementation of the unit, and an
   iteration of the recorder with the default implementations, which read a
   tilt and a record of zero. *)
run step 3.0

run record ()
