(* A sprint start system on the M5Stack CoreS3 Lite: the gun 1.5 to 3 s after
   Set, its time read at once, and the start judged within a second of it

   Run this example with the 'regex-timed-rigid-interval-rational-symbolic' grading monoid, e.g.

     ./tempore --grades regex-timed-rigid-interval-rational-symbolic \
       --package m5-imu \
       --package m5-display \
       --package m5-touch \
       --package m5-speaker \
       --board m5stack-cores3 \
       examples/arduino/starter/starter.tpe

   Grades [L, U]: a lower bound in the coverage order and an upper bound in
   the rigid allowance order on the traces with rational durations
     - Unit [{0}, {0}]: nothing demanded, only the empty trace allowed
     - Top [{0}, ∞): nothing demanded, every trace allowed
     - Product: concatenation of traces, componentwise *)

(* Runs on the M5Stack CoreS3 Lite lying on a starting block or held in the
   hand (starter.device.json): 'starter' as a free task. A tap on Start
   gives "On your marks", checks for a second that the block is still, gives
   "Set" with a tone and fires the gun, a long tone, after a random hold;
   the block is then polled for the push, and the reaction time judged
   against 100 ms. "Stand up" abandons a start before the gun, and "Reset"
   clears the tally. bindings.cpp defines ReadClock and the safe state,
   world.cpp models the starts. The figures below are those under the
   bounds of the CoreS3, some of them provisional.

   On the board: make arduino-starter-upload; simulated on the host: make
   arduino-starter-simulate ('make examples-help',
   src/05-backends/arduino/README.md). *)

(* ReadClock () is the time since start-up, in microseconds, modulo 2^32.
   Its bounds are PROVISIONAL, not yet measured. *)
operation ReadClock : unit ~> nat # {ReadClock} within (0, 0.05]
default ReadClock () = delay 1/100; 0

(* An athlete at the start: the lane and the false starts charged to the
   athlete in this session. *)
type athlete = nat * nat

(* The protocol of a start, as three boxes nested in each other, each
   containing a function that creates the next. The box of the marks,
   created at On your marks, admits the Set command only a second or more
   after that command; the box of the Set, created at the Set command, the
   gun only 1.5 to 3 s after it; and the box of the gun, created at the gun,
   the judgement of the athlete only after the gun and the reading of its
   time, and within a second. Each command is the first operation after its
   box, and the reading of the time of the gun the second; the lower bounds
   demand the time after them, and the upper bounds bound it, any other
   operation coming within their delays. *)
type at_gun = [{Beep; ReadClock; [0, 1000]}]athlete
type at_set = [{ShowColourTextAt; [1500, 3000]}](unit -> at_gun)
type at_marks = [{ShowColourTextAt; [1000, ∞)}](unit -> at_set)

let marks (a : athlete) : at_marks =
  box {ShowColourTextAt; [1000, ∞)}
    (fun () ->
      box {ShowColourTextAt; [1500, 3000]}
        (fun () -> box {Beep; ReadClock; [0, 1000]} a))

(* The end of a start: abandoned by a tap on Stand up, the block not still
   at the marks, a movement in Set, no push within the polls after the gun,
   or a push, with the athlete and the reaction time, in microseconds. *)
type outcome =
  | Abandoned
  | Unsettled
  | Moved
  | NoStart
  | Reaction of nat * nat * nat

(* The tally of a session: the legal starts, the warnings, the
   disqualifications, the starts without a push and the best reaction time
   of a legal start, in microseconds, 0 before the first. *)
type tally = nat * nat * nat * nat * nat

(* The least deviations of the magnitude of the acceleration from its mean
   at the marks that count as a movement in Set and as the push, in g, and
   their ratios to the standard deviation at the marks; the polls at the
   marks; the shortest legal reaction time, in microseconds. *)
let move_least = 0.1
let move_ratio = 5.0
let push_least = 0.2
let push_ratio = 8.0
let mark_polls = 60.0
let false_start = 100000

(* The colours of 24 bits: the states, the text on them, and the
   background. *)
let green = 0x00c000
let yellow = 0xffd000
let orange = 0xff8000
let red = 0xe00000
let white = 0xffffff
let black = 0x000000

let absolute (x : float) = if x < 0.0 then ~-.x else x

(* The magnitude of the acceleration, in g. *)
let load () : float # {ReadImu} =
  let (ax, ay, az), _ = perform ReadImu () in
  sqrt ((ax *. ax) +. (ay *. ay) +. (az *. az))

(* The buttons, 40 pixels high from the row 188, each 156 pixels wide: Start
   from the column 0 and Reset from the column 164. *)
type key = Start | Reset | Elsewhere

let key (x : nat) (y : nat) =
  if y < 188 || y >= 228 then Elsewhere
  else if x < 156 then Start
  else if x >= 164 then Reset
  else Elsewhere

(* The time from the microsecond a to the microsecond b, modulo 2^32. *)
let elapsed (a : nat) (b : nat) =
  if b >= a then b - a else 4294967295 - a + b + 1

(* The state of the slow polls: the sum of the magnitudes and of their
   squares, the least and the greatest magnitude, whether the screen was
   touched at the last poll, and whether a touch began on Stand up. *)
type sense = float * float * float * float * bool * bool

(* The phases of a start are bounded by boxes, each checked from its binding
   to its unboxing. A recursion has a grade whose repetitions it includes,
   which bounds no duration; the polls are therefore written out as fixed
   sequences. The slow ones are annotated with the interval of their
   durations; the fast ones with their exact traces, a poll repeated a
   number of times, so that the box of the reaction window sees each of
   their operations and the box of the gun their number. *)

(* A reading of the unit and of the touch screen 19.5 ms after the last,
   19.7 to 22.45 ms. A touch begins where the screen is touched and was not
   at the last poll, so that the finger of the tap on Start begins none. *)
let poll_slow ((sum, square, lo, hi, held, stood) : sense) : sense
    # {19.5; ReadImu; ReadTouch} =
  delay 39/2;
  let m = load () in
  let touched, x, y = perform ReadTouch () in
  ( sum +. m,
    square +. (m *. m),
    min lo m,
    max hi m,
    touched,
    stood || (touched && (not held) && key x y = Start) )

(* Ten slow polls: 197 to 224.5 ms. *)
let ten_slow (s : sense) : sense # {[197, 224.5]} =
  poll_slow (poll_slow (poll_slow (poll_slow (poll_slow (poll_slow (poll_slow
    (poll_slow (poll_slow (poll_slow s)))))))))

let stood ((_, _, _, _, _, stood) : sense) = stood

(* Whether the magnitude left the band of the half width w about the mean
   m during the polls. *)
let moved (m : float) (w : float) ((_, _, lo, hi, _, _) : sense) =
  hi -. m > w || m -. lo > w

(* A slow poll unless the hold is over, the block moved or Stand up was
   tapped, with the optional polls left. *)
let poll_more (m : float) (w : float) ((s, left) : sense * nat) : sense * nat
    # {0 | 19.5; ReadImu; ReadTouch} =
  if left = 0 || stood s || moved m w s then (s, left)
  else (poll_slow s, left - 1)

let ten_more (m : float) (w : float) (s : sense * nat) : sense * nat
    # {[0, 224.5]} =
  let s = poll_more m w s in
  let s = poll_more m w s in
  let s = poll_more m w s in
  let s = poll_more m w s in
  let s = poll_more m w s in
  let s = poll_more m w s in
  let s = poll_more m w s in
  let s = poll_more m w s in
  let s = poll_more m w s in
  let s = poll_more m w s in
  s

(* Up to fifty optional polls: at most 1122.5 ms. *)
let fifty_more (m : float) (w : float) (s : sense * nat) : sense * nat
    # {[0, 1122.5]} =
  let s = ten_more m w s in
  let s = ten_more m w s in
  let s = ten_more m w s in
  let s = ten_more m w s in
  let s = ten_more m w s in
  s

(* A reading of the unit 2.5 ms after the last, unless the push was found,
   and the time read after it: whether the push was found, and its time.
   The reading is boxed with ReadClock, without delays: the push is judged
   only from a reading whose time was read at once, with no operation
   between. *)
let poll_fast (m : float) (w : float) ((found, at) : bool * nat) : bool * nat
    # {0 | !2.5; ReadImu; ReadClock} =
  if found then (found, at)
  else (
    delay 5/2;
    let a = load () in
    box {ReadClock} a as fresh in
    let t = perform ReadClock () in
    unbox fresh as reading in
    if absolute (reading -. m) > w then (true, t) else (false, at))

(* Ten fast polls, until the push: up to 40.5 ms. *)
let ten_fast (m : float) (w : float) (r : bool * nat) : bool * nat
    # {(0 | !2.5; ReadImu; ReadClock)^10} =
  let r = poll_fast m w r in
  let r = poll_fast m w r in
  let r = poll_fast m w r in
  let r = poll_fast m w r in
  let r = poll_fast m w r in
  let r = poll_fast m w r in
  let r = poll_fast m w r in
  let r = poll_fast m w r in
  let r = poll_fast m w r in
  let r = poll_fast m w r in
  r

(* Fifty fast polls, until the push: up to 202.5 ms. *)
let fifty_fast (m : float) (w : float) (r : bool * nat) : bool * nat
    # {(0 | !2.5; ReadImu; ReadClock)^50} =
  let r = ten_fast m w r in
  let r = ten_fast m w r in
  let r = ten_fast m w r in
  let r = ten_fast m w r in
  let r = ten_fast m w r in
  r

(* Two hundred fast polls, until the push: a push is found within 4.05 ms of
   its start, and no push declared 540 to 810 ms after the first poll. *)
let react (m : float) (w : float) : bool * nat
    # {(0 | !2.5; ReadImu; ReadClock)^200} =
  let r = fifty_fast m w (false, 0) in
  let r = fifty_fast m w r in
  let r = fifty_fast m w r in
  let r = fifty_fast m w r in
  r

(* The recall of the athletes: two tones 110 ms apart. *)
let recall () : unit # {Beep; [100, 120]; Beep} =
  perform Beep (800, 80);
  delay 110;
  perform Beep (800, 80)

(* Correctly accepted by the typechecker: the gun and the judgement. The gun
   is a tone of 300 ms, and the block is then polled for the push for up to
   810 ms. The box of the athlete, created at once before the gun, admits
   the judgement only after the gun and the reading of its time, at once,
   with no operation between, a redraw of the screen in particular, and
   within a second of the gun.

   The box of the reaction window, created with it, holds the measure of the
   reaction time. It admits the measure only after the gun, its time and
   nothing but polls, each reading of the unit followed at once by the
   reading of its time, and no pause longer than 2.5 ms between the time of
   a poll and the next reading: a push is thus seen within 4.05 ms of its
   start. It bounds no duration, which the box of the athlete does; and a
   repetition admits any number of rounds, none included, so that it
   demands no polls until a push or the end of the window, and admits the
   polls ended once the push is found. *)
let fire (gun : at_gun) (m : float) (w : float) : outcome
    # {Beep; ReadClock; [0, 810]} =
  box {Beep; ReadClock; (![0, 2.5]; ReadImu; ReadClock)*} elapsed
    as window in
  perform Beep (2500, 300);
  let fired = perform ReadClock () in
  let found, at = react m w in
  unbox gun as (lane, warnings) in
  unbox window as reaction in
  if found then Reaction (lane, warnings, reaction fired at) else NoStart

(* Correctly rejected by the typechecker: the screen is cleared between the
   gun and the reading of its time, which the time then misses by 31 to
   48 ms:

     Typing error: Variable `gun` is unboxed with grade
       `[{Beep; ClearDisplay; ReadClock; (0 | !2.5; ReadImu; ReadClock)^200},
       {Beep; ClearDisplay; ReadClock; (0 | !2.5; ReadImu; ReadClock)^200}]`
       accumulated since it was bound, which is not below its box grade
       `[{Beep; ReadClock; [0, 1000]}, {Beep; ReadClock; [0, 1000]}]`
       ...
*)
(*
let fire_cleared (gun : at_gun) (m : float) (w : float) : outcome
    # {Beep; ReadClock; [0, 810]} =
  box {Beep; ReadClock; (![0, 2.5]; ReadImu; ReadClock)*} elapsed
    as window in
  perform Beep (2500, 300);
  perform ClearDisplay ();
  let fired = perform ReadClock () in
  let found, at = react m w in
  unbox gun as (lane, warnings) in
  unbox window as reaction in
  if found then Reaction (lane, warnings, reaction fired at) else NoStart
*)

(* Correctly rejected by the typechecker: GO is shown on the screen after
   the reading of the time of the gun, before the polls, for up to 33 ms in
   which a push is not seen. The box of the athlete admits it, within its
   second:

     Typing error: Variable `window` is unboxed with grade
       `[{Beep; ReadClock; ShowColourTextAt; (0 | !2.5; ReadImu;
       ReadClock)^200}, {Beep; ReadClock; ShowColourTextAt; (0 | !2.5;
       ReadImu; ReadClock)^200}]` accumulated since it was bound, which is
       not below its box grade `[{Beep; ReadClock; (![0, 2.5]; ReadImu;
       ReadClock)*}, {Beep; ReadClock; (![0, 2.5]; ReadImu; ReadClock)*}]`
       ...
*)
(*
let fire_shown (gun : at_gun) (m : float) (w : float) : outcome
    # {Beep; ReadClock; ShowColourTextAt; [0, 810]} =
  box {Beep; ReadClock; (![0, 2.5]; ReadImu; ReadClock)*} elapsed
    as window in
  perform Beep (2500, 300);
  let fired = perform ReadClock () in
  perform ShowColourTextAt (0, 40, 3, black, green, "GO");
  let found, at = react m w in
  unbox gun as (lane, warnings) in
  unbox window as reaction in
  if found then Reaction (lane, warnings, reaction fired at) else NoStart
*)

(* Correctly accepted by the typechecker: a start, from the tap on Start to
   the outcome. On your marks: sixty slow polls, 1182 to 1347 ms, check that
   the spread of the magnitude is below 0.1 g and give its mean and standard
   deviation. Set: a tone, the time read, eighty slow polls, 1576 to
   1796 ms, and as many optional polls, up to fifty, as the time in
   microseconds modulo 51; the gun is thus fired 1576 to 2919 ms after the
   Set command. The polls are checked every ten, and a tap on Stand up or a
   movement in Set ends the start before the gun.

   The box of the marks is unboxed after the sixty polls, its thunk applied
   to create the box of the Set, which is unboxed after the hold, its thunk
   applied to create the box of the gun. Their lower bounds exclude a Set
   commanded at once and a gun fired after sixty polls of the hold, and the
   upper bound of the Set a hold of more than 3 s. A gun after the eighty
   fixed polls alone is accepted: that the hold is random is program logic.

   The grade is the protocol: On your marks and the polls, ended there or
   followed by the Set, its tone, the time and the hold, ended there or
   followed by the gun, its time and the polls for the push; 197.1 to
   5273.9 ms in all. *)
let start_once (a : athlete) : outcome
    # {ShowColourTextAt; ShowColourTextAt; DrawButton; DrawButton;
       [197, 1347];
       (0
       | ShowColourTextAt; ShowColourTextAt; Beep; ReadClock; [197, 2918.5];
         (0 | Beep; ReadClock; [0, 810]))} =
  let mark = marks a in
  perform ShowColourTextAt (0, 40, 3, black, white, "ON YOUR MARKS");
  perform ShowColourTextAt (0, 70, 2, black, white, "Settle for 1 s");
  perform DrawButton (0, 188, 156, 40, "Stand up");
  perform DrawButton (164, 188, 156, 40, "");
  let s = ten_slow (0.0, 0.0, 10.0, 0.0, true, false) in
  if stood s then Abandoned else
  let s = ten_slow s in
  if stood s then Abandoned else
  let s = ten_slow s in
  if stood s then Abandoned else
  let s = ten_slow s in
  if stood s then Abandoned else
  let s = ten_slow s in
  if stood s then Abandoned else
  let s = ten_slow s in
  if stood s then Abandoned else
  let sum, square, lo, hi, held, _ = s in
  let mean = sum /. mark_polls in
  let variance = (square /. mark_polls) -. (mean *. mean) in
  let deviation = sqrt (max 0.0 variance) in
  let move = max move_least (move_ratio *. deviation) in
  let push = max push_least (push_ratio *. deviation) in
  if hi -. lo > move_least then Unsettled else
  unbox mark as set_thunk in
  let set = set_thunk () in
  perform ShowColourTextAt (0, 40, 3, black, yellow, "SET");
  perform ShowColourTextAt (0, 70, 2, black, yellow, "Hold still");
  perform Beep (1500, 80);
  let now = perform ReadClock () in
  let s = ten_slow (0.0, 0.0, mean, mean, held, false) in
  if stood s then Abandoned else if moved mean move s then Moved else
  let s = ten_slow s in
  if stood s then Abandoned else if moved mean move s then Moved else
  let s = ten_slow s in
  if stood s then Abandoned else if moved mean move s then Moved else
  let s = ten_slow s in
  if stood s then Abandoned else if moved mean move s then Moved else
  let s = ten_slow s in
  if stood s then Abandoned else if moved mean move s then Moved else
  let s = ten_slow s in
  if stood s then Abandoned else if moved mean move s then Moved else
  let s = ten_slow s in
  if stood s then Abandoned else if moved mean move s then Moved else
  let s = ten_slow s in
  if stood s then Abandoned else if moved mean move s then Moved else
  let s, _ = fifty_more mean move (s, now mod 51) in
  if stood s then Abandoned else if moved mean move s then Moved else
  unbox set as gun_thunk in
  fire (gun_thunk ()) mean push

(* Correctly rejected by the typechecker: the gun is fired after sixty slow
   polls of the Set hold, 1182 to 1347 ms after the Set command:

     Typing error: Variable `set` is unboxed with grade
       `[{ShowColourTextAt^2; Beep; [197, 224.5]^6}, {ShowColourTextAt^2;
       Beep; [197, 224.5]^6}]` accumulated since it was bound, which is not
       below its box grade
       `[{ShowColourTextAt; [1500, 3000]}, {ShowColourTextAt; [1500, 3000]}]`
       ...
*)
(*
let start_early (a : athlete) : outcome =
  let mark = marks a in
  perform ShowColourTextAt (0, 40, 3, black, white, "ON YOUR MARKS");
  perform ShowColourTextAt (0, 70, 2, black, white, "Settle for 1 s");
  let s = ten_slow (ten_slow (ten_slow (ten_slow (ten_slow (ten_slow
    (0.0, 0.0, 10.0, 0.0, true, false)))))) in
  let sum, _, _, _, held, _ = s in
  let mean = sum /. mark_polls in
  unbox mark as set_thunk in
  let set = set_thunk () in
  perform ShowColourTextAt (0, 40, 3, black, yellow, "SET");
  perform ShowColourTextAt (0, 70, 2, black, yellow, "Hold still");
  perform Beep (1500, 80);
  let _ = ten_slow (ten_slow (ten_slow (ten_slow (ten_slow (ten_slow
    (0.0, 0.0, mean, mean, held, false)))))) in
  unbox set as gun_thunk in
  fire (gun_thunk ()) mean push_least
*)

(* The screen of the session: the title, the guarantee and the footer. *)
let frame () =
  perform ClearDisplay ();
  perform ShowTextAt (0, 0, 2, "Sprint start system");
  perform ShowTextAt
    (0, 20, 1, "Gun 1.5-3 s after Set; judged within 1 s of the gun");
  perform ShowTextAt (80, 230, 1, "Typechecked by Tempore (tempore-lang.ee)")

(* The tally and the athlete on the screen, in four rows from the row 100,
   22 pixels apart, and the buttons, a label first and at most 495 ms in
   all. Each band of text extends to the right edge, so each row is written
   from left to right. *)
let board ((legal, warned, out, none, best) : tally)
    ((lane, warnings) : athlete) : unit # {ShowTextAt; [0, 495]} =
  perform ShowTextAt (0, 100, 2, "Legal");
  perform ShowNumberAt (96, 100, 2, 0, float_of_nat legal);
  perform ShowTextAt (160, 100, 2, "Warnings");
  perform ShowNumberAt (280, 100, 2, 0, float_of_nat warned);
  perform ShowTextAt (0, 122, 2, "DQ");
  perform ShowNumberAt (96, 122, 2, 0, float_of_nat out);
  perform ShowTextAt (160, 122, 2, "No starts");
  perform ShowNumberAt (280, 122, 2, 0, float_of_nat none);
  perform ShowTextAt (0, 144, 2, "Best, s");
  if best = 0 then perform ShowTextAt (96, 144, 2, "-")
  else perform ShowNumberAt (96, 144, 2, 3, float_of_nat best /. 1000000.0);
  perform ShowTextAt (0, 166, 2, "Lane");
  perform ShowNumberAt (60, 166, 2, 0, float_of_nat lane);
  perform ShowTextAt (96, 166, 2, "False starts");
  perform ShowNumberAt (256, 166, 2, 0, float_of_nat warnings);
  perform DrawButton (0, 188, 156, 40, "Start");
  perform DrawButton (164, 188, 156, 40, "Reset")

(* The messages of the two lines of the state: in idle, after a reset,
   after a start abandoned or not still, without a push, legal, and a false
   start charged as a warning or a disqualification, after a movement in Set
   or not. *)
type message =
  | Ready
  | Cleared
  | StandUp
  | NotStill
  | NoPush
  | Legal
  | Warned of bool
  | Disqualified of bool

let say (m : message) : unit # {ShowColourTextAt; ShowColourTextAt} =
  match m with
  | Ready ->
      perform ShowColourTextAt (0, 40, 3, black, white, "READY");
      perform ShowColourTextAt (0, 70, 2, black, white, "Tap Start")
  | Cleared ->
      perform ShowColourTextAt (0, 40, 3, black, white, "READY");
      perform ShowColourTextAt (0, 70, 2, black, white, "Tally cleared")
  | StandUp ->
      perform ShowColourTextAt (0, 40, 3, black, white, "STAND UP");
      perform ShowColourTextAt (0, 70, 2, black, white, "Start abandoned")
  | NotStill ->
      perform ShowColourTextAt (0, 40, 3, black, orange, "NOT STILL");
      perform ShowColourTextAt
        (0, 70, 2, black, orange, "Settle and tap Start")
  | NoPush ->
      perform ShowColourTextAt (0, 40, 3, black, orange, "NO START");
      perform ShowColourTextAt (0, 70, 2, black, orange, "No push seen")
  | Legal ->
      perform ShowColourTextAt (0, 40, 3, black, green, "LEGAL START");
      perform ShowColourTextAt (0, 70, 2, black, green, "Reaction, s")
  | Warned in_set ->
      perform ShowColourTextAt (0, 40, 3, white, red, "FALSE START");
      if in_set then
        perform ShowColourTextAt
          (0, 70, 2, white, red, "Warning: moved in Set")
      else
        perform ShowColourTextAt (0, 70, 2, white, red, "Warning: under 0.1 s")
  | Disqualified in_set ->
      perform ShowColourTextAt (0, 40, 3, white, red, "DISQUALIFIED");
      if in_set then
        perform ShowColourTextAt (0, 70, 2, white, red, "Moved in Set")
      else
        perform ShowColourTextAt (0, 70, 2, white, red, "Reaction under 0.1 s")

(* A false start charged to the athlete, after a movement in Set or not: a
   warning for the first, a disqualification for each further one (the
   rule of the combined events), with the recall. *)
let charge ((legal, warned, out, none, best) : tally)
    ((lane, warnings) : athlete) (in_set : bool) : tally * athlete =
  recall ();
  if warnings = 0 then (
    say (Warned in_set);
    ((legal, warned + 1, out, none, best), (lane, 1)))
  else (
    say (Disqualified in_set);
    ((legal, warned, out + 1, none, best), (lane, warnings + 1)))

(* The outcome of a start on the screen and in the tally, for the athlete
   'a' of the session. A push within 100 ms of the gun is a false start,
   charged to the athlete judged after the gun; a movement in Set to the
   athlete of the session. *)
let conclude (t : tally) (a : athlete) (o : outcome) : tally * athlete =
  let legal, warned, out, none, best = t in
  match o with
  | Abandoned ->
      say StandUp;
      (t, a)
  | Unsettled ->
      say NotStill;
      (t, a)
  | Moved -> charge t a true
  | NoStart ->
      say NoPush;
      ((legal, warned, out, none + 1, best), a)
  | Reaction (lane, warnings, r) ->
      if r < false_start then charge t (lane, warnings) false
      else (
        say Legal;
        perform ShowColourNumberAt
          (160, 70, 2, 3, black, green, float_of_nat r /. 1000000.0);
        let best = if best = 0 || r < best then r else best in
        ((legal + 1, warned, out, none, best), (lane, warnings)))

(* Correctly accepted by the typechecker: a start, its outcome and the
   tally, On your marks first and at most 6 s in all. *)
let race (t : tally) (a : athlete) : tally * athlete
    # {ShowColourTextAt; [0, 6000]} =
  let o = start_once a in
  let t, a = conclude t a o in
  board t a;
  (t, a)

(* Correctly accepted by the typechecker: at most n polls of the touch
   screen 50 ms apart, in idle, a start following a touch begun on Start
   and a tone and a cleared tally one begun on Reset; with the tally, the
   athlete and whether the screen was touched at the last poll, taken as
   touched after a start, so that a finger left on the screen begins no
   touch.

   The grade is the session: rounds of a poll of the touch screen followed
   by a start, the tone of Reset with its message and the tally, or a wait
   of 50 ms; another operation fits only within the durations of a start
   and of the tally. *)
let rec officiate (n : nat) (t : tally) (a : athlete) (held : bool) : unit
    # {(ReadTouch;
        (ShowColourTextAt; [0, 6000]
        | Beep; ShowColourTextAt; ShowColourTextAt; ShowTextAt; [0, 495]
        | 50))*} =
  match n with
  | 0 -> ()
  | m + 1 ->
      let touched, x, y = perform ReadTouch () in
      let k = if touched && not held then key x y else Elsewhere in
      let t, a, held =
        if k = Start then
          let t, a = race t a in
          (t, a, true)
        else if k = Reset then (
          perform Beep (3000, 50);
          let lane, _ = a in
          say Cleared;
          board (0, 0, 0, 0, 0) (lane, 0);
          ((0, 0, 0, 0, 0), (lane, 0), touched))
        else (
          delay 50;
          (t, a, touched))
      in
      officiate m t a held

(* Correctly accepted by the typechecker: the task. The output data rate of
   the accelerometer is set to 400 Hz, at which the fast polls read a new
   sample each, and the session starts with an empty tally and the athlete
   of lane 1. *)
let starter () =
  frame ();
  perform ConfigureImu 400;
  say Ready;
  board (0, 0, 0, 0, 0) (1, 0);
  officiate 4000000000 (0, 0, 0, 0, 0) (1, 0) false

(* The judgement in the interpreter, which has no clock. The handler 'still'
   replaces the readings by those of a block at rest with its z axis up,
   and 'pushed' by those of a block pushed by 0.6 g; their cases perform
   their operations, and keep their running times. The default ReadClock
   returns 0, so that the reaction time of a run is 0 and a push is a false
   start. The box of the athlete is created by the run, in place of the
   boxes of the marks and the Set, whose polls take long to interpret. The
   device does not use them. *)
let still =
  handler
  | s -> s
  | ReadImu () k ->
      let _, gyro = perform ReadImu () in
      continue k with ((0.0, 0.0, 1.0), gyro)

let pushed =
  handler
  | s -> s
  | ReadImu () k ->
      let _, gyro = perform ReadImu () in
      continue k with ((0.0, 0.0, 1.6), gyro)

(* The athlete of lane 1, not warned, on a block at rest: no push within the
   two hundred polls, a start without a push. *)
run
  let o =
    handle
      fire (box {Beep; ReadClock; [0, 1000]} (1, 0)) 1.0 0.2
    with still
  in
  conclude (0, 0, 0, 0, 0) (1, 0) o

(* The athlete of lane 1, warned once, on a block pushed at once: the push
   found at the first poll, and the athlete disqualified. *)
run
  let o =
    handle
      fire (box {Beep; ReadClock; [0, 1000]} (1, 1)) 1.0 0.2
    with pushed
  in
  conclude (0, 1, 0, 0, 0) (1, 1) o
