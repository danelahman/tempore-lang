(* The counter at rest: the filter at 1 g, not armed; no run; no steps. *)
let rest : counter = (((1.0, 1.0, 1.0), false), (Still, 0, 0, 0), 0, 0, false)

(* The task: the output data rate of the accelerometer set to 100 Hz, the
   screen, and 4 billion rounds, at least 2.5 years. *)
let watch () =
  perform ConfigureImu 100;
  screen ();
  listen 4000000000 rest

(* Three rounds with the default implementations, which read a unit at
   rest: no step is counted. *)
run listen 3 rest
