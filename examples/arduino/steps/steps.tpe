    : unit # (ReadImu, [0, 0], [0, 50], [0, 50]) =
  match n with
  | 0 -> ()
  | m + 1 ->
      let a = load () in
      box (1, ReadImu, [10, 45], [0, 1.5]) a as first in
      perform DrawBar (0, 180, 320, 16, bar a, blue);
      delay 10;
      let b = load () in
      unbox first as a in
      let stepped = armed && a > high && b > high in
      let steps = if stepped then steps + 1 else steps in
      (if stepped then screen steps
       else perform DrawBar (0, 180, 320, 16, bar b, blue));
      delay 10;
      count_redrawn m steps ((armed && not stepped) || a < low || b < low)
*)

(* Correctly rejected by the typechecker: the second reading follows the
   first at once, so that it may return the same sample and confirm
   nothing; the readings remain at most 44.5 ms apart, and the invariant of
   the loop holds:

     Typing error: Variable `first` is unboxed with grade `{ReadImu}`
       accumulated since it was bound, which is not below its box grade
       `(1, ReadImu, [10, 45], [0, 1.5])`
       ...
       Note: the resource inequality `{ReadImu} <= (1, ReadImu, [10, 45],
       [0, 1.5])` does not hold
*)
