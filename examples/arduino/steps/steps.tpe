(* A step counter on the M5Stack CoreS3 Lite: the accelerometer calibrated
   from 50 samples and read at least every 50 ms, steps counted 250 ms apart

   Run this example with the 'event-separation' grading monoid, e.g.

     ./tempore --grades event-separation \
       --package m5-imu \
       --package m5-display \
       --package m5-touch \
       --package m5-speaker \
       --board m5stack-cores3 \
       examples/arduino/steps/steps.tpe

   Grades (X, lead, gaps, tail): the times before the first X, between the
   starts of consecutive Xs and from the start of the last X to the end;
   (X, [s, t]): gaps in [s, t] and lead and tail at most t; (n, X, lead,
   gaps, tail): exactly n Xs, the counts added by the product
     - Unit 0: no operation, no time spent
     - Top ⊤: any times before, between and after the operations
     - Product: (a, G, b) · (a', G', b') = (a, G ∪ G' ∪ {b + a'}, b') *)

(* Runs on the M5Stack CoreS3 Lite carried by a walker (steps.device.json):
   'watch' as a free task. It calibrates the accelerometer, beeps once and
   counts steps in one loop of rounds of two readings, which also draws the
   screen band by band and reads the touch screen. Two buttons at the bottom
   of the screen: "Calibrate" stops the counting and calibrates again, and
   "Reset", tapped twice, resets the count with a short beep. bindings.cpp
   defines CountStep, ResetSteps, ReadClock and ShowButton, world.cpp models
   walks, motions that are none and taps. The figures below are those under
   the bounds of the CoreS3, some of them provisional.

   On the board: make arduino-steps-upload; simulated on the host: make
   arduino-steps-simulate ('make examples-help',
   src/05-backends/arduino/README.md). *)

(* CountStep n adds n steps to the steps counted, kept by bindings.cpp, and
   ResetSteps sets them to zero; ReadClock () is the time since start-up, in
   milliseconds; ShowButton (x, y, w, h, active, s) draws a button labelled
   s from (x, y), w by h pixels, with a white border: dark grey with a white
   label, or, active, yellow with a black label. Their bounds are
   PROVISIONAL, not yet measured. *)

operation CountStep : nat ~> unit # {CountStep} within [0, 0.2]
default CountStep _ = delay 1/10

operation ResetSteps : unit ~> unit # {ResetSteps} within [0, 0.2]
default ResetSteps () = delay 1/10

operation ReadClock : unit ~> nat # {ReadClock} within [0, 0.05]
default ReadClock () = delay 1/100; 0

operation ShowButton : nat * nat * nat * nat * bool * string ~> unit
    # {ShowButton} within [0, 33]
default ShowButton _ = delay 3

(* The states of the counter: at rest, a run of steps not yet confirmed, a
   confirmed walk, and a rise in a motion along a line. *)
type status = Still | Checking | Walking | Linear

(* The weights of a reading in exponential moving averages: in each of the
   two smoothings of the magnitude, in the slow means of the magnitude and of
   the moments of the acceleration, and in the mean square of the step
   signal. The least half width of the hysteresis, in g, and its ratio to
   the root mean square of the step signal; the least effective dimension of
   the motion; the shortest and the longest time between rises, in ms; the
   steps of a confirming run; the assumed stride, in cm; the time within
   which a second tap on Reset resets, in ms. *)
let weight = 0.25
let slow_weight = 0.01
let power_weight = 0.005
let least_half_width = 0.03
let width_ratio = 0.35
let least_dimension = 1.4
let shortest_gap = 250
let longest_gap = 1500
let run_length = 4
let stride = 70
let window = 2000

(* The colours of 24 bits: the bar, the thresholds, the states and the
   background. *)
let blue = 0x00a0ff
let orange = 0xff8000
let green = 0x00c000
let yellow = 0xffd000
let white = 0xffffff
let black = 0x000000

(* The operations on vectors of m5-imu, in g. *)
let plus ((ax, ay, az) : vector) ((bx, by, bz) : vector) : vector =
  (ax +. bx, ay +. by, az +. bz)

let minus ((ax, ay, az) : vector) ((bx, by, bz) : vector) : vector =
  (ax -. bx, ay -. by, az -. bz)

let scale (s : float) ((x, y, z) : vector) : vector = (s *. x, s *. y, s *. z)

let dot ((ax, ay, az) : vector) ((bx, by, bz) : vector) =
  (ax *. bx) +. (ay *. by) +. (az *. bz)

let norm (v : vector) = sqrt (dot v v)

(* The moving average a moved towards b by the weight w. *)
let toward (w : float) (a : vector) (b : vector) : vector =
  plus a (scale w (minus b a))

(* The acceleration, in g. *)
let reading () : vector # {ReadImu} =
  let accel, _ = perform ReadImu () in
  accel

(* Correctly accepted by the typechecker: the calibration handler. The case
   of ReadImu performs the operation and resumes its continuation with the
   acceleration multiplied by the gain. A case is checked against the grade
   of its operation, {ReadImu}: its continuation is boxed with that grade,
   so that the case performs one ReadImu and nothing else, and the bounds of
   the counter hold under the handler. The Arduino backend compiles it to a
   direct call. A case averaging two readings is rejected, its grade
   {ReadImu; ReadImu} not below {ReadImu}. *)
let calibrated (gain : float) =
  handler
  | s -> s
  | ReadImu () k ->
      let accel, gyro = perform ReadImu () in
      continue k with (scale gain accel, gyro)

(* The calibration: the sum of the accelerations of ten readings added to
   sum, each followed by a delay of 10 ms. *)
let sample (sum : vector) : vector =
  let x = reading () in
  delay 10;
  plus sum x

let ten (sum : vector) =
  sample (sample (sample (sample (sample (sample (sample (sample (sample
    (sample sum)))))))))

(* The filter: the two smoothings of the magnitude of the acceleration, the
   slow mean of the magnitude, the mean square of the step signal, whether
   the step signal fell below the hysteresis since the last rise, and the
   slow means of the acceleration, of the squares of its components and of
   the products of consecutive components. *)
type filter = float * float * float * float * bool * vector * vector * vector

(* The squares of the components of a vector and the products of
   consecutive components. *)
let moments ((x, y, z) : vector) : vector * vector =
  ((x *. x, y *. y, z *. z), (x *. y, y *. z, z *. x))

(* The filter after a reading x, and whether the step signal rose above
   the hysteresis after it fell below it. The magnitude is smoothed by
   two exponential moving averages in series, a low-pass filter of about
   2 Hz at the rate of the readings, so that a step is one hump; the step
   signal is the second smoothing less the slow mean. The half width of the
   hysteresis is the greater of the least half width and the ratio times
   the root mean square of the step signal, compared as squares. No orientation
   of the unit is assumed. *)
let filter ((s1, s2, base, power, armed, mean, square, cross) : filter)
    (x : vector) =
  let m = norm x in
  let s1 = s1 +. (weight *. (m -. s1)) in
  let s2 = s2 +. (weight *. (s1 -. s2)) in
  let base = base +. (slow_weight *. (m -. base)) in
  let d = s2 -. base in
  let power = power +. (power_weight *. ((d *. d) -. power)) in
  let wide =
    d *. d
    > max (least_half_width *. least_half_width)
        (width_ratio *. width_ratio *. power)
  in
  let above = wide && d > 0.0 in
  let below = wide && d < 0.0 in
  let xx, xy = moments x in
  ( ( s1,
      s2,
      base,
      power,
      below || (armed && not above),
      toward slow_weight mean x,
      toward slow_weight square xx,
      toward slow_weight cross xy ),
    armed && above )

(* Whether the recent motion is along a line: the effective dimension
   tr(C)^2 / ||C||^2 of the covariance C of the acceleration, from its slow
   means, below the least, compared without a division; it is 1 for a
   motion along a line and 3 for an isotropic one. *)
let along_line ((_, _, _, _, _, (m1, m2, m3), (q1, q2, q3), (p1, p2, p3)) :
    filter) =
  let a = q1 -. (m1 *. m1) in
  let b = q2 -. (m2 *. m2) in
  let c = q3 -. (m3 *. m3) in
  let p = p1 -. (m1 *. m2) in
  let q = p2 -. (m2 *. m3) in
  let r = p3 -. (m3 *. m1) in
  let trace = a +. b +. c in
  trace *. trace
  < least_dimension
    *. ((a *. a) +. (b *. b) +. (c *. c)
       +. (2.0 *. ((p *. p) +. (q *. q) +. (r *. r))))

(* The second smoothing of the magnitude, and the high and low thresholds:
   the slow mean plus and minus the half width of the hysteresis. *)
let smoothed ((_, s2, _, _, _, _, _, _) : filter) = s2

let thresholds ((_, _, base, power, _, _, _, _) : filter) =
  let half = max least_half_width (width_ratio *. sqrt power) in
  (base +. half, base -. half)

(* The length of the bar of an acceleration of a g, in pixels: 320 for
   2 g. *)
let bar (a : float) = nat_of_float (a *. 160.0)

(* The readings of a round, each followed by the time, the first by the
   bar of the smoothed magnitude and a delay of 10 ms. Returns the filter,
   whether the step signal rose at either reading, whether the motion is
   along a line, the time of the reading at which it rose, and the time of
   the second reading.

   The filter after the first reading is boxed until the second, with a
   count: exactly one reading, started 10 to 43 ms after the box, and the
   decision at its end. The unit samples at 100 Hz, and a reading within
   10 ms of another may return the same sample; the decision of the round,
   the rise and the test of the line, is thus taken after a new sample.

   The decision is boxed until it is paired with the time of the second
   reading, with exactly one ReadClock, started at most 0.1 ms after the box
   and ended within 0.05 ms. A rise at the second reading is thus timed by
   it, and one at the first by the time read after the first; the time of
   the round alone, 10.2 to 44.55 ms after that time, would let the gaps
   between rises err by up to 34.35 ms, across the shortest gap of
   250 ms. *)
let sense (f : filter) =
  let x = reading () in
  let before = perform ReadClock () in
  let first, early = filter f x in
  let level = smoothed first in
  box (1, ReadImu, [10, 45], [0, 1.5]) first as boxed in
  perform DrawBar (0, 146, 320, 10, bar level, blue);
  delay 10;
  let x = reading () in
  unbox boxed as first in
  let second, late = filter first x in
  box (1, ReadClock, [0, 0.1], [0, 0.05]) (early || late, along_line second)
  as decision in
  let t = perform ReadClock () in
  unbox decision as (rose, linear) in
  (second, rose, linear, (if early then before else t), t)

(* The rhythm: the state, the steps of the current run, the time of its last
   rise and the time between its last two steps, in ms. *)
type rhythm = status * nat * nat * nat

(* Whether the gap between two rises is regular after the interval: within
   half the interval of it. *)
let regular (gap : nat) (interval : nat) =
  2 * gap >= interval && 2 * gap <= 3 * interval

(* A rise at the time t: ignored within the shortest gap of the last rise;
   no step in a motion along a line; the first step of a run after a gap
   above the longest; the second, with the last step, after a gap not
   regular; and otherwise the next. With the steps to count: those of the
   run once it is confirmed, and then each step. *)
let rise ((status, streak, last, interval) : rhythm) (t : nat) (linear : bool)
    =
  let gap = t - last in
  if gap < shortest_gap then ((status, streak, last, interval), 0)
  else if linear then ((Linear, 0, t, interval), 0)
  else if streak = 0 || gap > longest_gap then ((Checking, 1, t, interval), 0)
  else if streak >= 2 && not (regular gap interval) then
    ((Checking, 2, t, gap), 0)
  else if streak + 1 < run_length then ((Checking, streak + 1, t, gap), 0)
  else
    let added = if streak + 1 = run_length then run_length else 1 in
    ((Walking, streak + 1, t, gap), added)

(* No rise at the time t: at rest after a gap above the longest. *)
let idle ((status, streak, last, interval) : rhythm) (t : nat) =
  if (not (status = Still)) && t - last > longest_gap then
    (Still, 0, last, interval)
  else (status, streak, last, interval)

(* The touch screen: whether it was touched at the last reading, whether
   that reading began a touch, and its point. *)
type touch = bool * bool * nat * nat

(* The buttons, 40 pixels high from the row 188, each 156 pixels wide:
   Calibrate from the column 0 and Reset from the column 164. The key of a
   point is the button that contains it, if any. *)
type key = Calibration | Reset | Elsewhere

let key (x : nat) (y : nat) =
  if y < 188 || y >= 228 then Elsewhere
  else if x < 156 then Calibration
  else if x >= 164 then Reset
  else Elsewhere

let show_calibrate (active : bool) =
  perform ShowButton (0, 188, 156, 40, active, "Calibrate")

let show_reset (active : bool) =
  perform ShowButton (164, 188, 156, 40, active, "Reset")

(* The bands of the screen left to redraw: the state, the steps, the prompt,
   the Reset button, the cadence and the distance. *)
type bands = bool * bool * bool * bool * bool * bool

(* The counter: the filter, the rhythm, the steps shown and those of them
   not yet passed to CountStep, the bands left to redraw, the threshold
   drawn next, the touch screen, whether the prompt is shown and the time of
   the last round. *)
type counter =
  filter * rhythm * (nat * nat) * bands * bool * touch * bool * nat

(* The state on the screen: its text and colour. *)
let show_status (status : status) =
  match status with
  | Still -> perform ShowColourTextAt (0, 30, 2, white, black, "Still")
  | Checking ->
      perform ShowColourTextAt (0, 30, 2, yellow, black, "Checking rhythm")
  | Walking -> perform ShowColourTextAt (0, 30, 2, green, black, "Walking")
  | Linear ->
      perform ShowColourTextAt
        (0, 30, 2, orange, black, "Ignored: along a line")

let show_steps (steps : nat) =
  perform ShowNumberAt (120, 52, 4, 0, float_of_nat steps)

let show_distance (steps : nat) =
  perform ShowNumberAt (200, 112, 2, 0, float_of_nat (steps * stride / 100))

(* The screen of the counter with the given steps: the title, the
   guarantees, the state, the steps, the cadence and the distance, the label
   of the bar, the buttons and the footer. *)
let screen (steps : nat) =
  perform ClearDisplay ();
  perform ShowTextAt (0, 0, 2, "Step counter");
  perform ShowTextAt (0, 20, 1, "Read every 50 ms, steps counted 250 ms apart");
  show_status Still;
  perform ShowTextAt (0, 60, 2, "Steps");
  show_steps steps;
  perform ShowTextAt (0, 92, 2, "Steps a minute");
  perform ShowNumberAt (200, 92, 2, 0, 0.0);
  perform ShowTextAt (0, 112, 2, "Distance, m");
  show_distance steps;
  perform ShowTextAt (0, 134, 1, "Acceleration, 0 to 2 g; thresholds");
  show_calibrate false;
  show_reset false;
  perform ShowTextAt (80, 230, 1, "Typechecked by Tempore (tempore-lang.ee)")

(* The bands to redraw after the state before changes to after: the state,
   the cadence and the distance where it changes. *)
let changed (before : status) (after : status) ((s, n, p, r, c, d) : bands) =
  if before = after then (s, n, p, r, c, d) else (true, n, p, r, true, true)

(* The band of a round, after its second reading: the next band left to
   redraw, and otherwise one of the thresholds in turn. The prompt and the
   Reset button, active while the prompt is shown, are two bands. *)
let show ((f, rhythm, steps, bands, turn, touch, prompt, now) : counter) =
  let status, _, _, interval = rhythm in
  let high, low = thresholds f in
  let s, n, p, r, c, d = bands in
  let shown, _ = steps in
  if s then (
    show_status status;
    (f, rhythm, steps, (false, n, p, r, c, d), turn, touch, prompt, now))
  else if n then (
    show_steps shown;
    (f, rhythm, steps, (s, false, p, r, c, d), turn, touch, prompt, now))
  else if p then (
    (if prompt then
       perform ShowColourTextAt
         (0, 168, 2, black, yellow, "Tap Reset again to reset")
     else perform ShowColourTextAt (0, 168, 2, white, black, ""));
    (f, rhythm, steps, (s, n, false, r, c, d), turn, touch, prompt, now))
  else if r then (
    show_reset prompt;
    (f, rhythm, steps, (s, n, p, false, c, d), turn, touch, prompt, now))
  else if c then (
    let cadence = if status = Walking then 60000 / interval else 0 in
    perform ShowNumberAt (200, 92, 2, 0, float_of_nat cadence);
    (f, rhythm, steps, (s, n, p, r, false, d), turn, touch, prompt, now))
  else if d then (
    show_distance shown;
    (f, rhythm, steps, (s, n, p, r, c, false), turn, touch, prompt, now))
  else (
    (if turn then perform DrawBar (0, 158, 320, 4, bar high, orange)
     else perform DrawBar (0, 163, 320, 4, bar low, green));
    (f, rhythm, steps, bands, not turn, touch, prompt, now))

(* The readings of a round and the rhythm after them: the counter, its
   bands left to redraw, and the steps to count. *)
let advance ((f, rhythm, steps, bands, turn, touch, prompt, _) : counter) =
  let f, rose, linear, at, t = sense f in
  let status, _, _, _ = rhythm in
  let next, added =
    if rose then rise rhythm at linear else (idle rhythm t, 0)
  in
  let after, _, _, _ = next in
  ((f, next, steps, changed status after bands, turn, touch, prompt, t), added)

(* The rest of a round without a count: a band and a delay of 10 ms. *)
let pause (c : counter) =
  let c = show c in
  delay 10;
  c

(* The rest of a round with a count of the steps added: the count of these
   and of those deferred, the steps and a delay of 10 ms, with the state,
   the cadence and the distance left to redraw. *)
let count ((f, rhythm, (shown, deferred), (state, _, p, r, _, _), turn,
    touch, prompt, now) : counter) (added : nat) =
  perform CountStep (added + deferred);
  show_steps (shown + added);
  delay 10;
  (f, rhythm, (shown + added, 0), (state, false, p, r, true, true), turn,
    touch, prompt, now)

(* The rest of a round with steps added where none may be counted, while
   the prompt is shown or in the cooldown: the steps and a delay of 10 ms,
   their count deferred to the next count. *)
let defer ((f, rhythm, (shown, deferred), (state, _, p, r, _, _), turn,
    touch, prompt, now) : counter) (added : nat) =
  show_steps (shown + added);
  delay 10;
  (f, rhythm, (shown + added, deferred + added),
    (state, false, p, r, true, true), turn, touch, prompt, now)

(* A round in which no step counts: its steps deferred. *)
let quiet c =
  let c, added = advance c in
  if added = 0 then pause c else defer c added

(* A reading of the touch screen, 0 to 1.45 ms: a touch begins where the
   screen is touched and was not at the last reading, so that a finger left
   on the screen begins none. *)
let poll ((f, rhythm, steps, bands, turn, (held, _, _, _), prompt, now) :
    counter) =
  let touched, x, y = perform ReadTouch () in
  (f, rhythm, steps, bands, turn, (touched, touched && not held, x, y), prompt,
    now)

let polled c = poll (quiet c)

(* The button on which a touch began at the last reading, if any. *)
let tapped ((_, _, _, _, _, (_, began, x, y), _, _) : counter) =
  if began then key x y else Elsewhere

(* The cooldown: twelve rounds in which no step counts, their steps
   deferred, each of at least 20.4 ms, two readings of at least 0.2 ms and
   two delays of 10 ms, the bands, the clock and the touch screen taking at
   least 0; with the touch screen read in each, or not. *)
let quiet3 c = quiet (quiet (quiet c))
let cooldown c = quiet3 (quiet3 (quiet3 (quiet3 c)))
let polled3 c = polled (polled (polled c))
let polled_cooldown c = polled3 (polled3 (polled3 (polled3 c)))

(* A round, followed by the cooldown if it counted steps; with the touch
   screen read at the end of each round, or not. *)
let step c =
  let c, added = advance c in
  if added = 0 then pause c else cooldown (count c added)

let step_polled c =
  let c, added = advance c in
  if added = 0 then poll (pause c) else polled_cooldown (count c added)

(* A round while the prompt is shown: its steps deferred. *)
let step_deferred c =
  let c, added = advance c in
  if added = 0 then poll (pause c) else polled_cooldown (defer c added)

(* Fifteen rounds without a reading of the touch screen: at least 306 ms. *)
let step5 c = step (step (step (step (step c))))
let settle c = step5 (step5 (step5 c))

(* Correctly accepted by the typechecker: the rounds after a tap, until a
   touch begins on a button or 'window' ms have passed since the time
   'since', for at most n rounds; with that button, if any. The grade is an
   invariant: readings at least every 50 ms, the end at most 46 ms after the
   start of the last, and no count, the steps found being deferred. *)
let rec wait (n : nat) (since : nat) (c : counter) : counter * key
    # ((ReadImu, [0, 0], [0, 50], [0, 46]), (0, CountStep, [0, ∞))) =
  match n with
  | 0 -> (c, Elsewhere)
  | m + 1 ->
      let c = step_deferred c in
      let _, _, _, _, _, _, _, now = c in
      let k = tapped c in
      if not (k = Elsewhere) then (c, k)
      else if now - since > window then (c, Elsewhere)
      else wait m since c

(* The prompt and the Reset button shown, or cleared, by the band queue. *)
let prompt ((f, rhythm, steps, (s, n, _, _, c, d), turn, touch, _, now) :
    counter) (shown : bool) =
  (f, rhythm, steps, (s, n, true, true, c, d), turn, touch, shown, now)

(* The reset: the steps set to zero, and the bands of the steps, the prompt,
   the Reset button and the distance to redraw. The counter is boxed after
   ResetSteps with exactly one Beep, at once, and the end within 0.15 ms of
   its start; the box is returned, and unboxed where the beep is
   performed. The beep thus answers the confirming tap before any band of
   the screen is redrawn; a beep after the band of the steps, redrawn in
   0.05 to 33 ms, is rejected. *)
type confirmation = [(1, Beep, [0, 0], [0, 0.15])]counter

let reset ((f, rhythm, _, (s, _, _, _, c, _), turn, touch, _, now) : counter)
    : confirmation =
  perform ResetSteps ();
  box (1, Beep, [0, 0], [0, 0.15])
    (f, rhythm, (0, 0), (s, true, true, true, c, true), turn, touch, false,
      now)
  as confirmed in
  confirmed

(* Correctly accepted by the typechecker: the response to a tap begun on the
   button k, with the prompt "Tap Reset again to reset" and the button
   active, while the rounds go on. The button is boxed until the reset, over
   the recursive call of 'wait', with the product of two entries: readings
   of the unit at least every 50 ms, so that no step is missed while the
   prompt is shown, and no reading of the touch screen within 300 ms, longer
   than a tap, so that the tap and the bounces of its contact are not read
   as a second. The fifteen rounds of 'settle' read none, at least 306 ms;
   fourteen, at least 285.6 ms, are rejected. A second tap on the same
   button at most 'window' ms after the first resets the count; a tap on the
   other button, or none, clears the prompt, and a touch elsewhere does
   nothing. The boxes of each round, in 'sense', are bound and unboxed
   within this one, each checked against its own grade.

   The steps found while the prompt is shown are shown at once and passed to
   CountStep with the next count, or cleared by the reset: a rate limit of
   the counts is not closed under sequencing, so that the loop of the
   counter could not follow the recursive call with a count, while the
   invariant of no count is. *)
let respond (c : counter) (k : key) =
  let _, _, _, _, _, _, _, since = c in
  box ((ReadImu, [0, 50], [0, 50], [0, 50]),
       (ReadTouch, [300, ∞), [0, ∞), [0, ∞))) k as tap in
  let c = settle (prompt c true) in
  let c, second = wait 100 since c in
  unbox tap as first in
  if second = first then (
    let confirmed = reset c in
    perform Beep (3000, 50);
    unbox confirmed as c in
    c)
  else prompt c false

(* Correctly accepted by the typechecker: at most n rounds of a session,
   each count followed by the cooldown, a tap on Reset answered by
   'respond', until a tap on Calibrate; with the counter at its end. The
   grade is the invariant of the loop.

   ReadImu: the loop starts with a reading, and the starts of consecutive
   readings are at most 50 ms apart, as is the end from the start of the
   last. The first reading of a round, the clock, a band and the delay take
   at most 44.55 ms; the second, the clock, a band, the delay and the touch
   screen 46 ms, and 46.35 ms with ResetSteps and the beep; the second, the
   clock, a count, the steps and the delay 44.75 ms.

   CountStep: the starts of consecutive counts at least 250 ms apart. A
   count is followed by its band, of at least 0.05 ms, the delay of 10 ms
   and the cooldown, of at least 244.8 ms, 254.85 ms in all; a cooldown of
   eleven rounds, 234.45 ms in all, is rejected. The rounds before the next
   count add to the gap.

   Both are closed under sequencing as the loop is built, so that they hold
   of any number of rounds. The smoothing, the hysteresis, the test of the
   line, the shortest and longest gaps between rises, their regularity and
   the confirming run are program logic, which the types do not check; the
   steps found within the cooldown are counted with the next count. *)
let rec listen (n : nat) (c : counter) : counter
    # ((ReadImu, [0, 0], [0, 50], [0, 50]), (CountStep, [250, ∞))) =
  match n with
  | 0 -> c
  | m + 1 ->
      let c = step_polled c in
      let k = tapped c in
      if k = Calibration then c
      else if k = Reset then
        let c = respond c k in
        listen m c
      else listen m c

(* The counter at rest with gravity along g: the filter at g, not armed; no
   run; no steps; nothing to redraw; the touch screen not touched. *)
let at_rest (g : vector) : filter =
  let square, cross = moments g in
  (1.0, 1.0, 1.0, 0.0, false, g, square, cross)

let rest (g : vector) : counter =
  ( at_rest g,
    (Still, 0, 0, 0),
    (0, 0),
    (false, false, false, false, false, false),
    false,
    (false, false, 0, 0),
    false,
    0 )

(* The counter c at the start of a session with gravity along g: at rest,
   its steps kept, and the touch screen taken as touched, so that a finger
   left on Calibrate begins no touch. *)
let resume (g : vector) ((_, _, steps, _, turn, _, _, now) : counter) :
    counter =
  ( at_rest g,
    (Still, 0, 0, 0),
    steps,
    (false, false, false, false, false, false),
    turn,
    (true, false, 0, 0),
    false,
    now )

(* The calibration, a value whose box changes as it passes through two
   stages, each box licensing its use only after the computation its grade
   admits.

   The sampling: with "Hold still", "Calibrating: not counting" and the
   Calibrate button active, the number of samples is boxed with exactly 50
   readings, the starts of consecutive readings 10 to 45 ms apart, and at
   most 50 ms before the first and after the last; the box is returned, and
   unboxed where the mean is formed. The mean thus divides the sum by the
   number of readings taken, and the unit, at 100 Hz, returns a new sample
   at each. A count is not closed under recursion, whose grade states none,
   so the readings are written out.

   The readiness: the gain, 1 g over the magnitude of the mean, and the
   direction of gravity are boxed after the screen of the counter is drawn,
   with exactly one Beep, at once, and the end within 0.2 ms of its start,
   its running time at most 0.15 ms; the box is returned, and unboxed where
   the counting starts. The counter, whose loop starts with a reading, thus
   sees the first steps after the beep. A beep before the screen, whose
   drawing takes 31.55 to 477 ms, and thus 31.6 to 477.15 ms from the start
   of the beep to the counting, is rejected. *)
type sampling = [(50, ReadImu, [0, 50], [10, 45], [0, 50])]float
type readiness = [(1, Beep, [0, 0], [0, 0.2])](float * vector)

let hold_still () : sampling =
  perform ShowColourTextAt (0, 30, 2, yellow, black, "Hold still");
  perform ShowColourTextAt
    (0, 168, 2, white, black, "Calibrating: not counting");
  show_calibrate true;
  box (50, ReadImu, [0, 50], [10, 45], [0, 50]) 50.0 as samples in
  samples

let calibrate (samples : sampling) (steps : nat) : readiness =
  let sum = ten (ten (ten (ten (ten (0.0, 0.0, 0.0))))) in
  unbox samples as n in
  let mean = scale (1.0 /. n) sum in
  let gain = 1.0 /. norm mean in
  screen steps;
  box (1, Beep, [0, 0], [0, 0.2]) (gain, scale gain mean) as ready in
  ready

(* Correctly accepted by the typechecker: at least n sessions, each a
   calibration, a beep that tells the walker to start and the counter read
   through the calibration handler with its gain, for 4 billion rounds, at
   least 2.5 years, or until a tap on Calibrate. The steps are kept from one
   session to the next, and none is counted during a calibration.

   The grade is the invariant of the loop: the starts of consecutive counts
   at least 250 ms apart, within a session by the grade of 'listen' and
   across sessions by the calibration that starts each, at least 541.7 ms
   before its first count. The rate limit (CountStep, [250, ∞)), whose
   lead may be 0, is not closed under this sequencing and is rejected. *)
let rec sessions (n : nat) (c : counter)
    : unit # (CountStep, [250, ∞), [250, ∞), [0, ∞)) =
  let _, _, (shown, _), _, _, _, _, _ = c in
  let samples = hold_still () in
  let ready = calibrate samples shown in
  perform Beep (2000, 150);
  unbox ready as (gain, g) in
  let c = handle listen 4000000000 (resume g c) with calibrated gain in
  match n with
  | 0 -> ()
  | m + 1 -> sessions m c

(* Correctly accepted by the typechecker: the task. The output data rate of
   the accelerometer is set to 100 Hz, and the sessions start with the
   counter at rest. *)
let watch () =
  perform ConfigureImu 100;
  perform ClearDisplay ();
  perform ShowTextAt (0, 0, 2, "Step counter");
  sessions 4000000000 (rest (0.0, 0.0, 1.0))

(* The simulation of a walk in the interpreter, which has no clock. The
   handler 'walk t' replaces the readings by those of a walk at the time t,
   in ms, and the time by t; its cases perform their operations, and keep
   their running times. The device does not use it. *)

(* A triangle wave of the period of 400 ms and the amplitude of 1 at the
   time t, in ms. *)
let triangle (t : nat) =
  let p = float_of_nat (t mod 400) /. 100.0 in
  if p < 1.0 then p else if p < 3.0 then 2.0 -. p else p -. 4.0

(* A walk of 2.5 steps a second: the vertical acceleration 1 g plus 0.4 g
   by the triangle wave, and the horizontal one 0.2 g by it a quarter period
   later. *)
let walk (t : nat) =
  handler
  | s -> s
  | ReadImu () k ->
      let _, gyro = perform ReadImu () in
      continue k with
        ((0.2 *. triangle (t + 100), 0.0, 1.0 +. (0.4 *. triangle t)), gyro)
  | ReadClock () k ->
      let _ = perform ReadClock () in
      continue k with t

(* Each round sees the walk at its start, the time advancing by 25 ms a
   round, about the duration of a round under the default implementations,
   23.21 to 25.31 ms. *)
let period = 25

(* A round, and the steps it counted. *)
let round (c : counter) =
  let c, added = advance c in
  if added = 0 then (pause c, 0) else (count c added, added)

let rec cool (n : nat) (t : nat) (c : counter) : counter * nat # ⊤ =
  match n with
  | 0 -> (c, t)
  | m + 1 ->
      let c = handle quiet c with walk t in
      cool m (t + period) c

(* Correctly accepted by the typechecker: n rounds of the walk from the time
   t, each count followed by the twelve rounds of the cooldown. The tally:
   the counts, the steps counted, the time of the last count and the least
   time between two counts, the greatest natural number of 32 bits before
   the second count. *)
let rec replay (n : nat) (t : nat) (c : counter)
    ((counts, steps, last, least) : nat * nat * nat * nat)
    : nat * nat * nat * nat # ⊤ =
  match n with
  | 0 -> (counts, steps, last, least)
  | m + 1 ->
      let c, added = handle round c with walk t in
      if added = 0 then replay m (t + period) c (counts, steps, last, least)
      else
        let c, next = cool 12 (t + period) c in
        let least = if counts = 0 then least else min least (t - last) in
        replay m next c (counts + 1, steps + added, t, least)

(* The walk from the time 1 s for 64 rounds: its run is confirmed at its
   fourth step, when four steps are counted, and the next step is counted
   400 ms later; two counts of five steps, the last at 2875 ms. *)
run replay 64 1000 (rest (0.0, 0.0, 1.0)) (0, 0, 0, 4294967295)
