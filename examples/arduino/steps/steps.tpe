*)

(* The task: the output data rate of the accelerometer set to 100 Hz, the
   screen, and readings for about 460 days. *)
let watch () =
  perform ConfigureImu 100;
  screen 0;
  count 4000000000 0 false

(* Three rounds with the default implementations, which read a unit at
   rest: no step is counted. *)
run count 3 0 false
