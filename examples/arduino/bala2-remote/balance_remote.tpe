      perform Arm calibration;
      drive 4000000000 0)
    else ())
  else ()
*)

(* Correctly rejected by the typechecker: an iteration of the drive that
   polls again for a Disarm before it applies the message received first,
   which is then no longer the latest:

     Typing error: Variable `latest` is unboxed with grade `{Receive;
       Disarm?}` accumulated since it was bound, which is not below its box
       grade `{[0, 150) & ~Receive}`
       ...
*)
(*
let drive_polled () =
  let latest = remote_receive () in
  let newer = remote_receive () in
  unbox newer as polled in
  let n, _ = polled in
  (match n with Got Disarm -> perform Disarm () | _ -> ());
  unbox latest as received in
  let r, setpoints = received in
