  else ()
*)

(* Correctly rejected by the typechecker: an iteration of the drive that
   polls again for a Disarm before it applies the message received first,
   which is then no longer the latest:

     Typing error: Variable `latest` is unboxed with grade `[{Receive; (0 |
       Disarm)}, {Receive; (0 | Disarm)}]` accumulated since it was bound,
       which is not below its box grade `[{(!_ & ~Receive)*}, {(!_ &
       ~Receive)*}]`
       ...
*)
(*
let drive_polled () =
  let latest, fresh = remote_receive () in
  let newer, _ = remote_receive () in
  unbox newer as n in
  (match n with Got Disarm -> perform Disarm () | _ -> ());
  unbox latest as r in
  match r with
  | Got (Drive _) ->
      unbox fresh as setpoints in
      perform Command setpoints
  | _ -> perform Command (0.0, 0.0)
*)

(* Two control steps from the reading of the default implementation of the
   unit, a robot at rest, and a tilt of 3 degrees. *)
run step (step (3.0, 0.0, 0.0, 0.0, 0.0))
