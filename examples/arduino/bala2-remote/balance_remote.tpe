(* The M5Stack BALA2 driven by radio from a controller over ESP-NOW, under
   rigid timed regular expressions

   Run this example with the 'regex-timed-rigid-interval-rational-symbolic' grading monoid, e.g.

     ./tempore --grades regex-timed-rigid-interval-rational-symbolic \
       --package m5-imu \
       --package m5-display \
       --package m5-speaker \
       --package bala2-base \
       --package esp-now \
       --package bala2-remote \
       --board m5stack-gray \
       examples/arduino/bala2-remote/balance_remote.tpe

   Grades [L, U]: a lower bound in the coverage order and an upper bound in
   the rigid allowance order on the traces with rational durations
     - Unit [{0}, {0}]: nothing demanded, only the empty trace allowed
     - Top [{0}, ∞): nothing demanded, every trace allowed
     - Product: concatenation of traces, componentwise *)

(* The robot of examples/arduino/bala2-regex (its control step, and the
   bindings.cpp and plant.cpp of examples/arduino/bala2), armed, driven and
   disarmed by the messages of the package bala2-remote. On the board: make
   arduino-bala2-remote-upload REMOTE_PEER=XX:XX:XX:XX:XX:XX, the address of
   the controller (by default broadcast); simulated on the host, with
   controller.cpp scripting the controller: make
   arduino-bala2-remote-simulate. *)

(* The exchange between the tasks, as in balance.tpe. The step publishes the
   tilt, in degrees, the rate of the gyroscope, in degrees per second, the
   filtered speed of the wheels, in encoder counts per second, and the
   reference tilt of the speed loop, in degrees, and reads the setpoints:
   whether the robot is armed, the bias of the gyroscope, the speed of the
   wheels, in encoder counts per second, and the difference of the drives of
   the motors, which turns the robot. The supervision reads the attitude,
   arms the robot with a calibration of the gyroscope, disarms it, and
   commands a speed and a turn; a command older than 200 ms is replaced by
   zero setpoints. The default implementations describe an armed robot
   without commands. The bounds of their running times are those of
   balance.tpe. *)

type calibration = Calibration of float

operation Publish : float * float * float * float ~> unit # {Publish} within [0, 0.05]
default Publish _ = delay 1/100

operation Setpoints : unit ~> bool * float * float * float # {Setpoints} within [0, 0.05]
default Setpoints () = delay 1/100; (true, 0.0, 0.0, 0.0)

operation Attitude : unit ~> float * float # {Attitude} within [0, 0.05]
default Attitude () = delay 1/100; (0.0, 0.0)

operation Arm : calibration ~> unit # {Arm} within [0, 0.05]
default Arm _ = delay 1/100

operation Disarm : unit ~> unit # {Disarm} within [0, 0.05]
default Disarm () = delay 1/100

operation Command : float * float ~> unit # {Command} within [0, 0.05]
default Command _ = delay 1/100

(* Report armed sends the status of the robot to the controller: whether it
   is armed and the tilt last published by the step, through the package
   bala2-remote; bound in bindings.cpp. Its bounds are those of Attitude and
   of the provisional bounds of SendStatus together: [0, 1.05]. *)
operation Report : bool ~> unit # {Report} within [0, 1.05]
default Report _ = delay 1/10

(* The control step. The state is the tilt, in degrees, filtered from the
   inertial measurement unit; the speed of the wheels, in encoder counts per
   second, filtered; the integral of the error of the speed; the
   position of the wheels, in encoder counts; and the heading held, the
   difference of the counts of the left and the right encoder. *)

type state = float * float * float * float * float

(* The period, in seconds, the weight of the gyroscope in the complementary
   filter of the tilt, the gains and bounds of the controller and of its
   heading loop, the weight of the previous speed in the filter of the
   speed, the balance point, in degrees, which the tilt loop subtracts from
   the tilt, and the dead bands of the left and the right motor, in units of
   drive, by which their drives are moved away from zero, those of
   balance.tpe. *)
let period = 0.005
let gyro_weight = 0.98
let tilt_gain = 25.0
let rate_gain = 0.4
let speed_gain = 0.02
let integral_gain = 0.004
let speed_weight = 0.9
let integral_limit = 1250.0
let reference_limit = 20.0
let cutoff = 70.0
let balance_point = 0.0
let heading_gain = 2.0
let heading_limit = 200.0
let left_dead_band = 70.0
let right_dead_band = 180.0

let compensated (band : float) (d : float) =
  if d > 0.0 then d +. band else if d < 0.0 then d -. band else d

let magnitude (x : float) = if x < 0.0 then ~-.x else x

let clamp (limit : float) (x : float) =
  if x < ~-.limit then ~-.limit else if x > limit then limit else x

(* Correctly accepted by the typechecker: the step reads the unit, the
   encoders and the setpoints, publishes the attitude, the speed and the
   reference tilt, and commands the motors, each once and in this order; its
   durations, 1.2 to 2.8 ms, are checked against its period of 5 ms by the
   device. The reading of the unit is boxed with any number of reads of the
   encoders and the setpoints, without delays: it is used only if no other
   operation, in particular no command of the motors, and no delay has come
   since it was taken. While a turn is commanded, the heading held follows the
   difference of the counts; disarmed, the step holds the present heading. *)
let step ((tilt, speed, integral, position, heading) : state) : state
    # {ReadImu; ReadEncoders; Setpoints; Publish; SetMotors} =
  let reading = perform ReadImu () in
  box {(ReadEncoders | Setpoints)*} reading as fresh in
  let left, right = perform ReadEncoders () in
  let armed, bias, target, turn = perform Setpoints () in
  unbox fresh as imu in
  let accel, gyro = imu in
  let raw, _, _ = gyro in
  let rate = raw -. bias in
  let tilt =
    complementary gyro_weight period tilt (tilt_x_of_accel accel) rate
  in
  let now = (float_of_int left +. float_of_int right) /. 2.0 in
  let difference = float_of_int left -. float_of_int right in
  let speed =
    (speed_weight *. speed)
    +. ((1.0 -. speed_weight) *. ((now -. position) /. period))
  in
  let error = speed -. target in
  let integral = clamp integral_limit (integral +. (error *. period)) in
  let reference =
    clamp reference_limit
      (~-.((speed_gain *. error) +. (integral_gain *. integral)))
  in
  perform Publish (tilt, raw, speed, reference);
  if armed && magnitude tilt <= cutoff then
    let drive =
      (tilt_gain *. (tilt -. balance_point -. reference)) +. (rate_gain *. rate)
    in
    let heading = if magnitude turn > 0.0 then difference else heading in
    let command_turn =
      turn +. clamp heading_limit (~-.(heading_gain *. (difference -. heading)))
    in
    perform SetMotors
      ( bala2_drive (compensated left_dead_band (drive +. command_turn)),
        bala2_drive (compensated right_dead_band (drive -. command_turn)) );
    (tilt, speed, integral, now, heading)
  else (
    perform SetMotors (0i, 0i);
    (tilt, speed, 0.0, now, difference))

(* The initial state: the encoders reset, and the tilt from the
   accelerometer. *)
let start () : state =
  perform LinkStart remote_channel;
  perform ResetEncoders ();
  let accel, _ = perform ReadImu () in
  (tilt_x_of_accel accel, 0.0, 0.0, 0.0, 0.0)


(* The supervision. The bias of the gyroscope is the mean of 50 rates
   published by the step 10 ms apart, with the robot held still. *)

let rec rate_sum (n : nat) (sum : float) : float # {(Attitude; 10)*} =
  match n with
  | 0 -> sum
  | m + 1 ->
      let _, rate = perform Attitude () in
      delay 10;
      rate_sum m (sum +. rate)

(* The calibration. The bias of the gyroscope drifts with the temperature,
   and is valid while the robot stands still, so the calibration is boxed
   twice: with [{[1000, ∞)}, {[0, 600000]}], so that it arms the robot at
   least a second later, in which the robot is held upright, and at most 10
   minutes later; and with {(!_ & ~Command)*}, so that no motion has been
   commanded since. A grade has a single upper bound, and a time bound over
   operations is a budget, which admits any operation that fits, a
   Command among them, so the two conditions are two boxes; a box of a box
   is refused. Both are unboxed before the arming, and span the hold of a
   second, two display calls and the wait for Arm, its Receives and
   waits. *)
type aged = [[{[1000, ∞)}, {[0, 600000]}]]calibration
type still = [{(!_ & ~Command)*}]calibration

let calibrate () : aged * still
    # {Disarm; ShowTextAt; (Attitude; 10)*} =
  perform Disarm ();
  perform ShowTextAt (0, 100, 2, "Calibrating");
  let sum = rate_sum 50 0.0 in
  let calibration = Calibration (sum /. 50.0) in
  box [{[1000, ∞)}, {[0, 600000]}] calibration as aged in
  box {(!_ & ~Command)*} calibration as still in
  (aged, still)

(* The number of consecutive iterations of the drive without a message, about
   2 s, after which the link is reported lost. *)
let silence_limit = 160

(* The wait for Arm, bounded so that the calibration stays within its 10
   minutes: a poll reports the status of the disarmed robot, waits 400 ms,
   and is true at an Arm message of the controller, which repeats Arm for
   1 s: two Receives lie at most 401.15 ms apart, Report taking at most
   1.05 ms and Receive 0.1 ms, so that at least two fall within those 1 s,
   each finding an Arm at most 12.5 ms old. The message received is unboxed
   after the report and the wait, before any further Receive. wait5, wait25
   and wait125 repeat the poll up to 5, 25 and 125 times, and wait_arm up
   to 500 times, about 200 s, without a recursion, whose grade would be a
   star; 625 polls would take 8 s to typecheck, 500 take 4 s. *)
let poll_arm () : bool # {Receive; Report; !400} =
  let latest, _ = remote_receive () in
  perform Report false;
  delay 400;
  unbox latest as r in
  match r with Got Arm -> true | _ -> false

let wait5 () : bool # {(Receive; Report; !400)^[1, 5]} =
  if poll_arm () then true
  else if poll_arm () then true
  else if poll_arm () then true
  else if poll_arm () then true
  else poll_arm ()

let wait25 () : bool # {(Receive; Report; !400)^[1, 25]} =
  if wait5 () then true
  else if wait5 () then true
  else if wait5 () then true
  else if wait5 () then true
  else wait5 ()

let wait125 () : bool # {(Receive; Report; !400)^[1, 125]} =
  if wait25 () then true
  else if wait25 () then true
  else if wait25 () then true
  else if wait25 () then true
  else wait25 ()

let wait_arm () : bool # {(Receive; Report; !400)^[1, 500]} =
  if wait125 () then true
  else if wait125 () then true
  else if wait125 () then true
  else wait125 ()

(* Correctly accepted by the typechecker: the drive. Each iteration receives
   a message and applies it at once, before any further Receive: a Drive
   command is commanded with its setpoints, unboxed within 150 ms of the
   reception; Beat, Arm or no message command zero setpoints, and the 160th
   consecutive iteration without a message shows "Link lost" and beeps once,
   the robot staying armed, and the first message after the silence shows
   "Armed" again; each of these iterations then reports the status of the
   armed robot. Disarm disarms the robot and ends the drive. The grade
   fixes the operations and the strict delay of each iteration, which
   therefore takes 12.5 to 46.85 ms by the bounds of its operations,
   below the 50 ms period of the controller and the 200 ms after which a
   command expires. *)
(* Shows "Armed" again at the first message after the link was reported
   lost. *)
let restored (silent : nat) : unit # {ShowTextAt | 0} =
  if silent >= silence_limit then perform ShowTextAt (0, 100, 2, "Armed")
  else ()

let rec drive (n : nat) (silent : nat) : unit
    # {(Receive; Command; (ShowTextAt; Beep | ShowTextAt | 0); Report;
        !12.5)*;
       (Receive; Disarm; !12.5 | 0)} =
  match n with
  | 0 -> ()
  | m + 1 -> (
      let latest, fresh = remote_receive () in
      unbox latest as r in
      match r with
      | Got Disarm ->
          perform Disarm ();
          delay 25/2
      | Got (Drive _) ->
          unbox fresh as setpoints in
          perform Command setpoints;
          restored silent;
          perform Report true;
          delay 25/2;
          drive m 0
      | Got _ ->
          perform Command (0.0, 0.0);
          restored silent;
          perform Report true;
          delay 25/2;
          drive m 0
      | Nothing ->
          perform Command (0.0, 0.0);
          (if silent + 1 = silence_limit then (
             perform ShowTextAt (0, 100, 2, "Link lost");
             perform Beep (880, 200))
           else ());
          perform Report true;
          delay 25/2;
          drive m (min (silent + 1) silence_limit))

(* Correctly accepted by the typechecker: a session calibrates the robot,
   holds it upright for a second and waits for Arm; at Arm it unboxes the
   calibration, at least a second and at most about 202 s old, with
   no Command since, arms the robot and drives it until Disarm, and
   otherwise ends; the next session calibrates anew. Its grade is the
   protocol of the robot: calibration, Arm, commands and Disarm, in this
   order. *)
let rec session (n : nat) : unit
    # {(Disarm; ShowTextAt; (Attitude; 10)*; ShowTextAt; !1000; ShowTextAt;
        (Receive; Report; !400)^[1, 500];
        (0 | Arm; ShowTextAt;
         (Receive; Command; (ShowTextAt; Beep | ShowTextAt | 0); Report;
          !12.5)*;
         (Receive; Disarm; !12.5 | 0); ShowTextAt))*} =
  match n with
  | 0 -> ()
  | m + 1 ->
      let aged, still = calibrate () in
      perform ShowTextAt (0, 100, 2, "Hold upright");
      delay 1000;
      perform ShowTextAt (0, 100, 2, "Waiting for Arm");
      (if wait_arm () then (
         unbox aged as calibration in
         unbox still as _ in
         perform Arm calibration;
         perform ShowTextAt (0, 100, 2, "Armed");
         drive 4000000000 0;
         perform ShowTextAt (0, 100, 2, "Disarmed"))
       else ());
      session m

(* The supervision draws the name and the footer once, and repeats the
   sessions. *)
let supervise () =
  perform ClearDisplay ();
  perform ShowTextAt (0, 0, 2, "Remote robot");
  perform ShowTextAt (80, 230, 1, "Typechecked by Tempore (tempore-lang.ee)");
  session 4000000000;
  perform Disarm ()

(* Correctly rejected by the typechecker: a session that commands zero
   setpoints before it waits for Arm, to keep the setpoints fresh, arms the
   robot with a calibration after which a motion may have been commanded:

     Typing error: Variable `still` is unboxed with grade `[{ShowTextAt;
       !1000; Command; (Receive; Report; !400)^[1, 500]}, ...]` accumulated
       since it was bound, which is not below its box grade
       `[{(!_ & ~Command)*}, {(!_ & ~Command)*}]`
       ...
*)
(*
let session_commanding () =
  let aged, still = calibrate () in
  perform ShowTextAt (0, 100, 2, "Hold upright");
  delay 1000;
  perform Command (0.0, 0.0);
  if wait_arm () then (
    unbox aged as calibration in
    unbox still as _ in
    perform Arm calibration;
    drive 4000000000 0)
  else ()
*)

(* Correctly rejected by the typechecker: a session that waits for Arm
   without a bound, by a recursion, arms the robot with a calibration that
   may be older than 10 minutes:

     Typing error: Variable `aged` is unboxed with grade `[{ShowTextAt;
       !1000; (Receive; Report; !400)*; (Receive | 0)}, ...]` accumulated
       since it was bound, which is not below its box grade
       `[{[1000, ∞)}, {[0, 600000]}]`
       ...
*)
