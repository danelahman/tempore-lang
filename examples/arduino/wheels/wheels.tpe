(* A wheel check of the M5Stack BALA2: speeds over windows of fixed traces

   Run this example with the 'regex-timed-interval-rational-symbolic' grading monoid, e.g.

     ./tempore --grades regex-timed-interval-rational-symbolic \
       --package m5-imu \
       --package m5-display \
       --package bala2-base \
       --board m5stack-gray \
       examples/arduino/wheels/wheels.tpe

   Grades [L, U]: a lower and upper regular-language bound on the traces with
   rational durations
     - Unit [{0}, {0}]: nothing demanded, only the empty trace allowed
     - Top [{0}, ∞): nothing demanded, every trace allowed
     - Product: concatenation of traces, componentwise *)

(* Runs on the M5Stack Gray core of the BALA2 on a stand, its wheels off the
   ground (wheels.device.json): 'watch' every 10 ms from the state of
   'start', and 'check' repeated. Operations come from the packages m5-imu,
   m5-display and bala2-base; bindings.cpp binds the others and stand.cpp
   models the robot on its stand. The figures below are those under the
   bounds of the Gray.

   On the board: make arduino-wheels-upload; simulated on the host: make
   arduino-wheels-simulate ('make examples-help',
   src/05-backends/arduino/README.md). *)

(* The exchange between the tasks, through bindings.cpp: the step publishes
   the tilt, in degrees, and the check reads the tilt last published. The
   bindings are those of examples/arduino/tilt, and their bounds those
   measured there. *)

operation Publish : float ~> unit # {Publish} within [0, 0.05]
default Publish _ = delay 1/100

operation Latest : unit ~> float # {Latest} within [0, 0.05]
default Latest () = delay 1/100; 0.0

(* The period of the step, in seconds, and the weight of the gyroscope in the
   complementary filter of the tilt. *)
let period = 0.01
let gyro_weight = 0.98

(* Correctly accepted by the typechecker: the step reads the unit, filters
   the tilt and publishes it, in this order; its grade bounds its durations
   by the running times of the two operations, 0.55 to 1.3 ms, below its
   period. *)
let watch (tilt : float) : float # {ReadImu; Publish} =
  let imu = perform ReadImu () in
  let tilt = tilt_x gyro_weight period tilt imu in
  perform Publish tilt;
  tilt

(* The initial state: the tilt from the accelerometer alone. *)
let start () : float =
  let accel, _ = perform ReadImu () in
  tilt_x_of_accel accel

let magnitude (x : float) = if x < 0.0 then ~-.x else x

(* Correctly accepted by the typechecker: the speeds of the wheels, in
   encoder counts per second, at the drive 'drive' of both motors. The
   encoders are reset, and the length of the window, 0.1005 s, is boxed with
   the trace of the window: a drive command, 100 to 101 ms, and a reading of
   the encoders, in this order. The counts read are divided by the length
   only once it is unboxed, so that they are counts over the window; the
   motors are then stopped. *)
let spin (drive : int) : float * float =
  perform ResetEncoders ();
  box {SetMotors; [100, 101]; ReadEncoders} 0.1005 as window in
  perform SetMotors (drive, drive);
  delay 100.5;
  let left, right = perform ReadEncoders () in
  unbox window as seconds in
  perform SetMotors (0i, 0i);
  (float_of_int left /. seconds, float_of_int right /. seconds)

(* Correctly rejected by the typechecker: the drive is commanded after the
   wait, just before the encoders are read, so that the counts are read 0.2
   to 0.45 ms after the drive command, not 100 to 101 ms:

     Typing error: Variable `window` is unboxed with grade
       `[{100.5; SetMotors; ReadEncoders},
       {100.5; SetMotors; ReadEncoders}]` accumulated since it was bound, which
       is not below its box grade
       `[{SetMotors; [100, 101]; ReadEncoders},
       {SetMotors; [100, 101]; ReadEncoders}]`
       ...
       Note: the resource inequality
         `[{100.5; SetMotors; ReadEncoders},
         {100.5; SetMotors; ReadEncoders}] <=
         [{SetMotors; [100, 101]; ReadEncoders},
         {SetMotors; [100, 101]; ReadEncoders}]` does not hold
*)
(*
let spin_unordered (drive : int) : float * float =
  perform ResetEncoders ();
  box {SetMotors; [100, 101]; ReadEncoders} 0.1005 as window in
  delay 100.5;
  perform SetMotors (drive, drive);
  let left, right = perform ReadEncoders () in
  unbox window as seconds in
  perform SetMotors (0i, 0i);
  (float_of_int left /. seconds, float_of_int right /. seconds)
*)

(* Correctly rejected by the typechecker: the drive is shown on the display
   within the window, which takes up to 12.5 ms, so that the counts may be
   read up to 113 ms after the drive command:

     Typing error: Variable `window` is unboxed with grade
       `[{SetMotors; ShowNumber; 100.5; ReadEncoders},
       {SetMotors; ShowNumber; 100.5; ReadEncoders}]` accumulated since it was
       bound, which is not below its box grade
       `[{SetMotors; [100, 101]; ReadEncoders},
       {SetMotors; [100, 101]; ReadEncoders}]`
       ...
       Note: the resource inequality
         `[{SetMotors; ShowNumber; 100.5; ReadEncoders},
         {SetMotors; ShowNumber; 100.5; ReadEncoders}] <=
         [{SetMotors; [100, 101]; ReadEncoders},
         {SetMotors; [100, 101]; ReadEncoders}]` does not hold
*)
(*
let spin_shown (drive : int) : float * float =
  let shown = float_of_int drive in
  perform ResetEncoders ();
  box {SetMotors; [100, 101]; ReadEncoders} 0.1005 as window in
  perform SetMotors (drive, drive);
  perform ShowNumber shown;
  delay 100.5;
