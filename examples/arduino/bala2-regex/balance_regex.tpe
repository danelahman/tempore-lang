let rec drive_redrawn (n : nat) : unit # {_*} =
  match n with
  | 0 -> ()
  | m + 1 ->
      box [0, 200) () as expiry in
      drive_step_redrawn m;
      unbox expiry as _ in
      drive_redrawn m
*)

(* Correctly accepted by the typechecker: the robot is calibrated, held
   upright for a second, armed with a calibration 1000.05 to 1012.5 ms old,
   and driven for about 13 years, after which it is disarmed. Its grade is
   the protocol of the supervision: calibrate, arm, drive and disarm, in
   this order. *)
let supervise () : unit
    # {Disarm; ClearDisplay; ShowTextAt; ShowTextAt; ShowText;
       (Attitude; 10)*; ShowText; 1000; Arm; ShowText;
       (Attitude; Command; (ShowNumber | 0); 100)*; Disarm} =
  let token = calibrate () in
  perform ShowText "Hold upright";
  delay 1000;
  unbox token as calibration in
  perform Arm calibration;
  perform ShowText "Armed";
  drive 4000000000;
  perform Disarm ()

