(* The M5Stack BALA2 balancing robot under timed regular expressions: the
   order and timing of its control step and its supervision

   Run this example with the 'regex-timed-interval-rational-symbolic' grading monoid, e.g.

     ./tempore --grades regex-timed-interval-rational-symbolic \
       --package m5-imu \
       --package m5-display \
       --package bala2-base \
       examples/arduino/bala2-regex/balance_regex.tpe

   Grades [L, U]: a lower and upper regular-language bound on the traces with
   rational durations
     - Unit [{0}, {0}]: nothing demanded, only the empty trace allowed
     - Top [{0}, ∞): nothing demanded, every trace allowed
     - Product: concatenation of traces, componentwise *)

(* The application of examples/arduino/bala2/balance.tpe, with its control
   law, its tasks and its exchange between them, under the regular
   expressions of timed operations, in milliseconds: the grades fix the
   order of the operations as well as their timing. The device manifest
   balance_regex.device.json runs the control step 'step' every 5 ms, from
   the state of 'start', and the supervision 'supervise' once as a free
   task: a repeated free task needs a grade that bounds its durations below
   by a positive time, and the backend determines the durations of a grade
   under these grades only where they are bounded above, which those of the
   supervision, with its loops, are not. The operations ReadImu, SetMotors,
   ReadEncoders, ResetEncoders, ShowText, ShowNumber and ClearDisplay, and
   the functions tilt_x_of_accel and complementary, come from the packages
   m5-imu, m5-display and bala2-base, whose declarations under these grades
   precede this file. The operations declared below are bound by
   examples/arduino/bala2/bindings.cpp; examples/arduino/bala2/plant.cpp is
   the host model of the robot.

   The PlatformIO project is written, and simulated on the host for 8
   seconds, by

     ./tempore --grades regex-timed-interval-rational-symbolic \
       --emit-arduino balance_regex \
       --device examples/arduino/bala2-regex/balance_regex.device.json \
       --host-simulate 8 \
       examples/arduino/bala2-regex/balance_regex.tpe

   and built for the board, with PlatformIO, by --build in place of
   --host-simulate.

   A grade is a regular expression over the operations and the delays: each
   operation is a letter, within the bounds of its running time, and an
   interval such as [1000, 600000) is a delay. A grade written as one
   expression is both bounds: the operations it names are demanded, in its
   order, and the delays between them are bounded below and above; another
   operation may come between them only within a delay, at the upper bound
   of its running time. A box grade without delays therefore excludes every
   other operation, while a box grade with a long delay bounds the time
   but not the operations within it.

   The typing is relative to the declared bounds of the running times of the
   operations; the monitors of the device check these bounds, and the
   watchdog of the base and the tilt cutoff of the step stop the motors. *)

(* The exchange between the tasks, as in balance.tpe. The step publishes the
   tilt, in degrees, and the rate of the gyroscope, in degrees per second,
   and reads the setpoints: whether the robot is armed, the bias of the
   gyroscope, the speed of the wheels, in encoder counts per second, and the
   difference of the drives of the motors, which turns the robot. The
   supervision reads the attitude, arms the robot with a calibration of the
   gyroscope, disarms it, and commands a speed and a turn; a command older
   than 200 ms is replaced by zero setpoints. The default implementations
   describe an armed robot without commands. *)

type calibration = Calibration of float

operation Publish : float * float ~> unit # {Publish} within [0, 0.05]
default Publish _ = delay 1/100

operation Setpoints : unit ~> bool * float * float * float # {Setpoints} within [0, 0.05]
default Setpoints () = delay 1/100; (true, 0.0, 0.0, 0.0)

operation Attitude : unit ~> float * float # {Attitude} within [0, 0.05]
default Attitude () = delay 1/100; (0.0, 0.0)

operation Arm : calibration ~> unit # {Arm} within [0, 0.05]
default Arm _ = delay 1/100

operation Disarm : unit ~> unit # {Disarm} within [0, 0.05]
default Disarm () = delay 1/100

operation Command : float * float ~> unit # {Command} within [0, 0.05]
default Command _ = delay 1/100

(* The control step. The state is the tilt, in degrees, filtered from the
   inertial measurement unit; the speed of the wheels, in encoder counts per
   second, filtered; the integral of the error of the speed; and the
   position of the wheels, in encoder counts. *)

type state = float * float * float * float

(* The period, in seconds, the weight of the gyroscope in the complementary
   filter of the tilt, and the gains and bounds of the controller, those of
   balance.tpe. *)
let period = 0.005
let gyro_weight = 0.98
let tilt_gain = 50.0
let rate_gain = 0.8
let speed_gain = 0.02
let integral_gain = 0.001
let integral_limit = 2000.0
let reference_limit = 10.0
let cutoff = 70.0

let magnitude (x : float) = if x < 0.0 then ~-.x else x

let clamp (limit : float) (x : float) =
  if x < ~-.limit then ~-.limit else if x > limit then limit else x

(* Correctly accepted by the typechecker: the step reads the unit, the
   encoders and the setpoints, publishes the attitude and commands the
   motors, each once and in this order; its durations, 0.35 to 2 ms, are
   checked against its period of 5 ms by the device. The reading of the unit
   is boxed with the trace of the reads of the encoders and the setpoints,
   without delays: it is used at most 0.65 ms after it is taken, and only if
   no other operation, in particular no command of the motors, has come
   between. *)
let step ((tilt, speed, integral, position) : state) : state
    # {ReadImu; ReadEncoders; Setpoints; Publish; SetMotors} =
  let reading = perform ReadImu () in
  box {ReadEncoders; Setpoints} reading as fresh in
  let left, right = perform ReadEncoders () in
  let armed, bias, target, turn = perform Setpoints () in
  unbox fresh as imu in
  let accel, gyro = imu in
  let raw, _, _ = gyro in
  let rate = raw -. bias in
  let tilt =
    complementary gyro_weight period tilt (tilt_x_of_accel accel) rate
  in
  perform Publish (tilt, raw);
  let now = (left +. right) /. 2.0 in
  let speed = (0.7 *. speed) +. (0.3 *. ((now -. position) /. period)) in
  if armed && magnitude tilt <= cutoff then
    let error = speed -. target in
    let integral = clamp integral_limit (integral +. (error *. period)) in
    let reference =
      clamp reference_limit
        (~-.((speed_gain *. error) +. (integral_gain *. integral)))
    in
    let drive = (tilt_gain *. (tilt -. reference)) +. (rate_gain *. rate) in
    perform SetMotors (drive +. turn, drive -. turn);
    (tilt, speed, integral, now)
  else (
    perform SetMotors (0.0, 0.0);
    (tilt, speed, 0.0, now))

(* The initial state: the encoders reset, and the tilt from the
   accelerometer. *)
let start () : state =
  perform ResetEncoders ();
  let accel, _ = perform ReadImu () in
  (tilt_x_of_accel accel, 0.0, 0.0, 0.0)

