(* The supervision. The bias of the gyroscope is the mean of 50 rates
   published by the step 10 ms apart, with the robot held still. *)

let rec rate_sum (n : nat) (sum : float) : float # {(Attitude; 10)*} =
  match n with
  | 0 -> sum
  | m + 1 ->
      let _, rate = perform Attitude () in
      delay 10;
      rate_sum m (sum +. rate)

(* Correctly accepted by the typechecker: the measurement of the bias
   disarms the robot, clears the display and shows a message before it reads
   the rates, in this order. *)
let measure_bias () : float
    # {Disarm; ClearDisplay; ShowText; (Attitude; 10)*} =
  perform Disarm ();
  perform ClearDisplay ();
  perform ShowText "Calibrating";
  let sum = rate_sum 50 0.0 in
  sum /. 50.0

(* Correctly rejected by the typechecker: the measurement does not disarm
   the robot first, so that the motors may move it while the rates are read:

     Typing error: This function's body has grade
       `[{ClearDisplay; ShowText}, {ClearDisplay; ShowText; _*}]`, which does
       not match its annotated grade
       `[{Disarm; ClearDisplay; ShowText; (Attitude; 10)*},
       {Disarm; ClearDisplay; ShowText; (Attitude; 10)*}]`
       Note: the effect inequality
         `[{ClearDisplay; ShowText}, {ClearDisplay; ShowText; _*}] <=
         [{Disarm; ClearDisplay; ShowText; (Attitude; 10)*},
         {Disarm; ClearDisplay; ShowText; (Attitude; 10)*}]` does not hold
*)
(*
let measure_bias_armed () : float
    # {Disarm; ClearDisplay; ShowText; (Attitude; 10)*} =
  perform ClearDisplay ();
  perform ShowText "Calibrating";
  let sum = rate_sum 50 0.0 in
  sum /. 50.0
*)

(* The calibration is boxed with a message on the display followed by a
   delay of one second to ten minutes: arming the robot needs it unboxed,
   that is, at least a second after the message that asks for the robot to
   be held upright, and at most ten minutes after the calibration. *)
let calibrate () =
  let bias = measure_bias () in
  box {ShowText; [1000, 600000)} (Calibration bias)

(* Correctly accepted by the typechecker: an iteration of the drive reads
   the attitude, commands zero setpoints, shows the tilt every tenth
   iteration and waits 100 ms, in this order. Each iteration is boxed with a
   delay below 200 ms: it takes at most 120.1 ms, within the 200 ms after
   which a command expires. *)
let drive_step (n : nat) : unit # {Attitude; Command; (ShowNumber | 0); 100} =
  let tilt, _ = perform Attitude () in
  perform Command (0.0, 0.0);
  (if n mod 10 = 0 then perform ShowNumber tilt else ());
  delay 100

let rec drive (n : nat) : unit
    # {(Attitude; Command; (ShowNumber | 0); 100)*} =
  match n with
  | 0 -> ()
  | m + 1 ->
      box [0, 200) () as expiry in
      drive_step m;
      unbox expiry as _ in
      drive m

(* Correctly rejected by the typechecker: an iteration of the drive clears
   and redraws the display, and may take 200.1 ms, so that a command may
   expire before the next:

     Typing error: Variable `expiry` is unboxed with grade
       `[{Attitude; Command; ClearDisplay; ShowText; ShowNumber; 100},
       {Attitude; Command; ClearDisplay; ShowText; ShowNumber; 100}]`
       accumulated since it was bound, which is not below its box grade
       `[{0}, {[0, 200)}]`
       ...
       Note: the resource inequality
         `[{Attitude; Command; ClearDisplay; ShowText; ShowNumber; 100},
         {Attitude; Command; ClearDisplay; ShowText; ShowNumber; 100}] <=
         [{0}, {[0, 200)}]` does not hold
*)
(*
let drive_step_redrawn (n : nat) =
  let tilt, _ = perform Attitude () in
  perform Command (0.0, 0.0);
  perform ClearDisplay ();
  perform ShowText "Tilt";
  perform ShowNumber tilt;
  delay 100

let rec drive_redrawn (n : nat) : unit # {_*} =
  match n with
  | 0 -> ()
  | m + 1 ->
      box [0, 200) () as expiry in
      drive_step_redrawn m;
      unbox expiry as _ in
      drive_redrawn m
*)

(* Correctly accepted by the typechecker: the robot is calibrated, held
   upright for a second, armed with a calibration 1000.2 to 1020 ms old, and
   driven for about 13 years, after which it is disarmed. Its grade is the
   protocol of the supervision: calibrate, arm, drive and disarm, in this
   order. *)
let supervise () : unit
    # {Disarm; ClearDisplay; ShowText; (Attitude; 10)*; ShowText; 1000; Arm;
       ShowText; (Attitude; Command; (ShowNumber | 0); 100)*; Disarm} =
  let token = calibrate () in
  perform ShowText "Hold upright";
  delay 1000;
  unbox token as calibration in
  perform Arm calibration;
  perform ShowText "Armed";
  drive 4000000000;
  perform Disarm ()

(* Correctly rejected by the typechecker: the robot is armed with the boxed
   calibration, not with an unboxed one:

     Typing error: Operation `Arm` takes an argument of type `calibration` but
       is given `[_]calibration`
       ...
*)
(*
let supervise_unchecked () =
  let token = calibrate () in
  perform Arm token;
  drive 4000000000
*)

