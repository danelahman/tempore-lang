(* The box of the calibration bounds the time to the arming, but not the
   operations within it: an operation may come within its delay, at the
   upper bound of its running time, so that a second measurement of the
   bias between the message and the arming is not excluded. The box of the
   reading of the unit, without delays, excludes every other operation. *)

(* Two control steps from the reading of the default implementation of the
   unit, a robot at rest, and a tilt of 3 degrees. *)
run step (step (3.0, 0.0, 0.0, 0.0, 0.0))

(* The simulation by handlers, in the interpreter. Under these grades a case
   of an operation is checked against the grade of the operation, its own
   trace: the case of an atomic operation performs the operation once and
   nothing else, and may replace its argument and its result. The handlers
   below therefore keep the operations, and with them their running times,
   those of the default implementations in the interpreter, and replace the
   readings by those of a model of the robot. The device does not use them:
   the Arduino backend compiles the definitions that the tasks of the
   manifest use, and handlers are outside its fragment. *)

(* Correctly accepted by the typechecker: the robot at the tilt 'tilt', in
   degrees, turning at the rate 'rate', in degrees per second, with the
   wheels at the position 'position', in encoder counts. The case of ReadImu
   replaces the reading by the direction of gravity, its y component
   approximated by the tilt in radians, and the rate about the x axis; the
   case of ReadEncoders replaces the counts by those of the position; the
   case of SetMotors returns, with the result of the handled computation,
   the mean of the drives of the motors. *)
let simulated_robot (tilt : float) (rate : float) (position : float) =
  handler
  | s -> (s, 0.0)
  | ReadImu () k ->
      let _ = perform ReadImu () in
      continue k with ((0.0, tilt /. imu_degrees, 1.0), (rate, 0.0, 0.0))
  | ReadEncoders () k ->
      let _ = perform ReadEncoders () in
      let counts = int_of_float position in
      continue k with (counts, counts)
  | SetMotors (left, right) k ->
      perform SetMotors (left, right);
      let s, _ = continue k with () in
      (s, (float_of_int left +. float_of_int right) /. 2.0)

(* The closed loop of 'n' control steps with a linear model of the robot,
   whose coefficients are chosen for the illustration, not identified from
   the BALA2: the angular acceleration, in degrees per second squared, is
   100 times the tilt less 150 times the mean drive, and the wheels turn by
   2 encoder counts per second for each unit of drive. The result is the
   state of the step and the tilt of the model after the last step. *)
let rec balance (n : nat) (tilt : float) (rate : float) (position : float)
    (s : state) : state * float
    # {(ReadImu; ReadEncoders; Setpoints; Publish; SetMotors)*} =
  match n with
  | 0 -> (s, tilt)
  | m + 1 ->
      let s, drive = handle step s with simulated_robot tilt rate position in
      let rate = rate +. (period *. ((100.0 *. tilt) -. (150.0 *. drive))) in
      let tilt = tilt +. (period *. rate) in
      balance m tilt rate (position +. (2.0 *. period *. drive)) s

(* Correctly accepted by the typechecker: the injection of a fault, a
   gyroscope stuck at its full-scale rate of 2000 degrees per second. The
   case of ReadImu performs the operation, which a handler around it may
   handle in turn, and replaces the rate of its reading. *)
let stuck_gyroscope =
  handler
  | s -> s
  | ReadImu () k ->
      let accel, _ = perform ReadImu () in
      continue k with (accel, (2000.0, 0.0, 0.0))

(* 'n' control steps of the robot held upright at rest, with the gyroscope
   stuck. The result is the state of the step and the mean drive of the
   motors in the last step. *)
let rec held (n : nat) (s : state) (drive : float) : state * float
    # {(ReadImu; ReadEncoders; Setpoints; Publish; SetMotors)*} =
  match n with
  | 0 -> (s, drive)
  | m + 1 ->
      let s, drive =
        handle (handle step s with stuck_gyroscope)
        with simulated_robot 0.0 0.0 0.0
      in
      held m s drive

(* Correctly rejected by the typechecker: the case of ReadImu also commands
   the motors, so that its trace is not that of the operation:

     Typing error: Variable `k` is unboxed with grade
       `[{ReadImu; SetMotors}, {ReadImu; SetMotors}]` accumulated since it
       was bound, which is not below its box grade
       `[{ReadImu}, {ReadImu}]`
       ...
       Note: the resource inequality
         `[{ReadImu; SetMotors}, {ReadImu; SetMotors}] <=
         [{ReadImu}, {ReadImu}]` does not hold
*)
