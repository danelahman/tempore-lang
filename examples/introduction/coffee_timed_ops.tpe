(* A café whose coffee is served once it has been paid for, hasn't been
   refunded, has had time to brew, and has optionally had milk or sugar added.

   Run this example with the 'regex-timed-interval-rational-symbolic' grading monoid, e.g.

     ./tempore --grades regex-timed-interval-rational-symbolic examples/introduction/coffee_timed_ops.tpe

   Grades [L, U]: a lower and upper bound on the traces with rational durations, 
   expresssed as regular expressions (as explained in 'coffee.tpe')
     - Unit [{0}, {0}]: nothing demanded, only the empty trace allowed
     - Top [{0}, ∞): nothing demanded, every trace allowed
     - Product: concatenation of traces, componentwise *)

(* The preceding example, 'coffee.tpe', introduced
     - boxes, whose values may be unboxed only once/until the computation since
       boxing the resource has accumulated a grade below the box's grade
     - operations and delays, and traces as sequences of them; in the traces, 
       operations take no time, so only delays make time pass explicitly
     - grades as regular expressions over traces

   New in this example: operations can also take time when computing
     - a declaration 'within [lo, hi]' bounds the running time of the
       operation to be between `lo` and `hi` minutes
     - 'default Op () = ...' gives the implementation that a run executes when
       the operation is not handled by an effect handler; here each default 
       simulates the operation by a delay within its running-time bounds

   A duration is an amount of elapsed time, passing through delays or through
   the running times of operations.

   Here, a grade is an interval '[L, U]' of two regular expressions of traces. 

   The grade of a computation is below '[L, U]' if
     - with each operation read as itself or as a duration of its lower
       running-time bound, its traces are among those of L: the computation
       takes at least what L demands
     - with each operation read as itself or as a duration of its upper
       running-time bound, its traces are among those of U: the computation
       performs only what U allows *)

(* The stages of a cup of coffee, as in 'coffee.tpe', and grinding. *)
type beans = Beans of string
type ground = Ground of beans
type brewed = Brewed of ground
type cup = Cup of brewed

let grind beans = Ground beans

(* Paying has a running time between half a minute and one minute; its default
   takes three quarters of a minute. *)
operation Pay : unit ~> unit # {Pay} within [1/2, 1]
default Pay () = delay 3/4

(* Brewing has a running time between four and six minutes; its default takes
   five minutes. *)
operation Brew : unit ~> unit # {Brew} within [4, 6]
default Brew () = delay 5

(* Adding milk or sugar has a running time between a quarter and half a
   minute; their defaults take a quarter of a minute. *)
operation Milk : unit ~> unit # {Milk} within [1/4, 1/2]
default Milk () = delay 1/4

operation Sugar : unit ~> unit # {Sugar} within [1/4, 1/2]
default Sugar () = delay 1/4

(* A refund has a running time between half a minute and one minute; 
   its default takes two thirds of a minute. *)
operation Refund : unit ~> unit # {Refund} within [1/2, 1]
default Refund () = delay 2/3

(* This program is correctly accepted by the typechecker.

   The brewing coffee is boxed, as the pot, and is served in a cup once unboxed.

   At their lower running-time bounds the operations take 1/2 + 4 + 1/4 + 1/4 =
   5 minutes, a duration of at least 5, and the trace 'Pay; Brew; Milk; Sugar'
   is among those that pay, brew and then add any number of milk and sugar.

   The upper bound lists the permitted operations rather than excluding the
   refund by '(_ & ~Refund)*': in the upper component a duration may stand for
   an operation at its upper running-time bound, and '_' also matches durations,
   so that bound would admit the refund we want to rule out. *)
let sweet_serving beans =
  box [{[5, ∞)}, {Pay; Brew; (Milk | Sugar)*}]
    (Brewed (grind beans)) as pot in
  perform Pay ();
  perform Brew ();
  perform Milk ();
  perform Sugar ();
  unbox pot as coffee in
  Cup coffee

(* This program is correctly rejected by the typechecker.

   Without adding the sugar, the operations take 1/2 + 4 + 1/4 = 4.75 at their
   lower running-time bounds, less than the 5 the lower bound demands.

     Typing error: Variable `pot` is unboxed with grade `[{Pay; Brew; Milk},
       {Pay; Brew; Milk}]` accumulated since it was bound, which is not below
       its box grade `[{[5, ∞)}, {Pay; Brew; (Milk | Sugar)*}]`
       ...
       Note: the resource inequality
         `[{Pay; Brew; Milk}, {Pay; Brew; Milk}] <= [{[5, ∞)}, {Pay; Brew; (Milk | Sugar)*}]`
         does not hold
*)
(*
let rushed_serving beans =
  box [{[5, ∞)}, {Pay; Brew; (Milk | Sugar)*}]
    (Brewed (grind beans)) as pot in
  perform Pay ();
  perform Brew ();
  perform Milk ();
  unbox pot as coffee in
  Cup coffee
*)

(* This program is correctly rejected by the typechecker. 

   The refund makes up the time, 5.25 minutes at the lower running-time bounds,
   but the trace 'Pay; Brew; Refund; Milk' is not among those the upper bound
   allows.

     Typing error: Variable `pot` is unboxed with grade `[{Pay; Brew; Refund;
       Milk}, {Pay; Brew; Refund; Milk}]` accumulated since it was bound, which
       is not below its box grade `[{[5, ∞)}, {Pay; Brew; (Milk | Sugar)*}]`
       ...
       Note: the resource inequality
         `[{Pay; Brew; Refund; Milk}, {Pay; Brew; Refund; Milk}] <= [{[5, ∞)}, {Pay; Brew; (Milk | Sugar)*}]`
         does not hold
*)
(*
let refunded_serving beans =
  box [{[5, ∞)}, {Pay; Brew; (Milk | Sugar)*}]
    (Brewed (grind beans)) as pot in
  perform Pay ();
  perform Brew ();
  perform Refund ();
  perform Milk ();
  unbox pot as coffee in
  Cup coffee
*)

(* The top-level command 'run' executes a computation and prints its value and
   final state.

   Here the operations are not handled, so the run executes their default
   implementations, and the serving takes 3/4 + 5 + 1/4 + 1/4 = 6.25 minutes. *)
run sweet_serving (Beans "arabica")
