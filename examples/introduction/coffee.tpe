(* A café whose coffee is served once it has brewed, timed in minutes.

   Run this example with the 'regex-upper-bound-rational-symbolic' grading monoid, e.g.

     ./tempore --grades regex-upper-bound-rational-symbolic examples/introduction/coffee.tpe

   Grades {...}: regular languages of traces over operations and rational delays
     - Unit {0}: the empty trace
     - Top ⊤: every trace
     - Product: concatenation of traces, adjacent delays added *)

(* In Tempore, resources are placed in boxes that guard when they can be used. 

   The computation 'box ρ v as x in c' boxes the value v at the grade ρ and
   continues with c; within c, the value may be used, by 'unbox x as y in ...',
   only once/until the computation since boxing has accumulated a grade below ρ.

   A trace of a computation is the sequence of operations it performs and 
   delays it makes, in order, e.g. 'Pay; 3; 2; Milk'; 'delay q' performs
   computationally a delay of q minutes, and adjacent delays add.

   In this example, each grade is a set of traces: the grade of a computation 
   contains every trace it may have, and a box's grade specifies the traces 
   permitted between boxing and unboxing.

   A grade is written as a regular expression in braces:
     - 'r; s' is the sequence of r and s, 'r | s' the choice between them
     - 'r*' is any number of repetitions of r
     - '_' is any single operation or positive delay
     - '~r' is the complement of r, 'r & s' the intersection of r and s
     - an interval such as '[5, ∞)' is a delay of at least 5

   A grade is below another if its set of traces is included in the other's.

   The typechecker infers the type and grade of every defined computation, and
   checks the validity of each unboxing before the program is run. *)

(* An operation declaration gives the operation's name, its argument and
   result types, and the grade specifying what performing it means; 
   'perform Pay ()' performs Pay, a computation with the single trace 'Pay'. *)
operation Pay : unit ~> unit # {Pay}
operation Milk : unit ~> unit # {Milk}
operation Sugar : unit ~> unit # {Sugar}
operation Refund : unit ~> unit # {Refund}

(* The stages of a cup of coffee, each an inductive type whose constructor wraps
   the preceding stage: beans, ground beans, brewed coffee, and served cup. *)
type beans = Beans of string
type ground = Ground of beans
type brewed = Brewed of ground
type cup = Cup of brewed

let grind beans = Ground beans

(* This program is correctly accepted by the typechecker.

   The brewing coffee is boxed, as the pot, at the traces consisting of delays
   of at least 5 minutes, and it is served in a cup once unboxed. *)
let timely_serving beans =
  box {[5, ∞)} (Brewed (grind beans)) as pot in
  delay 3;
  delay 2;
  unbox pot as coffee in
  Cup coffee

(* This program is correctly rejected by the typechecker. 

   The box grade demands a delay of at least 5, and the delay of 3 is shorter.

     Typing error: Variable `pot` is unboxed with grade `{3}` accumulated since
       it was bound, which is not below its box grade `{[5, ∞)}`
       ...
       Note: the resource inequality `{3} <= {[5, ∞)}` does not hold
*)
(*
let rushed_serving beans =
  box {[5, ∞)} (Brewed (grind beans)) as pot in
  delay 3;
  unbox pot as coffee in
  Cup coffee
*)

(* This program is correctly accepted by the typechecker. 

   The pot is boxed at the traces that pay, perform no refund, wait for at least
   5, still don't refund, and end with any number of additions of milk and sugar. 

   The trace 'Pay; 5; Milk' is among them, each '(_ & ~Refund)*' component matching 
   the empty trace. *)
let paid_serving beans =
  box {Pay; (_ & ~Refund)*; [5, ∞);
       (_ & ~Refund)*; (Milk | Sugar)*}
    (Brewed (grind beans)) as pot in
  perform Pay ();
  delay 3;
  delay 2;
  perform Milk ();
  unbox pot as coffee in
  Cup coffee

(* This program is correctly rejected by the typechecker. 

   No part of the grade matches the refund in the trace
   'Pay; 3; Refund; 2; Milk', since '_ & ~Refund' excludes it and
   '(Milk | Sugar)*' does not contain it either.

     Typing error: Variable `pot` is unboxed with grade `{Pay; 3; Refund; 2;
       Milk}` accumulated since it was bound, which is not below its box grade
       `{Pay; (_ & ~Refund)*; [5, ∞); (_ & ~Refund)*; (Milk | Sugar)*}`
       ...
       Note: the resource inequality
         `{Pay; 3; Refund; 2; Milk} <=
            {Pay; (_ & ~Refund)*; [5, ∞); (_ & ~Refund)*; (Milk | Sugar)*}`
         does not hold
*)
(*
let refunded_serving beans =
  box {Pay; (_ & ~Refund)*; [5, ∞);
       (_ & ~Refund)*; (Milk | Sugar)*}
    (Brewed (grind beans)) as pot in
  perform Pay ();
  delay 3;
  perform Refund ();
  delay 2;
  perform Milk ();
  unbox pot as coffee in
  Cup coffee
*)

(* The top-level command 'run' executes a computation and prints its value and
   final state.

   In this prototype, an operation without a default implementation stops a 
   run, so the run executes the first definition, which uses delays alone. *)
run timely_serving (Beans "arabica")
