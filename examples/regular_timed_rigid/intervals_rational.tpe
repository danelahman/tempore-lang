(* A reaction window timed in milliseconds: at least three polls, and nothing but polls at most 2.5 milliseconds apart.

   Run this example with the 'regex-timed-rigid-interval-rational-symbolic' grading monoid, e.g.

     ./tempore --grades regex-timed-rigid-interval-rational-symbolic \
       examples/regular_timed_rigid/intervals_rational.tpe

   Grades [L, U]: a lower and an upper bound on the traces with rational
   durations, in the rigid order: operations are matched in order, budgets
   admit operations within their time, strict waits `!` admit none, a
   literal is read by its hull on each side, and operations take positive
   time
     - Unit {0}: the empty trace
     - Top {≥0}: every trace
     - Product: concatenation of traces, componentwise *)

type sample = Sample of nat

(* A reading of the inertial unit, a reading of the clock and a redraw of the
   screen, in milliseconds. *)
operation ReadImu : unit ~> nat # {ReadImu} within [0.2, 1.5]
default ReadImu () = delay 0.6; 3

operation ReadClock : unit ~> nat # {ReadClock} within (0, 0.05]
default ReadClock () = delay 0.02; 1200

operation Redraw : unit ~> unit # {Redraw} within [0.05, 33]
default Redraw () = delay 21.5

(* Correctly accepted by the typechecker: the first reading is boxed and
   averaged with the readings of three polls, which the lower bound demands,
   each after a delay of at most 2.5 milliseconds, as the upper bound allows,
   which demands every operation of its rounds and so excludes a pause or
   another operation between them. *)
let window () =
  let first = perform ReadImu () in
  box [{(≥0; ReadImu; ReadClock)^3; ≥0},
       {(2.5; ReadImu; ReadClock)*}] first as w in
  delay 1.75;
  let a = perform ReadImu () in
  let s = perform ReadClock () in
  delay 2.25;
  let b = perform ReadImu () in
  let t = perform ReadClock () in
  delay 1.5;
  let c = perform ReadImu () in
  let u = perform ReadClock () in
  unbox w as first' in
  Sample ((first' + a + b + c) / 4)

(* Correctly rejected by the typechecker: the average is taken after two polls,
   short of the three the lower bound demands:

     Typing error: Variable `w` is unboxed with grade
       `{!1.75; ReadImu; ReadClock; !2.25; ReadImu; ReadClock}` accumulated
       since it was bound, which is not below its box grade
       `[{(≥0; ReadImu; ReadClock)^3; ≥0},
         {(≤2.5; ReadImu; ReadClock)*}]`
       ...
       Note: the resource inequality
         `{!1.75; ReadImu; ReadClock; !2.25; ReadImu; ReadClock} <= [{(≥0; ReadImu; ReadClock)^3; ≥0}, {(≤2.5; ReadImu; ReadClock)*}]`
         does not hold
*)
(*
let window_short () =
  let first = perform ReadImu () in
  box [{(≥0; ReadImu; ReadClock)^3; ≥0},
       {(2.5; ReadImu; ReadClock)*}] first as w in
  delay 1.75;
  let a = perform ReadImu () in
  let s = perform ReadClock () in
  delay 2.25;
  let b = perform ReadImu () in
  let t = perform ReadClock () in
  unbox w as first' in
  Sample ((first' + a + b) / 3)
*)

(* Correctly rejected by the typechecker: the screen is redrawn between the
   second and the third poll, which no delay of 2.5 milliseconds pays for.
   Under 'regex-timed-interval-rational-symbolic', with the lower bound
   {(ReadImu; ReadClock)^3}, it is accepted, the delays of further rounds of
   the upper bound paying for the redraw:

     Typing error: Variable `w` is unboxed with grade
       `{!1.75; ReadImu; ReadClock; !2.25; ReadImu; ReadClock; Redraw; ReadImu;
       ReadClock}` accumulated since it was bound, which is not below its
       box grade
       `[{(≥0; ReadImu; ReadClock)^3; ≥0},
         {(≤2.5; ReadImu; ReadClock)*}]`
       ...
       Note: the resource inequality
         `{!1.75; ReadImu; ReadClock; !2.25; ReadImu; ReadClock; Redraw; ReadImu; ReadClock} <= [{(≥0; ReadImu; ReadClock)^3; ≥0}, {(≤2.5; ReadImu; ReadClock)*}]`
         does not hold
*)
(*
let window_redrawn () =
  let first = perform ReadImu () in
  box [{(≥0; ReadImu; ReadClock)^3; ≥0},
       {(2.5; ReadImu; ReadClock)*}] first as w in
  delay 1.75;
  let a = perform ReadImu () in
  let s = perform ReadClock () in
  delay 2.25;
  let b = perform ReadImu () in
  let t = perform ReadClock () in
  perform Redraw ();
  let c = perform ReadImu () in
  let u = perform ReadClock () in
  unbox w as first' in
  Sample ((first' + a + b + c) / 4)
*)

run window ()
