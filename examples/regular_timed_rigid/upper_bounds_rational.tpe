(* A reaction timer timed in milliseconds: a start signal, its time stamp and a loop of polls, bounded by rigid regular upper bounds.

   Run this example with the 'regex-timed-rigid-upper-bound-rational-symbolic' grading monoid, e.g.

     ./tempore --grades regex-timed-rigid-upper-bound-rational-symbolic \
       examples/regular_timed_rigid/upper_bounds_rational.tpe

   Grades {...}: upper bounds on the traces with rational durations, in the
   rigid order: operations are matched in order, budgets admit operations
   within their time, strict waits `idle` admit none, a literal is read by the
   upper end of its hull, and operations take positive time
     - Unit {0}: the empty trace, not the least grade
     - Top {≥0}: every trace
     - Product: concatenation of traces *)

type stamp = Stamp of nat

(* The operations of a reaction timer, in milliseconds: a start signal, a
   reading of the clock, a reading of the inertial unit and a redraw of the
   screen. *)
operation Beep : unit ~> unit ! {Beep} within (0, 0.15]
default Beep () = delay 0.1

operation ReadClock : unit ~> nat ! {ReadClock} within (0, 0.05]
default ReadClock () = delay 0.02; 1200

operation ReadImu : unit ~> nat ! {ReadImu} within [0.2, 1.5]
default ReadImu () = delay 0.6; 3

operation Redraw : unit ~> unit ! {Redraw} within [0.05, 33]
default Redraw () = delay 21.5

(* Correctly accepted by the typechecker: the time stamp read before the
   polls is boxed, and the time from it to the last poll is measured after
   three polls, each a reading of the inertial unit and a time stamp, each
   after a delay of at most 2.5 milliseconds. The loop demands its polls: a
   pause or another operation between them is not a poll. *)
let polls () =
  let start = perform ReadClock () in
  box {(2.5; ReadImu; ReadClock)*} start as p in
  delay 1.8;
  let a = perform ReadImu () in
  let s = perform ReadClock () in
  delay 2.25;
  let b = perform ReadImu () in
  let t = perform ReadClock () in
  delay 0.75;
  let c = perform ReadImu () in
  let u = perform ReadClock () in
  unbox p as start' in
  u - start'

(* Correctly accepted by the typechecker: the lane of the athlete is boxed,
   and the start is recorded for it, with its time stamp, only if the time
   stamp follows the start signal at once, without a delay that could buy
   another operation between them, and the first poll follows within 750
   milliseconds. *)
let stamped (lane : nat) =
  box {Beep; ReadClock; [0, 750]} lane as s in
  perform Beep ();
  let t = perform ReadClock () in
  delay 312.5;
  let a = perform ReadImu () in
  unbox s as lane' in
  (lane', Stamp t)

(* Correctly accepted by the typechecker: as 'stamped', the time stamp read
   within 40 milliseconds of the start signal. The redraw is not in the
   bound, and is bought within its delay of at most 40 milliseconds before
   the time stamp, at its upper running-time bound of 33. *)
let redrawn (lane : nat) =
  box {Beep; [0, 40]; ReadClock} lane as s in
  perform Beep ();
  perform Redraw ();
  delay 6.5;
  let t = perform ReadClock () in
  unbox s as lane' in
  (lane', Stamp t)

(* Correctly rejected by the typechecker: a redraw of up to 33 milliseconds
   between two polls exceeds the 2.5 the loop allows. Under the allowance
   order of 'regex-timed-upper-bound-rational-symbolic', which leaves the
   operations of a bound out, it is accepted, the delays of further rounds
   paying for the redraw:

     Typing error: Variable `p` is unboxed with grade
       `{ReadImu; ReadClock; Redraw; ReadImu; ReadClock}` accumulated since it
       was bound, which is not below its box grade
       `{(≤2.5; ReadImu; ReadClock)*}`
       ...
       Note: the resource inequality
         `{ReadImu; ReadClock; Redraw; ReadImu; ReadClock} <= {(≤2.5; ReadImu; ReadClock)*}`
         does not hold
*)
(*
let polls_redrawn () =
  let start = perform ReadClock () in
  box {(2.5; ReadImu; ReadClock)*} start as p in
  let a = perform ReadImu () in
  let s = perform ReadClock () in
  perform Redraw ();
  let b = perform ReadImu () in
  let t = perform ReadClock () in
  unbox p as start' in
  t - start'
*)

(* Correctly rejected by the typechecker: the screen is redrawn between the
   start signal and its time stamp, which the bound places next to each
   other. Under the allowance order it is accepted, the time stamp of the
   bound left out and the redraw bought within the 750 milliseconds:

     Typing error: Variable `s` is unboxed with grade `{Beep; Redraw; ReadClock;
       idle ≤312.5; ReadImu}` accumulated since it was bound, which is not below
       its box grade `{Beep; ReadClock; ≤750}`
       ...
       Note: the resource inequality
         `{Beep; Redraw; ReadClock; idle ≤312.5; ReadImu} <= {Beep; ReadClock; ≤750}`
         does not hold
*)
(*
let stamped_late (lane : nat) =
  box {Beep; ReadClock; [0, 750]} lane as s in
  perform Beep ();
  perform Redraw ();
  let t = perform ReadClock () in
  delay 312.5;
  let a = perform ReadImu () in
  unbox s as lane' in
  (lane', Stamp t)
*)

(* Correctly rejected by the typechecker: a redraw of up to 33 milliseconds and
   a delay of 7.5 exceed the 40 before the time stamp:

     Typing error: Variable `s` is unboxed with grade
       `{Beep; Redraw; idle ≤7.5; ReadClock}` accumulated since it was bound,
       which is not below its box grade `{Beep; ≤40; ReadClock}`
       ...
       Note: the resource inequality
         `{Beep; Redraw; idle ≤7.5; ReadClock} <= {Beep; ≤40; ReadClock}` does
         not hold
*)
(*
let redrawn_slowly (lane : nat) =
  box {Beep; [0, 40]; ReadClock} lane as s in
  perform Beep ();
  perform Redraw ();
  delay 7.5;
  let t = perform ReadClock () in
  unbox s as lane' in
  (lane', Stamp t)
*)

run stamped 4
