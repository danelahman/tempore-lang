(* A weather station timed in seconds, its runs bounded below and above by regular languages.

   Run this example with the 'regex-cost-interval-rational' grading monoid, e.g.

     ./tempore --grades regex-cost-interval-rational examples/regular_costs/regular_costs_intervals_rational.tpe

   Grades [L, U]: a lower and upper regular-language bound on the runs with rational delays
     - Unit [{0}, {0}]: nothing demanded, only the empty run allowed
     - Top [{0}, ∞): nothing demanded, every run allowed
     - Product: concatenation of runs, componentwise *)

type reading = Reading of nat
type packet = Packet of reading

(* A reading of the sensors takes between half a second and one and a half;
   unhandled, it takes three quarters. *)
operation Sample : unit ~> reading # {Sample} within [1/2, 3/2]
default Sample () = delay 0.75; Reading 12

(* Compressing a reading takes between a quarter of a second and one. *)
operation Compress : reading ~> packet # {Compress} within [1/4, 1]
default Compress r = delay 1/4; Packet r

(* A transmission takes more than half a second and at most one and a half:
   its runtime bounds are open below. Unhandled, it takes three quarters,
   within these bounds. *)
operation Transmit : packet ~> unit # {Transmit} within (1/2, 3/2]
default Transmit p = delay 3/4

(* A report samples, compresses and transmits, in that order. *)
operation Report : unit ~> unit # {Sample; Compress; Transmit}

(* Correctly accepted by the typechecker: the packet may be used after more
   than 0.8 seconds and must be used within less than three, the interval
   (0.8, 3), that is, [{(0.8, ∞)}, {[0, 3)}]. The sample, the pause and the
   compression take at least 1/2 + 1/5 + 1/4 = 0.95 and at most
   3/2 + 1/5 + 1 = 2.7. *)
let settled_packet () =
  box (0.8, 3) () as window in
  let r = perform Sample () in
  delay 1/5;
  let p = perform Compress r in
  unbox window as w in
  p

(* Correctly accepted by the typechecker: a window written with regular
   expressions, demanding the sample and a pause of a fifth, and allowing the
   sample, a pause of more than nothing and at most a quarter, and the
   compression. *)
let settled_by_events () =
  box [{Sample; 1/5}, {Sample; (0, 1/4]; Compress}] () as window in
  let r = perform Sample () in
  delay 1/5;
  let p = perform Compress r in
  unbox window as w in
  p

(* Correctly accepted by the typechecker: at least one sample, and at most
   samples each followed by a pause of at most a third. *)
let polling () =
  box [{Sample}, {(Sample; [0, 1/3])*}] () as window in
  let r = perform Sample () in
  delay 1/4;
  let s = perform Sample () in
  delay 1/3;
  unbox window as w in
  s

(* Correctly accepted by the typechecker: the upper bound excludes the single
   pause of one second, but a grade stands for its closure, and the longer
   pauses the complement keeps permit it. *)
let offbeat () =
  box [{1}, {~1}] () as window in
  delay 1/2;
  delay 1/2;
  unbox window as w in
  w

(* Correctly accepted by the typechecker: the report itself, performed by
   hand, realises the grade of 'Report'. *)
let report_by_hand () =
  let r = perform Sample () in
  let p = perform Compress r in
  perform Transmit p

(* Correctly accepted by the typechecker: a report takes more than
   1/2 + 1/4 + 1/2 = 5/4 seconds, since a transmission takes more than half a
   second, and at most 3/2 + 1 + 3/2 = 4, so it fits a radio slot that opens
   after 5/4 seconds and closes at 4. *)
let report_in_slot () =
  box (5/4, 4] () as slot in
  perform Report ();
  unbox slot as s in
  s

(* Correctly rejected by the typechecker: without the pause, the sample and
   the compression may take exactly 1/2 + 1/4 = 3/4 seconds, which the window
   open at 3/4 excludes; the closed window [3/4, 3] would permit it:

     Typing error: Variable `window` is unboxed with grade
       `[{Sample; Compress}, {Sample; Compress}]` accumulated since it was
       bound, which is not below its box grade `[{(0.75, ∞)}, {[0, 3)}]`
       ...
       Note: the resource inequality
         `[{Sample; Compress}, {Sample; Compress}] <= [{(0.75, ∞)}, {[0, 3)}]`
         does not hold
*)
(*
let hasty_packet () =
  box (3/4, 3) () as window in
  let r = perform Sample () in
  let p = perform Compress r in
  unbox window as w in
  p
*)

(* Correctly rejected by the typechecker: a pause of half a second exceeds
   the quarter the upper bound allows between the sample and the compression:

     Typing error: Variable `window` is unboxed with grade
       `[{Sample; 0.5; Compress}, {Sample; 0.5; Compress}]` accumulated since
       it was bound, which is not below its box grade
       `[{Sample; 0.2}, {Sample; (0, 0.25]; Compress}]`
       ...
       Note: the resource inequality
         `[{Sample; 0.5; Compress}, {Sample; 0.5; Compress}] <= [{Sample; 0.2}, {Sample; (0, 0.25]; Compress}]`
         does not hold
*)
(*
let idle_packet () =
  box [{Sample; 1/5}, {Sample; (0, 1/4]; Compress}] () as window in
  let r = perform Sample () in
  delay 1/2;
  let p = perform Compress r in
  unbox window as w in
  p
*)

(* Correctly rejected by the typechecker: a report may take exactly four
   seconds, which the slot open at 4 excludes:

     Typing error: Variable `slot` is unboxed with grade
       `[{Sample; Compress; Transmit}, {Sample; Compress; Transmit}]`
       accumulated since it was bound, which is not below its box grade
       `[{(1.25, ∞)}, {[0, 4)}]`
       ...
       Note: the resource inequality
         `[{Sample; Compress; Transmit}, {Sample; Compress; Transmit}] <= [{(1.25, ∞)}, {[0, 4)}]`
         does not hold
*)
(*
let report_in_short_slot () =
  box (5/4, 4) () as slot in
  perform Report ();
  unbox slot as s in
  s
*)

(* The operations are atomic and run their defaults, so the report takes
   0.75 + 0.25 + 0.75 = 1.75 seconds. *)
run report_by_hand ()
