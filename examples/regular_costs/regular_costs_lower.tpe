(* Run this example with the 'traces-regex-lower-symbolic' grading monoid, e.g.

     ./tempore --grades traces-regex-lower-symbolic examples/regular_costs/regular_costs_lower.tpe *)

type part = Part of string

(* The operations of a coating line: a coating takes one to two ticks, a bake
   three to five and an inspection one. *)
operation Coat : unit ~> unit # {Coat} within (1, 2)
default Coat () = delay 1

operation Bake : unit ~> unit # {Bake} within (3, 5)
default Bake () = delay 4

operation Inspect : unit ~> unit # {Inspect} within (1, 1)
default Inspect () = delay 1

(* Correctly accepted by the typechecker: the part cures for at least four
   ticks, banked by a bake (three) and an inspection (one). *)
let cured () =
  box {4} (Part "gear") as p in
  perform Bake ();
  perform Inspect ();
  unbox p as x in
  x

(* Correctly accepted by the typechecker: the coating is matched by the
   grade's own, and the bake and a tick of waiting after it bank the four ticks
   of curing demanded. *)
let coated_then_cured () =
  box {Coat; 4} (Part "gear") as p in
  perform Coat ();
  perform Bake ();
  delay 1;
  unbox p as x in
  x

(* Correctly accepted by the typechecker: the grade demands a bake or six
   ticks of air drying, and each branch covers one of them. *)
let baked_or_dried (b : bool) =
  box {Bake | 6} (Part "gear") as p in
  if b then perform Bake () else delay 6;
  unbox p as x in
  x

(* Correctly accepted by the typechecker: the function coats, and then takes
   at least four ticks. *)
let finish () : unit # {Coat; 4} =
  perform Coat ();
  perform Bake ();
  perform Inspect ()

(* Correctly accepted by the typechecker, which may be surprising: the grade
   contains the empty run, which every run covers, so '{(Bake; Inspect)*}'
   equals '{0}', the top of the order, and demands nothing. *)
let undemanding () =
  box {(Bake; Inspect)*} (Part "gear") as p in
  unbox p as x in
  x

(* Correctly rejected by the typechecker: a bake may take only three ticks,
   short of the five the grade demands:

     Typing error: Variable `p` is unboxed with grade `{Bake}` accumulated
       since it was bound, which is not below its box grade `{5}`
       ...
       Note: the resource inequality `{Bake} <= {5}` does not hold
*)
(*
let undercured () =
  box {5} (Part "gear") as p in
  perform Bake ();
  unbox p as x in
  x
*)

(* Correctly rejected by the typechecker: waiting never performs a demanded
   operation:

     Typing error: Variable `p` is unboxed with grade `{10}` accumulated since
       it was bound, which is not below its box grade `{Inspect}`
       ...
       Note: the resource inequality `{10} <= {Inspect}` does not hold
*)
(*
let uninspected () =
  box {Inspect} (Part "gear") as p in
  delay 10;
  unbox p as x in
  x
*)

(* Correctly rejected by the typechecker: the bake precedes the coating, so the
   ticks it banks do not count towards the four demanded after the coating:

     Typing error: Variable `p` is unboxed with grade `{Bake; Coat; 1}`
       accumulated since it was bound, which is not below its box grade
       `{Coat; 4}`
       ...
       Note: the resource inequality `{Bake; Coat; 1} <= {Coat; 4}` does not
         hold
*)
(*
let baked_first () =
  box {Coat; 4} (Part "gear") as p in
  perform Bake ();
  perform Coat ();
  delay 1;
  unbox p as x in
  x
*)

(* Correctly rejected by the typechecker: every run must cover the grade, and
   the run that only inspects banks a single tick of the three demanded:

     Typing error: Variable `p` is unboxed with grade `{Bake | Inspect}`
       accumulated since it was bound, which is not below its box grade `{3}`
       ...
       Note: the resource inequality `{Bake | Inspect} <= {3}` does not hold
       Note: the grade `{Inspect}` is below `{Bake | Inspect}` but not below
         `{3}`
*)
(*
let baked_or_inspected (b : bool) =
  box {3} (Part "gear") as p in
  if b then perform Bake () else perform Inspect ();
  unbox p as x in
  x
*)

(* Correctly rejected by the typechecker: two inspections after the coating
   bank two ticks, not the four the annotated grade demands:

     Typing error: This function's body has grade `{Coat; Inspect; Inspect}`,
       which does not match its annotated grade `{Coat; 4}`
       Note: the effect inequality `{Coat; Inspect; Inspect} <= {Coat; 4}`
         does not hold
*)
(*
let hasty_finish () : unit # {Coat; 4} =
  perform Coat ();
  perform Inspect ();
  perform Inspect ()
*)

run coated_then_cured ()

(* A grade with large intermediate automata: the box grade permits the runs of
   one or more cycles of a coating, a bake and an inspection whose 12th-last
   step, if any, is neither a coating nor a bake, that is, the runs of one to
   three cycles. Under 'traces-regex-lower', reading the literal builds the
   minimal automata of the two complements and of their intersection before the
   cycles restrict it: the example, with this program uncommented, takes about
   3.5 s, and about 11 s with the 13th-last step. Under
   'traces-regex-lower-symbolic', the literal is kept as a normalised
   expression, whose derivatives are few: the example takes about 0.06 s at both
   sizes, as without the program. *)
(*
let cycles () =
  box {~(_*; Coat; _; _; _; _; _; _; _; _; _; _; _)
       & ~(_*; Bake; _; _; _; _; _; _; _; _; _; _; _)
       & ((Coat; Bake; Inspect)*; Coat; Bake; Inspect)} (Part "gear") as p in
  perform Coat ();
  perform Bake ();
  perform Inspect ();
  unbox p as x in
  x
*)
