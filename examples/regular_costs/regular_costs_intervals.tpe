(* Run this example with the 'traces-regex-interval-symbolic' grading monoid,
   e.g.

     ./tempore --grades traces-regex-interval-symbolic examples/regular_costs/regular_costs_intervals.tpe *)

(* A grade is a pair '({...}, {...})' of regular languages of runs: a lower
   bound, ordered as under 'traces-regex-lower' at the lower ends of the
   runtime bounds 'within (lo, hi)', and an upper bound, ordered as under
   'traces-regex-upper' at their upper ends; pairs are compared componentwise.
   '{...}' abbreviates the pair of a language with itself, and '(n, m)' the
   pair '({n}, {m})'. *)

type part = Part of string

(* The operations of a coating line: a coating takes one to two ticks, a bake
   three to five, an inspection one and a sealing one to two. *)
operation Coat : unit ~> unit # {Coat} within (1, 2)
default Coat () = delay 1

operation Bake : unit ~> unit # {Bake} within (3, 5)
default Bake () = delay 4

operation Inspect : unit ~> unit # {Inspect} within (1, 1)
default Inspect () = delay 1

operation Seal : unit ~> unit # {Seal} within (1, 2)
default Seal () = delay 1

(* Correctly accepted by the typechecker: the part cures for at least four and
   at most eight ticks; a bake and an inspection take between four and six. *)
let cured () =
  box (4, 8) (Part "gear") as p in
  perform Bake ();
  perform Inspect ();
  unbox p as x in
  x

(* Correctly accepted by the typechecker: the grade demands, and allows,
   exactly a coating followed by two ticks. *)
let coated_exactly () =
  box {Coat; 2} (Part "gear") as p in
  perform Coat ();
  delay 2;
  unbox p as x in
  x

(* Correctly accepted by the typechecker: a bake is demanded, and it may be
   followed by any number of inspections and ticks. *)
let baked_and_inspected () =
  box ({Bake}, {Bake; (Inspect | 1)*}) (Part "gear") as p in
  perform Bake ();
  perform Inspect ();
  delay 1;
  perform Inspect ();
  unbox p as x in
  x

(* Correctly accepted by the typechecker: the function coats, cures for four
   to eight ticks, and seals. *)
let sealed () : unit # ({Coat; 4; Seal}, {Coat; 8; Seal}) =
  perform Coat ();
  perform Bake ();
  perform Inspect ();
  perform Seal ()

(* Correctly rejected by the typechecker: a bake may take only three ticks,
   short of the lower bound of four:

     Typing error: Variable `p` is unboxed with grade `({Bake},{Bake})`
       accumulated since it was bound, which is not below its box grade
       `({4},{8})`
       ...
       Note: the resource inequality `({Bake},{Bake}) <= ({4},{8})` does not
         hold
*)
(*
let undercured () =
  box (4, 8) (Part "gear") as p in
  perform Bake ();
  unbox p as x in
  x
*)

(* Correctly rejected by the typechecker: two bakes may take ten ticks, past
   the upper bound of eight:

     Typing error: Variable `p` is unboxed with grade
       `({Bake; Bake},{Bake; Bake})` accumulated since it was bound, which is
       not below its box grade `({4},{8})`
       ...
       Note: the resource inequality
         `({Bake; Bake},{Bake; Bake}) <= ({4},{8})` does not hold
*)
(*
let overcured () =
  box (4, 8) (Part "gear") as p in
  perform Bake ();
  perform Bake ();
  unbox p as x in
  x
*)

(* Correctly rejected by the typechecker: the upper bound allows only
   inspections after the bake, and a tick of waiting is not one:

     Typing error: Variable `p` is unboxed with grade `({Bake; 1},{Bake; 1})`
       accumulated since it was bound, which is not below its box grade
       `({Bake},{Bake; Inspect*})`
       ...
       Note: the resource inequality
         `({Bake; 1},{Bake; 1}) <= ({Bake},{Bake; Inspect*})` does not hold
*)
(*
let baked_and_idle () =
  box ({Bake}, {Bake; Inspect*}) (Part "gear") as p in
  perform Bake ();
  delay 1;
  unbox p as x in
  x
*)

(* Correctly rejected by the typechecker: a second coating takes at most the
   two ticks the upper bound allows, but may take one, short of the two the
   lower bound demands:

     Typing error: Variable `p` is unboxed with grade
       `({Coat; Coat},{Coat; Coat})` accumulated since it was bound, which is
       not below its box grade `({Coat; 2},{Coat; 2})`
       ...
       Note: the resource inequality
         `({Coat; Coat},{Coat; Coat}) <= ({Coat; 2},{Coat; 2})` does not hold
*)
(*
let coated_twice () =
  box {Coat; 2} (Part "gear") as p in
  perform Coat ();
  perform Coat ();
  unbox p as x in
  x
*)

run sealed ()
