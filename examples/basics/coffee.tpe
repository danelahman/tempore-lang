(* A café whose coffee is served once it has brewed, timed in minutes.

   Run this example with the 'regex-upper-bound-rational' grading monoid, e.g.

     ./tempore --grades regex-upper-bound-rational examples/basics/coffee.tpe

   Grades {...}: regular languages of runs over operations and rational delays
     - Unit {0}: the empty run
     - Top ⊤: every run
     - Product: concatenation of runs, adjacent delays added *)

(* A resource is a value placed in a box. The computation 'box ρ v as x in c'
   boxes the value v at the grade ρ and continues with c; within c, the value
   may be used, by 'unbox x as y in ...', only once the computation since the
   box has a grade below ρ.

   The grade of a computation is the set of its runs. A run is a sequence of
   operations and pauses; 'delay q' is a pause of q minutes, and adjacent
   pauses add. A grade is written as a regular expression in braces:
     - 'r; s' is the sequence of r and s, 'r | s' the choice between them
     - 'r*' is any number of repetitions of r
     - '_' is any single operation or positive pause
     - '~r' is the complement of r, 'r & s' the intersection of r and s
     - an interval such as '[5, ∞)' is a pause of at least 5
   A grade is below another if its set of runs is included in the other's.

   The typechecker infers the grade of every computation and checks each
   unboxing before the program is run. *)

(* An operation declaration gives the operation's name, its argument and
   result types, and the grade of performing it; 'perform Pay ()' performs
   Pay, a computation with the single run 'Pay'. *)
operation Pay : unit ~> unit # {Pay}
operation Milk : unit ~> unit # {Milk}
operation Sugar : unit ~> unit # {Sugar}
operation Refund : unit ~> unit # {Refund}

(* Brewing, a pure function of the beans. *)
let brew beans = beans

(* Correctly accepted by the typechecker: the cup is boxed at the runs
   consisting of one pause of at least 5. The delays of 3 and 2 add up to the
   run '5', which is among them. *)
let timely_serving beans =
  box {[5, ∞)} (brew beans) as cup in
  delay 3;
  delay 2;
  unbox cup as c in
  c

(* Correctly rejected by the typechecker: the run '3' is not a pause of at
   least 5:

     Typing error: Variable `cup` is unboxed with grade `{3}` accumulated
       since it was bound, which is not below its box grade `{[5, ∞)}`
       ...
       Note: the resource inequality `{3} <= {[5, ∞)}` does not hold
*)
(*
let rushed_serving beans =
  box {[5, ∞)} (brew beans) as cup in
  delay 3;
  unbox cup as c in
  c
*)

(* Correctly accepted by the typechecker: the cup is boxed at the runs that
   pay, perform no refund, pause for at least 5, still perform no refund, and
   end with any number of additions of milk and sugar. The run
   'Pay; 5; Milk' is among them, each '(_ & ~Refund)*' matching the empty
   run. *)
let paid_serving beans =
  box {Pay; (_ & ~Refund)*; [5, ∞);
       (_ & ~Refund)*; (Milk | Sugar)*}
    (brew beans) as cup in
  perform Pay ();
  delay 3;
  delay 2;
  perform Milk ();
  unbox cup as c in
  c

(* Correctly rejected by the typechecker: no part of the grade matches the
   refund in the run 'Pay; 3; Refund; 2; Milk', since '_ & ~Refund' excludes
   it and '(Milk | Sugar)*' does not contain it:

     Typing error: Variable `cup` is unboxed with grade
       `{Pay; 3; Refund; 2; Milk}` accumulated since it was bound, which is
       not below its box grade
       `{Pay; (_ & ~Refund)*; [5, ∞); (_ & ~Refund)*; (Milk | Sugar)*}`
       ...
       Note: the resource inequality
         `{Pay; 3; Refund; 2; Milk} <=
            {Pay; (_ & ~Refund)*; [5, ∞); (_ & ~Refund)*; (Milk | Sugar)*}`
         does not hold
*)
(*
let refunded_serving beans =
  box {Pay; (_ & ~Refund)*; [5, ∞);
       (_ & ~Refund)*; (Milk | Sugar)*}
    (brew beans) as cup in
  perform Pay ();
  delay 3;
  perform Refund ();
  delay 2;
  perform Milk ();
  unbox cup as c in
  c
*)

(* 'run' executes a computation and prints its value and final state. An
   operation without a default implementation stops a run, so the run
   executes the first definition, which uses delays alone. *)
run timely_serving "arabica"
