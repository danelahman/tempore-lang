(* Reading and writing a piece of state, each operation with its own grade.

   Run this example with the 'time-lower-bound' grading monoid, e.g.

     ./tempore --grades time-lower-bound examples/basics/operations.tpe

   Grades n: at least n time steps
     - Unit 0: no time needed
     - Top 0: no time needed; the unit is the top
     - Product: addition *)

(* Reading the state takes 3 ticks. *)
operation Get : unit ~> nat # 3
(* Writing it takes 7. *)
operation Set : nat ~> unit # 7

(* Correctly accepted by the typechecker: grade 13, the three ticks of each of
   the two 'Get's and the seven of the 'Set'. *)
let foo () =
  perform Get (); 
  perform Set 42; 
  let x = perform Get () in
  x + x