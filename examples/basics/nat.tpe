(* Unary natural numbers, with addition, multiplication and conversion to nat.

   Run this example with the 'time-lower-bound' grading monoid, e.g.

     ./tempore --grades time-lower-bound examples/basics/nat.tpe

   Grades n: at least n ticks (time steps)
     - Unit 0: no time needed
     - Top 0: no time needed; the unit is the top
     - Product: addition *)

(* Unary natural numbers. *)
type unary =
  | Zero
  | Succ of unary

(* Correctly accepted by the typechecker: structural recursion on 'm', of
   grade 0 --- nothing in this file takes time. *)
let rec add m n =
  match m with
  | Zero -> n
  | Succ m' -> Succ (add m' n)

(* Multiplication as repeated addition. *)
let rec multiply m n =
  match m with
  | Zero -> Zero
  | Succ m' -> add n (multiply m' n)

(* Conversion to a built-in natural number. *)
let rec to_nat =
  function
  | Zero -> 0
  | Succ m -> to_nat m + 1

(* And back, by recursion on the natural number. *)
let rec from_nat n =
  match n with
  | 0 -> Zero
  | m + 1 -> Succ (from_nat m)

(* The run computes 6 * 7 in unary and prints it as a natural number. *)
run
  let six = from_nat 6 in
  let seven = Succ six in
  let forty_two = multiply six seven in
  to_nat forty_two
