(* A session synchronising four messages, two of them unseen. *)
run synchronise_mailbox "ada" 4

(* A session reading the first message. *)
run read_first_message "ada"

(* A session implemented by the handler, fetching three messages. *)
run handle perform Session 3 with fetch_then_flag

(* Two messages synchronised without a login. *)
run synchronise_without_login 2
