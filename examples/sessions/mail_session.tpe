   by no operation of the session and paid for by no tick:

     Typing error: This function's body has grade `{Login; Logout; Fetch*}`,
       which does not match its annotated grade
       `{Login; (Fetch | Store)*; Logout}`
       Note: the effect inequality
         `{Login; Logout; Fetch*} <= {Login; (Fetch | Store)*; Logout}` does
         not hold
       Note: the grade `{Login; Logout; Fetch}` is below
         `{Login; Logout; Fetch*}` but not below
         `{Login; (Fetch | Store)*; Logout}`
*)
(*
let fetch_after_logout (user : string) (count : nat)
    : message list # {Login; (Fetch | Store)*; Logout} =
  perform Login user;
  perform Logout ();
  fetch_messages 1 count
*)

