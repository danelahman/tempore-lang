(* Logins and requests of a client checked against rate limits, each login issuing a boxed token.

   Run this example with the 'at-most-counts' grade algebra, e.g.

     ./tempore --grades at-most-counts examples/at_most_counts/rate_limits.tpe

   Grades ((A, n), ...): at most n calls of each operation A
     - Unit 0: no calls, the least grade
     - Top ∞: unlimited calls of every operation
     - Product: addition, name by name *)

(* A token is noneternal, so it is kept across calls only inside its box. *)
noneternal type token = Token of string

(* Each operation counts itself once. A login issues a token boxed at
   '(Request, 2)', usable while at most two requests and no other operation
   have followed. *)
operation Login : string ~> [(Request, 2)]token ! (Login, 1)
default Login user = box (Request, 2) (Token user)

operation Request : token * string ~> string ! (Request, 1)
default Request (t, q) = "response"

(* Correctly accepted by the typechecker: a session of one login and three
   requests, however long it waits between them. *)
let session () : unit ! ((Login, 1), (Request, 3)) =
  let t = perform Login "alice" in
  unbox t as token in
  let _ = perform Request (token, "a") in
  delay 10;
  unbox t as token in
  let _ = perform Request (token, "b") in
  unbox t as token in
  let _ = perform Request (token, "c") in
  ()

(* Correctly accepted by the typechecker: a branch takes the greater count of
   its arms, so up to three attempts at logging in count three. *)
let login_with_retries user : bool ! (Login, 3) =
  let t = perform Login user in
  unbox t as Token a in
  if a = user then true
  else
    let t = perform Login user in
    unbox t as Token b in
    if b = user then true
    else
      let t = perform Login user in
      unbox t as Token c in
      c = user

(* Correctly accepted by the typechecker: the token is in reach after two
   requests and a wait. *)
let two_requests () =
  let t = perform Login "bob" in
  unbox t as token in
  let _ = perform Request (token, "a") in
  unbox t as token in
  let _ = perform Request (token, "b") in
  delay 5;
  unbox t as token in
  token

(* Correctly rejected by the typechecker: a fourth request with one token
   follows three requests, one more than its box allows:

     Typing error: Variable `t` is unboxed with grade `(Request, 3)`
       accumulated since it was bound, which is not below its box grade
       `(Request, 2)`
       ...
       Note: the resource inequality `(Request, 3) <= (Request, 2)` does not
         hold
*)
(*
let greedy_session () : unit ! ((Login, 1), (Request, 3)) =
  let t = perform Login "alice" in
  unbox t as token in
  let _ = perform Request (token, "a") in
  unbox t as token in
  let _ = perform Request (token, "b") in
  unbox t as token in
  let _ = perform Request (token, "c") in
  unbox t as token in
  let _ = perform Request (token, "d") in
  ()
*)

(* Correctly rejected by the typechecker: a fourth request with the token of a
   second login exceeds the limits of the session:

     Typing error: This function's body has grade `((Login, 2), (Request, 4))`,
       which does not match its annotated grade `((Login, 1), (Request, 3))`
       Note: the effect inequality
         `((Login, 2), (Request, 4)) <= ((Login, 1), (Request, 3))` does not
         hold
*)
(*
let relogin_session () : unit ! ((Login, 1), (Request, 3)) =
  let t = perform Login "alice" in
  unbox t as token in
  let _ = perform Request (token, "a") in
  unbox t as token in
  let _ = perform Request (token, "b") in
  unbox t as token in
  let _ = perform Request (token, "c") in
  let u = perform Login "alice" in
  unbox u as token in
  let _ = perform Request (token, "d") in
  ()
*)

(* Correctly rejected by the typechecker: logging in again spends the boxed
   token, whose grade allows requests only:

     Typing error: Variable `t` is unboxed with grade
       `((Login, 1), (Request, 1))` accumulated since it was bound, which is
       not below its box grade `(Request, 2)`
       ...
       Note: the resource inequality
         `((Login, 1), (Request, 1)) <= (Request, 2)` does not hold
*)
(*
let relogin () =
  let t = perform Login "bob" in
  unbox t as token in
  let _ = perform Request (token, "a") in
  let _ = perform Login "bob" in
  unbox t as token in
  token
*)

(* Correctly rejected by the typechecker: the request after the second login
   reuses the token unboxed before it, which is kept across the login:

     Typing error: Variable `token` is used with grade
       `((Login, 1), (Request, 1))` accumulated since it was bound, but its
       type `token` is not eternal
       ...
       Note: the resource inequality `((Login, 1), (Request, 1)) <= 0` does
         not hold
*)
(*
let relogin_kept () =
  let t = perform Login "bob" in
  unbox t as token in
  let _ = perform Request (token, "a") in
  let _ = perform Login "bob" in
  perform Request (token, "b")
*)

run session ()
run two_requests ()
