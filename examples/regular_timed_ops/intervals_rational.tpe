(* A weather station timed in seconds, its traces bounded below and above by
   regular languages.

   Run this example with the 'regex-timed-interval-rational-symbolic' grading monoid, e.g.

     ./tempore --grades regex-timed-interval-rational-symbolic \
       examples/regular_timed_ops/intervals_rational.tpe

   Grades [L, U]: a lower and upper regular-language bound on the traces with
   rational durations
     - Unit [{0}, {0}]: nothing demanded, only the empty trace allowed
     - Top [{0}, ∞): nothing demanded, every trace allowed
     - Product: concatenation of traces, componentwise *)

type reading = Reading of nat
type packet = Packet of reading

(* A reading of the sensors has a running time between half a second and one
   and a half; its default takes three quarters of a second. *)
operation Sample : unit ~> reading ! {Sample} within [1/2, 3/2]
default Sample () = delay 0.75; Reading 12

(* Compressing a reading has a running time between a quarter of a second and
   one second; its default takes three fifths of a second. *)
operation Compress : reading ~> packet ! {Compress} within [1/4, 1]
default Compress r = delay 3/5; Packet r

(* A transmission has a running time of more than half a second and at most
   one and a half: its running-time bounds are open below. Its default takes
   three quarters of a second, within these bounds. *)
operation Transmit : packet ~> unit ! {Transmit} within (1/2, 3/2]
default Transmit p = delay 3/4

(* A report samples, compresses and transmits, in that order. *)
operation Report : unit ~> unit ! {Sample; Compress; Transmit}

(* Correctly accepted by the typechecker: the previous packet is boxed and
   transmitted after more than 0.8 seconds and within less than three, the
   interval (0.8, 3), that is, [{(0.8, ∞)}, {[0, 3)}], while the next one is
   prepared. The sample, the delay and the compression take at least
   1/2 + 1/5 + 1/4 = 0.95 and at most 3/2 + 1/5 + 1 = 2.7. *)
let settled_packet (previous : packet) =
  box (0.8, 3) previous as window in
  let r = perform Sample () in
  delay 1/5;
  let p = perform Compress r in
  unbox window as previous' in
  perform Transmit previous';
  p

(* Correctly accepted by the typechecker: as 'settled_packet', with a window
   written with regular expressions, demanding the sample and a duration of a
   fifth, and allowing the sample, a duration of more than nothing and at most
   a quarter, and the compression; the delay of 0.22 seconds lies between the
   two. *)
let settled_by_events (previous : packet) =
  box [{Sample; 1/5}, {Sample; (0, 1/4]; Compress}] previous as window in
  let r = perform Sample () in
  delay 0.22;
  let p = perform Compress r in
  unbox window as previous' in
  perform Transmit previous';
  p

(* Correctly accepted by the typechecker: the previous packet is boxed and
   transmitted after at least one sample, and at most samples each followed
   by a duration of at most a third. *)
let polling (previous : packet) =
  box [{Sample}, {(Sample; [0, 1/3])*}] previous as window in
  let r = perform Sample () in
  delay 1/4;
  let s = perform Sample () in
  delay 0.3;
  unbox window as previous' in
  perform Transmit previous';
  s

(* Correctly accepted by the typechecker: the reading is boxed and
   compressed after a second. The upper bound excludes the single duration of
   one second, but a grade stands for its closure, and the longer durations
   the complement keeps permit it. *)
let offbeat () =
  let r = perform Sample () in
  box [{1}, {~1}] r as held in
  delay 1/2;
  delay 1/2;
  unbox held as r' in
  perform Compress r'

(* Correctly accepted by the typechecker: the report itself, performed by
   hand, realises the grade of 'Report'. *)
let report_by_hand () =
  let r = perform Sample () in
  let p = perform Compress r in
  perform Transmit p

(* Correctly accepted by the typechecker: a report takes more than
   1/2 + 1/4 + 1/2 = 5/4 seconds, since a transmission takes more than half a
   second, and at most 3/2 + 1 + 3/2 = 4, so it fits a radio slot that opens
   after 5/4 seconds and closes at 4, the annotated grade of the function. *)
let report_in_slot () : unit ! (5/4, 4] =
  perform Report ()

(* Correctly rejected by the typechecker: without the delay, the sample and
   the compression may take exactly 1/2 + 1/4 = 3/4 seconds, which the window
   open at 3/4 excludes; the closed window [3/4, 3] would permit it:

     Typing error: Variable `window` is unboxed with grade
       `[{Sample; Compress}, {Sample; Compress}]` accumulated since it was
       bound, which is not below its box grade `[{(0.75, ∞)}, {[0, 3)}]`
       ...
       Note: the resource inequality
         `[{Sample; Compress}, {Sample; Compress}] <= [{(0.75, ∞)}, {[0, 3)}]`
         does not hold
*)
(*
let hasty_packet (previous : packet) =
  box (3/4, 3) previous as window in
  let r = perform Sample () in
  let p = perform Compress r in
  unbox window as previous' in
  perform Transmit previous';
  p
*)

(* Correctly rejected by the typechecker: a delay of half a second exceeds
   the quarter the upper bound allows between the sample and the compression:

     Typing error: Variable `window` is unboxed with grade
       `[{Sample; 0.5; Compress}, {Sample; 0.5; Compress}]` accumulated since
       it was bound, which is not below its box grade
       `[{Sample; 0.2}, {Sample; (0, 0.25]; Compress}]`
       ...
       Note: the resource inequality
         `[{Sample; 0.5; Compress}, {Sample; 0.5; Compress}] <= [{Sample; 0.2}, {Sample; (0, 0.25]; Compress}]`
         does not hold
*)
(*
let idle_packet (previous : packet) =
  box [{Sample; 1/5}, {Sample; (0, 1/4]; Compress}] previous as window in
  let r = perform Sample () in
  delay 1/2;
  let p = perform Compress r in
  unbox window as previous' in
  perform Transmit previous';
  p
*)

(* Correctly rejected by the typechecker: a report may take exactly four
   seconds, which the slot open at 4 excludes:

     Typing error: This function's body has grade
       `[{Sample; Compress; Transmit}, {Sample; Compress; Transmit}]`, which
       does not match its annotated grade `[{(1.25, ∞)}, {[0, 4)}]`
       Note: the effect inequality
         `[{Sample; Compress; Transmit}, {Sample; Compress; Transmit}] <= [{(1.25, ∞)}, {[0, 4)}]`
         does not hold
*)
(*
let report_in_short_slot () : unit ! (5/4, 4) =
  perform Report ()
*)

(* The operations are atomic and run their defaults, so the report takes
   0.75 + 0.6 + 0.75 = 2.1 seconds. *)
run report_by_hand ()
